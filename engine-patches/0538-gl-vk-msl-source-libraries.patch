--- /dev/null
+++ b/dm/gfx/layer_msl.h
@@ -0,0 +1,95 @@
+// The GL and Vulkan layers' shaders from Metal SOURCE (engine-patches/0538): one .metal file per function, compiled on the device at first use.
+// The iPhone has no `xcrun metal`, so a game whose GL / Vulkan shaders were translated on the phone ships <DM_MSL_DIR>/<api>/<api>_shaders.tsv and <DM_MSL_DIR>/<api>/msl/<name>.metal
+// instead of <api>_shaders.metallib: the file of function <api>_<name> (vk_<key>, vk_<key>_d, vk_<key>_vp<n>; gl_<key>_v, gl_<key>_f) holds that function alone, as the temporary
+// .metal files gl_shaders.py / vk_shaders.py compile one by one before they link the metallib (crates/ibuilder-glvk writes them). The layer (hle_gl.m, hle_vk.m) includes this file
+// once and asks layer_fn for every function of the game's library; with no metallib, lmsl_lib compiles that name's file with newLibraryWithSource, once: one library per name, cached
+// under a lock (a name whose file is missing or does not compile is cached as such, and reported once).
+// Options: the family of the NVN layer's source compiles (iOSBuilder's paches/0007 with engine-patches/0535): mathMode Relaxed, preserveInvariance YES, optimizationLevel Size
+// (DM_MTL_OPT_SIZE=0: Default, the switch 0535 reads, read here once too). A plain [MTLCompileOptions new] with the three set: 0535's DmMslCompileOptions exists only because 0007's
+// line cannot be edited, and a subclass of the class (a facade) would have none of its properties. The Mac's gl_shaders.py / vk_shaders.py compile with `metal -fpreserve-invariance
+// -fwrapv` (fast math, the compiler's default); -fwrapv has no MTLCompileOptions counterpart.
+#ifndef DM_LAYER_MSL_H
+#define DM_LAYER_MSL_H
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include "../host/dm_envflag.h"
+
+static char g_lmsl_dir[1024];   // <DM_MSL_DIR>/<api>/msl, set by lmsl_probe when that folder exists (source mode); empty otherwise
+static char g_lmsl_api[4];      // "vk" / "gl": every function name starts with it and "_", which the file name drops
+static pthread_mutex_t g_lmsl_mu = PTHREAD_MUTEX_INITIALIZER;
+static NSMutableDictionary<NSString *, id> *g_lmsl_libs;   // under g_lmsl_mu: name -> its id<MTLLibrary>, or NSNull (no file, or it did not compile)
+static _Atomic uint64_t g_lmsl_compiled, g_lmsl_failed, g_lmsl_missing, g_lmsl_ns;   // libraries compiled, compiles failed, names without a file, and the compiles' total time
+
+static int lmsl_on(void) { return g_lmsl_dir[0] != 0; }
+// Source mode: <d>/<api>/msl is a folder. Called by sh_load when <d>/<api>/<api>_shaders.metallib does not exist; returns 1 (and sets the folder) when it does
+static int lmsl_probe(const char *d, const char *api) {
+    struct stat st; char p[sizeof g_lmsl_dir];
+    g_lmsl_dir[0] = 0; strlcpy(g_lmsl_api, api, sizeof g_lmsl_api);
+    if (!d || !*d || (size_t)snprintf(p, sizeof p, "%s/%s/msl", d, api) >= sizeof p - 128) return 0;   // room for the longest file name lmsl_lib accepts
+    if (stat(p, &st) || !S_ISDIR(st.st_mode)) return 0;
+    strlcpy(g_lmsl_dir, p, sizeof g_lmsl_dir);
+    return 1;
+}
+static int lmsl_opt_size(void) {
+    static int v, bad; static dispatch_once_t once;
+    dispatch_once(&once, ^{ v = dm_env_flag("DM_MTL_OPT_SIZE", 1, &bad); });
+    return v;
+}
+// The options every library compiled here gets (one object per compile: Metal keeps none of it)
+static MTLCompileOptions *lmsl_options(void) {
+    MTLCompileOptions *o = [MTLCompileOptions new];
+    o.mathMode = MTLMathModeRelaxed; o.preserveInvariance = YES;
+    if (lmsl_opt_size()) o.optimizationLevel = MTLLibraryOptimizationLevelSize;
+    return o;
+}
+// The file of a function name: <dir>/<name without "<api>_">.metal. Only the names the tools make (letters, digits, '_'; 112 characters at most) are looked up
+static int lmsl_path(NSString *name, char *p, size_t n) {
+    const char *s = name.UTF8String; size_t a = strlen(g_lmsl_api);
+    if (!s || strncmp(s, g_lmsl_api, a) || s[a] != '_' || !s[a + 1] || strlen(s + a + 1) > 112) return 0;
+    for (const char *c = s + a + 1; *c; c++) if (!((*c >= '0' && *c <= '9') || (*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') || *c == '_')) return 0;
+    return (size_t)snprintf(p, n, "%s/%s.metal", g_lmsl_dir, s + a + 1) < n;
+}
+// The library of function name, compiled from its file on the first call (concurrent first calls may both compile; the first stored is kept). nil: not source mode, no such file,
+// or it does not compile (logged once, with Metal's message, by red: the layer's own [RED] log line, called with the name, the path and the message)
+static id<MTLLibrary> lmsl_lib(id<MTLDevice> dev, NSString *name, void (*red)(const char *name, const char *path, const char *why)) {
+    if (!lmsl_on() || !dev || !name) return nil;
+    pthread_mutex_lock(&g_lmsl_mu);
+    id have = g_lmsl_libs[name];
+    pthread_mutex_unlock(&g_lmsl_mu);
+    if (have) return have == [NSNull null] ? nil : have;
+    char p[sizeof g_lmsl_dir + 128]; id<MTLLibrary> lib = nil;
+    if (!lmsl_path(name, p, sizeof p)) { if (red) red(name.UTF8String, "", "not a function name of the layer's library"); atomic_fetch_add(&g_lmsl_failed, 1); }
+    else {
+        NSError *err = nil;
+        NSString *src = [NSString stringWithContentsOfFile:@(p) encoding:NSUTF8StringEncoding error:&err];
+        if (!src) atomic_fetch_add(&g_lmsl_missing, 1);   // a variant the tools did not make (vk_<key>_d of a shader without a second output): nil, as newFunctionWithName gives
+        else {
+            uint64_t t0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+            lib = [dev newLibraryWithSource:src options:lmsl_options() error:&err];
+            atomic_fetch_add(&g_lmsl_ns, clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0);
+            if (lib) atomic_fetch_add(&g_lmsl_compiled, 1);
+            else { atomic_fetch_add(&g_lmsl_failed, 1); if (red) red(name.UTF8String, p, err.localizedDescription.UTF8String ? err.localizedDescription.UTF8String : "no message"); }
+        }
+    }
+    pthread_mutex_lock(&g_lmsl_mu);
+    if (!g_lmsl_libs) g_lmsl_libs = [NSMutableDictionary new];
+    id first = g_lmsl_libs[name];
+    if (first) lib = first == [NSNull null] ? nil : first;
+    else g_lmsl_libs[name] = lib ? (id)lib : (id)[NSNull null];
+    pthread_mutex_unlock(&g_lmsl_mu);
+    return lib;
+}
+// The layer's teardown (session reset): the libraries go with the device; the folder is probed again by the next sh_load
+static void lmsl_teardown(void) {
+    pthread_mutex_lock(&g_lmsl_mu);
+    g_lmsl_libs = nil; g_lmsl_dir[0] = 0;
+    atomic_store(&g_lmsl_compiled, 0); atomic_store(&g_lmsl_failed, 0); atomic_store(&g_lmsl_missing, 0); atomic_store(&g_lmsl_ns, 0);
+    pthread_mutex_unlock(&g_lmsl_mu);
+}
+#endif
