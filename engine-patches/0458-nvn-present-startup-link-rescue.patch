# nvn/present: complete startup display-link rescue (PR #3004)
#
# Upstream:  https://github.com/seedds/nxnative/commit/fa549e08c39c01e054528ed68ef857296bd4a9b1  (PR #3004)
# Author:    seedds, 2026-11-20 18:37:56 +0800
# Co-authors:
#   Co-authored-by: bettterlabs
# Licence:   MIT, Copyright (c) 2026 seedds (nxnative LICENSE); the attribution above is kept as the licence asks.
#
# WHAT IT CHANGES FOR THE PHONE
#   The phone presents through CAMetalDisplayLink. When the link already owns the Metal layer but its first pacing mode has not been applied (applied == 0), a rescue asking for mode 0 (the
#   present thread takes the layer back: the stall rescue) returned early in link_sync, so the link was never invalidated, callbacks that declined presents kept refreshing the stall clock and the
#   present thread's next nextDrawable stalled: a start-up freeze (upstream: 5 of 5 freezes on Wonder 1.2.1, Mac mini at a fixed 144 Hz; 0 of 5 after). Now link_sync with want == 0 and a link
#   present still invalidates it, and a callback entering during rescue (or with the link off) returns before touching the stall clock or publishing a tick. Default: on, no switch.
# One of upstream's four hunks (a comment-only line) did not apply and was left out; the three code hunks and the test apply as they are.
# RISK: low-medium (the phone's only presenter); no phone log shows this stall. NOT run on a device. Shader chain id untouched.
#
# Apply with: patch -p1, to the tree out-stage/out-engine/engine + engine-patches/0401..0415 and the candidates numbered below this one, in the order of the numbers of this folder.

--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -19992,6 +19992,8 @@
     (void)link;
     double cb = CACurrentMediaTime();
     pthread_mutex_lock(&g_pq_mu);
+    // A callback that cannot take a present must not reset the watchdog or count a pacing tick. The next enqueue that hands off the layer may be waiting for a texture.
+    if (!g_dm_present_link || g_rescue_mode) { pthread_mutex_unlock(&g_pq_mu); return; }
     if (g_stall_t0) { uint64_t since = dm_focus_in_since(), t = now_ns();
         MLOG("display link recovered: stalled %.0f ms (%.0f ms of it active), fallback dropped %llu frames (stall #%llu)", (t - g_stall_t0) / 1e6, (t - (g_stall_t0 > since ? g_stall_t0 : since)) / 1e6, (unsigned long long)g_stall_drop, (unsigned long long)g_stall_n); g_stall_t0 = 0; }
     pthread_mutex_unlock(&g_pq_mu);
@@ -20238,7 +20240,8 @@
     if (lk && hz != hz_was) { hz_was = hz; if (want && want == applied) { lk.preferredFrameRateRange = link_range(want); MLOG("display link: the screen runs at %d Hz now, range set again (frame %llu)", hz, (unsigned long long)atomic_load(&g_cur_frame)); } }
     int lat = link_latency();   // fullscreen, screen or refresh mode changed: a link created since took the current policy
     if (lk && lk.preferredFrameLatency != lat) { lk.preferredFrameLatency = lat; MLOG("display link: frame latency %d (%s; frame %llu)", lat, link_latency_why(), (unsigned long long)atomic_load(&g_cur_frame)); }
-    if (want == applied) return;
+    // Rescue can ask for mode 0 after link_main has attached the layer but before an enqueue has applied the link's first mode, so applied is still 0 while a link owns the layer. Mode 0 with a link present still has to invalidate it, or the layer is never handed back.
+    if (want == applied && (want || !lk)) return;
     g_link_mode = want;
     if (!g_link_started) {
         if (!want) { applied = 0; return; }
@@ -20250,7 +20253,8 @@
     CAMetalDisplayLink *link = g_link; if (!link) return;
     if (want) link.preferredFrameRateRange = link_range(want);
     else { CFRunLoopRef rl = g_link_rl; g_link = nil; CFRunLoopPerformBlock(rl, kCFRunLoopDefaultMode, ^{ [link invalidate]; pthread_mutex_lock(&g_pq_mu); g_link_owns_layer = 0; pthread_cond_broadcast(&g_pq_cv); pthread_mutex_unlock(&g_pq_mu); CFRunLoopStop(rl); }); CFRunLoopWakeUp(rl); }
-    MLOG("present pacing mode %d → %d (frame %llu)", applied, want, (unsigned long long)atomic_load(&g_cur_frame));
+    if (want == applied) MLOG("display link: returning the layer to the present thread during startup (frame %llu)", (unsigned long long)atomic_load(&g_cur_frame));
+    else MLOG("present pacing mode %d → %d (frame %llu)", applied, want, (unsigned long long)atomic_load(&g_cur_frame));
     applied = want;
     pthread_mutex_lock(&g_pq_mu); pthread_cond_broadcast(&g_pq_cv); pthread_mutex_unlock(&g_pq_mu);
 }
--- a/dm/gfx/tests/t_present_rescue.m
+++ b/dm/gfx/tests/t_present_rescue.m
@@ -1,4 +1,5 @@
 // Exercise the production watchdog with a silent display link and a controlled clock; no GPU or game files. --metal also checks real layer ownership.
+// Checks: startup_rescue: a callback that enters during rescue leaves the stall clock and the ticks alone, the acquire after it returns, and a link published after the last enqueue keeps the layer until run-loop invalidation and then releases it.
 #import <QuartzCore/CAMetalDisplayLink.h>
 #import <QuartzCore/CAMetalLayer.h>
 @interface SilentDisplayLink : NSObject
@@ -22,6 +23,11 @@
 - (void)addToRunLoop:(NSRunLoop *)loop forMode:(NSRunLoopMode)mode { (void)mode; [loop addPort:[NSMachPort port] forMode:NSDefaultRunLoopMode]; }
 - (void)invalidate { self.invalidated = YES; }
 @end
+@interface RescueUpdate : NSObject
+@property CFTimeInterval targetPresentationTimestamp;
+@end
+@implementation RescueUpdate
+@end
 #define CAMetalDisplayLink SilentDisplayLink
 #define nvn_game_fps test_game_fps_now   // hle_nvn.c, linked here, has the strong nvn_game_fps; t_present_rescue_focus.c sets the rate
 #include "../nvn/nvn_mtl.m"
@@ -101,6 +107,26 @@
     CHECK("rescue invalidates the link before releasing the layer", link.invalidated && !g_link && !g_link_owns_layer);
     g_link_started = 0;
 }
+static void startup_rescue(void) {
+    reset(); g_link_started = 1; g_link_rl = CFRunLoopGetCurrent();
+    test_fullscreen = 1; test_screen_hz = 144;
+    link_sync();   // link_main owns the layer but has not published the link yet
+    SilentDisplayLink *link = [SilentDisplayLink new];
+    link.preferredFrameRateRange = link_range(g_link_mode);
+    wait_frame(); link_sync();   // rescue requested before the first mode has been applied
+    g_link = link;
+    uint64_t tick = g_link_tick_n, last = g_link_tick_ns;
+    RescueUpdate *update = [RescueUpdate new]; update.targetPresentationTimestamp = CACurrentMediaTime();
+    [[NvMetalDisplayLinkDelegate new] metalDisplayLink:(id)link needsUpdate:(id)update];
+    CHECK("a callback during rescue keeps the watchdog stalled", g_stall_t0 && g_link_tick_ns == last && g_link_tick_n == tick);
+    wait_frame();   // the next acquire must return before there can be another enqueue
+    test_screen_hz = 120;
+    link_sync();
+    CHECK("the newly published link still owns the layer until invalidated", g_link_owns_layer);
+    CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+    CHECK("rescue releases a link published after the last enqueue", link.invalidated && !g_link && !g_link_owns_layer);
+    g_link_started = 0; g_link = nil; test_fullscreen = test_screen_hz = 0;
+}
 static void latency(void) {   // Only variable-refresh fullscreen needs the latency-2 workaround; a new link takes the current policy as link_main does.
     reset(); test_fullscreen = 0; test_variable_refresh = 1; g_present_latency = 0;
     SilentDisplayLink *link = [SilentDisplayLink new]; link.preferredFrameLatency = link_latency();
@@ -190,7 +216,7 @@
 int main(int argc, char **argv) { @autoreleasepool {
     alarm(10); setbuf(stdout, NULL);
     if (argc > 2 || (argc == 2 && strcmp(argv[1], "--metal"))) return 2;
-    thresholds(); backoff(); settings(); lifecycle(); latency(); thirty(); vrr120();
+    thresholds(); backoff(); settings(); startup_rescue(); lifecycle(); latency(); thirty(); vrr120();
     if (argc == 2) metal_lifecycle();
     printf("present rescue: %d checks, %d failed\n", checks, failed); return failed != 0;
 } }
