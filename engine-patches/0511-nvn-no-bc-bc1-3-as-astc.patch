diff --git a/dm/gfx/tests/t_astc_hw.m b/dm/gfx/tests/t_astc_hw.m
new file mode 100644
index 0000000..1e8f0fc
--- /dev/null
+++ b/dm/gfx/tests/t_astc_hw.m
@@ -0,0 +1,82 @@
+// The GPU's own ASTC decoder against bcdec: BC1 / BC2 / BC3 blocks are transcoded (nvn_bc2astc.c), uploaded as ASTC 4x4 LDR and sRGB textures and read back through a compute kernel
+// (what a shader samples). astcenc (tests/t_bc2astc.c in dm/gfx/tex) is the reference decoder there; this checks the hardware agrees, layout by layout.
+// Usage: t_astc_hw [-v]
+#import <Metal/Metal.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define BCDEC_IMPLEMENTATION
+#include "../../third_party/bcdec/bcdec.h"
+#include "../tex/nvn_bc2astc.h"
+#include "../tex/bc2astc_core.h"
+
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return (uint32_t)(rng >> 16); }
+static void gen(int kind, uint8_t *b) {   // as t_bc2astc_gpu.m: families that reach every layout
+    for (int i = 0; i < 16; i++) b[i] = (uint8_t)rnd();
+    uint8_t *c = kind == 1 ? b : b + 8; uint32_t mode = rnd() % 12, c0 = c[0] | c[1] << 8, c1 = c[2] | c[3] << 8;
+    if (mode == 1) c[4] = c[5] = c[6] = c[7] = (uint8_t)(0x55 * (rnd() & 3));
+    if (mode == 2) c1 = c0;
+    if (mode == 3) { c0 = (rnd() & 1) ? 0 : 0xffff; c1 = (rnd() & 1) ? 0 : 0xffff; }
+    if (mode == 4 && c0 < c1) { uint32_t t = c0; c0 = c1; c1 = t; }
+    if (mode == 5 && c0 > c1) { uint32_t t = c0; c0 = c1; c1 = t; }
+    c[0] = (uint8_t)c0; c[1] = (uint8_t)(c0 >> 8); c[2] = (uint8_t)c1; c[3] = (uint8_t)(c1 >> 8);
+    uint32_t am = rnd() % 8;
+    if (kind == 2) { if (am == 1) { uint8_t n = (uint8_t)(rnd() & 15); for (int i = 0; i < 8; i++) b[i] = (uint8_t)(n | n << 4); } if (am == 2) for (int i = 0; i < 8; i++) b[i] = 0xff; }
+    if (kind == 3) { if (am == 1) { b[1] = b[0]; for (int i = 2; i < 8; i++) b[i] = 0; } if (am == 2) { b[0] = 255; b[1] = 255; for (int i = 2; i < 8; i++) b[i] = 0; } if (am == 3 && b[0] < b[1]) { uint8_t t = b[0]; b[0] = b[1]; b[1] = t; } }
+}
+static float srgb2lin(float c) { return c <= 0.04045f ? c / 12.92f : powf((c + 0.055f) / 1.055f, 2.4f); }
+
+static const char *k_msl =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"kernel void rd(texture2d<float, access::read> t [[texture(0)]], device float4 *o [[buffer(0)]], constant uint &w [[buffer(1)]], uint2 g [[thread_position_in_grid]]) {\n"
+"  if (g.x >= t.get_width() || g.y >= t.get_height()) return; o[g.y * w + g.x] = t.read(g); }\n";
+
+int main(void) {
+    @autoreleasepool {
+        id<MTLDevice> dev = MTLCreateSystemDefaultDevice(); NSError *err = nil;
+        id<MTLLibrary> lib = [dev newLibraryWithSource:@(k_msl) options:nil error:&err]; if (!lib) { printf("MSL: %s\n", err.localizedDescription.UTF8String); return 1; }
+        id<MTLComputePipelineState> ps = [dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"rd"] error:&err];
+        id<MTLCommandQueue> q = [dev newCommandQueue];
+        const uint32_t nbx = 256, nby = 128, n = nbx * nby, W = nbx * 4, H = nby * 4;
+        int fails = 0; const char *ln[5] = {"L0", "L1a", "L1b", "L2", "L3"};
+        for (int srgb = 0; srgb < 2; srgb++) for (int kind = 1; kind <= 3; kind++) {
+            uint8_t *bc = malloc((size_t)n * 16), *astc = malloc((size_t)n * 16); uint8_t *lay = malloc(n); uint8_t (*ref)[16][4] = malloc((size_t)n * 64);
+            for (uint32_t i = 0; i < n; i++) { gen(kind, bc + (size_t)i * 16); uint32_t r = nvn_bc2astc_block(kind, bc + (size_t)i * 16, astc + (size_t)i * 16); lay[i] = (uint8_t)(r & 0xff);
+                if (kind == 1) bcdec_bc1(bc + (size_t)i * 16, ref[i], 16); else if (kind == 2) bcdec_bc2(bc + (size_t)i * 16, ref[i], 16); else bcdec_bc3(bc + (size_t)i * 16, ref[i], 16); }
+            MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:srgb ? MTLPixelFormatASTC_4x4_sRGB : MTLPixelFormatASTC_4x4_LDR width:W height:H mipmapped:NO];
+            d.storageMode = MTLStorageModeShared; d.usage = MTLTextureUsageShaderRead;
+            id<MTLTexture> t = [dev newTextureWithDescriptor:d];
+            [t replaceRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0 withBytes:astc bytesPerRow:nbx * 16];
+            id<MTLBuffer> out = [dev newBufferWithLength:(size_t)W * H * 16 options:MTLResourceStorageModeShared]; uint32_t wv = W;
+            id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLComputeCommandEncoder> e = [cb computeCommandEncoder];
+            [e setComputePipelineState:ps]; [e setTexture:t atIndex:0]; [e setBuffer:out offset:0 atIndex:0]; [e setBytes:&wv length:4 atIndex:1];
+            [e dispatchThreads:MTLSizeMake(W, H, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)]; [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+            const float (*px)[4] = out.contents;
+            long cnt[5] = {0}, bad[5] = {0}; float worst[5] = {0}, worst_a[5] = {0}; int firstbad[5]; for (int l = 0; l < 5; l++) firstbad[l] = -1;
+            for (uint32_t i = 0; i < n; i++) {
+                uint32_t bx = i % nbx, by = i / nbx; float mx = 0, ma = 0;
+                for (int p = 0; p < 16; p++) {
+                    const float *g = px[(by * 4 + p / 4) * W + bx * 4 + (p & 3)];
+                    for (int c = 0; c < 4; c++) {
+                        float want = ref[i][p][c] / 255.0f; if (srgb && c < 3) want = srgb2lin(want);
+                        if (kind == 1 && ref[i][p][3] == 0 && c < 3) continue;   // transparent BC1 texel: RGB is a don't-care
+                        float df = fabsf(g[c] - want) * 255.0f; if (c == 3) { if (df > ma) ma = df; } else if (df > mx) mx = df;
+                    }
+                }
+                int L = lay[i]; cnt[L]++; if (mx > worst[L]) worst[L] = mx; if (ma > worst_a[L]) worst_a[L] = ma;
+                // L3 carries four alpha levels per block, so its alpha differs from bcdec by design (the benchmark measures how much); everything else must agree within 4 levels (L3 colour: within its own endpoint precision)
+                float tol_rgb = L == 4 ? (srgb ? 12.0f : 6.0f) : 4.0f;   // L3's colour endpoints have 48 levels (measured by the benchmark: about 5 of 255; an sRGB texture is compared after the linear conversion, which magnifies dark values)
+                if (mx > tol_rgb || (L != 4 && ma > 4.0f) || (L == 4 && ma > 80.0f)) { bad[L]++; if (firstbad[L] < 0) firstbad[L] = (int)i; }
+            }
+            printf("%s BC%d: ", srgb ? "sRGB" : "LDR ", kind);
+            for (int l = 0; l < 5; l++) if (cnt[l]) printf("%s %ld blocks, %ld off (worst RGB %.1f, alpha %.1f)  ", ln[l], cnt[l], bad[l], worst[l], worst_a[l]);
+            printf("\n");
+            for (int l = 0; l < 5; l++) if (bad[l]) { fails++; int i = firstbad[l]; printf("   first bad %s block %d: BC", ln[l], i); for (int k = 0; k < (kind == 1 ? 8 : 16); k++) printf("%02x", bc[(size_t)i * 16 + k]); printf(" → ASTC "); for (int k = 0; k < 16; k++) printf("%02x", astc[(size_t)i * 16 + k]); printf("\n"); }
+            free(bc); free(astc); free(lay); free(ref);
+        }
+        printf("%s\n", fails ? "hardware ASTC decode DIFFERS from bcdec in some layouts" : "hardware ASTC decode matches bcdec within 4 levels in every layout (L3 alpha: within its four levels)");
+        return fails != 0;
+    }
+}
diff --git a/dm/gfx/tests/t_bc2astc_gpu.m b/dm/gfx/tests/t_bc2astc_gpu.m
new file mode 100644
index 0000000..5c131ae
--- /dev/null
+++ b/dm/gfx/tests/t_bc2astc_gpu.m
@@ -0,0 +1,84 @@
+// GPU BC1/BC2/BC3 → ASTC 4x4 transcoder (kernel `bca`, text from bc2astc_msl.h) against the C reference (nvn_bc2astc.c): the output must be byte-identical.
+// Millions of blocks per format, mixed so that every layout and both swap directions are reached, through a pitched and offset source / destination; the bytes between the rows must stay untouched.
+// Usage: t_bc2astc_gpu
+#import <Metal/Metal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "../tex/nvn_bc2astc.h"
+#include "../tex/bc2astc_msl.h"
+
+static uint64_t rng = 0x243F6A8885A308D3ull;
+static uint32_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return (uint32_t)(rng >> 16); }
+static uint64_t now_ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec * 1000000000ull + t.tv_nsec; }
+
+// A BC block of this kind (1/2/3), drawn from families that reach every layout: raw random, solid colour, uniform alpha, equal endpoints, extreme endpoints, c0 > c1 / c0 <= c1 forced
+static void gen(int kind, uint8_t *b) {
+    for (int i = 0; i < 16; i++) b[i] = (uint8_t)rnd();
+    uint8_t *c = kind == 1 ? b : b + 8; uint32_t mode = rnd() % 12;
+    uint32_t c0 = c[0] | c[1] << 8, c1 = c[2] | c[3] << 8;
+    if (mode == 1) { c[4] = c[5] = c[6] = c[7] = (uint8_t)(0x55 * (rnd() & 3)); }                       // every colour index the same
+    if (mode == 2) { c1 = c0; }                                                                          // equal endpoints
+    if (mode == 3) { c0 = (rnd() & 1) ? 0 : 0xffff; c1 = (rnd() & 1) ? 0 : 0xffff; }                    // black / white endpoints
+    if (mode == 4 && c0 < c1) { uint32_t t = c0; c0 = c1; c1 = t; }                                      // c0 > c1
+    if (mode == 5 && c0 > c1) { uint32_t t = c0; c0 = c1; c1 = t; }                                      // c0 <= c1
+    c[0] = (uint8_t)c0; c[1] = (uint8_t)(c0 >> 8); c[2] = (uint8_t)c1; c[3] = (uint8_t)(c1 >> 8);
+    uint32_t am = rnd() % 8;
+    if (kind == 2) {
+        if (am == 1) { uint8_t n = (uint8_t)(rnd() & 15); for (int i = 0; i < 8; i++) b[i] = (uint8_t)(n | n << 4); }   // uniform alpha (including 15 = 255)
+        if (am == 2) { for (int i = 0; i < 8; i++) b[i] = 0xff; }
+    }
+    if (kind == 3) {
+        if (am == 1) { b[1] = b[0]; for (int i = 2; i < 8; i++) b[i] = 0; }                               // a0 == a1, every index 0
+        if (am == 2) { b[0] = 255; b[1] = 255; for (int i = 2; i < 8; i++) b[i] = 0; }                    // opaque
+        if (am == 3 && b[0] < b[1]) { uint8_t t = b[0]; b[0] = b[1]; b[1] = t; }                          // 8-level mode
+    }
+}
+
+int main(void) {
+    @autoreleasepool {
+        id<MTLDevice> dev = MTLCreateSystemDefaultDevice(); if (!dev) { printf("no Metal device\n"); return 1; }
+        NSError *err = nil; id<MTLLibrary> lib = [dev newLibraryWithSource:@(nvn_bca_msl) options:nil error:&err];
+        if (!lib) { printf("MSL compile failed: %s\n", err.localizedDescription.UTF8String); return 1; }
+        id<MTLComputePipelineState> ps = [dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"bca"] error:&err];
+        if (!ps) { printf("pipeline failed: %s\n", err.localizedDescription.UTF8String); return 1; }
+        id<MTLCommandQueue> q = [dev newCommandQueue];
+        int fails = 0, checks = 0;
+        for (int kind = 1; kind <= 3; kind++) {
+            const uint32_t nbx = 1000, nby = 600, n = nbx * nby, bb = kind == 1 ? 8 : 16;
+            const uint32_t off_in = 48, pitch_in = nbx * bb + 16, off_out = 64, pitch_out = nbx * 16 + 32;   // pitched and offset on both sides
+            size_t in_size = off_in + (size_t)pitch_in * nby + 32, out_size = off_out + (size_t)pitch_out * nby + 32;
+            uint8_t *in = calloc(1, in_size), *out_ref = malloc(out_size);
+            memset(out_ref, 0xCD, out_size);
+            memset(in, 0xEE, in_size);
+            long layouts[5] = {0}, swapped = 0, swap_by[5] = {0};
+            for (uint32_t y = 0; y < nby; y++) for (uint32_t x = 0; x < nbx; x++) {
+                uint8_t blk[16]; gen(kind, blk);
+                memcpy(in + off_in + (size_t)y * pitch_in + (size_t)x * bb, blk, bb);
+                uint32_t r = nvn_bc2astc_block(kind, blk, out_ref + off_out + (size_t)y * pitch_out + (size_t)x * 16);
+                layouts[r & 0xff]++; if (r & 0x100) { swapped++; swap_by[r & 0xff]++; }
+            }
+            id<MTLBuffer> bin = [dev newBufferWithBytes:in length:in_size options:MTLResourceStorageModeShared];
+            id<MTLBuffer> bout = [dev newBufferWithLength:out_size options:MTLResourceStorageModeShared]; memset(bout.contents, 0xCD, out_size);
+            uint32_t p[7] = {off_in, pitch_in, off_out, pitch_out, nbx, nby, (uint32_t)kind};
+            uint64_t t0 = now_ns();
+            id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLComputeCommandEncoder> e = [cb computeCommandEncoder];
+            [e setComputePipelineState:ps]; [e setBuffer:bin offset:0 atIndex:0]; [e setBytes:p length:sizeof p atIndex:1]; [e setBuffer:bout offset:0 atIndex:2];
+            [e dispatchThreads:MTLSizeMake(nbx, nby, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)]; [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+            double ms = (now_ns() - t0) / 1e6;
+            if (cb.error) { printf("BC%d: GPU error %s\n", kind, cb.error.localizedDescription.UTF8String); return 1; }
+            const uint8_t *got = bout.contents; size_t bad = 0, first = (size_t)-1;
+            for (size_t i = 0; i < out_size; i++) if (got[i] != out_ref[i]) { if (first == (size_t)-1) first = i; bad++; }
+            checks++; if (bad) { fails++; printf("  ✗ BC%d: %zu of %zu bytes differ (first at %zu)\n", kind, bad, out_size, first); }
+            // coverage: every layout the format can produce, and swaps in each layout that has endpoints to swap
+            int want[5] = {1, 1, kind != 1, kind == 1, kind != 1};
+            for (int l = 0; l < 5; l++) { if (!want[l]) continue; checks++; if (!layouts[l]) { fails++; printf("  ✗ BC%d: layout %d never reached\n", kind, l); } }
+            for (int l = 1; l < 5; l++) { if (!want[l]) continue; checks++; if (!swap_by[l] || swap_by[l] == layouts[l]) { fails++; printf("  ✗ BC%d: layout %d swapped %ld of %ld blocks (need both)\n", kind, l, swap_by[l], layouts[l]); } }
+            printf("BC%d: %u blocks, L0 %ld L1a %ld L1b %ld L2 %ld L3 %ld, %ld swapped, %s, %.1f ms (%.0f Mblocks/s)\n", kind, n, layouts[0], layouts[1], layouts[2], layouts[3], layouts[4], swapped, bad ? "DIFFERENT" : "byte-identical", ms, n / ms / 1e3);
+            free(in); free(out_ref);
+        }
+        printf("%d checks, %d failed\n", checks, fails);
+        return fails != 0;
+    }
+}
diff --git a/dm/gfx/tests/t_bc_astc.m b/dm/gfx/tests/t_bc_astc.m
new file mode 100644
index 0000000..e35f091
--- /dev/null
+++ b/dm/gfx/tests/t_bc_astc.m
@@ -0,0 +1,175 @@
+// The no-BC path's ASTC storage of BC1-3 (engine-patches/0511, ported from mianmuhammadse/nxnative no-bc, MIT) through the production code, with DM_TEST_NO_BC=1 on this Mac (whose GPU has
+// BC), and the proof that none of it is reached on a GPU with BC. No game data.
+//   1  BC1 / BC1 RGBA / BC2 / BC3 and their sRGB twins, a 2D array with mips (and a size that is not a multiple of 4), uploaded through the GPU (deswizzle + bca) and through the CPU
+//      (DM_NO_BC_GPU=0): the host texture is ASTC 4x4 (LDR / sRGB) and holds, block for block, what nvn_bc2astc makes of the blocks; an upload of changed blocks replaces them
+//   2  DM_NO_BC_ASTC=bc1: BC1 as ASTC, BC3 decompressed; DM_NO_BC_ASTC=0: every BC format decompressed (0510); a 3D BC1 texture stays decompressed
+//   3  views: a BC1-3 view of an ASTC base names the ASTC format (an sRGB view the sRGB one), and tex_by_id makes it; a buffer→texture copy into an ASTC stand-in transcodes; the GPU store-back
+//      refuses an ASTC stand-in of BC3 (same block size, other bytes); the CPU readback of a packaged one reads its storage (the BC blocks)
+//   4  a GPU with BC (g_bc_cpu 0, as on an A17 Pro / M1 or later): BC formats stay BC, no decode or transcode job is ever queued, nothing is counted
+// Usage: t_bc_astc
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+static void finish(void) {
+    CHECK("upload submission completes", mtl_wait(mtl_sub_commit(), 5000000000ull));
+    CHECK("upload has no GPU error", !mtl_last_commit_error());
+}
+static uint32_t g_rng = 0x9E3779B9u;
+static uint32_t rnd(void) { g_rng ^= g_rng << 13; g_rng ^= g_rng >> 17; g_rng ^= g_rng << 5; return g_rng; }
+static int bc_bytes(int f) { return f == 0x41 || f == 0x42 || f == 0x45 || f == 0x46 || f == 0x49 || f == 0x4a ? 8 : 16; }
+
+typedef struct { tex_t t; pool_t pool; void *mem; size_t poolsize; } gtex;
+static void gtex_make(gtex *g, int format, int target, unsigned w0, unsigned h0, unsigned depth, unsigned levels) {
+    static uint64_t serial = 997000;
+    memset(g, 0, sizeof *g);
+    g->t = (tex_t){.magic = MAGIC('T','E','X',0), .serial = serial++, .has_layout = 1};
+    g->t.d = (nvn_texdesc){.target = target, .format = format, .width = w0, .height = h0, .depth = depth, .levels = levels, .samples = 1};
+    nvn_tex_layout(&g->t.d, &g->t.L);
+    g->poolsize = (g->t.L.size + 4096 + getpagesize() - 1) & ~(size_t)(getpagesize() - 1);
+    if (posix_memalign(&g->mem, getpagesize(), g->poolsize)) abort(); memset(g->mem, 0, g->poolsize);
+    g->pool = (pool_t){.magic = MAGIC('P','O','O','L'), .mem = g->mem, .size = g->poolsize, .flags = NVN_MEMORY_POOL_FLAGS_CPU_UNCACHED | NVN_MEMORY_POOL_FLAGS_GPU_CACHED};
+    g->t.pool = &g->pool; g->t.mem = (uint8_t *)g->mem + 4096;
+    mtl_pool_add(g->mem, g->poolsize); nvn_dirty_add_range(g->mem, g->poolsize);
+}
+static void gtex_free(gtex *g) { mtl_tex_release(&g->t); mtl_drain(); mtl_alias_drop_pool(&g->pool); nvn_dirty_remove_range(g->mem); mtl_pool_del(g->mem); mtl_drain(); free(g->mem); }
+static unsigned layers_of(const gtex *g) { return g->t.d.target == 4 ? g->t.d.depth : 1; }
+// Random BC blocks into every level and layer of g's storage; *ref receives what nvn_bc2astc makes of them, level by level and layer by layer (row pitch nbx * 16)
+static uint8_t *fill_random(gtex *g, size_t *ref_n) {
+    int f = g->t.d.format, bb = bc_bytes(f); size_t total = 0;
+    for (unsigned l = 0; l < g->t.d.levels; l++) { unsigned w = MAX(g->t.d.width >> l, 1u), h = MAX(g->t.d.height >> l, 1u); total += (size_t)((w + 3) / 4) * ((h + 3) / 4) * 16 * layers_of(g); }
+    uint8_t *ref = malloc(total); size_t off = 0;
+    dm_guest_write_prepare(g->mem, g->poolsize);
+    for (unsigned l = 0; l < g->t.d.levels; l++) for (unsigned a = 0; a < layers_of(g); a++) {
+        unsigned w = MAX(g->t.d.width >> l, 1u), h = MAX(g->t.d.height >> l, 1u), nbx = (w + 3) / 4, nby = (h + 3) / 4;
+        uint8_t *blocks = malloc((size_t)nbx * nby * bb);
+        for (size_t i = 0; i < (size_t)nbx * nby * bb; i++) blocks[i] = (uint8_t)rnd();
+        for (unsigned i = 0; i < nbx * nby; i += 7) { uint8_t *b = blocks + (size_t)i * bb + (bb == 16 ? 8 : 0); b[2] = b[0]; b[3] = b[1]; }   // some solid blocks (L0)
+        CHECK("blocks swizzle", !nvn_swizzle(&g->t.d, l, a, blocks, (size_t)nbx * bb, g->t.mem));
+        if (f <= 0x48) CHECK("reference transcode", !nvn_bc2astc(f, blocks, (size_t)nbx * bb, w, h, ref + off, (size_t)nbx * 16));
+        off += (size_t)nbx * nby * 16; free(blocks);
+    }
+    *ref_n = total; return ref;
+}
+static int read_blocks(id<MTLTexture> mt, const gtex *g, uint8_t *out, size_t n) {   // every level and layer of an ASTC texture, in fill_random's order
+    id<MTLBuffer> rb = [g_dev newBufferWithLength:n options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> enc = [cb blitCommandEncoder]; size_t off = 0;
+    for (unsigned l = 0; l < g->t.d.levels; l++) for (unsigned a = 0; a < layers_of(g); a++) {
+        unsigned w = MAX(g->t.d.width >> l, 1u), h = MAX(g->t.d.height >> l, 1u), nbx = (w + 3) / 4, nby = (h + 3) / 4;
+        [enc copyFromTexture:mt sourceSlice:a sourceLevel:l sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(w, h, 1) toBuffer:rb destinationOffset:off destinationBytesPerRow:nbx * 16 destinationBytesPerImage:(size_t)nbx * nby * 16];
+        off += (size_t)nbx * nby * 16;
+    }
+    [enc endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    memcpy(out, rb.contents, n); return cb.status == MTLCommandBufferStatusCompleted;
+}
+static void astc_upload(int format, int gpu) {
+    g_bc_gdec = gpu;
+    gtex g; gtex_make(&g, format, 4, 30, 18, 3, 3);
+    uint32_t want_pf; int k; nvn_bc_astc_fmt(format, &want_pf, &k);
+    for (int round = 0; round < 2; round++) {
+        size_t n; uint8_t *ref = fill_random(&g, &n);
+        uint64_t g0 = g_bc_astc_gpu, c0 = g_bc_astc_cpu;
+        mtl_sub_begin(); id<MTLTexture> mt = tex_mtl(&g.t); finish();
+        CHECK("ASTC stand-in exists", mt != nil); if (!mt) { free(ref); break; }
+        CHECK("stored as ASTC 4x4 of the format's colour space", mt.pixelFormat == want_pf);
+        CHECK("took the transcode asked for (GPU bca / CPU)", gpu ? g_bc_astc_gpu > g0 && g_bc_astc_cpu == c0 : g_bc_astc_cpu > c0 && g_bc_astc_gpu == g0);
+        uint8_t *got = malloc(n);
+        CHECK("readback completes", read_blocks(mt, &g, got, n));
+        size_t bad = 0; for (size_t i = 0; i < n; i += 16) bad += memcmp(got + i, ref + i, 16) != 0;
+        if (bad) fprintf(stderr, "format %#x %s round %d: %zu of %zu blocks differ\n", format, gpu ? "GPU" : "CPU", round, bad, n / 16);
+        CHECK("every level and layer holds nvn_bc2astc's blocks", bad == 0);
+        free(got); free(ref);
+    }
+    printf("t_bc_astc: format %#x through the %s: ASTC blocks byte-identical to nvn_bc2astc (2D array 30x18x3, 3 levels, uploaded twice)\n", format, gpu ? "GPU (deswizzle + bca)" : "CPU");
+    gtex_free(&g); g_bc_gdec = 1;
+}
+static void modes(void) {
+    tex_t t = {.magic = MAGIC('T','E','X',0), .serial = 1001000};
+    t.d = (nvn_texdesc){.target = 1, .format = 0x44, .width = 8, .height = 8, .depth = 1, .levels = 1, .samples = 1};
+    g_bc_astc = 2; CHECK("all: BC3 as ASTC", tex_desc(&t, 1).pixelFormat == MTLPixelFormatASTC_4x4_LDR);
+    t.d.format = 0x48; CHECK("all: BC3 sRGB as ASTC sRGB", tex_desc(&t, 1).pixelFormat == MTLPixelFormatASTC_4x4_sRGB);
+    t.d.format = 0x49; CHECK("all: BC4 decompressed (R8)", tex_desc(&t, 1).pixelFormat == MTLPixelFormatR8Unorm);
+    t.d.format = 0x4d; CHECK("all: BC7 decompressed (RGBA8)", tex_desc(&t, 1).pixelFormat == MTLPixelFormatRGBA8Unorm);
+    g_bc_astc = 1; t.d.format = 0x41; CHECK("bc1: BC1 as ASTC", tex_desc(&t, 1).pixelFormat == MTLPixelFormatASTC_4x4_LDR);
+    t.d.format = 0x44; CHECK("bc1: BC3 decompressed", tex_desc(&t, 1).pixelFormat == MTLPixelFormatRGBA8Unorm);
+    g_bc_astc = 0; t.d.format = 0x41; CHECK("0: BC1 decompressed", tex_desc(&t, 1).pixelFormat == MTLPixelFormatRGBA8Unorm);
+    g_bc_astc = 2; t.d.format = 0x41; t.d.target = 2; t.d.depth = 4; CHECK("all: a 3D BC1 stays decompressed", tex_desc(&t, 1).pixelFormat == MTLPixelFormatRGBA8Unorm);
+}
+static void views_copies(void) {
+    gtex g; gtex_make(&g, 0x44, 1, 16, 16, 1, 1);
+    size_t n; uint8_t *ref = fill_random(&g, &n); free(ref);
+    mtl_sub_begin(); id<MTLTexture> base = tex_mtl(&g.t); finish();
+    CHECK("BC3 base is ASTC", base && base.pixelFormat == MTLPixelFormatASTC_4x4_LDR);
+    uint32_t pf = 0; uint8_t sw[4];
+    CHECK("a BC3 view of the ASTC base names ASTC LDR", tex_view_to_mtl(base.pixelFormat, 0x44, &pf, sw) && pf == MTLPixelFormatASTC_4x4_LDR);
+    CHECK("a BC3 sRGB view of the ASTC base names ASTC sRGB", tex_view_to_mtl(base.pixelFormat, 0x48, &pf, sw) && pf == MTLPixelFormatASTC_4x4_sRGB);
+    CHECK("a BC3 view of a decompressed base names RGBA8", tex_view_to_mtl(MTLPixelFormatRGBA8Unorm, 0x44, &pf, sw) && pf == MTLPixelFormatRGBA8Unorm);
+    view_t v = {.set_format = 1, .format = 0x48}; mtl_reg_tex(300, &g.t, &v);
+    os_unfair_lock_lock(&g_rmu); id<MTLTexture> view = tex_by_id(300);
+    CHECK("the sRGB view of the ASTC stand-in exists", view != nil && view.pixelFormat == MTLPixelFormatASTC_4x4_sRGB); os_unfair_lock_unlock(&g_rmu);
+    CHECK("the GPU store-back refuses an ASTC stand-in of BC3", !gsb_host_ok(&g.t, base));
+    {   // a buffer→texture copy of one BC3 block into block (1, 2)
+        void *bm = NULL; if (posix_memalign(&bm, getpagesize(), 16384)) abort(); memset(bm, 0, 16384); mtl_pool_add(bm, 16384);
+        uint8_t blk[16]; for (int i = 0; i < 16; i++) blk[i] = (uint8_t)rnd(); memcpy(bm, blk, 16);
+        uint8_t want[16]; nvn_bc2astc_block(3, blk, want);
+        p_copy_b2t c = {.tex = &g.t, .src = (uint64_t)(uintptr_t)bm, .r = {4, 8, 0, 4, 4, 1}};
+        mtl_sub_begin(); copy_b2t(&c, 0); finish();
+        id<MTLBuffer> rb = [g_dev newBufferWithLength:16 options:MTLResourceStorageModeShared];
+        id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> e = [cb blitCommandEncoder];
+        [e copyFromTexture:tex_mtl(&g.t) sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(4, 8, 0) sourceSize:MTLSizeMake(4, 4, 1) toBuffer:rb destinationOffset:0 destinationBytesPerRow:16 destinationBytesPerImage:16];
+        [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        CHECK("copy_b2t transcodes the copied BC3 block into the ASTC stand-in", !memcmp(rb.contents, want, 16));
+        mtl_drain(); mtl_pool_del(bm); mtl_drain(); free(bm);
+    }
+    {   // a CPU readback of a packaged (CPU-written) stand-in reads its storage: the BC blocks, never the ASTC ones
+        uint8_t dst[16]; memset(dst, 0xaa, sizeof dst); NVNcopyRegion r = {0, 0, 0, 4, 4, 1};
+        mtl_read_texels(&g.t, 0, 0, &r, dst, 16, 16);
+        uint8_t lin[4 * 4 * 16]; CHECK("deswizzle the storage", !nvn_deswizzle(&g.t.d, 0, 0, g.t.mem, lin, 4 * 16));
+        CHECK("the CPU readback of a packaged ASTC stand-in returns the storage's BC block", !memcmp(dst, lin, 16));
+    }
+    gtex_free(&g);
+}
+static void bc_gpu(void) {   // what a GPU with BC runs: the no-BC code is not reached
+    g_bc_cpu = 0;
+    for (int f = 0x41; f <= 0x50; f++) {
+        tex_t t = {.magic = MAGIC('T','E','X',0), .serial = 1002000 + f};
+        t.d = (nvn_texdesc){.target = 1, .format = f, .width = 8, .height = 8, .depth = 1, .levels = 1, .samples = 1};
+        uint32_t native = 0; uint8_t sw[4]; nvn_fmt_to_mtl(f, &native, sw);
+        MTLTextureDescriptor *d = tex_desc(&t, 1);
+        CHECK("BC GPU: the descriptor keeps the BC format", d.pixelFormat == native);
+        CHECK("BC GPU: no write / view usage added for the no-BC path", !(d.usage & MTLTextureUsageShaderWrite));
+        CHECK("BC GPU: never an ASTC stand-in", !bc_astc_tex(&t, NULL, NULL) && !bc_gdec_tex(&t));
+        uint32_t pf = 0; tex_view_to_mtl(MTLPixelFormatASTC_4x4_LDR, f, &pf, sw); CHECK("BC GPU: views keep the BC format", pf == native);
+    }
+    uint64_t a = g_bc_up_gpu, b = g_bc_up_cpu, c = g_bc_astc_gpu, e = g_bc_astc_cpu, eb = g_up_ebar;
+    for (int f = 0x41; f <= 0x4b; f += 3) {
+        gtex g; gtex_make(&g, f, 4, 32, 32, 2, 2); size_t n; uint8_t *ref = fill_random(&g, &n); free(ref);
+        mtl_sub_begin(); id<MTLTexture> mt = tex_mtl(&g.t);
+        CHECK("BC GPU: no decode or transcode job queued", g_nup_decs == 0 && g_nup_asts == 0);
+        finish();
+        uint32_t native = 0; uint8_t sw[4]; nvn_fmt_to_mtl(f, &native, sw);
+        CHECK("BC GPU: uploaded as BC", mt && mt.pixelFormat == native);
+        gtex_free(&g);
+    }
+    CHECK("BC GPU: no no-BC upload counted, no no-BC barrier encoded", a == g_bc_up_gpu && b == g_bc_up_cpu && c == g_bc_astc_gpu && e == g_bc_astc_cpu && eb == g_up_ebar);
+    CHECK("BC GPU: compressed-alias pairs on", bcp_on());
+    g_bc_cpu = 1;
+}
+int main(void) { @autoreleasepool {
+    setenv("DM_TEST_NO_BC", "1", 1);
+    mtl_init();
+    CHECK("DM_TEST_NO_BC=1 turns the no-BC path on", g_bc_cpu && !g_bc_gpu);
+    CHECK("default mode: BC1-3 as ASTC", g_bc_astc == 2);
+    CHECK("the bca pipeline is made", bca_pso() != nil);
+    CHECK("compressed-alias pairs off without BC", !bcp_on());
+    int fmts[] = {0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48};
+    for (int gpu = 1; gpu >= 0; gpu--) for (size_t i = 0; i < sizeof fmts / sizeof *fmts; i++) astc_upload(fmts[i], gpu);
+    modes(); g_bc_astc = 2;
+    views_copies();
+    bc_gpu();
+    printf("t_bc_astc: %d checks, %d failed\n", checks, failed); return failed != 0;
+}}
