# (after 0532) nvn/copy: a multisample Downsample into a single-sample texture of another size resolves through a staging texture (Digimon Story Time Stranger)
#
# Upstream:  https://github.com/seedds/nxnative/commit/fa59a0a79086a42606f17307047dd0f4ea0364b6  ("gfx/nvn: resolve mismatched-size MSAA Downsample and add Time Stranger profile")
#            author seedds, 2026-11-22 23:22 +0800; Co-authored-by: RikyXerez
# Licence:   MIT, Copyright (c) 2026 seedds (nxnative LICENSE); ported from seedds/nxnative, MIT. The attribution above is kept as the licence asks.
#
# Why: Digimon Story Time Stranger resolves 1920x1080 4x into 1280x720 1x in handheld; copy_t2t_enc had no path for different level sizes (upstream refs #872).
# WHAT IT CHANGES (dm/gfx/nvn/nvn_mtl.m copy_t2t_enc, DM_COPY_RESOLVE; test t_tiled_resolve): same format, different size: resolve into a cached private staging texture of the source
#   level's size (4 slots) and blit the common (0, 0) corner unscaled into the destination.
# Engine part only: the game's profile (games/010062E01FE0C000) and its notes are not taken. Games: Digimon Story Time Stranger (010062E01FE0C000). Switches: none.
# Tests (M1 Pro): t_tiled_resolve 97 (16x12 4x -> 8x6 1x and 8x6 4x -> 16x12 1x added), in HOST_TESTS. NOT run on a device.
# Shader chain: not touched (b24b25240cad; scripts/build-host.sh checks it).
# Apply with: patch -p1, to the tree out-stage/out-engine/engine + engine-patches/0401..0532, in the order of the numbers of this folder (scripts/build-host.sh does).

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index aacd5faa3e2bedc8118461de1a08299714e36e28..1238e80cc7547c63384926c724612a62b506c8a9 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -19338,31 +19338,58 @@ static int copy_t2t_astc(id<MTLTexture> s, id<MTLTexture> d, unsigned sl, unsign
     if (!d || !lv_host(c->dst, d, &dl) || !tex_level_ok(d, dl, "texture copy destination")) return nil;
     { tex_t pair; bcp_before(c->dst, d, &pair); }   // a side of a compressed-alias pair: filled first, the copied region goes into its other side after (copy_t2t)
     if (c->flags & DM_COPY_RESOLVE) {   // Downsample: multisample resolve into the single-sample destination (depth takes sample 0); with equal sample counts it is a plain whole copy
-        if (s.sampleCount == d.sampleCount && s.pixelFormat == d.pixelFormat && s.width == d.width && s.height == d.height) {
-            enc_b_copy_texture(blit(), s, sz0, sl, MTLOriginMake(0, 0, 0), MTLSizeMake(s.width, s.height, 1), d, dz0, dl, MTLOriginMake(0, 0, 0));
+        NSUInteger sw = MAX(s.width >> sl, 1ul), sh = MAX(s.height >> sl, 1ul), dw = MAX(d.width >> dl, 1ul), dh = MAX(d.height >> dl, 1ul);
+        if (s.sampleCount == d.sampleCount && s.pixelFormat == d.pixelFormat && sw == dw && sh == dh) {
+            enc_b_copy_texture(blit(), s, sz0, sl, MTLOriginMake(0, 0, 0), MTLSizeMake(sw, sh, 1), d, dz0, dl, MTLOriginMake(0, 0, 0));
             return d;
         }
         // A single-sample source: a filtered scale of the whole level into the destination, converting the format (Bayonetta 2, SDK 3.6: 320x176 → 80x48 RGBA8 every frame, a quarter of
         // its 1280x720 frame and a quarter of that, rounded up to 16; and its 1280x720 BGRA8 frame into an RGBA8 texture of the same size), drawn as a scaling copy with bilinear filtering
         if (s.sampleCount == 1 && d.sampleCount == 1 && c->src->d.target != 2 && c->dst->d.target != 2) {
             if (!(d.usage & MTLTextureUsageRenderTarget) && !mtl_fmt_block(d.pixelFormat) && !fmt_int_or_ds(d.pixelFormat)) d = tex_upgrade(c->dst, d, MTLTextureUsageRenderTarget, d.pixelFormat);
-            NVNcopyRegion sr = {0, 0, 0, (int)MAX(s.width >> sl, 1u), (int)MAX(s.height >> sl, 1u), 1}, dr = {0, 0, 0, (int)MAX(d.width >> dl, 1u), (int)MAX(d.height >> dl, 1u), 1};
+            NVNcopyRegion sr = {0, 0, 0, (int)sw, (int)sh, 1}, dr = {0, 0, 0, (int)dw, (int)dh, 1};
             if (copy_t2t_draw(s, d, sl, sz0, dl, dz0, &sr, &dr, !fmt_int_or_ds(s.pixelFormat), 0)) return d;
         }
-        if (s.sampleCount <= 1 || d.sampleCount != 1 || s.pixelFormat != d.pixelFormat || s.width != d.width || s.height != d.height) {
+        if (s.sampleCount <= 1 || d.sampleCount != 1 || s.pixelFormat != d.pixelFormat) {
             RED_ONCE(72, "Downsample case not implemented: %lux%lu %lu samples format %lu → %lux%lu %lu samples format %lu", (unsigned long)s.width, (unsigned long)s.height, (unsigned long)s.sampleCount,
                      (unsigned long)s.pixelFormat, (unsigned long)d.width, (unsigned long)d.height, (unsigned long)d.sampleCount, (unsigned long)d.pixelFormat);
             return nil;
         }
+        // Metal requires the resolve target to match the multisample source's dimensions. When a game resolves between different sizes (e.g. handheld mode resolving
+        // a 1920x1080 4x render target into 1280x720: Digimon Story Time Stranger, issue #872), resolve into a cached private staging texture of the source's size
+        // and blit the common (0, 0) corner unscaled into the destination.
+        id<MTLTexture> rdst = d; unsigned rdl = dl, rdz = dz0;
+        if (sw != dw || sh != dh) {
+            static id<MTLTexture> stage[4]; static int stage_n;
+            id<MTLTexture> st = nil;
+            for (int i = 0; i < stage_n; i++)
+                if (stage[i].width == sw && stage[i].height == sh && stage[i].pixelFormat == s.pixelFormat) { st = stage[i]; break; }
+            if (!st) {
+                MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:s.pixelFormat width:sw height:sh mipmapped:NO];
+                td.storageMode = MTLStorageModePrivate; td.usage = MTLTextureUsageRenderTarget;
+                st = [g_dev newTextureWithDescriptor:td];
+                if (!st) { RED_ONCE(72, "Downsample staging texture allocation failed: %lux%lu format %lu", (unsigned long)sw, (unsigned long)sh, (unsigned long)s.pixelFormat); return nil; }
+                res_add(st);
+                if (stage_n < 4) stage[stage_n++] = st;
+                else { defer_obj_release(stage[0]); for (int i = 0; i < 3; i++) stage[i] = stage[i + 1]; stage[3] = st; }
+            }
+            rdst = st; rdl = 0; rdz = 0;
+        }
         rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
         MTL4RenderPassDescriptor *rp = [MTL4RenderPassDescriptor new];
         MTLPixelFormat pf = s.pixelFormat;
         int depth = pf == MTLPixelFormatDepth32Float || pf == MTLPixelFormatDepth16Unorm || pf == MTLPixelFormatDepth32Float_Stencil8;
         MTLRenderPassAttachmentDescriptor *a = depth ? rp.depthAttachment : rp.colorAttachments[0];
-        a.texture = s; a.level = sl; a.slice = sz0; a.resolveTexture = d; a.resolveLevel = dl; a.resolveSlice = dz0;
+        a.texture = s; a.level = sl; a.slice = sz0; a.resolveTexture = rdst; a.resolveLevel = rdl; a.resolveSlice = rdz;
         a.loadAction = MTLLoadActionLoad; a.storeAction = MTLStoreActionStoreAndMultisampleResolve;
         if (depth) rp.depthAttachment.depthResolveFilter = MTLMultisampleDepthResolveFilterSample0;
         ser_gate(); enc_r_end(enc_r_begin(rp));
+        if (rdst != d) {
+            enc_b_copy_texture(blit(), rdst, 0, 0, MTLOriginMake(0, 0, 0), MTLSizeMake(MIN(sw, dw), MIN(sh, dh), 1), d, dz0, dl, MTLOriginMake(0, 0, 0));
+            static int once; if (!once++) MLOG("multisample downsample with different sizes: %lux%lu %lu samples format %lu → %lux%lu (copied %lux%lu corner)",
+                                               (unsigned long)sw, (unsigned long)sh, (unsigned long)s.sampleCount, (unsigned long)s.pixelFormat,
+                                               (unsigned long)dw, (unsigned long)dh, (unsigned long)MIN(sw, dw), (unsigned long)MIN(sh, dh));
+        }
         return d;
     }
     PD("t src=%llu lv%u sl%u xyz=%d,%d,%d dst=%llu lv%u sl%u xyz=%d,%d,%d size=%d,%d,%d", c->src->serial, sl, sz0, c->sr.xoffset, c->sr.yoffset, c->sr.zoffset,
diff --git a/dm/gfx/tests/t_tiled_resolve.m b/dm/gfx/tests/t_tiled_resolve.m
index 34115ba8671f6257d0ce00be8a6c03a0e3a88c10..9c7bce2a6a91b8855df4451bf584a8d16ed1e285 100644
--- a/dm/gfx/tests/t_tiled_resolve.m
+++ b/dm/gfx/tests/t_tiled_resolve.m
@@ -15,13 +15,14 @@ void svc_thread_dump(void) {}
 static int checks, failed;
 #define CHECK(c, what) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", what); } } while (0)
 
-static tex_t texture(int samples, int layers) {
+static tex_t texture_sz(int w, int h, int samples, int layers) {
     tex_t t = {.magic=MAGIC('T','E','X',0), .serial=nvn_new_serial()};
     t.d = (nvn_texdesc){.target=samples > 1 ? (layers > 1 ? NVN_TEXTURE_TARGET_2D_MULTISAMPLE_ARRAY : NVN_TEXTURE_TARGET_2D_MULTISAMPLE)
                          : (layers > 1 ? NVN_TEXTURE_TARGET_2D_ARRAY : NVN_TEXTURE_TARGET_2D),
-        .format=NVN_FORMAT_RGBA8, .width=8, .height=8, .depth=layers, .levels=1, .samples=samples};
+        .format=NVN_FORMAT_RGBA8, .width=(uint32_t)w, .height=(uint32_t)h, .depth=layers, .levels=1, .samples=samples};
     return t;
 }
+static tex_t texture(int samples, int layers) { return texture_sz(8, 8, samples, layers); }
 static void completed(id<MTLCommandBuffer> cb) {
     [cb commit]; [cb waitUntilCompleted]; CHECK(cb.status == MTLCommandBufferStatusCompleted, "fixture GPU work completed");
 }
@@ -91,13 +92,72 @@ static void run_case(id<MTLLibrary> lib, int tiled, int views, int samples) {
     printf("%s samples=%d: checked pixels and retained recording\n", name, samples);
     h_nvnCommandBufferFinalize((NVNcommandBuffer *)&cmd); mtl_tex_release(&src); mtl_tex_release(&dst);
 }
+static void run_mismatched_size(id<MTLLibrary> lib, int sw, int sh, int dw, int dh) {
+    tex_t src = texture_sz(sw, sh, 4, 1), dst = texture_sz(dw, dh, 1, 1);
+    id<MTLTexture> s = [g_dev newTextureWithDescriptor:tex_desc(&src, 0)];
+    id<MTLTexture> d = [g_dev newTextureWithDescriptor:tex_desc(&dst, 0)];
+    CHECK(s && d, "mismatched resolve textures allocated"); if (!s || !d) return;
+    res_add(s); res_add(d); serial_put(src.serial, s); serial_put(dst.serial, d);
+    MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction = [lib newFunctionWithName:@"v"]; pd.fragmentFunction = [lib newFunctionWithName:@"fpos"];
+    pd.rasterSampleCount = 4; pd.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    NSError *err = nil; id<MTLRenderPipelineState> ps = [g_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+    CHECK(ps != nil, "mismatched resolve fixture pipeline builds"); if (!ps) return;
+    id<MTLCommandQueue> q = [g_dev newCommandQueue]; id<MTLCommandBuffer> cb = [q commandBuffer];
+    {
+        MTLRenderPassDescriptor *rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.colorAttachments[0].texture = s; rp.colorAttachments[0].loadAction = MTLLoadActionDontCare; rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+        [e setRenderPipelineState:ps]; [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [e endEncoding];
+    }
+    {
+        MTLRenderPassDescriptor *rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.colorAttachments[0].texture = d; rp.colorAttachments[0].loadAction = MTLLoadActionClear; rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        rp.colorAttachments[0].clearColor = MTLClearColorMake(1, 0, 1, 1);
+        [[cb renderCommandEncoderWithDescriptor:rp] endEncoding];
+    }
+    completed(cb);
+    cmd_t cmd; h_nvnCommandBufferInitialize((NVNcommandBuffer *)&cmd, NULL);
+    h_nvnCommandBufferBeginRecording((NVNcommandBuffer *)&cmd);
+    ((NVNT_nvnCommandBufferDownsample)nvn_lookup("nvnCommandBufferDownsample"))((NVNcommandBuffer *)&cmd, (NVNtexture *)&src, (NVNtexture *)&dst);
+    NVNcommandHandle handle = h_nvnCommandBufferEndRecording((NVNcommandBuffer *)&cmd);
+    uint8_t *record = nvn_rec_linear(handle, NULL);
+    state_reset(); memset(&R, 0, sizeof R); mtl_sub_begin(); mtl_exec(record);
+    CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "mismatched resolve submission completed");
+    CHECK(!mtl_last_commit_error(), "mismatched resolve has no Metal error"); free(record);
+    size_t row = (size_t)dw * 4, img = row * (size_t)dh;
+    id<MTLBuffer> out = [g_dev newBufferWithLength:img options:MTLResourceStorageModeShared];
+    CHECK(out != nil, "mismatched readback buffer allocated"); if (!out) abort();
+    cb = [q commandBuffer]; id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    [blit copyFromTexture:d sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(dw, dh, 1)
+          toBuffer:out destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:img];
+    [blit endEncoding]; completed(cb);
+    const uint8_t *pixels = out.contents;
+    int cw = sw < dw ? sw : dw, ch = sh < dh ? sh : dh, good = 1;
+    // fpos writes (sample==0 ? 1 : 0, pos.x < 8 && pos.y < 6 ? 1 : 0, sample%2==0 ? 1 : 0, 1) -> unscaled (0..cw-1, 0..ch-1) resolves to (64, 255, 128, 255); outside stays magenta (255, 0, 255, 255).
+    for (int y = 0; y < dh; y++) for (int x = 0; x < dw; x++) {
+        const uint8_t *p = pixels + (size_t)y * row + (size_t)x * 4;
+        if (x < cw && y < ch) {
+            int g = (x < 8 && y < 6) ? 255 : 0;
+            good &= abs((int)p[0] - 64) <= 1 && p[1] == g && abs((int)p[2] - 128) <= 1 && p[3] == 255;
+        } else {
+            good &= p[0] == 255 && p[1] == 0 && p[2] == 255 && p[3] == 255;
+        }
+    }
+    CHECK(good, "mismatched-size resolve averages samples into the unscaled common corner");
+    printf("nvnCommandBufferDownsample %dx%d 4x -> %dx%d 1x: checked unscaled common corner\n", sw, sh, dw, dh);
+    h_nvnCommandBufferFinalize((NVNcommandBuffer *)&cmd); mtl_tex_release(&src); mtl_tex_release(&dst);
+}
 int main(void) { @autoreleasepool {
     mtl_init(); NSError *err = nil;
     id<MTLLibrary> lib = [g_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\n"
         "vertex float4 v(uint i[[vertex_id]]) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return float4(p[i],0,1); }\n"
         "fragment float4 f(uint s[[sample_id]], constant uint &layer[[buffer(0)]]) { return float4(layer || s==0,s%2==0,1,1); }\n"
+        "fragment float4 fpos(float4 pos[[position]], uint s[[sample_id]]) { return float4(s==0, pos.x<8.0 && pos.y<6.0, s%2==0, 1); }\n"
         options:nil error:&err];
     CHECK(lib != nil, "synthetic sample shaders compile"); if (!lib) { fprintf(stderr, "%s\n", err.localizedDescription.UTF8String); return 1; }
     for (int samples = 2; samples <= 4; samples *= 2) for (int views = 0; views <= 1; views++) for (int tiled = 0; tiled <= 1; tiled++) run_case(lib, tiled, views, samples);
+    run_mismatched_size(lib, 16, 12, 8, 6);
+    run_mismatched_size(lib, 8, 6, 16, 12);
     printf("tiled resolves: %d checks, %d failed\n", checks, failed); return failed != 0;
 } }
