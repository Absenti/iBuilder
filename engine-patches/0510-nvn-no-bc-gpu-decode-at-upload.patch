+// No-BC upload batch order (engine-patches/0510; ported from the t_up_order test of mianmuhammadse/nxnative no-bc, 5b3a5c7b / 30198611 / 8e2beb9b, MIT). The test queues the jobs and
+// copies BEFORE the zero fill of the same texture (the worst order), flushes through the real up_flush, and reads the texture back byte for byte. It also counts the intra-encoder
+// barriers up_flush encodes for the no-BC order (g_up_ebar): whether an unordered copy overtakes a kernel depends on what else the GPU runs, so the data alone cannot be trusted to fail.
+//   A  no job: content copy queued, then zero fill, one batch -> 0 barriers: up_flush keeps its order as before 0510 (what a GPU with BC always runs)
+//   B  a bcd decode job (BC1 blocks -> an RGBA8 texture) queued, then zero fill, one batch -> the decoded texels, 2 barriers (fill -> job, job -> copies)
+// DM_TEST_NO_BC=1 forces the no-BC path on this Mac's GPU, which has BC.
+// Usage: t_nobc_order
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+static int checks, failed;
+#define CHECK(c, ...) do { checks++; if (!(c)) { failed++; printf("  FAIL: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static void wait_uploads(void) { for (int i = 0; i < 5000 && atomic_load(&g_up_pending); i++) usleep(1000); }
+static void read_back(id<MTLTexture> t, NSUInteger w, NSUInteger h, size_t bpp_or_block, int blocks, uint8_t *out, size_t n) {
+    id<MTLBuffer> dst = [g_dev newBufferWithLength:n options:MTLResourceStorageModeShared]; res_add(dst);
+    size_t row = blocks ? ((w + 3) / 4) * bpp_or_block : w * bpp_or_block;
+    id read = blit();
+    [read copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(w, h, 1) toBuffer:dst destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:n];
+    enc_b_end(g_blit); g_blit = nil;
+    mtl_sub_commit(); mtl_drain();
+    memcpy(out, dst.contents, n);
+    mtl_sub_begin();
+}
+static id<MTLTexture> new_rgba8(NSUInteger w, NSUInteger h) {
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:w height:h mipmapped:NO];
+    d.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite | MTLTextureUsagePixelFormatView; d.storageMode = MTLStorageModePrivate;
+    id<MTLTexture> t = [g_dev newTextureWithDescriptor:d]; res_add(t); return t;
+}
+
+int main(void) { @autoreleasepool {
+    setenv("DM_TEST_NO_BC", "1", 1);
+    mtl_init(); mtl_sub_begin();
+    CHECK(g_bc_cpu && !g_bc_gpu, "DM_TEST_NO_BC=1 did not turn the no-BC path on (g_bc_cpu %d, g_bc_gpu %d)", g_bc_cpu, g_bc_gpu);
+    CHECK(bcd_pso() != nil, "the bcd decode pipeline was not made");
+    {   // A: no job, content queued first, zero fill second, one batch: the order up_flush had before 0510 (no barrier of its own)
+        const NSUInteger W = 8, H = 8; uint8_t want[W * H * 4]; for (size_t i = 0; i < sizeof want; i++) want[i] = (uint8_t)(i * 7 + 3);
+        id<MTLTexture> t = new_rgba8(W, H);
+        id<MTLBuffer> src = [g_dev newBufferWithBytes:want length:sizeof want options:MTLResourceStorageModeShared]; res_add(src);
+        up_begin(); up_blit_add(src, 0, W * 4, sizeof want, MTLSizeMake(W, H, 1), t, 0, 0); [g_up_texs addObject:t];
+        tex_zero_fill(t);
+        CHECK(g_nup_blits >= 2 && g_up_blits[g_nup_blits - 1].fill, "A: the zero fill was not queued as a fill");
+        uint64_t eb0 = g_up_ebar; up_flush(); wait_uploads();
+        CHECK(g_up_ebar == eb0, "A: %llu intra-encoder barriers in a batch without no-BC jobs, expected 0 (up_flush as before 0510)", (unsigned long long)(g_up_ebar - eb0));
+    }
+    {   // B: a decode job (bcd) queued, then the zero fill of the same texture, one batch. Large, so an unordered fill or job would show
+        const uint32_t NBX = 256, NBY = 256, W = NBX * 4, H = NBY * 4; const size_t BYTES = (size_t)NBX * NBY * 8;
+        id<MTLTexture> t = new_rgba8(W, H);
+        uint8_t *blk = malloc(BYTES); uint32_t s = 4242;
+        for (size_t i = 0; i < BYTES; i++) { s = s * 1664525u + 1013904223u; blk[i] = (uint8_t)(s >> 24); }
+        uint8_t *want = malloc((size_t)W * H * 4); nvn_bc_decode(0x42, blk, NBX * 8, W, H, want, W * 4);
+        id<MTLBuffer> stg = [g_dev newBufferWithBytes:blk length:BYTES options:MTLResourceStorageModeShared]; res_add(stg);
+        up_begin();
+        size_t qoff; id<MTLBuffer> q = up_param_alloc(&qoff);
+        uint32_t *pp = (uint32_t *)((uint8_t *)q.contents + qoff); pp[0] = 0; pp[1] = NBX * 8; pp[2] = W; pp[3] = H; pp[4] = 1;
+        id<MTLTexture> v = [t newTextureViewWithPixelFormat:MTLPixelFormatRGBA8Unorm textureType:MTLTextureType2D levels:NSMakeRange(0, 1) slices:NSMakeRange(0, 1)];
+        if (!g_up_views) g_up_views = [NSMutableArray array];
+        [g_up_views addObject:v];
+        if (g_nup_decs == g_up_deccap) { g_up_deccap = g_up_deccap ? g_up_deccap * 2 : 16; g_up_decs = realloc(g_up_decs, g_up_deccap * sizeof *g_up_decs); }
+        g_up_decs[g_nup_decs++] = (up_dec){stg.gpuAddress, q.gpuAddress + qoff, NBX, NBY, v}; [g_up_texs addObject:t];
+        tex_zero_fill(t);
+        uint64_t eb0 = g_up_ebar; up_flush(); wait_uploads();
+        CHECK(g_up_ebar - eb0 == 2, "B: %llu intra-encoder barriers, expected 2 (zero fill -> decode job, decode job -> copies)", (unsigned long long)(g_up_ebar - eb0));
+        uint8_t *got = malloc((size_t)W * H * 4); read_back(t, W, H, 4, 0, got, (size_t)W * H * 4);
+        size_t bad = 0; for (size_t i = 0; i < (size_t)W * H * 4; i++) bad += abs((int)got[i] - (int)want[i]) > 1;
+        CHECK(bad == 0, "B: %zu of %u channel values differ from bcdec: the zero fill ran after the decode job, or the job did not run", bad, W * H * 4);
+        free(blk); free(want); free(got);
+    }
+    printf("t_nobc_order: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+}}
