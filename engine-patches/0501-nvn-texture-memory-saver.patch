+// The texture memory saver (DM_NVN_TEX_MIP_SKIP, from the PRAGMATA investigation, nxnative #1319; kid-with-sword-remake L7): a CPU-written compressed 2D, 2D array, cube or cube array
+// texture of at least that many pixels on its shorter side is made without its 1-3 finest levels (DM_NVN_TEX_MIP_LEVELS, default 1; at least one level kept). The finest level is about
+// three quarters of a texture's bytes, so those textures take about a quarter of the memory, and an area load converts and uploads about a quarter of their bytes. The guest's level l + k
+// is the host texture's level l: uploads (pkg_upload_), views and sparse clamps (tex_level_shift) and copies (lv_host) translate. Uncompressed textures (render targets, shader-written
+// ones) are never reduced. A BC texture CPU-decoded to RGBA8 / RGBA16F on a GPU without BC (g_bc_cpu) is reduced by the same rule: it is the largest memory case. Close-up detail is the price.
+// DM_NVN_TEX_MIP_SKIP=<pixels>|1 (1 = 512; unset / 0 = off, every texture as before)
+static unsigned mip_skip_levels(void) { static unsigned n; static dispatch_once_t once; dispatch_once(&once, ^{ const char *e = getenv("DM_NVN_TEX_MIP_LEVELS"); int v = e && *e ? atoi(e) : 1; n = (unsigned)MAX(1, MIN(v, 3)); }); return n; }   // read once (review L4: no unsynchronized lazy init)
+static unsigned mip_skip_px(void) { static int v = -1; static dispatch_once_t once; dispatch_once(&once, ^{ const char *e = getenv("DM_NVN_TEX_MIP_SKIP"); v = e && *e ? atoi(e) : 0; if (v == 1) v = 512; if (v < 0) v = 0;
+    if (v) { MLOG("DM_NVN_TEX_MIP_SKIP: compressed CPU-written textures of %d pixels and more are made without their %u finest mip level(s)", v, mip_skip_levels());
+        // The limits the review of 2026-11-21 found (target/agent-work/review-eng/REVIEW.txt M5, M6, L4), not fixed: said once, loudly, whenever the saver is turned on
+        MLOG("[RED] DM_NVN_TEX_MIP_SKIP is an EXPERIMENT with known limits: (1) a GPU copy INTO a reduced texture does not update its storage, and a later full re-upload brings back "
+             "stale levels (corrupted textures, e.g. a streamer that copies resident levels then writes the next one); (2) a GPU copy FROM a level a reduced texture lacks is left out, "
+             "the destination's level stays undefined (logged when it happens); (3) textureLod / texelFetch / textureSize see shifted levels, image-based-lighting cubes are blurrier; "
+             "(4) a render target or an sRGB / format twin view of a reduced texture is not checked for shifted levels. A texture with a compressed / uncompressed alias pair is never reduced; "
+             "one whose declared levels tex_desc cut is recognized (L4). Remove the line to go back"); } }); return (unsigned)v; }
+static int mip_skip_target(const tex_t *t) { return t->d.target == 1 || t->d.target == 4 || t->d.target == 8 || t->d.target == 9; }   // 2D, 2D array, cube, cube array
+static int bcp_find(const tex_t *t, tex_t *o);
+static unsigned mip_skip(const tex_t *t, MTLTextureDescriptor *d) {
+    unsigned px = mip_skip_px();
+    // A side of a compressed / uncompressed alias pair (bcp_*) is never reduced: the pair's block copies are made level for level and do not translate (the review's M7)
+    if (px) { tex_t other; if (bcp_find(t, &other)) { static uint64_t n; if (!(n++ % 1000)) MLOG("DM_NVN_TEX_MIP_SKIP: ser=%llu has a compressed / uncompressed alias pair: kept whole (%llu so far)", (unsigned long long)t->serial, (unsigned long long)n); return 0; } }
+    // Not the shader-write usage: an NVN image (NVN_TEXTURE_FLAGS_IMAGE) gets it, but no shader stores into a compressed format. Ocarina of Time makes nearly every texture an image
+    if (!px || !fmt_compressed(t->d.format) || d.mipmapLevelCount < 2 || !mip_skip_target(t)) return 0;
+    return MIN(d.width, d.height) >= px ? MIN(mip_skip_levels(), (unsigned)d.mipmapLevelCount - 1) : 0;
+}
+// How many finest levels the host texture m of t (or the texture a view of it is of) lacks: the levels by which its size falls short of the guest's
+// The levels tex_desc makes of t: the declared ones, cut to those its size holds (a texture declaring more than that is made with fewer: tex_desc's RED_ONCE 114). The count a reduced host
+// texture's levels are measured against (review L4: counting the declared levels did not recognize such a texture as reduced, and a copy of the guest's level-0 size went out of bounds)
+static unsigned tex_levels_made(const tex_t *t) {
+    unsigned n = t->d.levels ? t->d.levels : 1, big = MAX(t->d.width, t->d.height), fit = 1; if (!big) big = 1;
+    while (big >> fit) fit++;
+    return MIN(n, fit);
+}
+static unsigned tex_mip_skipped(const tex_t *t, id<MTLTexture> m) {
+    unsigned px = mip_skip_px();
+    if (!px || !t || !m || !fmt_compressed(t->d.format) || tex_levels_made(t) < 2 || MIN(t->d.width, t->d.height) < px || !mip_skip_target(t)) return 0;
+    id<MTLTexture> b = m.parentTexture ? m.parentTexture : m; unsigned made = tex_levels_made(t);
+    for (unsigned k = 1; k <= MIN(mip_skip_levels(), made - 1); k++)
+        if (b.width == MAX(t->d.width >> k, 1u) && b.height == MAX(t->d.height >> k, 1u) && b.mipmapLevelCount == made - k) return k;
     return 0;
 }
+// A guest level as the host texture's: 0 when the host texture lacks that level (a copy of it is left out)
+static int lv_host(const tex_t *t, id<MTLTexture> m, unsigned *level) { unsigned k = tex_mip_skipped(t, m); if (*level < k) return 0; *level -= k; return 1; }
