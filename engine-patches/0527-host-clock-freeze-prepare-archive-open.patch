diff --git a/dm/host/tests/t_clock_freeze.c b/dm/host/tests/t_clock_freeze.c
new file mode 100644
index 0000000000000000000000000000000000000000..0ddccef432f0f606b0ca3464cf58c5aebebaed3e
--- /dev/null
+++ b/dm/host/tests/t_clock_freeze.c
@@ -0,0 +1,54 @@
+// The guest clock's freeze reasons (hle_os.c guest_clock_freeze_for / guest_clock_read_wait): reason 2 (system keyboard) freezes the clock without parking clock reads; reasons 3
+// (NVN prepare) and 4 (NVN pipeline archive init) park guest reads that are not host work, and compose with reason 1 (background): a parked read wakes only once all are lifted.
+// The check is seedds/nxnative 8d888054's clock_freeze_wait (its t_sync_wait links hle_os.c through infrastructure this tree does not have: here hle_os.c alone, as t_objmap)
+#include "../hle_os.c"
+#include <assert.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <sched.h>
+module_t *g_mod; int g_nmod;
+__thread _Atomic int dm_host_work;
+void *module_sym(module_t *m, const char *name) { (void)m; (void)name; return NULL; }
+void *guest_sym(const char *name) { (void)name; return NULL; }
+int dm_sdk_ounce(void) { return 1; }
+void dm_guest_clock_advanced(void) {}
+void crash_watch_frame(void) {}
+typedef struct { _Atomic int entered, done; } cw_arg_t;
+static void *cw_reader(void *p) {
+    cw_arg_t *a = p;
+    atomic_store(&a->entered, 1);
+    guest_clock_read_wait();
+    atomic_store(&a->done, 1);
+    return NULL;
+}
+int main(void) {
+    alarm(10);
+    // Reason 2 (system keyboard) freezes the clock without parking clock reads.
+    guest_clock_freeze_for(2, 1);
+    guest_clock_read_wait();
+    guest_clock_freeze_for(2, 0);
+    // Reasons 3 (NVN prepare) and 4 (NVN archive init) park non-host-work readers and compose with reason 1 (background).
+    guest_clock_freeze_for(3, 1);
+    guest_clock_freeze_for(4, 1);
+    dm_host_work++;
+    guest_clock_read_wait();   // host work never parks itself
+    dm_host_work--;
+    cw_arg_t a = {0};
+    pthread_t th;
+    assert(!pthread_create(&th, NULL, cw_reader, &a));
+    while (!atomic_load(&a.entered)) sched_yield();
+    usleep(15000);
+    assert(!atomic_load(&a.done));
+    guest_clock_freeze_for(4, 0);   // reason 3 still holds
+    usleep(15000);
+    assert(!atomic_load(&a.done));
+    guest_clock_freeze_for(1, 1);   // background overlaps prepare
+    guest_clock_freeze_for(3, 0);   // reason 1 still holds
+    usleep(15000);
+    assert(!atomic_load(&a.done));
+    guest_clock_freeze_for(1, 0);   // all wait reasons lifted: reader wakes
+    assert(!pthread_join(th, NULL));
+    assert(atomic_load(&a.done));
+    printf("t_clock_freeze: guest clock freeze reasons 1-4 passed\n");
+    return 0;
+}
