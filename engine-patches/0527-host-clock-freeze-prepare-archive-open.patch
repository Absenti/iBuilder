# (after 0526) host/nvn: the guest clock is frozen and guest clock reads parked during the first-submission prepare step and the pipeline archive open (Vanillaware games skipped frames into a crash)
#
# Upstream:  https://github.com/seedds/nxnative/commit/8d888054ff67be537b1320beb9aa69984b7f3a5f  ("host/nvn: freeze guest clock and park clock reads during prepare and archive open")
#            author seedds, 2026-11-23 03:19 +0800; Co-authored-by: Aoba_d1snet
# Licence:   MIT, Copyright (c) 2026 seedds (nxnative LICENSE); ported from seedds/nxnative, MIT. The attribution above is kept as the licence asks.
#
# Why: mtl_prepare() (prewarm head, 0412) and pso4_init() (opening the .mtl4a archives) stall the render thread for seconds while the guest clock and the other guest threads ran on:
#   Vanillaware's main thread bounds its render-thread wait by GetSystemTick, skipped hundreds of frames and freed a texture frame 1 still used (13 Sentinels: Aegis Rim, SIGSEGV at
#   main+0x309128 / +0x309e28; Unicorn Overlord has the same loop).
# WHAT IT CHANGES (dm/host/hle_os.c, dm.h, hle.h, dm/gfx/nvn/nvn_mtl.m; tests t_shmap_warm, new t_clock_freeze): freeze reasons 3 (NVN prepare) and 4 (archive init) join reason 1
#   (background) in parking guest clock reads (GFZ_WAIT_MASK), composing by bitmask; mtl_prepare wraps its first-submission step in reason 3, pso4_init in reason 4 (not for the prebuild tool).
# Adapted: hle_os.c by hand (this tree's guest_clock_read_wait also honours the teardown parking); pso4_init by hand (this tree's is a locked once-block, upstream's a dispatch_once:
#   the freeze is taken inside the lock); the tail of the prewarm runs in the background (0412) and is not frozen, as upstream's. Upstream's t_sync_wait case needs a t_sync_wait that links
#   hle_os.c (an upstream change not in this tree): the same check is a new host test t_clock_freeze, linked as t_objmap is.
# Games: 13 Sentinels: Aegis Rim (01003FC01670C000, and the Asian release 01008D7016438000); Unicorn Overlord has the same loop (upstream's note); any game whose first prepare or archive open takes seconds. Switches: none.
# Tests (M1 Pro): t_clock_freeze (host-unit run), t_shmap_warm 16, t_gfx_suspend 22; in HOST_TESTS. NOT run on a device.
# Shader chain: not touched (b24b25240cad; scripts/build-host.sh checks it).
# Apply with: patch -p1, to the tree out-stage/out-engine/engine + engine-patches/0401..0526, in the order of the numbers of this folder (scripts/build-host.sh does).

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 0bbd85617c5d6954697ace02949febd19bd606ed..b1b49b763dbe20c2e9e4259823d9743f151bb2da 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -103,6 +103,9 @@ static inline uint64_t tex_slot_h(const uint64_t *tex, const uint64_t *img, unsi
 static int prepare_on(void);
 static int g_warm_started;
 static void warm_claim(void);
+#ifndef guest_clock_freeze_for
+void guest_clock_freeze_for(int reason, int on);
+#endif
 static _Atomic int g_gfx_teardown;
 static os_unfair_lock g_arch_retire_lk = OS_UNFAIR_LOCK_INIT;
 static NSString *g_arch_retire_dir;
@@ -2526,9 +2529,15 @@ static void up_owner_check(const char *where) {
 
 static uint64_t g_sub_serial;   // Submission index (used by the parallel precompile's 'predict only once per submission')
 static int g_pkg_kept;   // a texture written during this submission kept its texture (tex_mtl_): the next submission starts a write generation, as a write would
-// The first submission: the prepare step (warm_start), before anything of it is encoded. No GPU work: the submit entry (hle_nvn.c) calls it outside the graphics gate
+// The first submission: the prepare step (warm_start), before anything of it is encoded. No GPU work: the submit entry (hle_nvn.c) calls it outside the graphics gate.
+// Freeze the guest clock and park guest clock reads across it (reason 3, hle_os.c): the step can stall the render thread for seconds or minutes, and without this a game
+// whose main thread bounds its render-thread wait skips hundreds of frames and tears down frame 1's resources while frame 1 is still waiting here (13 Sentinels: Aegis Rim)
 void mtl_prepare(void) {
-    if (!g_warm_started && prepare_on()) { mtl_init(); shmap_load(); }
+    if (!g_warm_started && prepare_on()) {
+        guest_clock_freeze_for(3, 1);
+        mtl_init(); shmap_load();
+        guest_clock_freeze_for(3, 0);
+    }
 }
 static void sub_cut_begin(void); static void ts_sub_begin(void), ts_boundary(void); static int ts_on(void);
 static void tu_tick(void);
@@ -6966,6 +6975,9 @@ static inline int passdump(void) {
 // failed in about half the runs)
 __attribute__((weak)) uint64_t guest_ns(void) { return now_ns(); }
 __attribute__((weak)) uint64_t guest_ns_at_host_time(uint64_t host_ns) { return host_ns; }
+#ifndef guest_clock_freeze_for
+__attribute__((weak)) void guest_clock_freeze_for(int reason, int on) { (void)reason; (void)on; }
+#endif
 static uint64_t att_bytes(id<MTLTexture> t, NSUInteger level) {
     if (!t) return 0;
     NSUInteger w = MAX(t.width >> level, 1), h = MAX(t.height >> level, 1);
@@ -11917,6 +11929,10 @@ static void pso4_init(void) {
     os_unfair_lock_lock(&g_pso4_lk);
     if (!g_pso4_done) {
         g_pso4_done = 1;
+        // Opening the pipeline archives can take seconds on a slow external disk even with DM_PSO_PREPARE=0 or no prewarm list: hold guest clock reads (reason 4, hle_os.c;
+        // seedds/nxnative 8d888054, around this tree's locked once-block)
+        int freeze = !g_pre_tool;
+        if (freeze) guest_clock_freeze_for(4, 1);
         (^void(void){
         if (!pso4_on() || ![(id)g_dev respondsToSelector:@selector(newCompilerWithDescriptor:error:)]) return;   // no Metal 4 compiler (t_pso_pending's fake device): the MTLDevice path
         const char *e = getenv("DM_PSO_ARCHIVE"); NSString *user = pso_user_path();
@@ -12013,6 +12029,7 @@ static void pso4_init(void) {
             if (!g_ep) MLOG("[RED] pipeline archive: Metal made no pipeline serializer: nothing is captured into %s", g_arch_dir.UTF8String);
         }
         })();
+        if (freeze) guest_clock_freeze_for(4, 0);
     }
     os_unfair_lock_unlock(&g_pso4_lk);
 }
diff --git a/dm/gfx/tests/t_shmap_warm.m b/dm/gfx/tests/t_shmap_warm.m
index 39355689d1d6a0a0b37fa536dfd85b3e178c33a5..cbd8e67f467cc6b5ec4017a740518b3a771082ce 100644
--- a/dm/gfx/tests/t_shmap_warm.m
+++ b/dm/gfx/tests/t_shmap_warm.m
@@ -1,7 +1,17 @@
 // Reading the shader map is one thing and starting the prewarm another. The map is read once from any thread (shmap_read_once: the prefetch at nvnProgramSetShaders, the submit thread), inside a
 // dispatch_once; the prewarm and its prepare step run on the submit path, at the first submission, and reach shmap_load again (pso_prebuild). With the prewarm inside the once, that second call on
 // the same thread trapped in _dispatch_once_wait: every game with a window and a prebuild, at its first program.
+static unsigned g_freeze_mask;
+static int g_freeze_on[8], g_freeze_off[8];
+static void test_clock_freeze(int reason, int on) {
+    if (reason >= 0 && reason < 8) {
+        if (on) { g_freeze_mask |= 1u << reason; g_freeze_on[reason]++; }
+        else { g_freeze_mask &= ~(1u << reason); g_freeze_off[reason]++; }
+    }
+}
+#define guest_clock_freeze_for test_clock_freeze
 #include "../nvn/nvn_mtl.m"
+#undef guest_clock_freeze_for
 #include <stdlib.h>
 #include <unistd.h>
 
@@ -42,11 +52,15 @@ int main(void) { @autoreleasepool {
 
     mtl_prepare();   // the first submission: the prewarm, then the prebuild, which calls shmap_load again on this thread
     EXPECT_EQ("the first submission starts the prewarm", 1, g_warm_started);
+    EXPECT_EQ("the prepare step balanced its guest clock freeze (reason 3)", 1, g_freeze_on[3] == 1 && g_freeze_off[3] == 1);
+    EXPECT_EQ("pso4_init balanced its guest clock freeze (reason 4)", 1, g_freeze_on[4] == 1 && g_freeze_off[4] == 1);
+    EXPECT_EQ("no guest clock freeze left held after prepare", 0, g_freeze_mask);
     EXPECT_EQ("the prebuild path was reached: the compiler it needs exists", 1, hybrid_on());
     EXPECT_EQ("the item is still there", 1, g_warm_items.count);
 
     mtl_prepare(); shmap_load();   // later calls: nothing starts twice
     EXPECT_EQ("the prewarm starts once", 1, g_warm_started);
+    EXPECT_EQ("later calls do not freeze again", 1, g_freeze_on[3] == 1 && g_freeze_on[4] == 1);
 
     // Embedded DMMSLTR1 shader trailer in DM_ROMFS serves shmap_read / msl_data / msl_has when DM_MSL_DIR lacks the files, while DM_MSL_DIR still wins when present
     dm_gfx_teardown();
