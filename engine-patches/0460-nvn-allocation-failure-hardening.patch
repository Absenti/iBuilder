# nvn/mem: handle vertex-cache edge allocation failure; nvn/owner: log texture-sharing allocation failure (PR #2883, two commits)
#
# Upstream:  https://github.com/seedds/nxnative/commit/b061578e3ffb03fb32736a71aa36593d6575ad36  +  https://github.com/seedds/nxnative/commit/1f03e2fdebbbcad33a376b140968d04a16bb6a36  (PR #2883)
# Author:    seedds, 2026-11-21 15:12 +0800 (both)
# Co-authors:
#   Co-authored-by: Oliver Ames
#   Co-authored-by: kenCalx
# Licence:   MIT, Copyright (c) 2026 seedds (nxnative LICENSE); the attribution above is kept as the licence asks.
#
# WHAT IT CHANGES FOR THE PHONE
#   Two out-of-memory hardening fixes. (1) vk_get (the kept vertex-conversion cache) took its edge copy (malloc) AFTER write-protecting the source pages (nvn_dirty_protect) and wrote to the
#   unchecked result: a failed malloc crashed with the guest's pages left protected. Now the copy is allocated first; on failure the entry retries at the next submission and the caller converts
#   into the frame arena. This is the write-protection path (36,661 faults per window in the Ocarina log): it does not reduce the faults, it removes one crash. (2) nvn_owner.m names the
#   allocation and its size in the fatal log when growing the texture-sharing index fails. Default: on, no switch.
# Applies as is. RISK: low. NOT run on a device. Shader chain id untouched.
#
# Apply with: patch -p1, to the tree out-stage/out-engine/engine + engine-patches/0401..0415 and the candidates numbered below this one, in the order of the numbers of this folder.

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 19d36d84..ee92cc7d 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -9072,10 +9072,12 @@ static uint64_t vk_get(const vk_key *k, uint64_t src, uint64_t es) {
     id<MTLBuffer> b = [g_dev newBufferWithLength:(NSUInteger)bytes options:MTLResourceStorageModeShared];
     if (!b) return 0;
     uint64_t pg = (uint64_t)getpagesize(), plo = (src + pg - 1) & ~(pg - 1), phi = (src + sn) & ~(pg - 1), pn = phi > plo ? phi - plo : 0;
+    uint64_t head = pn ? plo - src : sn, tail = pn ? src + sn - phi : 0;
+    e->edge = malloc((size_t)(head + tail) + 1);
+    if (!e->edge) { e->retry = g_sub_serial + 1; return 0; }
     e->lo = src; e->n = sn; e->plo = plo; e->pn = pn; e->span = span;
     e->stamp = e->seen = nvn_dirty_now(); if (pn) nvn_dirty_protect((const void *)(uintptr_t)plo, (size_t)pn);   // take the stamp, protect, then read (as ix_range)
-    uint64_t head = pn ? plo - src : sn, tail = pn ? src + sn - phi : 0;
-    e->edge = malloc((size_t)(head + tail) + 1); memcpy(e->edge, (const void *)(uintptr_t)src, (size_t)head); memcpy(e->edge + head, (const void *)(uintptr_t)(src + sn - tail), (size_t)tail);
+    memcpy(e->edge, (const void *)(uintptr_t)src, (size_t)head); memcpy(e->edge + head, (const void *)(uintptr_t)(src + sn - tail), (size_t)tail);
     float *d = (float *)b.contents;
     vconv_fill((int)k->fmt, src, k->stride, k->nv, d);
     if (k->nt > k->nv) { static const uint8_t zeros[16]; vconv_fill((int)k->fmt, (uint64_t)(uintptr_t)zeros, 0, k->nt - k->nv, d + 4 * k->nv); }
diff --git a/dm/gfx/nvn/nvn_owner.m b/dm/gfx/nvn/nvn_owner.m
index c11b65f4..e5b85e84 100644
--- a/dm/gfx/nvn/nvn_owner.m
+++ b/dm/gfx/nvn/nvn_owner.m
@@ -165,7 +165,7 @@ static void alias_index(const alias_key *k, int add) {
         if (add) {
             if (v && i < v->n) continue;
             if (!v || v->n == v->cap) {
-                uint32_t cap = v ? v->cap * 2 : 4; alias_cell *nv = realloc(v, sizeof *nv + cap * sizeof nv->e[0]); if (!nv) abort();
+                uint32_t cap = v ? v->cap * 2 : 4; alias_cell *nv = realloc(v, sizeof *nv + cap * sizeof nv->e[0]); if (!nv) ODIE("no memory for the texture sharing cells (%zu bytes)", sizeof *nv + cap * sizeof nv->e[0]);
                 if (!v) nv->n = 0; nv->cap = cap; v = nv; nvn_hm_put(&g_alias_cells, ck, v);
             }
             v->e[v->n].k = *k; v->e[v->n++].end = end;
