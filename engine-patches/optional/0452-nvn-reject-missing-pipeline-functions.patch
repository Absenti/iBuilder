# nvn/pipeline: reject missing required render functions (Metal aborted instead of returning an error)
#
# Upstream:  https://github.com/seedds/nxnative/commit/d08243122795175f541fef95aa879194dc33a8d3
# Author:    seedds, 2026-11-20 23:29:41 +0800
# Co-authors:
#   Co-authored-by: Manuel Pérez Mayol
# Licence:   MIT, Copyright (c) 2026 seedds (nxnative LICENSE); the attribution above is kept as the licence asks.
#
# WHAT IT CHANGES FOR THE PHONE
#   The render pipelines of this phone go through dva_rps / dva_mps (engine-patches/0414, which take the place of dev_rps / dev_mps for every caller) and, without 0414, through dev_rps / dev_mps.
#   A required function that is nil (a shader library that failed to compile leaves one in the descriptor) made Metal ABORT the process before it returned an error. Now dva_rps returns an
#   NSError ("missing vertex function", code 3) BEFORE the archive lookup (the lookup is a Metal call too), and dva_mps does the same for a missing mesh or mesh-fragment function.
#   Depth-only classic rendering may still omit its fragment function, a native mesh pipeline its object function. Upstream tested it with the Ocarina of Time profile. Default: on.
#
# ADAPTED, not verbatim: upstream edits the bodies of dev_rps / dev_mps; on this tree 0414 routes every caller to dva_rps / dva_mps (its #defines), so the checks go there; missing_pipeline_function()
#   is defined after dev_mps. dev_rps / dev_mps themselves are left as they are (paches/0009 rewrites them; checked: paches/0007 0008 0009 still apply). Upstream's three test hunks are kept
#   (t_pso_warm calls dev_rps / dev_mps, which are the dva_* ones through 0414's #defines).
# RISK: low. NOT run on a device. Shader chain id untouched.
#
# Apply with: patch -p1, to the tree out-stage/out-engine/engine + engine-patches/0401..0415 and the candidates numbered below this one, in the order of the numbers of this folder.

--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -151,6 +151,13 @@
 static id<MTLRenderPipelineState> dev_mps(MTLMeshRenderPipelineDescriptor *d, NSError **out) {
     plain_compile_begin(); NSError *e = nil; id ps = [g_dev newRenderPipelineStateWithMeshDescriptor:d options:MTLPipelineOptionNone reflection:nil error:&e]; return compile_done(ps, e, out);
 }
+// The Metal device calls can abort on a missing required function before they return a pipeline error. Return that error at the host boundary instead (nxnative d0824312): a missing
+// vertex function, or a missing native mesh or mesh fragment function. Depth-only classic rendering may still omit its fragment function, a native mesh pipeline its object function.
+static id<MTLRenderPipelineState> missing_pipeline_function(NSString *stage, NSError **out) {
+    if (out) *out = [NSError errorWithDomain:@"nxnative.NVN.Pipeline" code:3
+        userInfo:@{NSLocalizedDescriptionKey: [NSString stringWithFormat:@"missing %@ function", stage]}];
+    return nil;
+}
 static id<MTLFunction> dev_fn(id<MTLLibrary> lib, NSString *name, MTLFunctionConstantValues *cv, NSError **out) {
     plain_compile_begin(); NSError *e = nil; id f = [lib newFunctionWithName:name constantValues:cv error:&e]; return compile_done(f, e, out);
 }
@@ -400,11 +407,15 @@
     return compile_done(ps, e, out);
 }
 static id<MTLRenderPipelineState> dva_rps(MTLRenderPipelineDescriptor *d, NSError **out) {
+    if (!d.vertexFunction) return missing_pipeline_function(@"vertex", out);   // before the archive lookup too: Metal aborts on it (nxnative d0824312)
     plain_compile_begin(); NSError *e = nil; id ps = dva_on() ? dva_lookup(0, d) : nil;
     if (!ps) { ps = [g_dev newRenderPipelineStateWithDescriptor:d error:&e]; if (ps && g_dva_state == 1) dva_offer(0, d); }
     return compile_done(ps, e, out);
 }
 static id<MTLRenderPipelineState> dva_mps(MTLMeshRenderPipelineDescriptor *d, NSError **out) {
+    // A mesh pipeline requires a fragment function even for depth-only rendering (mtk_nop_fragment).
+    if (!d.meshFunction) return missing_pipeline_function(@"mesh", out);
+    if (!d.fragmentFunction) return missing_pipeline_function(@"mesh fragment", out);
     plain_compile_begin(); NSError *e = nil; id ps = nil; int arch = 0;
     if (@available(iOS 18.0, macOS 15.0, *)) arch = dva_on();
     if (arch) ps = dva_lookup(2, d);
