+        "struct V { float4 p [[position]]; };\n"
+        "[[mesh]] void ms(mesh<V, void, 3, 1, topology::triangle> out) { out.set_primitive_count(0); }\n"
+        options:nil error:&err];
+    id<MTLFunction> mesh_fn = [mesh_lib newFunctionWithName:@"ms"];
