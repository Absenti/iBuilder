+    dispatch_async(g_feedback_q, ^{ dispatch_semaphore_signal(in); dispatch_semaphore_wait(gate, DISPATCH_TIME_FOREVER); });
+    dispatch_semaphore_wait(in, DISPATCH_TIME_FOREVER);
+    return gate;
