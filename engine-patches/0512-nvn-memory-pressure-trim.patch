diff --git a/dm/gfx/tests/t_mem_trim.m b/dm/gfx/tests/t_mem_trim.m
new file mode 100644
index 0000000..f7c8a8e
--- /dev/null
+++ b/dm/gfx/tests/t_mem_trim.m
@@ -0,0 +1,45 @@
+// The memory-pressure response (engine-patches/0512, adapted from mianmuhammadse/nxnative no-bc 2ad4c0d4, MIT): a request sets only a flag, the trim runs at the next submission's start.
+//   t_mem_trim            DM_MEM_HEADROOM=100 stands in for os_proc_available_memory(): no trim before frame 30, a tier-2 request at frame 30 (the watermark), one trim at the next submission that
+//                         empties the view cache and drops the idle staging blocks; not asked again before frame 330; DM_MEM_TRIM=400:1 asks at frame 400; an app request (reason 3) trims too
+//   t_mem_trim off        DM_MEM_PRESSURE=0: requests are ignored, nothing is trimmed
+// Usage: t_mem_trim [off]
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, ...) do { checks++; if (!(c)) { failed++; printf("  FAIL: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+static void sub(void) { mtl_sub_begin(); CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "submission completes"); }
+static void put_vc(void) {   // one view-cache entry and one staging block, so a trim has something to drop
+    os_unfair_lock_lock(&g_rmu); vc_set *s = calloc(1, sizeof *s); uint64_t a = 0x1234000; nvn_hm_put(&g_vc, &a, s); os_unfair_lock_unlock(&g_rmu);
+    mtl_sub_begin(); up_begin(); size_t off; up_alloc(4096, &off); up_flush(); CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "staging submission completes");
+    for (int i = 0; i < 5000 && atomic_load(&g_up_pending); i++) usleep(1000);
+}
+static int staged(void) { int n = 0; for (int i = 0; i < 3; i++) n += g_up_slot_blk[i] != nil; return n; }
+int main(int argc, char **argv) { @autoreleasepool {
+    int off = argc > 1 && !strcmp(argv[1], "off");
+    setenv("DM_MEM_HEADROOM", "100", 1); setenv("DM_MEM_TRIM", "400:1", 1);
+    if (off) setenv("DM_MEM_PRESSURE", "0", 1);
+    mtl_init();
+    put_vc(); CHECK(g_vc.n == 1 && staged() >= 1, "setup: a view-cache entry (%u) and a staging block (%d)", g_vc.n, staged());
+    for (unsigned long long f = 1; f < 30; f++) mtl_mem_pressure_tick(f);
+    sub(); CHECK(atomic_load(&g_mp_trims) == 0, "no trim before frame 30 (%llu)", (unsigned long long)atomic_load(&g_mp_trims));
+    mtl_mem_pressure_tick(30); CHECK(atomic_load(&g_mp_req) == 2, "the watermark (100 MB) asks for tier 2 at frame 30 (%d)", atomic_load(&g_mp_req));
+    sub();
+    if (off) {
+        CHECK(atomic_load(&g_mp_trims) == 0 && g_vc.n == 1, "DM_MEM_PRESSURE=0: nothing trimmed (trims %llu, view cache %u)", (unsigned long long)atomic_load(&g_mp_trims), g_vc.n);
+    } else {
+        CHECK(atomic_load(&g_mp_trims) == 1, "one trim at the next submission (%llu)", (unsigned long long)atomic_load(&g_mp_trims));
+        CHECK(g_vc.n == 0, "the view cache is empty after the trim (%u)", g_vc.n);
+        CHECK(staged() == 0, "the idle staging blocks are dropped (%d left)", staged());
+        for (unsigned long long f = 31; f < 330; f++) mtl_mem_pressure_tick(f);
+        sub(); CHECK(atomic_load(&g_mp_trims) == 1, "not asked again within 300 frames at the same tier (%llu)", (unsigned long long)atomic_load(&g_mp_trims));
+        for (unsigned long long f = 330; f <= 400; f++) mtl_mem_pressure_tick(f);
+        sub(); CHECK(atomic_load(&g_mp_trims) == 2, "the watermark again after 300 frames, with DM_MEM_TRIM=400:1 merged into it (%llu)", (unsigned long long)atomic_load(&g_mp_trims));
+        mtl_mem_pressure_request(1, 3); sub(); CHECK(atomic_load(&g_mp_trims) == 3, "an app request trims at the next submission (%llu)", (unsigned long long)atomic_load(&g_mp_trims));
+        put_vc(); sub(); CHECK(atomic_load(&g_mp_trims) == 3 && g_vc.n == 1, "no request, no trim (%llu, view cache %u)", (unsigned long long)atomic_load(&g_mp_trims), g_vc.n);
+    }
+    printf("t_mem_trim%s: %d checks, %d failed\n", off ? " off" : "", checks, failed); return failed != 0;
+}}
