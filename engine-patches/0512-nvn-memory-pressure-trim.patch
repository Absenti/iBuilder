 static int g_bc_gdec = 1;  // no-BC path: BC1-5 deswizzled and decoded on the GPU at upload (kernel bcd); DM_NO_BC_GPU=0 = every BC texture on the CPU, as before 0510
@@ -1543,6 +1545,7 @@ static void mtl_init_once(void) {
             if (flags & (DISPATCH_MEMORYPRESSURE_WARN | DISPATCH_MEMORYPRESSURE_CRITICAL)) {
                 atomic_store_explicit(&g_rh_pressure, 1, memory_order_release);
                 rh_trim();
+                mtl_mem_pressure_request(flags & DISPATCH_MEMORYPRESSURE_CRITICAL ? 2 : 1, flags & DISPATCH_MEMORYPRESSURE_CRITICAL ? 2 : 1);   // 0512: the trim at the next submission
             } else if (flags & DISPATCH_MEMORYPRESSURE_NORMAL) {
                 atomic_store_explicit(&g_rh_pressure, 0, memory_order_release);
