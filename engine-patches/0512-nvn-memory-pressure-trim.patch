+void mtl_mem_pressure_tick(unsigned long long frame);
+void mtl_set_frame(uint64_t f) { atomic_store(&g_cur_frame, f); if (g_ub_n) ub_frame(f); if (ab_len()) ab_frame(f); gpu_capture_frame(f); mtl_mem_pressure_tick(f); }   // 0512: the headroom watermark
 // GPU timing registration: gpu_tag_begin(frame) before commit, gpu_tag_done(frame, GPU start, GPU end) on completion (seconds on the CACurrentMediaTime base).
 // Old-queue command buffers go through gpu_tag_f; the Metal 4 main submission backfills in the feedback of mtl_sub_commit (when switching to Metal 4 all the call sites were lost and the GPU column of the timing line became empty)
 static void gpu_tag_begin(uint64_t f) {
@@ -8489,6 +8494,74 @@ static void vc_set_free(void *p) {
     vc_rows_drop(s);
     free(s);
 }
+// ---- Memory-pressure response (engine-patches/0512, adapted from mianmuhammadse/nxnative no-bc 2ad4c0d4 / 69e26193, MIT) ----
+// iOS stops an app at its footprint limit (about 3 GB on a 6 GB iPhone 15, the fork measured), usually without a warning it can act on. The triggers only set a request: the system's
+// memory-pressure source (warn = tier 1, critical = tier 2; mtl_init_once's handler, which also trims the render-target heaps at once as before), mtl_mem_pressure_request from the app
+// (its memory warning, reason 3), and a watermark on os_proc_available_memory() every 30 frames (mtl_mem_pressure_tick, from mtl_set_frame, each game frame): tier 1 under 300 MB of headroom,
+// tier 2 under 150 MB, asked again at most every 300 frames unless the tier rises. The trim runs at the next submission's start on the submit thread, before anything is encoded:
+// the view cache is emptied (its views go after the GPU is past them), the render-target heaps are trimmed (rh_trim), the GPU is waited for once so every deferred
+// release goes now, the staging slots' blocks of batches not in flight are dropped (made again by the next upload) and malloc returns its free pages. One log line per trim says what
+// it freed. Nothing runs while the headroom is fine. Not ported from the fork: its ghost-table cut and the drop of unreferenced shared textures and of re-upload spares (upstream
+// structures this tree keeps in nvn_owner.m, with other lifetimes), the UIKit memory-warning hook (the app's front end is not dm/ios: it can call mtl_mem_pressure_request).
+// DM_MEM_PRESSURE=0: no trim (the requests are ignored; the render-target heap trim of the system source stays). Test switches (Mac): DM_MEM_TRIM=<frame>:<tier>[,...] asks for tiers
+// at frames, DM_MEM_HEADROOM=<MB> stands in for os_proc_available_memory()
+size_t malloc_zone_pressure_relief(malloc_zone_t *zone, size_t goal);
+static _Atomic int g_mp_req, g_mp_reason; static _Atomic uint64_t g_mp_trims;
+static uint64_t g_mp_last_frame; static int g_mp_last_tier; static long g_mp_fake = -2;
+enum { MP_SRC_WARN = 1, MP_SRC_CRIT = 2, MP_APP = 3, MP_WATER = 4, MP_TEST = 5 };
+static int mp_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("DM_MEM_PRESSURE"); v = !(e && !strcmp(e, "0")); if (!v) MLOG("DM_MEM_PRESSURE=0: the memory-pressure trim is off"); } return v; }
+void mtl_mem_pressure_request(int tier, int reason) {
+    if (tier < 1) return; if (tier > 2) tier = 2;
+    int cur = atomic_load(&g_mp_req); while (tier > cur && !atomic_compare_exchange_weak(&g_mp_req, &cur, tier)) {}
+    atomic_store(&g_mp_reason, reason);
+}
+static long mp_headroom_mb(void) {   // -1: unknown (a Mac without DM_MEM_HEADROOM)
+    if (g_mp_fake == -2) { const char *e = getenv("DM_MEM_HEADROOM"); g_mp_fake = e && *e ? atol(e) : -1; }
+    if (g_mp_fake >= 0) return g_mp_fake;
+#if TARGET_OS_IPHONE
+    return (long)(os_proc_available_memory() >> 20);
+#else
+    return -1;
+#endif
+}
+static uint64_t mp_footprint_mb(void) { task_vm_info_data_t vi; mach_msg_type_number_t cnt = TASK_VM_INFO_COUNT; return task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vi, &cnt) == KERN_SUCCESS ? vi.phys_footprint >> 20 : 0; }
+void mtl_mem_pressure_tick(unsigned long long frame) {   // each game frame (mtl_set_frame)
+    static const char *sched; static int init;
+    if (!init) { init = 1; sched = getenv("DM_MEM_TRIM"); }
+    if (sched && *sched) { char *end; unsigned long long at = strtoull(sched, &end, 10);
+        if (*end == ':' && frame >= at) { mtl_mem_pressure_request(atoi(end + 1), MP_TEST); const char *c = strchr(end, ','); sched = c ? c + 1 : ""; } else if (*end != ':') sched = ""; }
+    if (frame % 30) return;
+    long h = mp_headroom_mb();
+    if (h < 0) return;
+    int tier = h < 150 ? 2 : h < 300 ? 1 : 0;
+    if (tier && (tier > g_mp_last_tier || frame - g_mp_last_frame >= 300)) { mtl_mem_pressure_request(tier, MP_WATER); g_mp_last_tier = tier; g_mp_last_frame = frame; }
+    if (!tier && h >= 600) g_mp_last_tier = 0;
+}
+static void mem_trim_if_requested(void) {
+    if (!atomic_load_explicit(&g_mp_req, memory_order_relaxed)) return;
+    int tier = atomic_exchange(&g_mp_req, 0); if (!tier || !mp_on() || !g_dev || atomic_load(&g_gfx_teardown)) return;
+    int reason = atomic_load(&g_mp_reason); unsigned long long frame = (unsigned long long)atomic_load(&g_cur_frame);
+    static const char *const rn[] = {"", "system warning", "system critical", "app memory warning", "headroom watermark", "test switch"};
+    long h0 = mp_headroom_mb(); uint64_t gpu0 = g_dev.currentAllocatedSize >> 20, fp0 = mp_footprint_mb();
+    os_unfair_lock_lock(&g_rmu); unsigned nvc = g_vc.n; nvn_hm_clear(&g_vc, vc_set_free); os_unfair_lock_unlock(&g_rmu);   // the fork's 69e26193: g_rmu is an unfair lock
+    rh_trim();   // under the policy of the moment: the system source sets and clears g_rh_pressure itself (a watermark trim does not leave it set)
+    mtl_finish_gpu_at(WS_FINISH);   // the GPU is idle and nothing of this submission is encoded: what was retired behind the submissions run so far goes now
+    defer_drain();   // (the fork also moved later releases forward; not here: an upload batch committed outside a submission may still hold them)
+    unsigned nblk = 0; size_t blkb = 0;
+    if (!g_up_cb) for (unsigned i = 0; i < 3; i++) {   // the staging slots of batches not in flight (as up_idle_release does for idle ones)
+        if (atomic_load(&g_up_alloc_busy[i])) continue;
+        if (g_up_slot_blk[i]) { nblk++; blkb += g_up_slot_blk[i].length; up_idle_drop(&g_up_slot_blk[i]); }
+        if (g_up_slot_over[i]) { nblk++; blkb += g_up_slot_over[i].length; up_idle_drop(&g_up_slot_over[i]); }
+        g_up_slot_want[i] = 0; g_up_idle_slot[i] = (up_idle_slot){0};
+    }
+    if (nblk) res_commit();
+    malloc_zone_pressure_relief(NULL, 0);
+    atomic_fetch_add(&g_mp_trims, 1);
+    long h1 = mp_headroom_mb(); uint64_t gpu1 = g_dev.currentAllocatedSize >> 20, fp1 = mp_footprint_mb();
+    MLOG("memory pressure: tier %d (%s, frame %llu), headroom %ld -> %ld MB (-1 = unknown), footprint %llu -> %llu MB, GPU allocated %llu -> %llu MB: view cache %u entries, "
+         "render-target heaps trimmed, deferred releases drained after a GPU wait, staging slot blocks %u (%zu MB), malloc relief", tier, reason >= 1 && reason <= 5 ? rn[reason] : "?", frame,
+         h0, h1, (unsigned long long)fp0, (unsigned long long)fp1, (unsigned long long)gpu0, (unsigned long long)gpu1, nvc, nblk, blkb >> 20);
+}
 static id<MTLTexture> vc_get(id<MTLTexture> base, const vc_key *k) {
     uint64_t a = vc_addr(base); vc_set *s = nvn_hm_get(&g_vc, &a); if (!s) return nil;
     for (int i = 0; i < VC_WAYS; i++) if (s->view[i] && !memcmp(&s->k[i], k, sizeof *k)) { g_vc_hit++; return (__bridge id<MTLTexture>)s->view[i]; }
