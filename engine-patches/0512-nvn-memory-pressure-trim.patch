+void mtl_mem_pressure_request(int tier, int reason); static void mem_trim_if_requested(void);   // the memory-pressure response (engine-patches/0512), with the view cache below
 static int g_bc_gpu = 1;   // the device advertises BC texture compression (set where the device is made; DM_TEST_NO_BC=1 says it does not)
