+
+def _inflate_dflt(data, size, name):
+    # The DLC's DFLT chunks each contain one final DEFLATE block. Its
+    # dynamic Huffman type is 0 instead of 2. Fixed Huffman keeps type 1.
+    header = data[0] & 7
