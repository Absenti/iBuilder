+    # every offset must be literal. A similarly named device pointer is not proof.
+    load = re.fullmatch(r'\(\*(\w+)\.(\w+)\)\.(\w+)\[(0[xX][0-9a-fA-F]+|[0-9]+)[uU]?\]\.([xyzw])', value)
