+    mtl_init();
+    g_tu_manual = 1; g_tu_now = 1000;
+    CHECK("small_working_set matches < 6 GB", small_working_set(5461ull << 20) && !small_working_set(6ull << 30) && !small_working_set(12124ull << 20) && !small_working_set(0));
