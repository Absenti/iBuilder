+// The memory-pressure trim's (mem_trim_if_requested, engine-patches/0525 after seedds/nxnative d08d7da6): every waiting heap goes, however fresh. -> bytes freed, *n_out heaps
+static uint64_t rh_trim_all(unsigned *n_out) {
+    os_unfair_lock_lock(&g_rh_lk); uint64_t b0 = g_rh_bytes; os_unfair_lock_unlock(&g_rh_lk);
+    uint64_t t0 = atomic_load(&g_rh_trimmed); rh_policy zero = {0, 0, 0, 1};
+    rh_evict_to_budget(clock_gettime_nsec_np(CLOCK_MONOTONIC), &zero);
+    os_unfair_lock_lock(&g_rh_lk); uint64_t b1 = g_rh_bytes; os_unfair_lock_unlock(&g_rh_lk);
+    if (n_out) *n_out = (unsigned)(atomic_load(&g_rh_trimmed) - t0);
+    return b0 > b1 ? b0 - b1 : 0;
+}
+// The whole system's memory (host_statistics64), in MB: what the per-app headroom misses. An iPhone 17 ended the app for proc-thrashing in Ocarina of Time with 67 MB free and 5.56 GB of its
+// 8 GB wired while os_proc_available_memory still read 2.7 GB (seedds/nxnative docs/reference/memory.md, d08d7da6). file: file-backed pages in memory (the guest's files among them, DM_GUEST_FILE)
+typedef struct { uint64_t total, free, wired, compressed, file, purgeable; int ok; } sys_mem_t;
+static sys_mem_t sys_mem(void) {
+    sys_mem_t m = {0}; vm_statistics64_data_t v; mach_msg_type_number_t n = HOST_VM_INFO64_COUNT; uint64_t total = 0; size_t tl = sizeof total;
+    if (host_statistics64(mach_host_self(), HOST_VM_INFO64, (host_info64_t)&v, &n) != KERN_SUCCESS) return m;
+    sysctlbyname("hw.memsize", &total, &tl, NULL, 0);
+    uint64_t pg = vm_kernel_page_size;
+    m.total = total >> 20; m.free = ((uint64_t)v.free_count + v.speculative_count) * pg >> 20; m.wired = (uint64_t)v.wire_count * pg >> 20;
+    m.compressed = (uint64_t)v.compressor_page_count * pg >> 20; m.file = (uint64_t)v.external_page_count * pg >> 20; m.purgeable = (uint64_t)v.purgeable_count * pg >> 20; m.ok = 1;
+    return m;
+}
+// The system memory-pressure events (mtl_init_once's source, iOS: 0 back to normal, 1 warn, 2 critical), each logged with the system's figures; what the trims gave back; idle uploaded
+// textures freed without pressure (pkg_sweep). The trim itself is 0512's (mem_trim_if_requested, whose counter g_mp_trims is declared here too): the source only asks for it
+static _Atomic uint64_t g_mpe_n[3], g_mp_freed, g_sweep_n, g_sweep_bytes;
+static _Atomic uint64_t g_mp_trims;   // tentative: defined with 0512's trim
+static void mp_event_log(int lv) {
+    atomic_fetch_add(&g_mpe_n[lv], 1);
+    sys_mem_t m = sys_mem(); char room[32] = "none";
+#if TARGET_OS_IPHONE
+    snprintf(room, sizeof room, "%llu MB", (unsigned long long)(os_proc_available_memory() >> 20));
+#endif
+    MLOG("[mem] memory pressure %s: system free %llu MB, wired %llu MB, compressed %llu MB, file-backed %llu MB; residency set %llu MB; headroom %s", lv == 2 ? "critical" : lv ? "warn" : "back to normal",
+         (unsigned long long)m.free, (unsigned long long)m.wired, (unsigned long long)m.compressed, (unsigned long long)m.file, (unsigned long long)(g_res ? g_res.allocatedSize >> 20 : 0), room);
+}
+static void mem_pressure_said(char *b, size_t n) {
+    snprintf(b, n, "memory pressure events warn %llu, critical %llu, back to normal %llu; trims %llu, %llu MB given back; idle uploaded textures freed without pressure %llu, %llu MB",
+             (unsigned long long)atomic_load(&g_mpe_n[1]), (unsigned long long)atomic_load(&g_mpe_n[2]), (unsigned long long)atomic_load(&g_mpe_n[0]),
+             (unsigned long long)atomic_load(&g_mp_trims), (unsigned long long)(atomic_load(&g_mp_freed) >> 20),
+             (unsigned long long)atomic_load(&g_sweep_n), (unsigned long long)(atomic_load(&g_sweep_bytes) >> 20));
+}
