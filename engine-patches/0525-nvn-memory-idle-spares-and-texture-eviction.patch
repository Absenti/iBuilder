+    CHECK("the idle texture's serial no longer resolves to its copy", tex_get(t[0].serial) == nil);
+    CHECK("the used, GPU-written and pinned ones stay", tex_get(t[1].serial) && tex_get(t[2].serial) && tex_get(t[3].serial));
