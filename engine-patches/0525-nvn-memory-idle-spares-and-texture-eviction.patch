+        mtl_tex_init(&t[i]); mtl_reg_tex(ID0 + i, &t[i], NULL);
+    }
+    (void)pool_seen_gpu();
+    // A shader reads all four through the pool: each is made
+    for (int i = 0; i < NT; i++) ((uint32_t *)g_seen_buf.contents)[(ID0 + i) / 32] |= 1u << ((ID0 + i) % 32);
