# nvn/sparse: honor descriptor lifetime in mapping scans (PR #3091)
#
# Upstream:  https://github.com/seedds/nxnative/commit/6d0ee04ac6505bec52bf514e4b0e9555222ef706  (PR #3091, see also #496)
# Author:    seedds, 2026-11-21 14:45:54 +0800
# Co-authors:
#   Co-authored-by: 4ever-adhd
# Licence:   MIT, Copyright (c) 2026 seedds (nxnative LICENSE); the attribution above is kept as the licence asks.
#
# WHAT IT CHANGES FOR THE PHONE
#   Sparse-layout textures are tracked per descriptor ID and scanned when the game remaps pages (treg_sparse_notes). A scan could dereference a descriptor whose pool had already been
#   finalized (freed): a crash while loading (upstream reproduction: Tony Hawk's Pro Skater 1 + 2; whether Ocarina of Time reaches this path was not checked). Now the scan skips descriptors
#   marked gone (set under g_rmu before the pool may be freed), and an identical re-registration reviving a pruned descriptor puts it back in the sparse list. Default: on, no switch.
# Applies as is (17 lines). RISK: low. NOT run on a device. Shader chain id untouched.
#
# Apply with: patch -p1, to the tree out-stage/out-engine/engine + engine-patches/0401..0415 and the candidates numbered below this one, in the order of the numbers of this folder.

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index d507cd7e..19d36d84 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -7348,7 +7348,8 @@ static void treg_sparse_notes(void) {
     os_unfair_lock_lock(&g_rmu);
     for (size_t i = 0; i < g_ntreg_sp; i++) {
         int id_ = g_treg_sp[i]; treg_t *rp = &g_treg[id_];
-        if (!rp->ok || !rp->t.pool || !nvn_sparse_pool(rp->t.pool)) { rp->sp = 0; continue; }
+        // Pool finalization marks its descriptors gone under g_rmu before the object may be freed.
+        if (!rp->ok || rp->gone || !rp->t.pool || !nvn_sparse_pool(rp->t.pool)) { rp->sp = 0; continue; }
         g_treg_sp[w++] = id_;
         uint64_t lo = (uint64_t)(uintptr_t)rp->t.mem, hi = lo + rp->t.L.size;
         int hit = n < 0;
@@ -7671,7 +7672,8 @@ void mtl_reg_tex(int tid, const tex_t *t, const view_t *v) {
     // registrations KTGL (Age of Calamity) makes before every bind repeat the ID's texture; the rest cycle textures through its IDs (the view cache below, vc_get)
     treg_t *rr = &g_treg[id_];
     int same = t && rr->ok && rr->has_v == (v != NULL) && !memcmp(&rr->t, t, sizeof *t) && (!v || !memcmp(&rr->v, v, sizeof *v));
-    if (rr->gone) { rr->gone = 0; reg_bump(id_, 0); if (rr->ok) bcp_idx(id_, &rr->t, 1); }   // registered again (pool storage made anew), even with the same data; a pair side again
+    int was_gone = rr->gone;
+    if (was_gone) { rr->gone = 0; reg_bump(id_, 0); if (rr->ok) bcp_idx(id_, &rr->t, 1); }   // registered again (pool storage made anew), even with the same data; a pair side again
     if (!same) {
         // The read mark (pool_seen) is the ID's: shaders read an ID, whatever texture the game puts into it, so the mark stays while the ID holds a texture and the next walk makes the new
         // one under the read budget (POOL_REQ_BYTES). Cleared on every change, it left a streamed replacement to the walk's room (pool_room), which is 0 once pool_budget() is spent:
@@ -7691,12 +7693,13 @@ void mtl_reg_tex(int tid, const tex_t *t, const view_t *v) {
             if (rr->next) g_treg[rr->next - 1].prev = id_ + 1;
             nvn_hm_put(&g_treg_serial, &t->serial, (void *)(uintptr_t)(id_ + 1));
         }
-        if (t && !rr->sp && t->pool && nvn_sparse_pool(t->pool)) {   // its pages follow the game's mappings (treg_sparse_notes)
-            if (g_ntreg_sp == g_treg_sp_cap) { g_treg_sp_cap = g_treg_sp_cap ? g_treg_sp_cap * 2 : 256; g_treg_sp = realloc_or_die(g_treg_sp, g_treg_sp_cap * sizeof *g_treg_sp, "the sparse texture IDs"); }
-            g_treg_sp[g_ntreg_sp++] = id_; rr->sp = 1;
-        }
-        if (id_ < (1 << 20)) atomic_store_explicit(&g_tser[id_], t ? t->serial : 0, memory_order_release);
     }
+    // The scan can remove a gone ID before an identical registration revives it.
+    if ((!same || was_gone) && t && !rr->sp && t->pool && nvn_sparse_pool(t->pool)) {
+        if (g_ntreg_sp == g_treg_sp_cap) { g_treg_sp_cap = g_treg_sp_cap ? g_treg_sp_cap * 2 : 256; g_treg_sp = realloc_or_die(g_treg_sp, g_treg_sp_cap * sizeof *g_treg_sp, "the sparse texture IDs"); }
+        g_treg_sp[g_ntreg_sp++] = id_; rr->sp = 1;
+    }
+    if (!same && id_ < (1 << 20)) atomic_store_explicit(&g_tser[id_], t ? t->serial : 0, memory_order_release);
     os_unfair_lock_unlock(&g_rmu);
     {   // DM_NVN_TREG_ID=n logs every registration of texture ID n: what it holds from then on, and when (the frame being recorded)
         static int want = -2; if (want == -2) { const char *e = getenv("DM_NVN_TREG_ID"); want = e ? atoi(e) : -1; }
diff --git a/dm/gfx/tests/t_sparse_pool_cache.m b/dm/gfx/tests/t_sparse_pool_cache.m
index 14fc2f43..a5a4f61f 100644
--- a/dm/gfx/tests/t_sparse_pool_cache.m
+++ b/dm/gfx/tests/t_sparse_pool_cache.m
@@ -131,6 +131,51 @@ int main(void) { @autoreleasepool {
     mtl_reg_tex(2, NULL, NULL); mtl_reg_tex(3, NULL, NULL); mtl_reg_tex(4, NULL, NULL);
     h_nvnTextureFinalize(&tm);
 
+    // An identical registration revives an ID pruned from the sparse scan while it was gone.
+    mtl_reg_tex_gone(1);
+    CHECK(map(&virt, &phys, past, 0x50000, 0x1000), "a mapping beside the gone descriptor's texture");
+    next_sub();
+    CHECK(g_treg[1].gone && !g_treg[1].sp, "the scan removes the gone descriptor");
+    mtl_reg_tex(1, (const tex_t *)&tx, NULL);
+    CHECK(!g_treg[1].gone && g_treg[1].sp, "an identical registration restores sparse tracking");
+    pool_gpu(0, MTLTextureType2D, NVN_DPF_FLOAT, 0, &table);
+    CHECK(gpu_read(table, 1) == C, "the revived descriptor reads the current page");
+    sg = g_ser_gen;
+    CHECK(map(&virt, &phys, 0, 0x10000, 0x1000), "remap the revived descriptor's page");
+    next_sub();
+    CHECK(g_ser_gen == sg + 1, "the next submission notes the revived descriptor's serial");
+    pool_gpu(0, MTLTextureType2D, NVN_DPF_FLOAT, 0, &table);
+    CHECK(gpu_read(table, 1) == B, "the revived descriptor reads the newly mapped page");
+
+    // A scene change finalizes a pool while its descriptor stays registered.
+    // Make the freed pool object's page inaccessible, then map the live pool:
+    // the next submission must retire the old sparse-scan entry without reading it.
+    const size_t page = (size_t)getpagesize();
+    pool_t *dead = mmap(NULL, page, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    CHECK(dead != MAP_FAILED, "pool object page allocated");
+    pb = (pool_builder_t){.size = 0x20000, .flags = NVN_MEMORY_POOL_FLAGS_VIRTUAL};
+    CHECK(h_nvnMemoryPoolInitialize((NVNmemoryPool *)dead, (NVNmemoryPoolBuilder *)&pb), "temporary virtual pool");
+    CHECK(map(dead, &phys, 0, 0x30000, 0x1000), "temporary pool mapped sparsely");
+    h_nvnTextureBuilderSetDefaults(&tb);
+    h_nvnTextureBuilderSetTarget(&tb, NVN_TEXTURE_TARGET_2D);
+    h_nvnTextureBuilderSetWidth(&tb, 32); h_nvnTextureBuilderSetHeight(&tb, 32);
+    h_nvnTextureBuilderSetFormat(&tb, NVN_FORMAT_RGBA8);
+    h_nvnTextureBuilderSetFlags(&tb, NVN_TEXTURE_FLAGS_SPARSE);
+    h_nvnTextureBuilderSetStorage(&tb, (NVNmemoryPool *)dead, 0);
+    NVNtexture td;
+    CHECK(h_nvnTextureInitialize(&td, &tb), "temporary sparse texture");
+    mtl_reg_tex(5, (const tex_t *)&td, NULL);
+    CHECK(g_treg[5].sp, "temporary descriptor belongs to sparse scan");
+    h_nvnTextureFinalize(&td);
+    CHECK(!g_treg[5].gone, "texture finalization keeps the registered descriptor live until its pool ends");
+    h_nvnMemoryPoolFinalize((NVNmemoryPool *)dead);
+    CHECK(g_treg[5].gone, "finalization marks the descriptor gone");
+    CHECK(!mprotect(dead, page, PROT_NONE), "freed pool object is inaccessible");
+    CHECK(map(&virt, &phys, past, 0x40000, 0x1000), "another pool's mapping triggers sparse notes");
+    next_sub();
+    CHECK(!g_treg[5].sp, "gone descriptor removed without reading freed pool object");
+    CHECK(!munmap(dead, page), "temporary object page released");
+
     h_nvnTextureFinalize(&tx);
     h_nvnMemoryPoolFinalize((NVNmemoryPool *)&virt); h_nvnMemoryPoolFinalize((NVNmemoryPool *)&phys);
     mtl_sub_commit(); mtl_drain(); free(mem);
