+// ---- the GPU half's fixtures: the libraries of t_pso_head (hs<t> for S tasks, hv<t> / hf<t> for R pairs), compiled with the Metal toolchain
+@interface UfGate : NSObject { @public id<MTLDevice> device; dispatch_semaphore_t entered, release; _Atomic unsigned calls; unsigned block_at; } @end
+@implementation UfGate
+- (id)forwardingTargetForSelector:(SEL)selector { return device; }
+- (id<MTLLibrary>)newLibraryWithData:(dispatch_data_t)data error:(NSError **)error {
+    unsigned n = atomic_fetch_add(&calls, 1) + 1;
+    if (block_at && n == block_at) { dispatch_semaphore_signal(entered); dispatch_semaphore_wait(release, DISPATCH_TIME_FOREVER); }
+    return [device newLibraryWithData:data error:error];
+}
+@end
