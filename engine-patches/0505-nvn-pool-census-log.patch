+# engine-patches/0505 revision 2 (review L5): the pool census line is made of whole numbers
+t_pool_census: t_pool_census.m $(MTL_T_DEP)
+	clang $(CFLAGS) -fobjc-arc -o $@ t_pool_census.m $(MTL_T_SRC) $(FW)
 t_pso_skey: t_pso_skey.m ../nvn/nvn_pso_skey.h ../nvn/nvn_obj.h
