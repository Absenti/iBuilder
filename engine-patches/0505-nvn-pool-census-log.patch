--- /dev/null
+++ b/dm/gfx/tests/t_pool_census.m
@@ -0,0 +1,45 @@
+// engine-patches/0505 revision 2 (the review's L5): the pool census line the frame hook writes every 600 frames is made of whole numbers (the hook runs on a small guest stack, where
+// floating-point formatting is what the file's own comment says to avoid). No GPU work: pool_census over three entries of the pool table, its [pools] line read back from the log
+#include "../nvn/nvn_mtl.m"
+#include <fcntl.h>
+#include <unistd.h>
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define EXPECT(name, want, got) do { long long w_ = (long long)(want), g_ = (long long)(got); checks++; if (w_ != g_) { printf("FAIL %s: expected %lld, got %lld (line %d)\n", name, w_, g_, __LINE__); failed++; } } while (0)
+#define EXPECT_HAS(name, log, needle) do { checks++; if (![(log) containsString:@needle]) { failed++; printf("FAIL %s: the log has no \"%s\"\n--- log\n%s\n---\n", name, needle, [(log) UTF8String]); } } while (0)
+#define EXPECT_NOHAS(name, log, needle) do { checks++; if ([(log) containsString:@needle]) { failed++; printf("FAIL %s: pool_census has \"%s\"\n", name, needle); } } while (0)
+int main(void) { @autoreleasepool {
+    char tmpl[1024]; snprintf(tmpl, sizeof tmpl, "%s/t_pool_census.XXXXXX", NSTemporaryDirectory().fileSystemRepresentation); if (!mkdtemp(tmpl)) return 1;
+    NSString *logp = [@(tmpl) stringByAppendingPathComponent:@"engine.log"]; int fd = open(logp.fileSystemRepresentation, O_RDWR | O_CREAT | O_TRUNC, 0600); if (fd < 0 || dup2(fd, 2) < 0) return 1;
+    mtl_init();
+    // 64 MB (resident, texture uploads only, 7 s old), 3.5 MB (resident, used by draws), 1.5 MB (not in the residency set)
+    g_pools = calloc(3, sizeof *g_pools); g_cap = 3; g_npool = 3;
+    uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+    g_pools[0] = (pool_ent){.lo = 0x100000000ull, .hi = 0x100000000ull + (64u << 20), .res = 1, .born = now - 7000000000ull, .reach = REACH_END, .n_tex_reads = 5, .n_other = 0};
+    g_pools[1] = (pool_ent){.lo = 0x200000000ull, .hi = 0x200000000ull + (3u << 20) + (1u << 19), .res = 1, .born = now - 2000000000ull, .reach = REACH_END, .n_tex_reads = 1, .n_other = 9};
+    g_pools[2] = (pool_ent){.lo = 0x300000000ull, .hi = 0x300000000ull + (1u << 20) + (1u << 19), .res = 0, .born = now, .reach = REACH_END};
+    pool_census(600);
+    NSString *log = [NSString stringWithContentsOfFile:logp encoding:NSUTF8StringEncoding error:nil] ?: @"";
+    NSRange r = [log rangeOfString:@"[pools] frame 600:"]; EXPECT("the [pools] line is written", 1, r.location != NSNotFound);
+    NSString *line = r.location == NSNotFound ? @"" : [log substringFromIndex:r.location]; NSRange e = [line rangeOfString:@"\n"]; if (e.location != NSNotFound) line = [line substringToIndex:e.location];
+    EXPECT_HAS("3 pool buffers, 69 MB (64 + 3.5 + 1.5 = 69)", line, "3 pool buffers 69 MB");
+    EXPECT_HAS("2 in the residency set, 68 MB (67.5 rounds up)", line, "2 in the residency set 68 MB");
+    EXPECT_HAS("only texture uploads reached 1, 64 MB", line, "only texture uploads reached 1 of them, 64 MB");
+    EXPECT_HAS("the largest, in whole MB and seconds", line, "64 MB (uploads 5 / other 0, 7 s old)");
+    EXPECT_HAS("the second", line, "4 MB (uploads 1 / other 9, 2 s old)");   // 3.5 MB rounds to 4
+    int digits_dot = 0; for (NSUInteger i = 0; i + 1 < line.length; i++) if (isdigit([line characterAtIndex:i]) && [line characterAtIndex:i + 1] == '.' && i + 2 < line.length && isdigit([line characterAtIndex:i + 2])) digits_dot++;
+    EXPECT("no decimal number in the line", 0, digits_dot);
+    // the source guard: the output of "%.0f" and of whole numbers reads the same, so the property that matters (no floating point on the hook's stack) is checked on the function's text
+    NSString *src = [NSString stringWithContentsOfFile:@"../nvn/nvn_mtl.m" encoding:NSUTF8StringEncoding error:nil] ?: @"";
+    NSRange a0 = [src rangeOfString:@"static void pool_census("], b0 = [src rangeOfString:@"void mtl_mem_stat(unsigned long long frame"];
+    EXPECT("found pool_census in the source", 1, a0.location != NSNotFound && b0.location > a0.location);
+    NSString *body = a0.location != NSNotFound && b0.location > a0.location ? [src substringWithRange:NSMakeRange(a0.location, b0.location - a0.location)] : @"";
+    EXPECT_NOHAS("no double in pool_census", body, "double"); EXPECT_NOHAS("no %.Nf in pool_census", body, "%.0f"); EXPECT_NOHAS("no floating division", body, "1e9"); EXPECT_NOHAS("no floating MB", body, "1048576.0");
+    [NSFileManager.defaultManager removeItemAtPath:@(tmpl) error:nil];
+    printf("t_pool_census: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
