# nvn/frame-step: DM_FPS_PAYBACK=off, a late frame's lost time is let go instead of paid back with a longer step
#
# Source:    https://github.com/cheemu21/kid-with-sword-remake  branch L, commit d5cca2772f7960122d776008fbbc5cc01d0acfed ("V17: a steady 30 fps on the iPhone", 2026-11-09,
#            cherry picked from 48b9ecbebf4f5cbfd36ca129ca37f8b7f5c5a12c)
# Author:    cheemu21 (the commit; Co-Authored-By: Claude Opus 5.5 in the original)
# Licence:   MIT, Copyright (c) 2026 seedds and contributors (nxnative LICENSE; the fork is MIT too); the attribution above is kept as the licence asks.
#
# WHAT IT CHANGES (dm/gfx/nvn/hle_nvn.c, nvn_fstep.h)
#   Only the first part of V17 (the frame step's payback). The other two parts need no code here: the display-link latency is DM_PRESENT_LATENCY=2 (already in the engine) and frame
#   buffering is DM_PRESENT_SNAP=1 (already in the engine). The fork made them profile keys (link_latency30, present_snap) which need game.py headers; this patch is env only.
#   fstep_payback(): DM_FPS_PAYBACK (on by default). nvn_fstep: with nopay set, the debt of a late frame is added to "dropped" and zeroed before the step is chosen, so the step stays
#   the hold's k. With payback (the engine's default) a late frame is followed by a step of k + 1 vsyncs: at a 30 fps cap the game's time advances by 3 vsyncs for 2 shown, a half-frame
#   jump in motion; the fork counted 109 of them in 40 s on an iPhone 18 Pro whose GPU clock iOS had lowered (log 60, render scale 0.25).
# DEFAULT: on = today's behaviour, byte for byte (nopay is 0). DM_FPS_PAYBACK=off (or 0) turns the payback off.
# Cost: the game runs slower than real time by the time late frames lost (as on the console), instead of jumping.
# Shader chain: not touched. Test: the fork's t_fstep cases were not ported. Checked: patch -p1 --forward --dry-run, no fuzz, on the tree + 0401..0415. NOT run on a device.
# Use: DM_FPS_PAYBACK=off in app/profiles/0400486024DEC000.env.txt (with DM_FPS_TARGET=30, which it already sets).

# REVISION 2 (2026-11-21, review L7): DM_FPS_PAYBACK is read by dm/host/dm_envflag.h (engine-patches/0415, needed before this patch): off / 0 / false / no turn the payback off
#   (were "off" and "0" only), on / 1 / true / yes and unset keep it; anything else is logged and keeps it. The reading itself is t_env_flag's (102 checks).
--- a/dm/gfx/nvn/hle_nvn.c
+++ b/dm/gfx/nvn/hle_nvn.c
@@ -9,6 +9,7 @@
 // Every implementation gets a compile-time signature check against the prototypes in nvn_protos.h (NVNboolean parameters are received as uint32_t, only the low 8 bits are looked at).
 // Environment switches: DM_NVN_FRAMES=N prints the call table per frame for the first N frames (default 3); DM_NVN_TSV=path writes the per-frame call table and timing to a TSV (DM_NVN_TSV_CALLS=0 writes timing only); DM_SLOWFRAME=1 writes only the per-frame breakdown of dropped frames to the log; DM_NVN_LOG=1 logs object creation.
 #include "../../host/hle.h"
+#include "../../host/dm_envflag.h"   // engine-patches/0415: one reading of on / off switches (0503, 0504)
 #include "nvn_protos.h"
 #include "nvn_count.h"
 #include "nvn_tex.h"
@@ -2616,6 +2617,18 @@
         if (!h) LOG("[nvn] frame step: frames are not held longer than the cap's vsyncs (%s)", e ? "DM_FPS_HOLD" : "game profile fps_hold");
     }
     return h;
+}
+// Whether real time a late frame lost is paid back with a step of k + 1 vsyncs (DM_FPS_PAYBACK=on / off, default on = as before; nvn_fstep.h nopay). Off, game time follows the frames
+// shown: a late frame slows the game by its lateness instead of a half-frame jump in motion on the next frame (kid-with-sword-remake V17: Ocarina of Time at a 30 fps cap on an iPhone
+// 18 Pro paid back 109 times in 40 s, about three judders a second, with the GPU clock lowered by iOS)
+static int fstep_payback(void) {
+    static int p = -1;
+    if (p < 0) {
+        int bad = 0; p = dm_env_flag("DM_FPS_PAYBACK", 1, &bad);   // dm_envflag.h (engine-patches/0415): off / 0 / false / no; on / 1 / true / yes
+        if (bad) LOG("[nvn] DM_FPS_PAYBACK=%s is not on / off: late frames are paid back (the default)", getenv("DM_FPS_PAYBACK"));
+        if (!p) LOG("[nvn] frame step: time a late frame lost is not paid back, the game slows by it instead (DM_FPS_PAYBACK)");
+    }
+    return p;
 }
 // Once per present, before this frame's period is taken: the time since the previous frame's start (shown) and the frame's cost decide this frame's hold and the next frame's step.
 // Cost = max(CPU: the time between the frames' starts without the pacing wait, GPU: the latest finished frame's GPU time), in vsyncs
@@ -2657,6 +2670,7 @@
     // A probe's grace lasts while its frames keep getting cheaper (nvn_fstep.h FSTEP_RAMP): macOS raises the GPU clock for the shorter deadline over seconds, not the iPhone's 30 frames
     // (Breath of the Wild on an M5 Pro: the probe's 33 frames took the clock 338 → 432 MHz and its GPU time 24.8 → 18.5 ms, then it failed at 22 ms frames; hold 1 needed about 560 MHz)
     g_fs.ramp = mtl_probe_ramp_on();
+    g_fs.nopay = !fstep_payback();
     g_fs.per_vsync = fstep_hz() / 60;
     g_fs.smax = dm_fps_step_max;   // the stub's largest step (Mario Kart World: 2): frames held longer than the game steps would play in slow motion
     g_fs.no_payback = fps_high();   // at 120 fps the game steps by its target, not by the step: a late frame is slow motion, so three raise the hold whatever the average
--- a/dm/gfx/nvn/nvn_fstep.h
+++ b/dm/gfx/nvn/nvn_fstep.h
@@ -58,6 +58,7 @@
     int kmin;                 // the last call's kmin (a lower one takes effect at once)
     double debt;              // real time the game is behind, in vsyncs
     int late_run, fit_run, trial;   // late frames in a row; frames in a row whose cost fits k − 1; frames left of a trial at k − 1 (0 = none)
+    int nopay;                // set by the caller (kept): 1 = real time a late frame lost is not paid back (DM_FPS_PAYBACK=off): the step stays k and the time is counted as dropped
     int probe, grace;         // 1: the trial in progress is a probe; 2: a probe held and its run at kmin has not ended yet; frames left of the probe's grace
     int ramp;                 // set by the caller (kept): 1 = a probe's grace is renewed while its frames keep getting cheaper (FSTEP_RAMP; the host's DM_FSTEP_PROBE_RAMP)
     double pa, pb; int plate, ptotal;   // the current grace window: the cost of its first and second halves (sums), its late frames; grace frames this probe has taken in all
@@ -179,6 +180,7 @@
     else if ((slow || nvn_fstep_same(s)) && s->k > kmin && s->since >= s->hold && !s->trial) {   // probe: straight to kmin, so the controller sees the whole deadline
         s->k = kmin; s->downs++; s->probes++; s->trial = FSTEP_RUN; s->probe = 1; s->grace = FSTEP_GRACE; s->fit_run = s->late_run = 0; s->pa = s->pb = 0; s->plate = s->ptotal = 0;
     }
+    if (s->nopay && s->debt > 0) { s->dropped += s->debt; s->debt = 0; }   // no payback: the time lost is let go at once, as a console game slows down
     s->step = s->k + (s->debt >= 1 && s->k < smax);
     s->paid += s->step > s->k;
     return s->step;
