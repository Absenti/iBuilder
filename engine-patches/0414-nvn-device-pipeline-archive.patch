+static int s_off(const char *dir) {
+    setenv("DM_PSO_BINARY_ARCHIVE", "0", 1);
+    if (!setup(dir, 0)) return 1;
+    setenv("DM_PSO_BINARY_ARCHIVE", "0", 1);
