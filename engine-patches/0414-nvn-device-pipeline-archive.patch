+    RUN(1, "--write", d8.UTF8String, "quit"); RUN(1, "--guard", d8.UTF8String);                                                         // H1: the memory guard
+    RUN(1, "--background", d9.UTF8String);                                                                                               // M2
+    RUN(1, "--write", d10.UTF8String, "quit"); RUN(1, "--failrun", d10.UTF8String, "0"); RUN(1, "--failrun", d10.UTF8String, "0");        // M3: two runs end on failed writes,
+    RUN(1, "--failrun", d10.UTF8String, "1");                                                                                            //     the third starts empty
