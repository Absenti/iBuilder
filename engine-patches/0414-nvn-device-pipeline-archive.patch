+// L2 (review): g_dva_state is published after the queue, the waiting list and the archive; a thread that reads 1 must see them. Eight threads start the archive at once; each one that gets 1
+// back checks what 1 promises (acquire / release), the type is asserted at compile time
+_Static_assert(__builtin_types_compatible_p(__typeof__(g_dva_state), _Atomic int), "g_dva_state must stay _Atomic (engine-patches/0414, review L2)");
+static _Atomic int g_race_ready, g_race_go, g_race_on, g_race_torn;
+static void *race_thread(void *p) {
+    (void)p; atomic_fetch_add(&g_race_ready, 1); while (!atomic_load(&g_race_go)) {}   // macOS has no pthread_barrier: a spin start
+    if (dva_on()) {
+        atomic_fetch_add(&g_race_on, 1);
+        if (!g_dva_q || !g_dva_pend || !g_dva_since || !g_dva_saves || !g_dva_ar || !g_dva_path || !g_dva_hdr_path || !g_dva_hdr || !g_dva_cap) atomic_fetch_add(&g_race_torn, 1);
+    }
+    return NULL;
+}
+static int s_race(const char *dir) {
+    if (!setup(dir, 0)) return 1;
+    enum { N = 8 }; pthread_t th[N];
+    for (int i = 0; i < N; i++) pthread_create(&th[i], NULL, race_thread, NULL);
+    while (atomic_load(&g_race_ready) < N) usleep(100);
+    atomic_store(&g_race_go, 1);
+    for (int i = 0; i < N; i++) pthread_join(th[i], NULL);
+    EXPECT("race: every thread got the archive", N, atomic_load(&g_race_on)); EXPECT("race: none saw the state before its objects", 0, atomic_load(&g_race_torn));
+    EXPECT("race: state 1", 1, DVA_ST()); EXPECT("race: opened once", 1, (int)[log_since() componentsSeparatedByString:@"pipeline binary archive (engine-patches/0414)"].count - 1);
+    return finish("the init race (L2)");
+}
+static int s_dropped(const char *dir, const char *needle) {   // a file the start must not use
+    if (!setup(dir, 0)) return 1;
+    EXPECT("drop: on", 1, dva_on()); NSString *log = log_since(); show(log);
+    checks++; if ([log rangeOfString:@(needle)].location == NSNotFound) { failed++; printf("FAIL drop: no \"%s\" in the log\n", needle); }
+    EXPECT("drop: pipelines built all the same", 5, build_five()); EXPECT("drop: none taken from it", 0, atomic_load(&g_dva_hits));
+    return finish("a file not for this host");
+}
