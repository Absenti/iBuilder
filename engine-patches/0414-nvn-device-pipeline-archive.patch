+    if (!mkdtemp(tmpl)) { perror("mkdtemp"); return 1; }
+    NSString *root = @(tmpl); NSFileManager *fm = NSFileManager.defaultManager; int bad = 0, runs = 0;
+    NSString *(^dir)(NSString *) = ^NSString *(NSString *n) { NSString *d = [root stringByAppendingPathComponent:n]; [fm createDirectoryAtPath:d withIntermediateDirectories:YES attributes:nil error:nil]; return d; };
+    #define RUN(want_exit0, ...) do { const char *a_[] = {__VA_ARGS__, NULL}; int st_ = run(argv[0], a_); runs++; \
+        int ok_ = want_exit0 ? (WIFEXITED(st_) && !WEXITSTATUS(st_)) : (WIFSIGNALED(st_) && WTERMSIG(st_) == SIGKILL); \
+        if (!ok_) { bad++; printf("FAIL session %s %s: status 0x%x\n", a_[0], a_[2] ? a_[2] : "", st_); } } while (0)
+    NSString *d1 = dir(@"quit"), *d2 = dir(@"term"), *d3 = dir(@"suspend"), *d4 = dir(@"policy"), *d5 = dir(@"mtl4"), *d6 = dir(@"off");
+    RUN(1, "--write", d1.UTF8String, "quit"); RUN(1, "--read", d1.UTF8String);                 // quit, then the next start takes them
+    RUN(1, "--write", d2.UTF8String, "term"); RUN(1, "--read", d2.UTF8String);                 // SIGTERM's graceful exit (_exit), then the next start
+    RUN(0, "--write", d3.UTF8String, "suspend-kill"); RUN(1, "--read", d3.UTF8String);         // background, then killed: the next start
