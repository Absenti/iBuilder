+static int run(const char *exe, const char *const *args) {   // a session; 0 when it passed
+    char *argv[8] = {(char *)exe}; int n = 1; for (; args[n - 1] && n < 7; n++) argv[n] = (char *)args[n - 1]; argv[n] = NULL;
+    pid_t pid; if (posix_spawn(&pid, exe, NULL, NULL, argv, environ)) return -1;
+    int st = 0; waitpid(pid, &st, 0);
+    return st;
+}
