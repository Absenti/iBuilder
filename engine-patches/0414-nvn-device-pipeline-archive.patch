+}
+static int s_caps(const char *dir, int count, int expect_open) {   // H1: the pipeline count cap (DM_PSO_ARCHIVE_COUNT): never past it; a file past it is deleted unopened
+    char c[16]; snprintf(c, sizeof c, "%d", count); setenv("DM_PSO_ARCHIVE_COUNT", c, 1);
+    if (!setup(dir, 0)) return 1;
+    EXPECT("caps: on", 1, dva_on()); NSString *log = log_since(); show(log);
+    if (expect_open == 2) {   // a file of 3 pipelines, a cap of 2: deleted unopened, a new archive
+        EXPECT_LOG("caps: the file past the cap is deleted unopened", log, "past the caps");
+        EXPECT_LOG("caps: then a new one", log, "(new)");
+        return finish("count cap below the file");
+    }
+    EXPECT("caps: five built", 5, build_five());
+    EXPECT("caps: hits", expect_open ? 3 : 0, atomic_load(&g_dva_hits));
+    mtl_arch_save(MTL_QUIT_ARCH_MS, 1); log = log_since(); show(log);
+    EXPECT("caps: never more than the cap in the archive", count, atomic_load(&g_dva_count));
+    NSString *h = [NSString stringWithContentsOfFile:g_dva_hdr_path encoding:NSUTF8StringEncoding error:nil];
+    NSString *want = [NSString stringWithFormat:@"pipelines=%d\n", count]; EXPECT("caps: the .hdr keeps the count", 1, [h containsString:want]);
+    if (!expect_open) EXPECT("caps: the two past the cap were not offered", 2, atomic_load(&g_dva_dropped));
+    // the size cap: a written file at its cap leaves no room (dva_fits)
+    os_unfair_lock_lock(&g_dva_lk); uint64_t cap0 = g_dva_cap; g_dva_cap = atomic_load(&g_dva_size); g_dva_count_cap = 100000; int fits = dva_fits(); g_dva_cap = cap0; os_unfair_lock_unlock(&g_dva_lk);
+    EXPECT("caps: a file at the size cap takes nothing more", 0, fits);
+    return finish(expect_open ? "count cap, reopened" : "count cap");
+}
+static int g_av_calls; static uint64_t av_drop_hook(void) { return g_av_calls++ ? 700ull << 20 : 1000ull << 20; }   // 1000 MB before the open, 700 MB after
+static int s_guard(const char *dir) {   // H1: an open that costs more than DM_PSO_ARCHIVE_GUARD_MB turns the archive off and deletes the file
+    if (!setup(dir, 0)) return 1;
+    g_dva_avail = av_drop_hook;
+    EXPECT("guard: off", 0, dva_on()); NSString *log = log_since(); show(log);
+    EXPECT_LOG("guard: the open is measured", log, "available memory 1000 MB before, 700 MB after");
+    EXPECT_LOG("guard: and turned off", log, "opening it took 300 MB of available memory, over DM_PSO_ARCHIVE_GUARD_MB 150: the file is deleted");
+    EXPECT("guard: the file is deleted", 0, [NSFileManager.defaultManager fileExistsAtPath:apath(dir)]);
+    NSError *e = nil; EXPECT("guard: drawing goes on", 1, dev_rps(rdesc(0), &e) != nil);
+    return finish("memory guard at the open");
+}
+static int g_bg_begins, g_bg_ends; static NSUInteger g_bg_last; static uint64_t g_bg_wr_at_begin;
+static NSUInteger bg_begin_hook(void) { g_bg_begins++; g_bg_wr_at_begin = atomic_load(&g_dva_wr); return 77; }
+static void bg_end_hook(NSUInteger t) { g_bg_ends++; g_bg_last = t; }
+static int s_background(const char *dir) {   // M2: going to the background: a background task, what is added is written first, then the waiting ones added and written
+    if (!setup(dir, 0)) return 1;
+    g_dva_manual = 1; g_dva_bg_begin = bg_begin_hook; g_dva_bg_end = bg_end_hook;
+    EXPECT("bg: on", 1, dva_on()); NSError *e = nil; unsigned pend = 0;
+    for (int i = 0; i < 2; i++) EXPECT("bg: built", 1, dev_rps(rdesc(i), &e) != nil);
+    tick(); EXPECT("bg: two added", 2, set_counts(&pend));
+    for (int i = 2; i < 5; i++) EXPECT("bg: built", 1, dev_rps(rdesc(i), &e) != nil);
+    set_counts(&pend); EXPECT("bg: three wait", 3, pend); (void)log_since();
+    mtl_arch_save(0, 0);   // dm_gfx_suspend(1)'s call
+    EXPECT("bg: the save is done", 0, dispatch_group_wait(g_dva_saves, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC)));
+    show(log_since());
+    EXPECT("bg: one background task begun", 1, g_bg_begins); EXPECT("bg: and ended, the same", 1, g_bg_ends == 1 && g_bg_last == 77);
+    EXPECT("bg: two writes: what was added first, then the rest", 2, atomic_load(&g_dva_wr)); EXPECT("bg: all five in it", 5, atomic_load(&g_dva_count));
+    set_counts(&pend); EXPECT("bg: nothing waits", 0, pend);
+    return finish("background save");
+}
+static int s_failrun(const char *dir, int expect_fresh) {   // M3: runs that end on a failed write are counted; after DVA_FAIL_SESSIONS the next start begins empty
+    if (!setup(dir, 0)) return 1;
+    g_dva_manual = 1;
+    EXPECT("failrun: on", 1, dva_on()); NSString *log = log_since(); show(log);
+    if (expect_fresh) { EXPECT_LOG("failrun: started again empty", log, "runs ended on a failed write of"); EXPECT_LOG("failrun: new", log, "(new)"); return finish("after runs ending on failed writes"); }
+    NSError *e = nil; unsigned pend = 0; EXPECT("failrun: five built", 5, build_five()); tick(); set_counts(&pend);
+    if (!atomic_load(&g_dva_wr) && ![NSFileManager.defaultManager fileExistsAtPath:g_dva_path]) dispatch_sync(g_dva_q, ^{ dva_write(1); });   // a good file first
+    EXPECT("failrun: one more", 1, dev_rps(rdesc(9), &e) != nil); tick();
+    g_dva_fail_next = 1; dispatch_sync(g_dva_q, ^{ dva_write(1); }); show(log_since());
