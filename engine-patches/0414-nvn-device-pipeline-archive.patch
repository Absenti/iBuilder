# nvn/pso: the MTLDevice path's pipeline archive in the engine: render, compute and mesh pipelines, no adds dropped for heat, written at every end, survives a failed write
#
# Origin:  written in this repository after the Ocarina of Time (Switch 2) device session of 2026-11-20 (iPhone 15 Pro). It takes over the role of iOSBuilder's paches/0009 (a host-level
#          patch load/prebuild_loadable.sh applies to a copy of nvn_mtl.m after 0007 and 0008): same file, same switches, the defects below fixed. No upstream commit. Applies after 0413
#          (patch -p1 --forward, no fuzz). paches/0007, 0008, 0009 still apply on top of it and land exactly where they did; 0009's code is then compiled but never reached (below).
# Licence: the licence of the tree it patches (the engine's MIT licence, Copyright (c) 2026 seedds and contributors).
#
# CLAIM CHECKED ("the pipeline archive gives 0 hits because arch_sweep deletes the files whose pipelines no lookup took, on the premise that the lists asked for every pipeline")
#   REFUTED for this device. "archive lookups found 0 / 0.0 ms, found none 0 / 0.0 ms" counts the Metal 4 archive (arch_lookup), which iOS does not run: pso4_on() is 0 there unless
#   DM_PSO_MTL4=1 or the profile's pso_mtl4 (the log: "render pipelines through the MTLDevice (iOS: DM_PSO_MTL4=1 ... turns on the Metal 4 bases, the pipeline archive ..."), so
#   pso4_init returns before opening anything, g_arch_use is empty and arch_sweep returns at its first test; "found none 0" shows that no lookup was even tried. 0412 already keeps the
#   sweep until the tail has asked for every line (warm_finish_ex(0, ..) after a head). The archive iOS does use is paches/0009's MTLBinaryArchive; the device log shows why it kept
#   nothing:
#   * session 1 ended by SIGTERM about 90 s after its start, before 0009's first timed write (60 s after the archive opened at the first present, t = 56.8 s); the graceful exit
#     (hle_lifecycle.c) ends with _exit(0), which skips 0009's end-of-run write (an atexit handler), and dm_gfx_quit_begin / dm_gfx_quit write only the Metal 4 archive
#     (mtl_arch_save returns at once without g_arch_cap): no file, so session 2 started "(new)";
#   * session 2: "written, 3.3 MB: 4 pipelines taken from it, 472 built, 24 added, 451 dropped (queue full or too hot)": 0009 drops every batch at thermal Serious or worse and every
#     descriptor beyond 48 waiting, and the session ran at thermal state 2 for its first 1,150 s (on-screen lines "thermal 2" up to frame 4200);
#   * then "[RED] pipeline binary archive: off for this run (Failed to generate machO: ... missing 'vertex' stage in pipeline no. '32')": the third write failed although the second
#     (40 pipelines) had been written, and 0009 turns itself off for the rest of the run;
#   * mesh pipelines (dev_mps) are never archived: 57 mesh pipelines took 92.1 s on the submit thread in session 2 (37 of them, 50.0 s, in frame 4342). Compute pipelines did: 136 built,
#     196.4 s, the first 11 of them 117.5 s (frame 270: "new pipelines 12 ... 117714.1 ms").
#   Of the session's 930 s of compiles in frames (the [longframe] lines), 580 s were pipelines, the part an archive can save (the 350 s of libraries are Metal's compile cache's).
#
# WHAT IT CHANGES (DM_PSO_BINARY_ARCHIVE: on unless 0 / off, as 0009's; only where pso4_on() is 0: iOS, or the Mac with DM_PSO_MTL4=0; a folder from DM_PSO_BINARY_DIR or DM_SAVE)
#   * dva_rps / dva_cps / dva_mps after dev_lib, and three #defines that make every later call of dev_rps / dev_cps / dev_mps go through them: a lookup in the archive first
#     (binaryArchives + MTLPipelineOptionFailOnBinaryArchiveMiss; a miss or a busy archive is the compile made before), then the compile and an offer. paches/0009's dev_* above the
#     #defines are not called any more, so its pa_on never runs: one archive, one writer. Same file <folder>/pipelines-<chain>-<gpu>.mtlarchive and .hdr (now "iBuilderPSO2" with the
#     kern.osversion build too: an 0009 file is dropped once, as any new host build's was), DM_PSO_ARCHIVE_SECS (60); DM_PSO_ARCHIVE_MB now 24 by default (was 256: see REVISION 2).
#   * Heat holds adds back, never drops them: below thermal Serious every waiting descriptor is added at the 2 s tick, at Serious DVA_HOT_BATCH (8) a tick, at Critical or below 400 MiB
#     available none (they wait, ticks every 10 s). At most DVA_PENDING_MAX (512) wait; more are dropped (they come again at the next start). One add per write-lock hold.
#   * Mesh pipelines: addMeshRenderPipelineFunctionsWithDescriptor and the mesh descriptor's binaryArchives (iOS 18 / macOS 15; the host's minimum is iOS 26).
#   * Writes: DM_PSO_ARCHIVE_SECS after the last, or the file's size at 512 KB/s when longer (every write rewrites the file: a 100 MB file every 200 s), plus at every end the host
#     controls, through mtl_arch_save, the call the Metal 4 archive already had: dm_gfx_suspend(1) (the app's DidEnterBackground, app patch 0030), dm_gfx_quit_begin and dm_gfx_quit
#     (the graceful exit, waiting up to DM_QUIT_ARCH_MS), atexit, and the DidEnterBackground notification itself. An end first adds what waits, whatever the heat, within
#     DVA_BG_ADD_MS (4 s) or half of the wait. Written to .tmp and renamed, under the host's serialization gate (ser_begin), as 0009 did.
#   * A failed write: the archive goes on from its last written file (newBinaryArchiveWithDescriptor on it); what was added since is lost and built again when drawn; off after
#     DVA_FAIL_MAX (3) failures in a run. Any other failure turns it off for the run, as before. It is a cache, never a condition of drawing.
#   * Log: "pipeline binary archive (engine-patches/0414): <file>, X MB of the 256 MB cap ...", "written, X MB in T ms: H taken from it, B built, A added, W waiting, D dropped
#     (queue full), K adds held back for heat or memory", "at exit: written in T ms (...)", "[RED] ... the write failed (...); it goes on from its last written file".
#
# MEASURED on this Mac (M1 Pro, macOS 27.3; an MTLBinaryArchive probe first: render, rasterization-off, compute and mesh pipelines added, serialized, and all four found by a SECOND
#   process with FailOnBinaryArchiveMiss): dm/gfx/tests t_pso_binary_archive, 11 sessions (processes), 0 failed: a session that quits, one that ends by SIGTERM's graceful exit
#   (_exit), and one that goes to the background (dm_gfx_suspend(1)) and is then killed with SIGKILL each leave a file from which the next process takes all five pipelines (two render,
#   a rasterization-off one, a compute, a mesh) and builds the one it never saw; a header for another host build is dropped, an unreadable file started again; Critical / low memory
#   add none, Serious 8 a tick, nominal the rest, nothing dropped for heat; the 512 cap; a failed write goes on from the last file (a pipeline written before is still found, the one
#   added since is built again), off after 3; the Metal 4 path and DM_PSO_BINARY_ARCHIVE=0 do not use it. The engine's other tests unchanged (see the section of docs/ENGINE-UPDATE.md).
#   Mutations (target/agent-work/eng/tools/mutate.py): nothing added at Serious, an end that does not add what waits, and off at the first failed write each fail sessions.
#   NOT reproduced on the Mac: the device's "missing 'vertex' stage" write failure (the rasterization-off pipeline is archived and found here); the recovery is what was tested.
# NOT VERIFIED (iPhone only): hits in a second session on the phone, the time a lookup and an add take there, a write's time for a large file, whether iOS's write failure comes back
#   after a reopen, frame time while adds run at Serious, flash wear.
# REVISION 2 (2026-11-21, after the read-only review target/agent-work/review-eng/REVIEW.txt, findings H1, M1, M2, M3, L1):
#   * H1 (HIGH): opening an MTLBinaryArchive costs a phys_footprint that grows with the SQUARE of the file and is not given back (the review's probe on this Mac: 22.8 MB / 400 pipelines
#     +46 MB, 68.6 MB / 1,200 +367 MB, 103 MB / 1,800 +843 MB; Ocarina already ended a session at 4.2 GB). Now: DM_PSO_ARCHIVE_MB 24 by default (1..4096), DM_PSO_ARCHIVE_COUNT 400
#     pipelines by default (1..100000, the count kept in the .hdr's "pipelines=" line); dva_add never grows the archive past either (the size at the file's bytes per pipeline so far),
#     an offer past the count is dropped, a file past either cap (or of unknown count: an archive of revision 1) is DELETED UNOPENED; the open is measured with
#     os_proc_available_memory() before and after (one log line on iOS) and a drop past DM_PSO_ARCHIVE_GUARD_MB (150 by default, 0 = no guard) turns the archive off for the run and
#     deletes the file ("opening it took X MB of available memory, over DM_PSO_ARCHIVE_GUARD_MB ...: the file is deleted"), so the next start does not pay it again.
#   * M1: a lookup that finds an add holding the lock waits for it up to DVA_LOOKUP_WAIT_US (30 ms; a compile costs far more), one that finds a write (g_dva_writing) misses at once;
#     dva_tick spaces its adds by DVA_ADD_GAP_US (1 ms). Counters "lookups waited for an add" / "missed it busy" in the exit line.
#   * M2: going to the background (mtl_arch_save(0, 0)): inside a UIApplication background task (beginBackgroundTaskWithName / endBackgroundTask, found at run time with
#     NSClassFromString: no UIKit link; none on the Mac), what is already added is written FIRST, then what waits is added within DVA_BG_FIRST_ADD_MS (0.5 s, was 4 s) and written again.
#     The prewarm tail is paused by dm_gfx_suspend(1) before (engine-patches/0415), so the write is not beside its compiles.
#   * M3: the descriptors added since the last good write are put back at the front of the waiting list when a write fails (they were lost for the run); a run whose last write
#     failed is counted in <archive>.fail (removed by a good write), and after DVA_FAIL_SESSIONS (2) such runs in a row the next start deletes the archive and begins empty.
#   * L1: DM_PSO_ARCHIVE_MB, _SECS (1..86400), _COUNT, _GUARD_MB are bounded whole numbers (one log line for a bad value): no shift or multiplication overflows.
#   MEASURED (this Mac): t_pso_binary_archive 21 sessions (processes), 0 failed: the 11 of revision 1, plus the count cap (3 kept of 5, the .hdr says 3, a reopen takes the 3, a cap of
#   2 deletes the file unopened), the memory guard (a test hook: 1000 MB before the open, 700 after -> off, file deleted), the background save (one task begun and ended, two writes:
#   the 2 added first, then the 3 waiting), M1 (a lookup waits through a 10 ms add and hits, gives up after ~30 ms on a 200 ms one, misses at once during a write), M3 (the pipeline
#   added since a failed write is queued again and found once re-added; two runs ending on failed writes, then the third starts empty). NOT VERIFIED on an iPhone: the footprint of an
#   open there, the background task's time, whether the "missing 'vertex' stage" failure comes back.
# RISKS: every MTLDevice pipeline (the host's own blits and kernels too, as with 0009) is looked up first; a write holds new compiles back for its length (ser_begin, as 0009's did);
#   a small cap keeps fewer pipelines (400 of this game's ~8,300: the ones built first, i.e. drawn first; raise DM_PSO_ARCHIVE_COUNT / _MB only after measuring the open on the phone). A later revision of paches/0009 that hooks elsewhere than dev_rps / dev_cps could run beside this one: check its pa_on.
# Roll back: DM_PSO_BINARY_ARCHIVE=0 turns it off (no archive at all, 0009's included); removing this file brings 0009's archive back.

# REVISION 3 (2026-11-21, review L2, engine-patches/0414 only): g_dva_state is an _Atomic int, written with release and read with acquire (DVA_ST / DVA_ST_SET). The double-checked
#   init published state 1 after the queue, the waiting list and the archive with a plain int: on ARM64 another thread could see 1 before them (one window, once per process).
#   Test: t_pso_binary_archive session --race (8 threads start the archive together: each that gets 1 sees every object; a compile-time check that the type stays atomic). 22 sessions now.

--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -157,6 +157,390 @@
 static id<MTLLibrary> dev_lib(NSString *source, NSError **out) {
     plain_compile_begin(); NSError *e = nil; id lib = [g_dev newLibraryWithSource:source options:nil error:&e]; return compile_done(lib, e, out);
 }
+// ---- engine-patches/0414: the pipeline archive of the MTLDevice path, in the engine (DM_PSO_BINARY_ARCHIVE) ----
+// On iOS the render, compute and mesh pipelines are built through the MTLDevice (pso4_on() is 0 there: no Metal 4 bases, so no arch_* archive, no compaction, no sweep) and were compiled
+// again at every start but for the per-game MTLBinaryArchive iOSBuilder's paches/0009 adds to a copy of this file. That archive kept almost nothing on the phone: Ocarina of Time, iPhone
+// 15 Pro, 2026-11-20 (the device log): the first session (ended by SIGTERM: the graceful exit ends with _exit, which skips 0009's only write at the end, an atexit handler) left no file, so
+// the second one started "(new)"; there 451 of the 472 pipelines built were "dropped (queue full or too hot)" (0009 drops every batch at thermal Serious, and the session ran at Serious for
+// its first 1,150 s, and drops beyond 48 waiting), then a write failed ("Failed to generate machO ... missing 'vertex' stage in pipeline no. '32'") and 0009 turned itself off for the run;
+// mesh pipelines (dev_mps) were never archived; 930 s of the session's frames went to compiles on the submit thread, 580 s of them pipelines. This keeps the same file
+// (<game folder>/pipelines-<chain>-<gpu>.mtlarchive, the folder of DM_SAVE or DM_PSO_BINARY_DIR, a .hdr beside it naming the host build, chain, OS build and GPU) with these changes:
+//  * adds are never dropped for heat: at thermal Serious at most DVA_HOT_BATCH a tick (2 s), at Critical or below 400 MiB available none, the descriptors wait (up to DVA_PENDING_MAX;
+//    an add is one more compile, which the system's cache usually makes cheap); one add per write-lock hold, so a lookup misses for at most one add;
+//  * mesh pipelines too (addMeshRenderPipelineFunctionsWithDescriptor, iOS 18 / macOS 15);
+//  * written when something was added and DM_PSO_ARCHIVE_SECS (60) passed, then at most every size / 512 KB/s seconds (a 100 MB file: every 200 s, not every 60); and at every end the
+//    host controls, through mtl_arch_save: going to the background (dm_gfx_suspend(1), app patch 0030), the graceful exit (dm_gfx_quit_begin, then dm_gfx_quit waits up to
+//    DM_QUIT_ARCH_MS) and atexit, adding what waits first within half of that time;
+//  * a failed write does not turn it off: the archive goes on from its last written file (what was added since is built again when drawn); off after DVA_FAIL_MAX failures in a run.
+// The three device wrappers below take the place of dev_rps / dev_cps / dev_mps for every caller after this point (the #defines): paches/0009's code above stays compiled but is never
+// reached (its pa_on is called only from its own dev_rps / dev_cps), so the two never write the same file. DM_PSO_BINARY_ARCHIVE=0 (or off) turns this one off, as it did 0009's.
+// It is a cache, never a condition of drawing: a lookup that misses (or finds the archive busy) is the compile made before, and any failure but a write turns it off for the run.
+enum { DVA_PENDING_MAX = 512, DVA_TICK_MS = 2000, DVA_HOT_BATCH = 8, DVA_FAIL_MAX = 3, DVA_BG_ADD_MS = 4000 };
+static int pso4_on(void);
+static int ser_begin(void); static void ser_end(void);
+static uint64_t bp_now(void);
+static _Atomic int g_dva_state;   // 0 not tried, 1 on, 2 off
+// Read with acquire, written with release (review L2): a thread that sees 1 sees the queue, the waiting list and the archive that were made before it. Plain reads are seq_cst loads too; the named
+// accessors say what is meant and keep a later plain int from creeping back in (t_pso_binary_archive asserts the type)
+#define DVA_ST() atomic_load_explicit(&g_dva_state, memory_order_acquire)
+#define DVA_ST_SET(v) atomic_store_explicit(&g_dva_state, (v), memory_order_release)
+static os_unfair_lock g_dva_init_lk = OS_UNFAIR_LOCK_INIT, g_dva_lk = OS_UNFAIR_LOCK_INIT;   // g_dva_lk: the waiting list and its flags
+static pthread_rwlock_t g_dva_rw = PTHREAD_RWLOCK_INITIALIZER;   // lookups try-read (a miss while an add or the write holds it: the compile that follows is today's); adds, the write and a reopen take it
+static id<MTLBinaryArchive> g_dva_ar; static NSString *g_dva_path, *g_dva_hdr_path, *g_dva_hdr; static dispatch_queue_t g_dva_q; static dispatch_group_t g_dva_saves;   // g_dva_saves: dva_save's blocks
+static NSMutableArray<NSArray *> *g_dva_pend; static int g_dva_tick_set, g_dva_dirty, g_dva_capped, g_dva_fails; static uint64_t g_dva_cap, g_dva_last_ser_ns, g_dva_secs;
+static _Atomic uint64_t g_dva_hits, g_dva_miss, g_dva_added, g_dva_dropped, g_dva_wr, g_dva_size, g_dva_held;
+static int (*g_dva_thermal)(void);   // the thermal state (NSProcessInfoThermalState's values); tests set it, NULL: the system's
+static uint64_t (*g_dva_avail)(void);   // available memory in bytes; tests set it, NULL: os_proc_available_memory on iOS, unlimited on the Mac
+static int g_dva_fail_next;   // tests: the next write fails as a failed serialization would
+static int g_dva_manual;   // tests: no timer ticks (dva_tick runs only when the test calls it)
+// Revision 2 of 0414 (the read-only review of 2026-11-21, target/agent-work/review-eng/REVIEW.txt H1, M1-M3, L1):
+//  * H1: opening an MTLBinaryArchive costs a footprint that grows with the SQUARE of its size and is not given back when it is released (this Mac: a 68.6 MB file of 1,200 pipelines
+//    +367 MB at the open, 103 MB / 1,800 pipelines +843 MB; 22.8 MB / 400 +46 MB). So the archive is bounded by DM_PSO_ARCHIVE_MB (now 24 by default, 1..4096) AND by
+//    DM_PSO_ARCHIVE_COUNT pipelines (400 by default, 1..100000, kept in the .hdr's "pipelines=" line); it never grows past either (dva_add stops adding before), a file past either is
+//    deleted unopened, and the open is measured: os_proc_available_memory() before and after (logged on iOS); a drop past DM_PSO_ARCHIVE_GUARD_MB (150 by default, 0 = no guard) turns
+//    the archive off for the run and deletes the file: a cache must never cost the game;
+//  * M1: a lookup that finds an ADD holding the lock waits for it, up to DVA_LOOKUP_WAIT_US (a compile costs far more); one that finds a WRITE misses at once, as before; adds are spaced
+//    by DVA_ADD_GAP_US so lookups get in between;
+//  * M2: going to the background writes what is already added FIRST, then adds what waits within DVA_BG_FIRST_ADD_MS (0.5 s) and writes again, inside a UIApplication background task
+//    (beginBackgroundTaskWithName / endBackgroundTask, found at run time; the tail of the prewarm is paused by dm_gfx_suspend before, engine-patches/0415);
+//  * M3: what was added since the last good write is put back in the waiting list when a write fails; a run whose last write failed is counted in <archive>.fail, and after
+//    DVA_FAIL_SESSIONS such runs in a row the next start begins with an empty archive;
+//  * L1: DM_PSO_ARCHIVE_MB and DM_PSO_ARCHIVE_SECS (1..86400) are bounded, so no shift or multiplication overflows.
+enum { DVA_LOOKUP_WAIT_US = 30000, DVA_ADD_GAP_US = 1000, DVA_BG_FIRST_ADD_MS = 500, DVA_FAIL_SESSIONS = 2, DVA_MB_DEFAULT = 24, DVA_COUNT_DEFAULT = 400, DVA_GUARD_MB_DEFAULT = 150 };
+static uint64_t g_dva_count_cap, g_dva_guard;   // DM_PSO_ARCHIVE_COUNT (pipelines), DM_PSO_ARCHIVE_GUARD_MB (bytes; 0: no guard)
+static _Atomic uint64_t g_dva_count, g_dva_since_write;   // pipelines in the archive (the file's, from its .hdr, + those added in this run); added since the last good write
+static _Atomic int g_dva_writing;   // dva_write holds or wants g_dva_rw: a lookup misses at once
+static _Atomic uint64_t g_dva_waited, g_dva_busy;   // lookups that waited for an add and then looked; lookups that missed because the archive was being written or the wait ran out
+static NSMutableArray<NSArray *> *g_dva_since;   // the descriptors added since the last good write (g_dva_lk): back to the waiting list when a write fails (M3)
+static int g_dva_fail_runs, g_dva_fail_noted;   // runs that ended on a failed write before this one (<archive>.fail); this run's failure is counted there
+static NSUInteger (*g_dva_bg_begin)(void); static void (*g_dva_bg_end)(NSUInteger);   // tests: stand-ins for the background task (NULL: UIApplication's, on iOS)
+static uint64_t dva_env_u(const char *name, uint64_t dflt, uint64_t lo, uint64_t hi) {   // a whole number in [lo, hi], else the default (one line says so)
+    const char *e = getenv(name); if (!e || !*e) return dflt;
+    char *end = NULL; unsigned long long v = strtoull(e, &end, 10);
+    if (end == e || *end || v < lo || v > hi) { MLOG("%s=%s is not a whole number from %llu to %llu: %llu is used", name, e, (unsigned long long)lo, (unsigned long long)hi, (unsigned long long)dflt); return dflt; }
+    return v;
+}
+#if TARGET_OS_IPHONE
+static NSUInteger dva_bg_begin_ui(void) {   // a UIApplication background task, so iOS lets the write finish before it suspends the process; 0: none
+    Class c = NSClassFromString(@"UIApplication"); if (!c || ![c respondsToSelector:@selector(sharedApplication)]) return 0;
+    id app = ((id (*)(id, SEL))objc_msgSend)(c, @selector(sharedApplication)); SEL b = NSSelectorFromString(@"beginBackgroundTaskWithName:expirationHandler:");
+    if (!app || ![app respondsToSelector:b]) return 0;
+    __block NSUInteger tid = 0; __block _Atomic int ended = 0;
+    tid = ((NSUInteger (*)(id, SEL, NSString *, void (^)(void)))objc_msgSend)(app, b, @"dm.nvn.pipeline-archive", ^{   // the time ran out: end it (the .tmp of a cut write is left, removed at the next start)
+        if (!atomic_exchange(&ended, 1)) ((void (*)(id, SEL, NSUInteger))objc_msgSend)(app, NSSelectorFromString(@"endBackgroundTask:"), tid); });
+    return tid;
+}
+static void dva_bg_end_ui(NSUInteger tid) {
+    if (!tid) return; Class c = NSClassFromString(@"UIApplication"); id app = c ? ((id (*)(id, SEL))objc_msgSend)(c, @selector(sharedApplication)) : nil;
+    if (app) ((void (*)(id, SEL, NSUInteger))objc_msgSend)(app, NSSelectorFromString(@"endBackgroundTask:"), tid);
+}
+#endif
+static NSUInteger dva_bg_begin(void) {
+    if (g_dva_bg_begin) return g_dva_bg_begin();
+#if TARGET_OS_IPHONE
+    return dva_bg_begin_ui();
+#else
+    return 0;
+#endif
+}
+static void dva_bg_end(NSUInteger tid) {
+    if (g_dva_bg_end) { g_dva_bg_end(tid); return; }
+#if TARGET_OS_IPHONE
+    dva_bg_end_ui(tid);
+#else
+    (void)tid;
+#endif
+}
+static int dva_thermal(void) { return g_dva_thermal ? g_dva_thermal() : (int)NSProcessInfo.processInfo.thermalState; }
+static uint64_t dva_avail(void) {
+    if (g_dva_avail) return g_dva_avail();
+#if TARGET_OS_IPHONE
+    return (uint64_t)os_proc_available_memory();
+#else
+    return UINT64_MAX;
+#endif
+}
+static void dva_off(const char *why) { if (DVA_ST() != 2) { DVA_ST_SET(2); MLOG("[RED] pipeline binary archive: off for this run (%s); pipelines are built as without it", why); } }
+static NSString *dva_header(NSString *gpu) {   // what the binaries are valid for: another host build, chain, OS build or GPU makes Metal refuse or ignore them
+    char b[64] = ""; size_t n = sizeof b; sysctlbyname("kern.osversion", b, &n, NULL, 0);
+    return [NSString stringWithFormat:@"iBuilderPSO2\nhost=%s %s\nchain=%s\nos=%@ (%s)\ngpu=%@\n", __DATE__, __TIME__, DMSH_CHAIN, NSProcessInfo.processInfo.operatingSystemVersionString, b, gpu];
+}
+static uint64_t dva_file_size(NSString *p) { struct stat st; return p && !stat(p.fileSystemRepresentation, &st) ? (uint64_t)st.st_size : 0; }
+static NSString *dva_hdr_text(void) { return [g_dva_hdr stringByAppendingFormat:@"pipelines=%llu\n", (unsigned long long)atomic_load(&g_dva_count)]; }   // the identity, then the pipeline count
+static int dva_hdr_read(NSString *have, uint64_t *count) {   // 1 when the .hdr's identity is this run's; *count: its pipelines= line (0 without one)
+    if (!have) return 0; NSMutableString *id_ = [NSMutableString string]; *count = 0;
+    for (NSString *l in [have componentsSeparatedByString:@"\n"]) { if (!l.length) continue; if ([l hasPrefix:@"pipelines="]) *count = strtoull([l substringFromIndex:10].UTF8String, NULL, 10); else [id_ appendFormat:@"%@\n", l]; }
+    return [id_ isEqualToString:g_dva_hdr];
+}
+static NSString *dva_fail_path(void) { return [g_dva_path stringByAppendingString:@".fail"]; }
+static void dva_drop_files(void) { NSFileManager *fm = NSFileManager.defaultManager; [fm removeItemAtPath:g_dva_path error:nil]; [fm removeItemAtPath:g_dva_hdr_path error:nil]; [fm removeItemAtPath:dva_fail_path() error:nil]; }
+static void dva_tick(void); static void dva_write(int now);
+static void dva_schedule(uint64_t ms) {   // g_dva_lk held
+    if (g_dva_tick_set || g_dva_manual) return; g_dva_tick_set = 1;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(ms * NSEC_PER_MSEC)), g_dva_q, ^{ @autoreleasepool { dva_tick(); } });
+}
