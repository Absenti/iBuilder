+int main(void) { @autoreleasepool {
+    alarm(240);   // a hang fails the run rather than the suite
+    setvbuf(stdout, NULL, _IOLBF, 0);
+    setenv("DM_PSO_ARCHIVE", "off", 1); setenv("DM_NVN_PREDICT", "0", 1); setenv("DM_PSO_PREPARE", "1", 1);
+    unsetenv("DM_NVN_HILITE"); unsetenv("DM_NVN_MAGSCAN"); unsetenv("DM_PSO_RECORD"); unsetenv("DM_PSO_USER"); unsetenv("DM_SAVE"); unsetenv("DM_PSO_PREBUILD"); unsetenv("DM_PSO_HYBRID");
+    char tmpl[1024]; snprintf(tmpl, sizeof tmpl, "%s/t_pso_head.XXXXXX", NSTemporaryDirectory().fileSystemRepresentation);
+    if (!mkdtemp(tmpl)) { perror("mkdtemp"); return 1; }
+    g_dir = @(tmpl);
+    g_logfd = open([g_dir stringByAppendingPathComponent:@"engine.log"].fileSystemRepresentation, O_RDWR | O_CREAT | O_TRUNC, 0600);
+    if (g_logfd < 0 || dup2(g_logfd, 2) < 0) { perror("log"); return 1; }
+    setenv("DM_PSO_MANIFEST", [g_dir stringByAppendingPathComponent:@"pso_manifest.tsv"].UTF8String, 1);
+    mtl_init();
+    if (!build_fixtures(g_dir) || !write_manifest()) { printf("failed to make the synthetic shader libraries and manifest\n"); [NSFileManager.defaultManager removeItemAtPath:g_dir error:nil]; return 1; }
+    pso4_init();   // the real compiler first (as warm_start does), then the counting device in front of it
+    const char *mode = g_comp4 ? "Metal 4" : "MTLDevice";
+    g_gate = [HeadGateDevice new]; g_gate->device = g_dev; g_dev = (id<MTLDevice>)g_gate;
+    calibrate();
+    const int K = 20; const long HEAD_LINES = g_lines_upto[K];   // 50 percent of 40 tasks: tasks 0..19, 5 S and 15 R: 35 lines; the tail 35 lines too
+    EXPECT("the head of 50 percent holds 35 lines", 35, HEAD_LINES);
+    EXPECT("the task after the head loads a library of its own (the gate will hold it)", 1, g_cum[K + 1] > g_cum[K]);
+    char b[200];
+
+    // ---- 1. no variable, 100, a value that is no whole number from 1 to 100, and 99 percent of 40 tasks (ceil(39.6) = 40: no tail): all the same, the step as it was
+    {
+        struct { const char *name; const char *p; int warned; } w[] = {{"unset", NULL, 0}, {"empty", "", 0}, {"100", "100", 0}, {"abc", "abc", 1}, {"0", "0", 1}, {"101", "101", 1}, {"-5", "-5", 1}, {"50.5", "50.5", 1}, {"99 (head = all 40 tasks)", "99", 0}};
+        for (unsigned i = 0; i < sizeof w / sizeof *w; i++) {
+            NSString *log = run_start((cfg){.percent = w[i].p});
+            snprintf(b, sizeof b, "PERCENT %s", w[i].name); check_whole(b, log);
+            if (w[i].warned) EXPECT_LOG(b, log, "is not a whole number from 1 to 100: ignored, every line of the prewarm lists is built before the first frame");
+            else EXPECT_NOLOG(b, log, "not a whole number");
+            if (i == 0) show_log("no variable", log);
+            if (i == 3) show_log("DM_PSO_PREPARE_PERCENT=abc", log);
+        }
+        // the tail switch alone changes nothing without a split
+        NSString *log = run_start((cfg){.tail = "0"}); check_whole("TAIL=0 without a percentage", log);
+    }
+
