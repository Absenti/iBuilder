+// How much of the prewarm lists the prepare step builds before the game's first frame (DM_PSO_PREPARE_PERCENT), and how the workers take tasks from the list. Pure C: no Metal, no
+// Objective-C, no state of its own, so dm/gfx/tests/t_warm_head.c runs it on any machine and nvn_mtl.m calls the very same functions.
+#ifndef NVN_WARM_HEAD_H
+#define NVN_WARM_HEAD_H
+#include <stdatomic.h>
+#include <stdlib.h>
+
+// The head of a list of n tasks: the first ceil(n * percent / 100) of them. percent >= 100 is all of them (the default: the prepare step builds every line, as it always did), a
+// percent under 1 counts as 1 (the env parser below never hands one over), n <= 0 is 0. Written as q * p + ceil(r * p / 100) for n = 100 q + r, which is the same number and cannot
+// overflow however large n is: r * p is at most 99 * 99, and q * p is at most n
+static inline long warm_head_count(long n, int percent) {
+    if (n <= 0) return 0;
+    if (percent >= 100) return n;
+    if (percent < 1) percent = 1;
+    long q = n / 100, r = n % 100;
+    return q * percent + (r * percent + 99) / 100;
+}
+
+// The text of DM_PSO_PREPARE_PERCENT: the whole number 1..100 (surrounding blanks and a line end are allowed: the value may come from a line of env.txt), or 0 when it is unset, empty, not
+// a whole number or out of range. The caller then builds every line before the first frame, which is what a start without the variable does
+static inline int warm_percent_parse(const char *s) {
+    if (!s) return 0;
+    while (*s == ' ' || *s == '\t') s++;
+    if (!*s) return 0;
+    char *end = NULL; long v = strtol(s, &end, 10);
+    if (end == s) return 0;
+    while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n') end++;
+    if (*end || v < 1 || v > 100) return 0;
+    return (int)v;
+}
+
+// The next task index of [.., end) a worker takes from the shared counter *next, or -1 once the counter is past end. Every index below end comes out exactly once whatever the number of
+// workers, and the counter only grows: the head's workers share one counter that starts at 0 and ends at the head's size, the tail's worker has its own that starts there and ends at n,
+// so the two ranges are [0, head) and [head, n): the whole list, nothing twice
+static inline long warm_claim_index(_Atomic long *next, long end) {
+    long i = atomic_fetch_add(next, 1);
+    return i < end ? i : -1;
+}
+#endif
