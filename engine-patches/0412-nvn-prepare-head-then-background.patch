+// DM_PSO_PREPARE_PERCENT and DM_PSO_PREPARE_TAIL (engine-patches/0412), on the real prepare step: warm_start with synthetic shader libraries and manifests, no game files, on this Mac's GPU
+// (the fixtures are compiled with the Metal toolchain, as t_pso_warm's are). What it shows:
+//  - without the variable (or with 100, or with a value that is no whole number from 1 to 100) the step is what it was: every line built before warm_start returns, the shader dictionary
+//    released, the archive's sweep allowed, no tail, none of the new log lines;
+//  - with PERCENT=p and the tail on: the first ceil(n * p / 100) tasks are built when warm_start returns (counted exactly: lines, libraries, pipelines, which tasks), the tail is held
+//    back by a gate on the device's library loads and shows as not started; once released it builds the REST, in the manifest's order, nothing twice, nothing lost, on one worker at
+//    utility QoS, and only then is the sweep allowed and the dictionary released;
+//  - with DM_PSO_PREPARE_TAIL=0 the tail is never built, nothing runs after warm_start returns, the dictionary is released and the sweep is not allowed;
+//  - mtl_warm_stop's flag (g_warm_stop) and dm_gfx_teardown, met while the tail runs, end it between two tasks with no deadlock and no use of the released dictionary;
+//  - a start that compacts the pipeline archive ignores the percentage.
+#include "../nvn/nvn_mtl.m"
+#include <fcntl.h>
+#include <unistd.h>
+
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+static int checks, failed;
+#define EXPECT(name, want, got) do { long long w_ = (long long)(want), g_ = (long long)(got); checks++; \
+    if (w_ != g_) { printf("FAIL %s: expected %lld, got %lld (line %d)\n", name, w_, g_, __LINE__); failed++; } } while (0)
+#define EXPECT_LOG(name, log, needle) do { checks++; if ([(log) rangeOfString:@needle].location == NSNotFound) { printf("FAIL %s: the log has no \"%s\"\n--- log\n%s\n---\n", name, needle, [(log) UTF8String]); failed++; } } while (0)
+#define EXPECT_NOLOG(name, log, needle) do { checks++; if ([(log) rangeOfString:@needle].location != NSNotFound) { printf("FAIL %s: the log has \"%s\"\n--- log\n%s\n---\n", name, needle, [(log) UTF8String]); failed++; } } while (0)
+
+enum { NT = 40 };   // tasks: every 4th is a shader load (S, one line), the others a pair of two pipelines (R, two lines): 10 + 30 tasks, 10 + 60 = 70 lines, 70 libraries, 60 pipelines
+static NSString *g_dir, *g_manifest;
+static int g_logfd; static off_t g_logmark;
+
+static NSString *log_since(void) {   // what the engine printed to stderr since the last call
+    off_t end = lseek(g_logfd, 0, SEEK_END); NSString *s = @"";
+    if (end > g_logmark) {
+        NSMutableData *d = [NSMutableData dataWithLength:(NSUInteger)(end - g_logmark)]; ssize_t n = pread(g_logfd, d.mutableBytes, d.length, g_logmark);
+        if (n > 0) s = [[NSString alloc] initWithBytes:d.bytes length:(NSUInteger)n encoding:NSUTF8StringEncoding] ?: @"";
+    }
+    g_logmark = end; return s;
+}
+static void show_log(const char *scenario, NSString *log) {   // the lines about the prepare step and the prewarm, for the record
+    printf("-- %s\n", scenario);
+    for (NSString *l in [log componentsSeparatedByString:@"\n"])
+        if ([l containsString:@"pipeline prepare"] || [l containsString:@"pipeline prewarm"] || [l containsString:@"DM_PSO_PREPARE"]) printf("   %s\n", [l stringByReplacingOccurrencesOfString:@"[dm] [nvn-mtl] " withString:@""].UTF8String);
+}
+
+// The device the loads go through: counts the library loads, can hold the N-th one until released (the tail's first), slows each load (a head long enough for the progress screen), and
+// records how many loads run at once and the QoS class of the thread that makes the first one and the one that is held
+@interface HeadGateDevice : NSObject {
+@public id<MTLDevice> device; dispatch_semaphore_t entered, release; _Atomic unsigned calls, inflight, max_inflight; unsigned block_at; useconds_t delay_us; _Atomic int qos_first, qos_block;
+}
+@end
+@implementation HeadGateDevice
+- (id)forwardingTargetForSelector:(SEL)selector { return device; }
+- (id<MTLLibrary>)newLibraryWithData:(dispatch_data_t)data error:(NSError **)error {
+    unsigned n = atomic_fetch_add(&calls, 1) + 1, in = atomic_fetch_add(&inflight, 1) + 1;
+    for (unsigned m = atomic_load(&max_inflight); in > m && !atomic_compare_exchange_weak(&max_inflight, &m, in);) {}
+    if (n == 1) atomic_store(&qos_first, (int)qos_class_self());
+    if (block_at && n == block_at) { atomic_store(&qos_block, (int)qos_class_self()); dispatch_semaphore_signal(entered); dispatch_semaphore_wait(release, DISPATCH_TIME_FOREVER); }
+    if (delay_us) usleep(delay_us);
+    id<MTLLibrary> lib = [device newLibraryWithData:data error:error];
+    atomic_fetch_sub(&inflight, 1);
+    return lib;
+}
+@end
+static HeadGateDevice *g_gate;
+
+static int build_fixtures(NSString *dir) {
+    NSString *source = @"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 vs(uint id [[vertex_id]]) { float2 uv = float2((id << 1) & 2, id & 2); return float4(uv * 2 - 1, 0, 1); }\n"
+        "fragment float4 fs() { return float4(0.5, 0.25, 1, 0.5); }\n";
+    NSString *metal = [dir stringByAppendingPathComponent:@"fixture.metal"], *library = [dir stringByAppendingPathComponent:@"fixture.metallib"];
+    if (![source writeToFile:metal atomically:YES encoding:NSUTF8StringEncoding error:nil]) return 0;
+    NSTask *compiler = [NSTask new]; compiler.executableURL = [NSURL fileURLWithPath:@"/usr/bin/xcrun"];
+    compiler.arguments = @[@"-sdk", @"macosx", @"metal", metal, @"-o", library];
+    NSError *error = nil;
+    if (![compiler launchAndReturnError:&error]) { printf("fixture compiler: %s\n", error.localizedDescription.UTF8String); return 0; }
+    [compiler waitUntilExit]; if (compiler.terminationStatus) return 0;
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSMutableDictionary *map = [NSMutableDictionary dictionary];
+    for (int t = 0; t < NT; t++) {
+        NSArray<NSArray *> *libs = t % 4 == 0 ? @[@[[NSString stringWithFormat:@"hs%d", t], @"vs", @"vertex"]]
+                                              : @[@[[NSString stringWithFormat:@"hv%d", t], @"vs", @"vertex"], @[[NSString stringWithFormat:@"hf%d", t], @"fs", @"pixel"]];
+        for (NSArray *l in libs) {
+            NSDictionary *reflection = @{@"chain": @DMSH_CHAIN, @"route": @"B", @"entry": l[1], @"entry_z": l[1], @"bindings": @[], @"vertex_inputs": @[]};
+            NSData *json = [NSJSONSerialization dataWithJSONObject:reflection options:0 error:nil];
+            if (![json writeToFile:[dir stringByAppendingPathComponent:[l[0] stringByAppendingString:@".json"]] atomically:YES]) return 0;
+            if (![fm copyItemAtPath:library toPath:[dir stringByAppendingPathComponent:[l[0] stringByAppendingString:@".metallib"]] error:nil]) return 0;
+            map[l[0]] = l[2];
+        }
+    }
+    g_msl_dir = dir; g_shmap = map;
+    return 1;
+}
+
+static NSString *rrow(NSString *vkey, NSString *fkey, unsigned chmask) {
+    NvShader *vs = [NvShader new], *fs = [NvShader new];
+    strcpy(vs->key, vkey.UTF8String); strcpy(fs->key, fkey.UTF8String); fs->stage = 1;
+    pso_key key = {0}; key.cfmt[0] = MTLPixelFormatRGBA8Unorm; key.samples = 1; key.chmask = chmask;
+    pso_skey sk; char hex[sizeof sk * 2 + 1]; pso_skey_from(&key, vs, fs, 0, NULL, &sk); pso_skey_hex(&sk, hex);
+    return [NSString stringWithFormat:@"R\t%s\n", hex];
+}
+static int write_manifest(void) {
+    NSMutableString *m = [NSMutableString string];
+    for (int t = 0; t < NT; t++) {
+        if (t % 4 == 0) [m appendFormat:@"S\ths%d\t0\n", t];
+        else { NSString *v = [NSString stringWithFormat:@"hv%d", t], *f = [NSString stringWithFormat:@"hf%d", t]; [m appendString:rrow(v, f, 15)]; [m appendString:rrow(v, f, 7)]; }
+    }
+    g_manifest = [g_dir stringByAppendingPathComponent:@"pso_manifest.tsv"];
+    return [m writeToFile:g_manifest atomically:YES encoding:NSUTF8StringEncoding error:nil];
+}
+
+// the engine's prewarm state as a fresh process has it (what dm_gfx_teardown resets of it)
+static void reset_warm(void) {
+    nvn_hm_clear(&g_pso, hm_rel); g_shcache = nil; g_warm_items = [NSMutableArray array]; g_warm_dict = nil; g_warm_loads = nil;
+    g_warm_started = 0; atomic_store(&g_warm_bg, 0); atomic_store(&g_warm_stop, 0); atomic_store(&g_warm_ready, 0); atomic_store(&g_warm_running, 0); atomic_store(&g_warm_done, 0);
+    atomic_store(&g_sweep_warm, 0); atomic_store(&g_sweep_pairs, 0);
+    g_warm_shaders = g_warm_rps = g_warm_mps = g_warm_cps = g_warm_skip_fz = g_warm_skip_stale = 0; g_warm_claim_shaders = g_warm_claim_rps = g_warm_claim_cps = 0;
+}
+
+static unsigned g_cum[NT + 1];   // library loads after the first i tasks, built one after another (calibration): the loads the head of k tasks makes are g_cum[k]
+static long g_lines_upto[NT + 1]; // the lines of the first i tasks
+static void calibrate(void) {
+    reset_warm(); warm_load_begin();
+    long lines = 0; NSArray<WarmTask *> *tasks = warm_parse(@[g_manifest], &lines);
+    EXPECT("the manifest makes the tasks", NT, tasks.count);
