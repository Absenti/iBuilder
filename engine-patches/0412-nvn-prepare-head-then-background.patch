+// Pure-C CPU-only tests for the prepare step's head/tail split (nvn_warm_head.h, DM_PSO_PREPARE_PERCENT): how many tasks the head holds, what the variable's text means, and that the
+// workers' claiming of task indexes partitions the list (the head is the first k tasks in order, the tail the rest, nothing lost, nothing twice). No Metal, no game, no GPU.
+#include "../nvn/nvn_warm_head.h"
+#include <limits.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+
+// the definition written in the plainest way: ceil(n * p / 100) in 128 bits, no overflow possible
+static long ref_head(long n, int p) {
+    if (n <= 0) return 0;
+    if (p < 1) p = 1;
+    if (p > 100) p = 100;
+    __int128 v = ((__int128)n * p + 99) / 100;
+    return (long)v;
+}
+
+static void head_count(void) {
+    // the default: 100 is every task, for any n, so a start without the variable (or with 100) builds exactly what it always did
+    long ns[] = {0, 1, 2, 3, 7, 99, 100, 101, 199, 200, 201, 1000, 6472, 14753, 25000, 1000000, LONG_MAX / 2, LONG_MAX - 1, LONG_MAX};
+    for (unsigned i = 0; i < sizeof ns / sizeof *ns; i++) {
+        CHECK(warm_head_count(ns[i], 100) == ns[i], "percent 100 is every task");
+        CHECK(warm_head_count(ns[i], 150) == ns[i], "percent over 100 is every task");
+        CHECK(warm_head_count(ns[i], INT_MAX) == ns[i], "INT_MAX percent is every task");
+        for (int p = 1; p <= 100; p++) CHECK(warm_head_count(ns[i], p) == ref_head(ns[i], p), "head equals ceil(n * p / 100) (128-bit reference)");
+    }
+    // n = 0: nothing, whatever the percentage
+    for (int p = -3; p <= 103; p++) CHECK(warm_head_count(0, p) == 0, "no tasks: no head");
+    CHECK(warm_head_count(-1, 50) == 0 && warm_head_count(LONG_MIN, 50) == 0, "a negative count is no tasks");
+    // exhaustive for small n: the ceiling, a head of at least one task and at most n, growing with p
+    for (long n = 1; n <= 1500; n++) {
+        long prev = 0;
+        for (int p = 1; p <= 100; p++) {
+            long h = warm_head_count(n, p);
+            CHECK(h == ref_head(n, p), "small n: ceil(n * p / 100)");
+            CHECK(h >= 1 && h <= n, "a head holds at least one task and never more than n");
+            CHECK(h >= prev, "the head never shrinks as the percentage grows");
+            prev = h;
+        }
+        CHECK(warm_head_count(n, 100) == n, "100: all");
+    }
+    // the cases of the Ocarina of Time list (14,753 lines; the tasks are fewer, and a pair's lines share one)
+    CHECK(warm_head_count(14753, 50) == 7377, "14,753 tasks at 50 percent: 7,377 (ceil of 7,376.5)");
+    CHECK(warm_head_count(10001, 50) == 5001, "odd count at 50 percent rounds up");
+    CHECK(warm_head_count(10000, 50) == 5000, "even count at 50 percent is exactly half");
+    CHECK(warm_head_count(1, 1) == 1 && warm_head_count(1, 99) == 1, "one task is always the head");
+    CHECK(warm_head_count(2, 50) == 1 && warm_head_count(3, 50) == 2, "small halves");
+    CHECK(warm_head_count(100, 1) == 1 && warm_head_count(101, 1) == 2 && warm_head_count(150, 1) == 2, "one percent rounds up");
+    // percentages below 1 count as 1 (the env parser never hands one over)
+    CHECK(warm_head_count(1000, 0) == 10 && warm_head_count(1000, -50) == 10 && warm_head_count(1000, INT_MIN) == 10, "a percentage under 1 is 1");
+    // huge n: no overflow (the product n * p alone would overflow a long from 93 quadrillion on)
+    CHECK(warm_head_count(LONG_MAX, 99) == ref_head(LONG_MAX, 99) && warm_head_count(LONG_MAX, 99) < LONG_MAX, "LONG_MAX tasks at 99 percent");
+    CHECK(warm_head_count(LONG_MAX, 50) == ref_head(LONG_MAX, 50), "LONG_MAX tasks at 50 percent");
+    CHECK(warm_head_count(LONG_MAX, 1) == ref_head(LONG_MAX, 1), "LONG_MAX tasks at 1 percent");
+    CHECK(warm_head_count(LONG_MAX - 99, 99) == ref_head(LONG_MAX - 99, 99), "near LONG_MAX, a whole number of hundreds");
+}
+
+static void percent_parse(void) {
+    CHECK(warm_percent_parse(NULL) == 0, "unset: 0, the caller builds everything");
+    CHECK(warm_percent_parse("") == 0, "empty");
+    CHECK(warm_percent_parse("   ") == 0, "blanks only");
+    CHECK(warm_percent_parse("1") == 1 && warm_percent_parse("50") == 50 && warm_percent_parse("99") == 99 && warm_percent_parse("100") == 100, "the range 1..100");
+    for (int p = 1; p <= 100; p++) { char b[8]; snprintf(b, sizeof b, "%d", p); CHECK(warm_percent_parse(b) == p, "every value 1..100 parses to itself"); }
+    CHECK(warm_percent_parse("0") == 0 && warm_percent_parse("-1") == 0 && warm_percent_parse("101") == 0 && warm_percent_parse("1000") == 0, "out of range");
+    CHECK(warm_percent_parse("-50") == 0, "negative");
+    CHECK(warm_percent_parse("abc") == 0 && warm_percent_parse("50abc") == 0 && warm_percent_parse("5 0") == 0 && warm_percent_parse("50%") == 0, "not a whole number");
+    CHECK(warm_percent_parse("50.5") == 0 && warm_percent_parse("5e1") == 0 && warm_percent_parse("0x32") == 0, "not a plain decimal");
+    CHECK(warm_percent_parse(" 50") == 50 && warm_percent_parse("50 ") == 50 && warm_percent_parse("\t50\t") == 50, "blanks around it");
+    CHECK(warm_percent_parse("50\n") == 50 && warm_percent_parse("50\r\n") == 50, "a line end (a line of env.txt)");
+    CHECK(warm_percent_parse("+50") == 50, "a plus sign (strtol's)");
+    CHECK(warm_percent_parse("99999999999999999999999999") == 0, "far out of range (strtol saturates)");
+    CHECK(warm_percent_parse("-99999999999999999999999999") == 0, "far out of range, negative");
+    CHECK(warm_percent_parse("050") == 50, "leading zeros are decimal");
+}
+
+// ---- claiming: the head's workers share one counter [0, k), the tail's worker has its own [k, n) ----
+enum { MAXN = 200000 };
+static _Atomic unsigned char g_seen[MAXN];     // how many times each index came out
+static _Atomic int g_who[MAXN];                // 1: a head worker took it, 2: the tail worker did
+typedef struct { _Atomic long *next; long end; int role; long taken; long last; int ascending; } worker;
+static void *run(void *arg) {
+    worker *w = arg; w->last = -1; w->ascending = 1;
+    for (;;) {
+        long i = warm_claim_index(w->next, w->end);
+        if (i < 0) break;
+        atomic_fetch_add(&g_seen[i], 1); atomic_store(&g_who[i], w->role);
+        if (i <= w->last) w->ascending = 0;
+        w->last = i; w->taken++;
+    }
+    return NULL;
+}
+static void partition(long n, int percent, int head_workers, int tail_concurrent) {
+    long k = warm_head_count(n, percent);
+    memset((void *)g_seen, 0, sizeof g_seen); memset((void *)g_who, 0, sizeof g_who);
+    _Atomic long head_next = 0, tail_next = k;
+    pthread_t th[16]; worker hw[16]; worker tw = {.next = &tail_next, .end = n, .role = 2};
+    for (int i = 0; i < head_workers; i++) hw[i] = (worker){.next = &head_next, .end = k, .role = 1};
+    if (tail_concurrent) {   // the tail running beside the head: the two ranges must not meet
+        pthread_t tt; pthread_create(&tt, NULL, run, &tw);
+        for (int i = 0; i < head_workers; i++) pthread_create(&th[i], NULL, run, &hw[i]);
+        for (int i = 0; i < head_workers; i++) pthread_join(th[i], NULL);
+        pthread_join(tt, NULL);
+    } else {   // as in the app: the head's workers join, then the tail's one starts
+        for (int i = 0; i < head_workers; i++) pthread_create(&th[i], NULL, run, &hw[i]);
+        for (int i = 0; i < head_workers; i++) pthread_join(th[i], NULL);
+        pthread_t tt; pthread_create(&tt, NULL, run, &tw); pthread_join(tt, NULL);
+    }
+    long head_taken = 0, lost = 0, twice = 0, wrong_side = 0;
+    for (long i = 0; i < n; i++) {
+        unsigned c = atomic_load(&g_seen[i]);
+        if (c == 0) lost++; else if (c > 1) twice++;
+        int who = atomic_load(&g_who[i]);
+        if (who == 1) head_taken++;
+        if ((i < k && who != 1) || (i >= k && who != 2)) wrong_side++;
+    }
+    for (long i = n; i < MAXN && i < n + 64; i++) if (atomic_load(&g_seen[i])) twice++;   // nothing past the end
+    long tail_taken = tw.taken, hsum = 0; int head_asc = 1;
+    for (int i = 0; i < head_workers; i++) { hsum += hw[i].taken; head_asc &= hw[i].ascending; }
+    CHECK(lost == 0, "no task lost");
+    CHECK(twice == 0, "no task built twice, none claimed past the end");
+    CHECK(wrong_side == 0, "tasks below the head's size are the head's, the rest the tail's");
+    CHECK(head_taken == k && hsum == k, "the head built exactly its first k tasks");
+    CHECK(tail_taken == n - k, "the tail built exactly the rest");
+    CHECK(head_asc && tw.ascending, "each worker takes its tasks in ascending (file) order");
+    CHECK(k + (n - k) == n, "head + tail = n");
+}
+
+static void claiming(void) {
+    // a single counter: every index once, in order, then -1 for ever, and the counter itself only grows
+    _Atomic long c = 0; long got[8]; int g = 0;
+    for (int i = 0; i < 8; i++) { long v = warm_claim_index(&c, 5); got[g++] = v; }
+    CHECK(got[0] == 0 && got[1] == 1 && got[2] == 2 && got[3] == 3 && got[4] == 4, "indexes 0..4 in order");
+    CHECK(got[5] == -1 && got[6] == -1 && got[7] == -1, "then -1 for ever");
+    c = 0; CHECK(warm_claim_index(&c, 0) == -1, "an empty range gives nothing");
+    c = 7; CHECK(warm_claim_index(&c, 7) == -1 && warm_claim_index(&c, 7) == -1 && atomic_load(&c) == 9, "a counter at its end gives nothing (and only grows)");
+    c = 3; CHECK(warm_claim_index(&c, 10) == 3, "a tail counter starts where the head ends");
+    long ns[] = {0, 1, 2, 3, 99, 100, 101, 1000, 14753, 20000};
+    int ps[] = {1, 2, 25, 33, 50, 51, 99, 100};
+    for (unsigned a = 0; a < sizeof ns / sizeof *ns; a++) for (unsigned b = 0; b < sizeof ps / sizeof *ps; b++) {
+        partition(ns[a], ps[b], 1, 0); partition(ns[a], ps[b], 8, 0); partition(ns[a], ps[b], 8, 1);
+    }
+    partition(150000, 50, 8, 0); partition(150000, 50, 16, 1);
+    partition(MAXN - 100, 37, 12, 1);
+    // percent 100 leaves no tail: every worker is a head worker and the tail's range [n, n) is empty
+    partition(5000, 100, 8, 0);
