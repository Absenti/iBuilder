+// the items are exactly those of the tasks [from, to): each S one item, each R pair two, and nothing else
+static void check_items(const char *name, NSArray<WarmItem *> *items, int from, int to) {
+    NSMutableDictionary *want = [NSMutableDictionary dictionary];
