+    EXPECT("one library per S task, two per R task", 70, g_cum[NT]);
+    EXPECT("the lines the tasks stand for add up to the lines of the lists", lines, g_lines_upto[NT]);
+    reset_warm();
+}
+
+typedef struct { const char *percent, *tail, *threads; unsigned block_at; useconds_t delay; } cfg;
+static void set_env(const char *k, const char *v) { if (v) setenv(k, v, 1); else unsetenv(k); }
+// warm_start under the environment c; the log it printed. The gate holds the library load number block_at (0: none)
+static NSString *run_start(cfg c) {
+    reset_warm(); (void)log_since();
+    set_env("DM_PSO_PREPARE_PERCENT", c.percent); set_env("DM_PSO_PREPARE_TAIL", c.tail); set_env("DM_PSO_PREPARE_THREADS", c.threads);
+    g_gate->entered = dispatch_semaphore_create(0); g_gate->release = dispatch_semaphore_create(0);
+    g_gate->block_at = c.block_at; g_gate->delay_us = c.delay; atomic_store(&g_gate->calls, 0); atomic_store(&g_gate->inflight, 0); atomic_store(&g_gate->max_inflight, 0);
+    warm_start();
+    set_env("DM_PSO_PREPARE_PERCENT", NULL); set_env("DM_PSO_PREPARE_TAIL", NULL); set_env("DM_PSO_PREPARE_THREADS", NULL);
+    return log_since();
+}
