+    NSDictionary *got = tally(items); checks++;
+    if (![got isEqualToDictionary:want]) { failed++; printf("FAIL %s: the items are not exactly the tasks [%d, %d): %lu items for %lu expected keys\n", name, from, to, (unsigned long)items.count, (unsigned long)want.count); }
