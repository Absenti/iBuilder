+static NSArray<WarmItem *> *items_now(void) {
+    os_unfair_lock_lock(&g_warm_lock); NSArray<WarmItem *> *a = [g_warm_items copy]; os_unfair_lock_unlock(&g_warm_lock); return a;
+}
+static int task_of(WarmItem *it) { return [[(it->kind == 0 ? it->key : it->vs_key) substringFromIndex:2] intValue]; }   // hs12 / hv5
+static NSDictionary<NSString *, NSNumber *> *tally(NSArray<WarmItem *> *items) {
+    NSMutableDictionary *d = [NSMutableDictionary dictionary];
+    for (WarmItem *it in items) { NSString *k = [NSString stringWithFormat:@"%d:%@", it->kind, it->kind == 0 ? it->key : it->vs_key]; d[k] = @([d[k] intValue] + 1); }
+    return d;
