+// One reading of an on / off switch for every DM_* variable that is one (engine-patches/0415, the review's L7: DM_AUDREN_RT read "on" as off, DM_PSO_PREPARE_TAIL and DM_STALL_DUMP knew
+// only "0", DM_FPS_PAYBACK "off" and "0", DM_PSO_TAIL_HOT only "1"). Pure C, no state: dm/gfx/tests/t_env_flag.c checks it.
+// 1 for 1 / on / true / yes, 0 for 0 / off / false / no (any case; blanks and a line end around it are allowed: the value may come from a line of env.txt), dflt when unset or empty;
+// anything else gives dflt and sets *bad (when bad is not NULL), so the caller can say in its log that the value was not understood
+#ifndef DM_ENVFLAG_H
+#define DM_ENVFLAG_H
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+static inline int dm_flag_text(const char *v, int dflt, int *bad) {
+    if (bad) *bad = 0;
+    if (!v) return dflt;
+    while (*v == ' ' || *v == '\t') v++;
+    size_t n = strlen(v);
+    while (n && (v[n - 1] == ' ' || v[n - 1] == '\t' || v[n - 1] == '\r' || v[n - 1] == '\n')) n--;
+    if (!n) return dflt;
+    static const char *const on[] = {"1", "on", "true", "yes"}, *const off[] = {"0", "off", "false", "no"};
+    for (int i = 0; i < 4; i++) {
+        if (strlen(on[i]) == n && !strncasecmp(v, on[i], n)) return 1;
+        if (strlen(off[i]) == n && !strncasecmp(v, off[i], n)) return 0;
+    }
+    if (bad) *bad = 1;
+    return dflt;
+}
+static inline int dm_env_flag(const char *name, int dflt, int *bad) { return dm_flag_text(getenv(name), dflt, bad); }
+// Whether v is the word w (any case, blanks and a line end around it allowed): for a switch with a third value (DM_PSO_PREPARE_TAIL=user)
+static inline int dm_flag_is(const char *v, const char *w) {
+    if (!v) return 0;
+    while (*v == ' ' || *v == '\t') v++;
+    size_t n = strlen(v);
+    while (n && (v[n - 1] == ' ' || v[n - 1] == '\t' || v[n - 1] == '\r' || v[n - 1] == '\n')) n--;
+    return n == strlen(w) && !strncasecmp(v, w, n);
+}
+#endif
