+// dm/host/dm_envflag.h (engine-patches/0415, the review's L7): one reading of on / off switches. Pure C, no GPU
+#include "../../host/dm_envflag.h"
+#include <stdio.h>
+static int checks, failed;
+#define EXPECT(name, want, got) do { long w_ = (long)(want), g_ = (long)(got); checks++; if (w_ != g_) { printf("FAIL %s: expected %ld, got %ld (line %d)\n", name, w_, g_, __LINE__); failed++; } } while (0)
+int main(void) {
+    const char *on[] = {"1", "on", "ON", "On", "true", "TRUE", "yes", "Yes", " 1", "on\n", "\ttrue \r\n"}, *off[] = {"0", "off", "OFF", "false", "False", "no", "NO", " 0 ", "off\r\n"};
+    const char *bad[] = {"2", "-1", "onn", "of", "y", "n", "enable", "1x", "o n", "00", "yes!"};
+    int b = 0;
+    for (unsigned i = 0; i < sizeof on / sizeof *on; i++) { EXPECT(on[i], 1, dm_flag_text(on[i], 0, &b)); EXPECT("on: not bad", 0, b); }
+    for (unsigned i = 0; i < sizeof off / sizeof *off; i++) { EXPECT(off[i], 0, dm_flag_text(off[i], 1, &b)); EXPECT("off: not bad", 0, b); }
+    for (unsigned i = 0; i < sizeof bad / sizeof *bad; i++) for (int d = 0; d < 2; d++) { EXPECT(bad[i], d, dm_flag_text(bad[i], d, &b)); EXPECT("bad: said", 1, b); }
+    for (int d = 0; d < 2; d++) { EXPECT("unset", d, dm_flag_text(NULL, d, &b)); EXPECT("unset: not bad", 0, b); EXPECT("empty", d, dm_flag_text("", d, &b)); EXPECT("blank", d, dm_flag_text("  \n", d, &b)); EXPECT("blank: not bad", 0, b); }
+    EXPECT("NULL bad pointer", 1, dm_flag_text("on", 0, NULL)); EXPECT("NULL bad pointer, bad value", 1, dm_flag_text("what", 1, NULL));
+    EXPECT("is user", 1, dm_flag_is("user", "user")); EXPECT("is USER", 1, dm_flag_is(" USER\n", "user")); EXPECT("is not users", 0, dm_flag_is("users", "user")); EXPECT("is not NULL", 0, dm_flag_is(NULL, "user"));
+    setenv("T_ENV_FLAG", "Off", 1); EXPECT("dm_env_flag", 0, dm_env_flag("T_ENV_FLAG", 1, &b)); unsetenv("T_ENV_FLAG"); EXPECT("dm_env_flag unset", 1, dm_env_flag("T_ENV_FLAG", 1, &b));
+    printf("t_env_flag: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+}
