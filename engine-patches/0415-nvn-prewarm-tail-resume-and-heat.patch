+// engine-patches/0415 revision 3 (review L8): the learned list's file, its "seen" set and the tail's seed index are set back when graphics are torn down, so a second game in the same
+// process writes its own pso_user.tsv. No GPU work beyond mtl_init
+#include "../nvn/nvn_mtl.m"
+#include <fcntl.h>
+#include <unistd.h>
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define EXPECT(name, want, got) do { long long w_ = (long long)(want), g_ = (long long)(got); checks++; if (w_ != g_) { printf("FAIL %s: expected %lld, got %lld (line %d)\n", name, w_, g_, __LINE__); failed++; } } while (0)
+static NSString *slurp(NSString *p) { return [NSString stringWithContentsOfFile:p encoding:NSUTF8StringEncoding error:nil] ?: @""; }
+int main(void) { @autoreleasepool {
+    char tmpl[1024]; snprintf(tmpl, sizeof tmpl, "%s/t_session_reset.XXXXXX", NSTemporaryDirectory().fileSystemRepresentation); if (!mkdtemp(tmpl)) return 1;
+    NSString *a = [@(tmpl) stringByAppendingPathComponent:@"game_a.tsv"], *b = [@(tmpl) stringByAppendingPathComponent:@"game_b.tsv"];
+    NSString *logp = [@(tmpl) stringByAppendingPathComponent:@"engine.log"]; int lfd = open(logp.fileSystemRepresentation, O_RDWR | O_CREAT | O_TRUNC, 0600); if (lfd < 0 || dup2(lfd, 2) < 0) return 1;
+    mtl_init();
+    setenv("DM_PSO_USER", a.fileSystemRepresentation, 1); unsetenv("DM_SAVE");
+    pso_user_record("row-one\n"); pso_user_record("row-one\n"); pso_user_record("row-two\n");
+    EXPECT("game A: its file has its two distinct rows", 1, [slurp(a) isEqualToString:@"row-one\nrow-two\n"]);
+    EXPECT("game A: the file is held open", 1, g_pso_user_fd >= 0); g_warm_seed_src = 3; g_warm_tail_skipped = 1;
+    // the second game: teardown of the first, then its own list
+    dm_gfx_teardown();
+    EXPECT("teardown: the file is closed", -1, g_pso_user_fd); EXPECT("teardown: asked again", 0, g_pso_user_checked); EXPECT("teardown: the seen set is gone", 1, g_pso_user_seen == nil);
+    EXPECT("teardown: the seed index is back to none", -1, g_warm_seed_src); EXPECT("teardown: the skipped flag is cleared", 0, g_warm_tail_skipped);
+    setenv("DM_PSO_USER", b.fileSystemRepresentation, 1);
+    pso_user_record("row-one\n"); pso_user_record("row-three\n");
+    EXPECT("game B: its own file has its rows, row-one included (a stale seen set would have dropped it)", 1, [slurp(b) isEqualToString:@"row-one\nrow-three\n"]);
+    EXPECT("game A's file did not receive game B's rows", 1, [slurp(a) isEqualToString:@"row-one\nrow-two\n"]);
+    [NSFileManager.defaultManager removeItemAtPath:@(tmpl) error:nil];
+    printf("t_session_reset: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
