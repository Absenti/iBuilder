+// Draft 0508: stretches of presents whose frames encoded no draw (draws replayed since the previous present = 0), with what the replay met in them: the draw records (none: the
+// game issued no draw) and the drops by reason. A stretch of 3 presents or more is logged when it ends (the first 16, then at powers of two), and one still going at 150 presents
+// is logged then too. Every 300 presents: frames with no draw encoded among them, and the drop totals
+static void drop_line(char *b, size_t n, const uint64_t *d) {   // "reason N, ..." of the non-zero counts in d
+    size_t o = 0; b[0] = 0;
+    for (int i = 0; i < DR_N && o + 80 < n; i++) if (d[i]) o += (size_t)snprintf(b + o, n - o, "%s%s %llu", o ? ", " : "", g_dr_name[i], (unsigned long long)d[i]);
+    if (!o) snprintf(b, n, "none");
+}
+static uint64_t g_st_n;   // stretches logged-or-counted so far (t_drop_reasons reads it)
+static void stretch_note(uint64_t frame_draws) {
+    static uint64_t prev_ops, prev_dr[DR_N], prev_rc[3], np, run, run_ops, run_dr[DR_N], run_rc[3], run_first, run_frame0, win_zero, win_ops0, win_dr0[DR_N];
+    static double run_t0;
+    uint64_t ops = g_draw_ops - prev_ops, d[DR_N]; prev_ops = g_draw_ops;
+    for (int i = 0; i < DR_N; i++) { d[i] = g_dr[i] - prev_dr[i]; prev_dr[i] = g_dr[i]; }
+    uint64_t rc[3]; for (int i = 0; i < 3; i++) { rc[i] = g_rc_eval[i] - prev_rc[i]; prev_rc[i] = g_rc_eval[i]; }
+    np++;
+    if (!frame_draws) {
+        if (!run) { run_first = np; run_frame0 = mtl_frame_now(); run_t0 = CACurrentMediaTime(); run_ops = 0; memset(run_dr, 0, sizeof run_dr); memset(run_rc, 0, sizeof run_rc); }
+        run++; run_ops += ops; for (int i = 0; i < DR_N; i++) run_dr[i] += d[i]; for (int i = 0; i < 3; i++) run_rc[i] += rc[i];
+        win_zero++;
     }
+    if (run && (frame_draws || run == 150)) {
+        if (run >= 3) { uint64_t k = ++g_st_n;
+            if (k <= 16 || !(k & (k - 1)) || run == 150) { char b[700]; drop_line(b, sizeof b, run_dr);
+                MLOG("[RED] %s%llu presents in a row encoded no draw (presents %llu-%llu, frames from %llu, %.2f s): draw records replayed in them %llu%s; dropped by reason: %s; render conditions true %llu / false %llu / unknown %llu (stretch #%llu)",
+                     run == 150 && !frame_draws ? "still going: " : "", (unsigned long long)run, (unsigned long long)run_first, (unsigned long long)(run_first + run - 1), (unsigned long long)run_frame0,
+                     CACurrentMediaTime() - run_t0, (unsigned long long)run_ops, run_ops ? "" : " (the game issued none)", b, (unsigned long long)run_rc[0], (unsigned long long)run_rc[1],
+                     (unsigned long long)run_rc[2], (unsigned long long)k); } }
+        if (frame_draws) run = 0;
+    }
+    if (np % 300 == 0) { uint64_t w[DR_N]; for (int i = 0; i < DR_N; i++) { w[i] = g_dr[i] - win_dr0[i]; win_dr0[i] = g_dr[i]; }
+        char b[700]; drop_line(b, sizeof b, w);
+        MLOG("draws up to present %llu: draw records replayed %llu, presents whose frame encoded no draw %llu of 300; dropped in these 300 by reason: %s; render conditions true %llu / false %llu / unknown %llu so far",
+             (unsigned long long)np, (unsigned long long)(g_draw_ops - win_ops0), (unsigned long long)win_zero, b, (unsigned long long)g_rc_eval[0], (unsigned long long)g_rc_eval[1], (unsigned long long)g_rc_eval[2]);
+        win_zero = 0; win_ops0 = g_draw_ops; }
 }
 
