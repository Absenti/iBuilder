+
+// ---------- Dropped draws, by reason (draft 0508, South Park: The Fractured But Whole, 01008F2005154000) ----------
+// The device log of 2026-11-22 had stretches of 1-2 s whose frames encoded no draw (@draws=0 over 10 passes, @rt_load_mb 42 left unwritten) while the game ran on and its audio
+// played: the picture held, flashed image / black, then jumped ahead. Only the slow frames had rows, and the one draw skip with a log line is a RED_ONCE, so whether the game
+// issued no draw or the host dropped them could not be told. Every draw record the replay meets is counted (g_draw_ops: OP_DRAW, OP_DRAW_IDX, OP_MULTI_DRAW, OP_DRAW_TEX), and
+// every way the draw path returns without encoding it is counted by reason (g_dr), each reason logged at its first cases and at powers of two with what it saw.
+// Reasons the console shares (the draw draws nothing there either) are marked so in the log: past_count, culled, empty_scissor, raster_discard.
+// mtl_drop_stats feeds the slow-frame rows @draw_ops, @drops (all reasons) and @drop_why (a bit per reason, bit i = g_dr_name[i]); the presents keep a census of the
+// stretches of frames that encoded no draw (stretch_note). Replay-thread state, as the draw path's own.
+enum { DR_RC, DR_NOPROG, DR_RASTDISC, DR_DIAG, DR_CULL, DR_SCISSOR, DR_NOPASS, DR_PSO, DR_VBUF, DR_ARGS, DR_PRIM, DR_IBUF, DR_PAST, DR_MESH, DR_DRAWTEX, DR_N };
+static const char *const g_dr_name[DR_N] = {"render_condition_false", "no_program", "raster_discard (as on the console)", "diagnostic_switch", "culled (as on the console)",
+    "empty_scissor (as on the console)", "render_pass_not_begun", "no_pipeline", "vertex_buffer_not_in_pool", "arguments_ended_pass_twice", "primitive_type", "index_buffer_not_in_pool",
+    "past_multi_draw_count (as on the console)", "mesh_or_wide_line_pipeline_missing", "draw_texture_failed"};
+static uint64_t g_dr[DR_N], g_draw_ops, g_rc_eval[3];   // g_rc_eval: render-enable conditions evaluated true / false / unknown (drawn)
+static uint64_t g_rc_last_addr, g_rc_last_x, g_rc_last_y; static int g_rc_last_mode, g_rc_last_known;
+void mtl_drop_stats(uint64_t *ops, uint64_t *by, int n) { *ops = g_draw_ops; for (int i = 0; i < n && i < DR_N; i++) by[i] = g_dr[i]; }
+static uint64_t mtl_frame_now(void);
+static uint64_t g_stat_pass_now(void);
+static void drop_note(int r, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void drop_note(int r, const char *fmt, ...) {
+    uint64_t n = ++g_dr[r];
+    if (n > 4 && (n & (n - 1))) return;
+    char d[400] = ""; if (fmt) { va_list ap; va_start(ap, fmt); vsnprintf(d, sizeof d, fmt, ap); va_end(ap); }
+    MLOG("%sdraw dropped: %s (%llu so far, frame %llu, pass %llu)%s%s", r == DR_PAST || r == DR_CULL || r == DR_SCISSOR || r == DR_RASTDISC ? "" : "[RED] ", g_dr_name[r], (unsigned long long)n,
+         (unsigned long long)mtl_frame_now(), (unsigned long long)g_stat_pass_now(), *d ? ": " : "", d);
 }
+static void rc_note_drop(const char *what) {
+    drop_note(DR_RC, "%s inside a render-enable block evaluated false: %s at %#llx, values %llu / %llu%s", what,
+              g_rc_last_mode >= 2 ? "SetRenderEnable(false)" : g_rc_last_mode ? "draw if not equal" : "draw if equal", (unsigned long long)g_rc_last_addr,
+              (unsigned long long)g_rc_last_x, (unsigned long long)g_rc_last_y, g_rc_last_mode >= 2 ? "" : g_rc_last_known ? " (both read from memory)" : "");
+}
 
