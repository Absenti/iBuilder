# nvn/pool: DM_NVN_POOL_SKIP_RETIRED, a finalized texture's ID gets the dummy in a pool table instead of a texture made again
#
# Upstream:  https://github.com/seedds/nxnative/pull/1393  (OPEN, not merged on 2026-11-21)
# Source:    https://github.com/cheemu21/kid-with-sword-remake  branch L, commit 3ee5e328b39e4aa8a58bbdff174b42dead3910a9 (2026-11-05, picked from 3a534edd06b4c0d4a0a10a02137b0cec6850601f)
# Author:    David Lepe (the commit); the fork's maintainer cheemu21 picked it
# Licence:   MIT, Copyright (c) 2026 seedds and contributors (nxnative LICENSE; the fork is MIT too); the attribution above is kept as the licence asks.
#
# WHAT IT CHANGES (dm/gfx/nvn/nvn_mtl.m only; no game profile key, no game.py header: the switch is the environment alone)
#   pool_entry(): an ID that is retired (the game finalized its texture) and holds no view gets the dummy texture in the pool table instead of a Metal texture made again from its
#   storage. A scene change in Ocarina of Time finalizes the old scene's textures and leaves their IDs registered (about 33,000 IDs in its texture pool); each table rebuild made them
#   again: 1,500 textures, 2.5 GB held only through retired IDs, as much again in deferred release (the fork's Mac measurement). Counted in the log ("pool_skip_retired: N retired
#   texture IDs given the dummy so far": at 1, then at each power of two from 1024).
# DEFAULT: off. DM_NVN_POOL_SKIP_RETIRED unset, empty or 0 = every pool table exactly as before. 1 turns it on.
# Risk: on the console a handle to a finalized texture still reads its storage while that is there; a game that keeps sampling through such handles would read the dummy (upstream
#   keeps it off for that reason). The fork played Ocarina of Time 25 minutes in Kokiri Forest with it (Mac, no out-of-memory). NOT measured on an iPhone.
# Shader chain: not touched (nvn_mtl.m is not in dmsh_chain.py's inventory; chain id b24b25240cad stays).
# Adapted: our pool_entry has the extra lead / limit logic of a newer base; declaration, function and call site were re-made by hand.
# Test: none added. Checked: patch -p1 --forward --dry-run (no fuzz) on the engine tree + engine-patches/0401..0415. NOT run on a device.
# Use: DM_NVN_POOL_SKIP_RETIRED=1 in app/profiles/0400486024DEC000.env.txt.

--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -13128,6 +13128,7 @@
 // One entry of a pool table, as the walk takes it: the resource ID of what the ID holds (0: nothing of the type, or a texture not made). gone counts IDs without storage, and *dead is set for
 // one whose storage does not exist (yet): one marked gone stays so until it is registered again, which is noted. left / left_req count the textures past limit (what this frame may still
 // make) and those of them a shader read. *transient is set for a view of a retired registration, which goes at the end of this submission. Caller holds g_rmu
+static int pool_skip_retired(void); static uint64_t g_pool_skipped;   // IDs pool_skip_retired gave the dummy (the walk's log)
 static uint64_t pool_entry(int samp, int dtt, int id_, uint64_t limit, int *gone, int *left, int *left_req, int *transient, int *dead, uint32_t *lead) {
     if (id_ <= 0) return 0;
     if (samp) return id_ < g_nsreg && g_sreg_ok[id_] && samp_fast(id_) ? g_srid[id_] : 0;
@@ -13135,6 +13136,7 @@
     const treg_t *r = &g_treg[id_];
     if (r->gone) { ++*gone; return 0; }
     if (!r->view && !tex_storage_live(&r->t)) { ++*gone; *dead = 1; return 0; }
+    if (r->retired && !r->view && pool_skip_retired()) { uint64_t n = ++g_pool_skipped; if (n == 1 || (n >= 1024 && !(n & (n - 1)))) MLOG("pool_skip_retired: %llu retired texture IDs given the dummy so far", (unsigned long long)n); return 0; }   // a finalized texture's ID: the dummy, not its texture made again (PR #1393)
     if (!r->view && pool_unwritten_target(&r->t)) return 0;   // dummy until a pass writes it (its new texture is noted: own_note)
     if (!r->view && r->t.d.target != NVN_TEXTURE_TARGET_BUFFER && pool_tex_size(&r->t) > limit && !pkg_shared(&r->t) && !tex_get(r->t.serial) && !(pool_seen(id_) && g_walk_req < POOL_REQ_BYTES)) { ++*left; *left_req += pool_seen(id_); return pool_stand(id_, dtt); }   // BUFFER is a live view, with no upload for this budget to defer
     if (r->tt1 && r->tt1 - 1 != dtt && !(pool_bridge_pair(r->tt1 - 1, dtt) && pool_seen_t(id_, dtt))) { pool_type_note(id_, r->tt1 - 1, dtt); return 0; }   // an ID of another texture type, seen before (the table holds only its own type, or a view of an ID read through it: pool_fit): nothing to look up or charge (the idea is from PR 1428)
@@ -13152,6 +13154,13 @@
     return tr;
 }
 static uint64_t pool_walk(int samp, int dtt, int dpf, int base, __unsafe_unretained id<MTLBuffer> *out);
+// DM_NVN_POOL_SKIP_RETIRED=1 (default 0: off, every pool table as before; the fork took it as a game profile key, here only the environment): an ID whose texture the game has
+// finalized (retired) and that holds no view gets the dummy in a pool table, rather than a Metal texture made again from its storage. The walk covers every registered ID (Ocarina of Time:
+// about 33,000 in its texture pool), and at a scene change the game finalizes the old scene's textures and leaves their IDs registered: each rebuild made them again, 1,500 textures and
+// 2.5 GB held only through retired IDs, as much again in deferred release, and GPU memory passed Metal's working set. Not the default: on the console a handle to a finalized texture
+// still reads its storage while that is there, so a game that keeps sampling through such handles would read the dummy
+static int g_pool_skip_retired = -1;   // -1: not read yet
+static int pool_skip_retired(void) { int v = g_pool_skip_retired; if (v < 0) { const char *e = getenv("DM_NVN_POOL_SKIP_RETIRED"); v = e && *e ? atoi(e) != 0 : 0; if (v) MLOG("pool_skip_retired: pool tables give retired texture IDs without a view the dummy (DM_NVN_POOL_SKIP_RETIRED)"); g_pool_skip_retired = v; } return v; }
 static uint64_t pool_gpu(int samp, int dtt, int dpf, int base, __unsafe_unretained id<MTLBuffer> *out) {   // what it resolves is not a use (g_pool_walk)
     g_pool_walk = 1; uint64_t r = pool_walk(samp, dtt, dpf, base, out); g_pool_walk = 0; return r;
 }
