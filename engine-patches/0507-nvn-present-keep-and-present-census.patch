 static uint64_t g_sd_dead_bytes, g_sd_n_dead, g_sd_n_all;
+// ---------- Presented textures: what the screen gets when a frame drew nothing into them (draft for South Park: The Fractured But Whole, 01008F2005154000) ----------
+// On the console a texture is its memory: a window texture the game presents again without drawing into it shows what it held, so a loading screen that presents with no
+// draws keeps the last picture on screen. Here a pass that loads an attachment and writes nothing into it stores DontCare (udc_on, DM_NVN_UNWRITTEN_DC), whose contents Metal
+// leaves undefined; on the iPhone 15 Pro (A17 Pro, not among the GPUs that rule was checked on) South Park's loading frames presented 0 draws with 14 MB of such stores and the
+// owner saw the picture alternate image / black. A texture the game has presented keeps its store (DM_NVN_PRESENT_KEEP=0: as before): one store of a window texture per pass.
+// Each present is also classified, per presented texture: drawn or cleared or copied into since its previous present, not written since (the console shows its old bytes), never
+// written since the host made it (the console shows its storage; here it is zeros), or shown through another Metal texture than last time (what was drawn before is gone).
+// Logged: the first cases of each, then at powers of two; a summary every 300 presents; mtl_present_unwritten for the slow-frame row @pres_unwritten.
+// Writes counted: draws and clears into a colour attachment (sd_finish), buffer / texture copies and texture clears into it. Not counted: compute image stores (a texture a
+// shader writes shows as "not written"). Replay-thread state: sd_finish, the copies and present_enqueue all run on the submitting thread
+enum { PS_N = 4 };
+typedef struct { uint64_t ser, presents, written, unwritten, never, replaced, kept, zero_draw, since_w, last; const void *mt; int ever; } ps_ent;
+static ps_ent g_ps[PS_N]; static uint64_t g_ps_n, g_ps_bad;
+uint64_t mtl_present_unwritten(void) { return __atomic_load_n(&g_ps_bad, __ATOMIC_RELAXED); }
+static int present_keep_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("DM_NVN_PRESENT_KEEP"); v = !(e && !strcmp(e, "0")); } return v; }
+static ps_ent *ps_find(uint64_t ser) { if (!ser) return NULL; for (int i = 0; i < PS_N; i++) if (g_ps[i].ser == ser) return &g_ps[i]; return NULL; }
+static void ps_note_write(const tex_t *t) { ps_ent *e = t ? ps_find(t->serial) : NULL; if (e) { e->since_w++; e->ever = 1; } }
+static int ps_pow2(uint64_t n) { return n <= 4 || !(n & (n - 1)); }
+static void ps_note_present(const tex_t *t, const void *mt, uint64_t frame_draws) {
+    if (!t || !t->serial) return;
+    ps_ent *e = ps_find(t->serial);
+    if (!e && mt) for (int i = 0; i < PS_N && !e; i++) if (g_ps[i].mt == mt) { e = &g_ps[i]; e->ser = t->serial; }   // a new texture object the sharing table gave the same Metal texture: the same picture
+    if (!e) { e = &g_ps[0]; for (int i = 1; i < PS_N; i++) if (g_ps[i].last < e->last) e = &g_ps[i];   // the least recently presented slot
+              memset(e, 0, sizeof *e); e->ser = t->serial; }
+    uint64_t n = ++g_ps_n; e->last = n; e->presents++;
+    if (!frame_draws) e->zero_draw++;
+    if (e->mt && mt && e->mt != mt) { e->replaced++; g_ps_bad++; if (ps_pow2(e->replaced)) MLOG("[RED] present #%llu of ser=%llu %ux%u: shown through another Metal texture than its previous present: what was drawn into it before is gone (%llu times for it)",
+        (unsigned long long)n, (unsigned long long)t->serial, t->d.width, t->d.height, (unsigned long long)e->replaced); }
+    if (!e->ever) { e->never++; g_ps_bad++; if (ps_pow2(e->never)) MLOG("present #%llu of ser=%llu %ux%u: nothing drew, cleared or copied into it since the host made it: the screen shows zeros, the console its storage (%llu times for it; frame draws %llu)",
+        (unsigned long long)n, (unsigned long long)t->serial, t->d.width, t->d.height, (unsigned long long)e->never, (unsigned long long)frame_draws); }
+    else if (!e->since_w) { e->unwritten++; g_ps_bad++; if (ps_pow2(e->unwritten)) MLOG("present #%llu of ser=%llu %ux%u: not written since its previous present (frame draws %llu): it shows its old picture%s (%llu times for it)",
+        (unsigned long long)n, (unsigned long long)t->serial, t->d.width, t->d.height, (unsigned long long)frame_draws, present_keep_on() ? ", its stores kept" : ", unless a DontCare store lost it (DM_NVN_PRESENT_KEEP=0)", (unsigned long long)e->unwritten); }
+    else e->written++;
+    e->since_w = 0; if (mt) e->mt = mt;
+    if (n % 300 == 0) {
+        char b[1024]; size_t o = 0;
+        for (int i = 0; i < PS_N && o < sizeof b - 200; i++) if (g_ps[i].ser) o += (size_t)snprintf(b + o, sizeof b - o, "%s ser=%llu: %llu presents, drawn %llu, not written %llu, never written %llu, texture replaced %llu, in frames with no draw %llu, stores kept %llu",
+            o ? ";" : "", (unsigned long long)g_ps[i].ser, (unsigned long long)g_ps[i].presents, (unsigned long long)g_ps[i].written, (unsigned long long)g_ps[i].unwritten, (unsigned long long)g_ps[i].never,
+            (unsigned long long)g_ps[i].replaced, (unsigned long long)g_ps[i].zero_draw, (unsigned long long)g_ps[i].kept);
+        MLOG("presented textures up to present %llu (DM_NVN_PRESENT_KEEP %s):%s", (unsigned long long)n, present_keep_on() ? "on" : "off", o ? b : " none");
+    }
+}
