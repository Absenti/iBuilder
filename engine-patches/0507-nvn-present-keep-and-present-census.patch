--- /dev/null
+++ b/dm/gfx/tests/t_present_keep.m
@@ -0,0 +1,47 @@
+// Presented textures (nvn_mtl.m ps_note_present, draft 0507): each present is classified as drawn / not written since its previous present / never written / shown through
+// another Metal texture, and a pass that loads a presented texture and writes nothing into it keeps its store (DM_NVN_PRESENT_KEEP=0: DontCare as before; the check target
+// runs both). Draft for South Park: The Fractured But Whole (01008F2005154000)
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+static void pass_on(uint64_t ser, int load, int wrote) {   // one colour attachment, then the pass's end (sd_finish; g_enc nil: the store action messages go nowhere)
+    g_nsd = 1; g_sd[0] = (sd_att){0}; g_sd[0].ser = ser; g_sd[0].bytes = 1280 * 720 * 4; g_sd[0].idx = 0; g_sd[0].load = (uint8_t)load; g_sd[0].wrote = (uint8_t)wrote; g_sd[0].rast = 1;
+    sd_finish();
+}
+int main(void) { @autoreleasepool {
+    const int keep = present_keep_on();
+    tex_t a = {0}, b = {0}; a.serial = 101; b.serial = 102; a.d.width = b.d.width = 1280; a.d.height = b.d.height = 720;
+    const void *ma = (const void *)0x1000, *mb = (const void *)0x2000, *mb2 = (const void *)0x3000;
+    uint64_t bad0 = mtl_present_unwritten();
+    ps_note_present(&a, ma, 0);   // the first present of a: nothing drew into it yet
+    CHECK("a texture presented before anything wrote it is 'never written'", ps_find(101) && ps_find(101)->never == 1);
+    pass_on(101, 0, 1);           // drawn
+    ps_note_present(&a, ma, 4);
+    CHECK("drawn since its previous present", ps_find(101)->written == 1);
+    ps_note_present(&b, mb, 4); pass_on(102, 1, 1); ps_note_present(&b, mb, 4);
+    CHECK("the second window texture has its own slot", ps_find(102) && ps_find(102)->written == 1 && ps_find(102)->never == 1);
+    uint64_t saved0 = g_udc_saved_bytes;
+    pass_on(101, 1, 0);           // a loading frame: the pass loads a and draws nothing
+    ps_note_present(&a, ma, 0);
+    CHECK("not written since its previous present", ps_find(101)->unwritten == 1 && ps_find(101)->zero_draw == 2);
+    if (keep) CHECK("its store is kept (no DontCare saving counted)", g_udc_saved_bytes == saved0 && ps_find(101)->kept == 1);
+    else CHECK("DM_NVN_PRESENT_KEEP=0: DontCare as before", g_udc_saved_bytes == saved0 + 1280 * 720 * 4 && ps_find(101)->kept == 0);
+    pass_on(555, 1, 0);           // a texture never presented: the DontCare rule is unchanged
+    CHECK("an unpresented texture still gets DontCare", g_udc_saved_bytes == saved0 + (uint64_t)(keep ? 1 : 2) * 1280 * 720 * 4);
+    ps_note_write(&b);            // a copy into b
+    ps_note_present(&b, mb2, 0);  // shown through another Metal texture
+    CHECK("a copy counts as a write", ps_find(102)->written == 2);
+    CHECK("another Metal texture is counted as replaced", ps_find(102)->replaced == 1);
+    tex_t a2 = a; a2.serial = 201;  // a new texture object the sharing table gave a's Metal texture
+    pass_on(101, 0, 1);
+    ps_note_present(&a2, ma, 4);
+    CHECK("a new serial over the same Metal texture takes its slot", ps_find(201) && !ps_find(101) && ps_find(201)->written == 2);
+    CHECK("the unwritten count for the slow-frame row", mtl_present_unwritten() == bad0 + 4);   // never a, never b, unwritten a, replaced b
+    printf("t_present_keep (keep %s): %d checks, %d failed\n", keep ? "on" : "off", checks, failed);
+    return failed != 0;
+} }
