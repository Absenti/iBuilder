+// The MTLDevice path's pipeline archive (engine-patches/0414) with pipelines that have no fragment stage (draft 0509): a vertex-only render pipeline (rasterization disabled) is
+// built as before but never offered to the archive nor added from the queue, it is counted, the "pipeline archive: ... left out" line is logged once, and a normal pipeline beside
+// it is added and the archive written, still on. South Park on an iPhone 15 Pro: "Failed to generate machO ... expecting 'fragment' stage in pipeline no. '10'" turned the archive
+// off for the run. Draft for 01008F2005154000
+#include "../nvn/nvn_mtl.m"
+#include <unistd.h>
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+static const char *k_src =
+    "#include <metal_stdlib>\nusing namespace metal;\n"
+    "struct V { float4 p [[position]]; };\n"
+    "vertex V vs(uint vid [[vertex_id]]) { V o; o.p = float4(float(vid & 1), float(vid >> 1), 0, 1); return o; }\n"
+    "vertex void vs_tf(uint vid [[vertex_id]], device float *out [[buffer(0)]]) { out[vid] = float(vid); }\n"
+    "fragment float4 fs(V i [[stage_in]]) { return float4(i.p.x, 0.25, 0.5, 1); }\n";
+static unsigned pending(void) { os_unfair_lock_lock(&g_dva_lk); unsigned n = (unsigned)g_dva_pend.count; os_unfair_lock_unlock(&g_dva_lk); return n; }
+int main(void) { @autoreleasepool {
+    char dir[] = "/tmp/t_pso_archive_nofrag.XXXXXX"; if (!mkdtemp(dir)) return 2;
+    setenv("DM_PSO_ARCHIVE_NOFRAG", "1", 1);   // the iPhone's default, on this Mac
+    setenv("DM_PSO_BINARY_DIR", dir, 1); setenv("DM_PSO_MTL4", "0", 1); setenv("DM_PSO_ARCHIVE_SECS", "3600", 1);
+    mtl_init();
+    CHECK("the archive is on", dva_on());
+    NSError *e = nil; id<MTLLibrary> lib = [g_dev newLibraryWithSource:@(k_src) options:nil error:&e];
+    CHECK("the library compiles", lib != nil); if (!lib) { printf("%s\n", e.localizedDescription.UTF8String); return 1; }
+    MTLRenderPipelineDescriptor *vo = [MTLRenderPipelineDescriptor new]; vo.vertexFunction = [lib newFunctionWithName:@"vs_tf"]; vo.rasterizationEnabled = NO;
+    NSError *pe = nil; id<MTLRenderPipelineState> p1 = dva_rps(vo, &pe);
+    CHECK("the vertex-only pipeline is built", p1 != nil);
+    CHECK("it is not offered to the archive", pending() == 0);
+    CHECK("it is counted", atomic_load(&g_dva_nofrag) == 1);
+    MTLRenderPipelineDescriptor *nd = [MTLRenderPipelineDescriptor new]; nd.vertexFunction = [lib newFunctionWithName:@"vs"]; nd.fragmentFunction = [lib newFunctionWithName:@"fs"];
+    nd.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
+    id<MTLRenderPipelineState> p2 = dva_rps(nd, &pe);
+    CHECK("a normal pipeline is built and offered", p2 != nil && pending() == 1);
+    CHECK("one queued before the offer checked it is not added", !dva_add(@[@0, vo]) && atomic_load(&g_dva_nofrag) == 2);
+    MTLRenderPipelineDescriptor *nofs = [nd copy]; nofs.fragmentFunction = nil;   // rasterization on but no fragment function: left out as well
+    dva_offer(0, nofs);
+    CHECK("no fragment function: left out", pending() == 1 && atomic_load(&g_dva_nofrag) == 3);
+    dva_save(5000, 1);
+    CHECK("the normal pipeline is added", atomic_load(&g_dva_added) == 1);
+    CHECK("the archive is written and stays on", atomic_load(&g_dva_wr) >= 1 && DVA_ST() == 1 && g_dva_fails == 0);
+    CHECK("the file exists", access([g_dva_path fileSystemRepresentation], F_OK) == 0);
+    [NSFileManager.defaultManager removeItemAtPath:@(dir) error:nil];
+    printf("t_pso_archive_nofrag: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
