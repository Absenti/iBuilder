+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+static uint8_t g_buf[4096]; static size_t g_n;
+static void put(uint32_t op, const void *a, uint32_t n) { op_hdr h = {0}; h.op = op; h.size = (uint32_t)(sizeof h + ((n + 7) & ~7u)); memcpy(g_buf + g_n, &h, sizeof h); if (n) memcpy(g_buf + g_n + sizeof h, a, n); g_n += h.size; }
+static void run(int mode, uint64_t addr) {   // render condition (mode 0: draw if equal), one draw, end
+    g_n = 0; p_render_cond rc = {mode, 0, addr}; put(OP_RENDER_COND, &rc, sizeof rc);
+    p_draw d = {0}; d.prim = 4; d.count = 3; d.instances = 1; put(OP_DRAW, &d, sizeof d);
+    p_render_cond on = {2, 0, 0}; put(OP_RENDER_COND, &on, sizeof on);
+    put(OP_END, NULL, 0);
+    mtl_exec(g_buf);
+}
+int main(void) { @autoreleasepool {
+    mtl_init();
+    const int eval = rc_eval_on();
+    uint64_t *rep = calloc(4, 8); rep[0] = 1; rep[2] = 2;   // counter 1 and 2: "draw if equal" is false
+    uint64_t a = (uint64_t)(uintptr_t)rep;
+    memset(&S, 0, sizeof S);
+    uint64_t np0 = g_dr[DR_NOPROG], rc0 = g_dr[DR_RC], ops0 = g_draw_ops, ig0 = g_rc_ignored, f0 = g_rc_eval[1];
+    run(0, a);
+    CHECK("the draw record is counted", g_draw_ops == ops0 + 1);
+    CHECK("the condition is evaluated false and counted either way", g_rc_eval[1] == f0 + 1);
+    if (eval) { CHECK("evaluated: the draw is dropped as render_condition_false", g_dr[DR_RC] == rc0 + 1 && g_dr[DR_NOPROG] == np0 && g_rc_ignored == ig0); }
+    else { CHECK("DM_NVN_RENDER_COND=0: the draw runs (reaches the draw path)", g_dr[DR_NOPROG] == np0 + 1 && g_dr[DR_RC] == rc0);
+           CHECK("DM_NVN_RENDER_COND=0: the draw a false condition would drop is counted", g_rc_ignored == ig0 + 1); }
+    // SetRenderEnable(false) is the game's own: kept with the switch off too
+    np0 = g_dr[DR_NOPROG]; rc0 = g_dr[DR_RC];
+    run(3, 0);
+    CHECK("SetRenderEnable(false) drops the draw in both modes", g_dr[DR_RC] == rc0 + 1 && g_dr[DR_NOPROG] == np0);
+    printf("t_render_cond_switch (DM_NVN_RENDER_COND %s): %d checks, %d failed\n", eval ? "1" : "0", checks, failed);
+    return failed != 0;
+} }
