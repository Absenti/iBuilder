+++ b/dm/host/dm_lockowner.h
@@ -0,0 +1,14 @@
+// Who owns a lock word, for the thread dump (hle_thread.c, engine-patches/0504). The word holds the owner thread's HANDLE up to SDK 21 and its kernel ID from SDK 22 (Ocarina of Time's
+// 22.2.8). A lookup that matched either one found the wrong thread when one thread's handle equals another's ID (review L6): the dump now looks for both and says which it is.
+//   DM_OWNER_NONE   no thread has that handle or ID
+//   DM_OWNER_HANDLE only a handle matches, or the same thread matches both: the owner is that thread
+//   DM_OWNER_ID     only a kernel ID matches
+//   DM_OWNER_BOTH   a handle of one thread and the ID of another match: both are named, neither is picked
+#ifndef DM_LOCKOWNER_H
+#define DM_LOCKOWNER_H
+enum { DM_OWNER_NONE = 0, DM_OWNER_HANDLE, DM_OWNER_ID, DM_OWNER_BOTH };
+static inline int dm_owner_kind(int by_handle, int by_id, int same_thread) {
+    if (by_handle && by_id) return same_thread ? DM_OWNER_HANDLE : DM_OWNER_BOTH;
+    return by_handle ? DM_OWNER_HANDLE : by_id ? DM_OWNER_ID : DM_OWNER_NONE;
+}
+#endif
