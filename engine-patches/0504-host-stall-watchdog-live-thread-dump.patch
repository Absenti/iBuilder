+// Stall watchdog (kid-with-sword-remake L6.1): once the game has presented 300 frames, a frame count that stays the same for 5 s while graphics are not suspended (the app on the screen)
+// logs every guest thread's wait as it stands (hle_thread.c svc_thread_dump_live, no thread suspended), once per stall; the next stall after frames came back logs again, up to 4 times.
+// An iPhone log ended on a picture that stayed stuck with nothing said, so what the game was waiting for was lost. DM_STALL_DUMP=0 turns this off (default on: it reads a counter once a second)
+static _Atomic uint64_t g_frame;   // (defined below with the frame stats)
+// the host's own (hle_thread.c) wins at link time; a program that links the graphics code alone (the engine's gfx tests) gets this one, which logs nothing
+__attribute__((weak)) void svc_thread_dump_live(void) { }
+// nvn_mtl.m: 1 while a pipeline / library compile runs on the submit path (a thread inside a graphics API call, or the encode thread); the weak stand-in serves where it is not linked
+#ifndef DM_MTL_SUBMIT_COMPILING
+__attribute__((weak)) int mtl_submit_compiling(void) { return 0; }
+#endif
+int dm_focus_now(void);   // hle_oe.c (nvn_mtl.m has a weak one for the graphics tests): 1 when the app is the front one
+static void *stall_watch(void *p) {
+    (void)p;
+    nvn_stall_t st = {0};
+    for (;;) {
+        sleep(1);
+        uint64_t f = atomic_load_explicit(&g_frame, memory_order_relaxed);
+        pthread_mutex_lock(&g_susp_mu); int susp = g_susp; pthread_mutex_unlock(&g_susp_mu);
+        // not a stall: graphics suspended, the app not in front (focus), or the submit thread inside a compile (review L6; nvn_stall_watch.h)
+        if (nvn_stall_step(&st, f, susp, dm_focus_now() != 1, mtl_submit_compiling())) {
+            LOG("[nvn] [RED] stall: no frame for %d s at frame %llu with graphics running: the game's threads as they stand (DM_STALL_DUMP=0 turns this off)", st.still, (unsigned long long)f);
+            svc_thread_dump_live();
+        }
+    }
+    return NULL;
+}
+__attribute__((constructor)) static void stall_watch_start(void) {
+    int bad = 0; if (!dm_env_flag("DM_STALL_DUMP", 1, &bad)) return;   // dm_envflag.h (engine-patches/0415): off / 0 / false / no; was "0" only
+    if (bad) LOG("[nvn] DM_STALL_DUMP=%s is not on / off: the stall watchdog runs (the default)", getenv("DM_STALL_DUMP"));
+    pthread_t th; if (!pthread_create(&th, NULL, stall_watch, NULL)) pthread_detach(th);
+}
