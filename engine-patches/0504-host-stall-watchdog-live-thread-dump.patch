+#define EXPECT(name, want, got) do { long long w_ = (long long)(want), g_ = (long long)(got); g_n++; if (w_ != g_) { printf("FAIL %s: expected %lld, got %lld (line %d)\n", name, w_, g_, __LINE__); g_fail++; } } while (0)
+int main(void) {
+    // ---- the decision: nvn_stall_step(state, frames, suspended, away, compiling)
+    { nvn_stall_t s = {0}; int due = 0;
+      for (int sec = 0; sec < 5; sec++) due += nvn_stall_step(&s, 1000, 0, 0, 0);   // the first look takes the count; then 4 still seconds
+      EXPECT("5 looks: not yet", 0, due);
+      EXPECT("5th still second (the 6th look): the dump is due", 1, nvn_stall_step(&s, 1000, 0, 0, 0)); EXPECT("  ... that stall's still count", 5, s.still);
+      EXPECT("once per stall", 0, nvn_stall_step(&s, 1000, 0, 0, 0)); EXPECT("  ... and still", 0, nvn_stall_step(&s, 1000, 0, 0, 0));
+      EXPECT("frames come back: reset", 0, nvn_stall_step(&s, 1001, 0, 0, 0)); EXPECT("  ... dumped flag cleared", 0, s.dumped);
+    }
+    { nvn_stall_t s = {0}; int due = 0; nvn_stall_step(&s, 1000, 0, 0, 0);
+      for (int sec = 0; sec < 400; sec++) due += nvn_stall_step(&s, 1000, 0, 0, 1);   // a 400 s compile on the submit thread (an iPhone log had 161 s)
+      EXPECT("a long compile: no dump, none of the 4 captures used", 0, due); EXPECT("  ... captures left", 0, s.n);
+      EXPECT("the compile ends: the wait starts over, 4 s later nothing", 0, nvn_stall_step(&s, 1000, 0, 0, 0) + nvn_stall_step(&s, 1000, 0, 0, 0) + nvn_stall_step(&s, 1000, 0, 0, 0) + nvn_stall_step(&s, 1000, 0, 0, 0));
+      EXPECT("  ... the 5th second after it", 1, nvn_stall_step(&s, 1000, 0, 0, 0));
+    }
+    { nvn_stall_t s = {0}; int due = 0; nvn_stall_step(&s, 1000, 0, 0, 0);
+      for (int sec = 0; sec < 60; sec++) due += nvn_stall_step(&s, 1000, 0, 1, 0);   // the app is not in front: Control Center, a call, a sheet
+      EXPECT("out of focus: no dump", 0, due);
+      for (int sec = 0; sec < 60; sec++) due += nvn_stall_step(&s, 1000, 1, 0, 0);   // graphics suspended (the background)
+      EXPECT("suspended: no dump", 0, due);
+      EXPECT("in front again: 4 s nothing", 0, nvn_stall_step(&s, 1000, 0, 0, 0) + nvn_stall_step(&s, 1000, 0, 0, 0) + nvn_stall_step(&s, 1000, 0, 0, 0) + nvn_stall_step(&s, 1000, 0, 0, 0));
+      EXPECT("  ... the 5th", 1, nvn_stall_step(&s, 1000, 0, 0, 0));
+    }
+    { nvn_stall_t s = {0}; int due = 0; nvn_stall_step(&s, 299, 0, 0, 0);
+      for (int sec = 0; sec < 30; sec++) due += nvn_stall_step(&s, 299, 0, 0, 0);
+      EXPECT("before 300 frames (start-up): no dump", 0, due);
+    }
+    { nvn_stall_t s = {0}; int due = 0;   // at most 4 stalls per game, then none; a second game (the count goes back) gets 4 again
+      for (int stall = 0; stall < 6; stall++) { nvn_stall_step(&s, 1000 + stall, 0, 0, 0); for (int sec = 0; sec < 8; sec++) due += nvn_stall_step(&s, 1000 + stall, 0, 0, 0); }
