+// engine-patches/0504 revision 3 (the review's L6, L8): the stall watchdog's decision and the frame counter's reset at teardown, no GPU work and no game.
+//  - nvn_stall_step (nvn_stall_watch.h): the 5 s rule; seconds with the app out of focus, graphics suspended, or the submit thread inside a compile are not stalls; a long compile does not use up
+//    the 4 captures; a counter that goes back (teardown) starts the count of dumps again;
+//  - nvn_hle_teardown() sets the frame counter back to 0 (a second game in the same process);
+//  - dm_owner_kind (dm_lockowner.h): a lock word that is one thread's handle and another's kernel ID is named both ways, not guessed.
+#include "../nvn/hle_nvn.c"
+#include "../../host/dm_lockowner.h"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW); }
