+// The same dump while the game runs on (the stall watchdog in hle_nvn.c, DM_THREAD_DUMP_AT): under G, so no thread is freed during the walk, and with no thread left suspended (a thread
+// stopped while it holds the log's or the allocator's lock would stop this one too): each thread's wait, the object it waits on, in an SVC its guest stack, and for a thread in no guest
+// wait its host frames. G is tried for at most 200 ms: a guest thread holding it longer is skipped over, not waited for
+void svc_thread_dump_live(void) {
+    int got = 0; for (int i = 0; i < 200 && !(got = !pthread_mutex_trylock(&G)); i++) usleep(1000);
+    if (!got) { fprintf(stderr, "[dm] thread dump skipped: the thread table stayed busy for 200 ms\n"); return; }
+    g_dump_live = 1; g_dump_host = 1; svc_thread_dump(); g_dump_live = 0; g_dump_host = 0;
+    pthread_mutex_unlock(&G);
 }
+// DM_THREAD_DUMP_AT=<s> (diagnostic): the live dump that many seconds after start, as the stall watchdog prints it
+static void *dump_at_main(void *p) { sleep((unsigned)(uintptr_t)p); fprintf(stderr, "[dm] DM_THREAD_DUMP_AT: the game's threads as they stand\n"); svc_thread_dump_live(); return NULL; }
+__attribute__((constructor)) static void dump_at_start(void) {
+    const char *e = getenv("DM_THREAD_DUMP_AT"); if (!e || atoi(e) <= 0) return;
+    pthread_t th; if (!pthread_create(&th, NULL, dump_at_main, (void *)(uintptr_t)atoi(e))) pthread_detach(th);
+}
 
