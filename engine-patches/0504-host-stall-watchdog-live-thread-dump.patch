@@ -0,0 +1,20 @@
+// The stall watchdog's decision (hle_nvn.c stall_watch, engine-patches/0504), pure C so dm/gfx/tests/t_stall_watch.c can run it with no GPU and no game.
+// Once a second the watchdog looks at the game's frame count; this says whether the live thread dump is due. A second that does not count as a stall:
+//  - the count moved, or fewer than NVN_STALL_FRAMES frames were ever presented (the start-up);
+//  - graphics are suspended (the app left the screen) or the app is not the front one (focus: a Control Center pull-down, a call, a system sheet stop the display link too);
+//  - the submit path is inside a pipeline / library compile (a compile on the submit thread can take minutes on a phone: an iPhone log has 161 s at one frame): the frames are not
+//    late for a reason a thread dump would explain, and each one used up one of the 4 captures. The wait restarts when the compile ends.
+// A count that goes BACK (graphics teardown reset it: a second game in the same process) starts the dumps' count again.
+#ifndef NVN_STALL_WATCH_H
+#define NVN_STALL_WATCH_H
+#include <stdint.h>
+enum { NVN_STALL_FRAMES = 300, NVN_STALL_SECS = 5, NVN_STALL_MAX = 4 };
+typedef struct { uint64_t last; int still, dumped, n; } nvn_stall_t;
+static inline int nvn_stall_step(nvn_stall_t *s, uint64_t frames, int suspended, int away, int compiling) {
+    if (frames < s->last) s->n = 0;
+    if (frames != s->last || suspended || away || frames < NVN_STALL_FRAMES) { s->last = frames; s->still = 0; s->dumped = 0; return 0; }
+    if (compiling) { s->still = 0; return 0; }   // a stall already reported stays reported until frames come back
+    if (++s->still >= NVN_STALL_SECS && !s->dumped && s->n < NVN_STALL_MAX) { s->dumped = 1; s->n++; return 1; }
+    return 0;
+}
+#endif
