+      due = 0; for (int stall = 0; stall < 2; stall++) { nvn_stall_step(&s, 400 + stall, 0, 0, 0); for (int sec = 0; sec < 8; sec++) due += nvn_stall_step(&s, 400 + stall, 0, 0, 0); }
