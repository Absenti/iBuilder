+// engine-patches/0504 revision 3 (review L6): mtl_submit_compiling() is 1 exactly while a pipeline / library compile runs on the SUBMIT path (a thread inside a graphics API call, i.e.
+// dm_host_work > 0), which is what the stall watchdog does not count; a compile of the prewarm, the archive's queue or any other thread does not. No GPU work beyond mtl_init
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define EXPECT(name, want, got) do { long long w_ = (long long)(want), g_ = (long long)(got); checks++; if (w_ != g_) { printf("FAIL %s: expected %lld, got %lld (line %d)\n", name, w_, g_, __LINE__); failed++; } } while (0)
+static _Atomic int g_bg_in, g_bg_go, g_bg_seen = -1;
+static void *bg_compile(void *p) {   // a host thread (dm_host_work 0): the prewarm's, the archive's
+    (void)p; plain_compile_begin(); atomic_store(&g_bg_in, 1); while (!atomic_load(&g_bg_go)) usleep(100); plain_compile_end(); return NULL;
+}
+int main(void) { @autoreleasepool {
+    mtl_init();
+    EXPECT("idle", 0, mtl_submit_compiling());
+    dm_host_work++;   // what gfx_enter does on a guest thread
+    plain_compile_begin(); EXPECT("a compile inside a graphics call", 1, mtl_submit_compiling());
+    ser_compile_begin(); EXPECT("nested", 1, mtl_submit_compiling());
+    ser_compile_end(); EXPECT("the inner one ends: still inside the outer", 1, mtl_submit_compiling());
+    plain_compile_end(); EXPECT("both ended", 0, mtl_submit_compiling());
+    dm_host_work--;
+    plain_compile_begin(); EXPECT("a compile of a host thread (not in a graphics call)", 0, mtl_submit_compiling()); plain_compile_end();
+    pthread_t th; pthread_create(&th, NULL, bg_compile, NULL); while (!atomic_load(&g_bg_in)) usleep(100);
+    EXPECT("a prewarm thread's compile under way: not the submit path", 0, mtl_submit_compiling());
+    dm_host_work++; plain_compile_begin(); EXPECT("while the submit path compiles too", 1, mtl_submit_compiling()); plain_compile_end(); dm_host_work--;
+    atomic_store(&g_bg_go, 1); pthread_join(th, NULL);
+    NSError *e = nil; dm_host_work++; id lib = dev_lib(@"kernel void k(device int *a [[buffer(0)]], uint i [[thread_position_in_grid]]) { a[i] = 1; }", &e);   // a real library build on the submit path
+    dm_host_work--; EXPECT("a real library compile returned", 1, lib != nil); EXPECT("and the counter is back to 0", 0, mtl_submit_compiling());
+    EXPECT("the compiles on the submit path were counted", 4, (long long)atomic_load(&g_fg_compile_n));
+    printf("t_submit_compile: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
