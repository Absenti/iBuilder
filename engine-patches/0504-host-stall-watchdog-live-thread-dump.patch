#            3282bd6a9 ("L4-L6 ...": the stall watchdog, DM_STALL_DUMP, in hle_nvn.c; 2026-11-16, cheemu21),
#            304f10b2a ("L7.5: freeze reports show where a stuck thread sits; SDK 22 lock owners get priority lending"; 2026-11-19, patpat)
# Authors:   cheemu21, patpat (the commits' names)
