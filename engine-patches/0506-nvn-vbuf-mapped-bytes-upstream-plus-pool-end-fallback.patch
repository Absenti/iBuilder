+    nvn_refl rf; memset(&rf, 0, sizeof rf); rf.nv = 1; rf.v[0].nvn = 0;
+    S.nattr = 1; S.attr[0] = (va_st){.fmt = 0x0a, .stream = 0}; S.stream[0].stride = 4;
+    uint64_t tail = base + n - 16;   // 16 bytes to the pool's end, bound with 4096
