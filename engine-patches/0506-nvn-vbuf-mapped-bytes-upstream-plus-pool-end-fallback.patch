+    pthread_mutex_lock(&g_mu); uint64_t room = pool_tail(tail), none = pool_tail(base + n + 16), be, al; pool_near(base + n + 16, &be, &al); pthread_mutex_unlock(&g_mu);
+    CHECK("pool_tail: the bytes to the pool's end", room == 16 && none == 0);
+    CHECK("pool_near: the pool below ends at its end", be == base + n);
