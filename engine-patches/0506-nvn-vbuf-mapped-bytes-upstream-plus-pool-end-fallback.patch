+// The vertex-stream safety net beside upstream's proof (nvn_mtl.m vbuf_fallback_bytes, engine-patches/0506). When the full-range lookup fails, a draw whose read range upstream proves
+// binds those bytes; one whose range is unproven (an indirect draw here) and whose stream starts in a pool is bound up to the pool's end (DM_NVN_VBUF_CLAMP=1, the default); one
+// proven to read past the pool stays skipped (bound anyway with DM_NVN_VBUF_CLAMP=2); a stream in no pool is skipped in every mode; DM_NVN_VBUF_CLAMP=0 is upstream exactly. Both
+// paths and the skips are counted. The check target runs modes 1, 0 and 2. Ordinary and chunked (large) pools. Draft for South Park: The Fractured But Whole (01008F2005154000)
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
