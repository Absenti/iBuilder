+// Vertex streams, iBuilder's safety net beside upstream's proof (bind_vbufs, pull_layout_fill; engine-patches/0506). NVN binds a vertex buffer as an address and a size, and the
+// GPU fetches only the vertices a draw reads. Snowdrop (South Park: The Fractured But Whole, 01008F2005154000) binds from offsets inside a buffer with the whole buffer's size, so the
+// declared range runs past the pool's end. When the full-range lookup fails, upstream (nxnative c96c45e9, 79555b67) proves the bytes this draw reads: from its vertex and instance
+// ranges, or from the CPU-readable indices of a direct indexed draw. It binds those bytes, and skips the draw when they are unknown or reach past the pool.
+// The fallback is ours: when the proof cannot place the read range (an indirect or multi-draw, indices the GPU writes in this submission, sparse pools, a format of unknown size)
+// and the stream's START lies in a pool, the stream is bound up to that pool's end, as iBuilder's first 0506 did. That build ran South Park on an iPhone 15 Pro, with hundreds of
+// such bindings and no frame without draws.
+// A proven range past the pool's end stays skipped, as upstream (a fetch past the buffer would fault).
+// DM_NVN_VBUF_CLAMP=0: no fallback, upstream exactly. 1 (default): the fallback. 2: also bind up to the pool's end when the proof says the draw reads past it (the first 0506).
+// Which path served is counted and logged at 1, 2, 4, 8, ...; skipped draws are counted, logged the same way with the address's neighbourhood, and appear in the slow-frame row
+// @vbuf_skips (mtl_vbuf_skips)
+static uint64_t g_vbuf_upstream, g_vbuf_clamped, g_vbuf_skips;
+uint64_t mtl_vbuf_skips(void) { return __atomic_load_n(&g_vbuf_skips, __ATOMIC_RELAXED); }
+static int vbuf_clamp_mode(void) { static int v = -1; if (v < 0) { const char *e = getenv("DM_NVN_VBUF_CLAMP"); v = e && *e ? atoi(e) : 1; if (v < 0 || v > 2) v = 1; } return v; }
+static uint64_t pool_tail(uint64_t addr) {   // caller holds g_mu: the bytes from addr to the end of the pool holding it, 0 when no pool does
+    int b = big_of(addr); if (b >= 0) return g_big[b].hi - addr;
+    int i = pool_held(addr, 1); return i >= 0 ? g_pools[i].hi - addr : 0;
+}
+static void pool_near(uint64_t addr, uint64_t *below_end, uint64_t *above_lo) {   // caller holds g_mu: the nearest pool end at or below addr and pool start above it (0 / ~0 when none)
+    *below_end = 0; *above_lo = ~0ull;
+    for (int i = 0; i < g_npool; i++) { if (g_pools[i].hi <= addr && g_pools[i].hi > *below_end) *below_end = g_pools[i].hi; if (g_pools[i].lo > addr && g_pools[i].lo < *above_lo) *above_lo = g_pools[i].lo; }
+    for (int i = 0; i < g_nbig; i++) { if (g_big[i].hi <= addr && g_big[i].hi > *below_end) *below_end = g_big[i].hi; if (g_big[i].lo > addr && g_big[i].lo < *above_lo) *above_lo = g_big[i].lo; }
+}
+static void vbuf_path_note(int fallback, int s, uint64_t addr, uint64_t size, uint64_t bytes) {
+    uint64_t n = fallback ? ++g_vbuf_clamped : ++g_vbuf_upstream;
+    if (n & (n - 1)) return;
+    if (fallback) MLOG("vertex stream %d at %#llx: bound up to the pool's end (fallback): %llu of %llu declared bytes, the draw's read range unproven (%llu so far; DM_NVN_VBUF_CLAMP=0 skips such draws as upstream)",
+                       s, (unsigned long long)addr, (unsigned long long)bytes, (unsigned long long)size, (unsigned long long)n);
+    else MLOG("vertex stream %d at %#llx: bound the bytes the draw reads (upstream): %llu of %llu declared bytes (%llu so far)", s, (unsigned long long)addr, (unsigned long long)bytes, (unsigned long long)size, (unsigned long long)n);
+}
+// The safety net for a stream whose full-range lookup failed: proven = the bytes upstream's proof gave (0: unknown). Returns the bytes to bind up to the pool's end, 0 for none
+static uint64_t vbuf_fallback_bytes(uint64_t addr, uint64_t size, uint64_t proven) {
+    int mode = vbuf_clamp_mode();
+    if (!mode || (proven && mode < 2)) return 0;   // a proven range the pool cannot hold stays skipped (mode 2: bound anyway)
+    pthread_mutex_lock(&g_mu); uint64_t room = pool_tail(addr); pthread_mutex_unlock(&g_mu);
+    return room && room < size ? room : 0;
+}
+static void vbuf_skip_note(int s, uint64_t addr, uint64_t size) {   // a draw skipped for vertex stream s (the callers' former RED_ONCE 158)
+    uint64_t n = __atomic_add_fetch(&g_vbuf_skips, 1, __ATOMIC_RELAXED);
+    if (n & (n - 1)) return;
+    uint64_t room, be, al; pthread_mutex_lock(&g_mu); room = pool_tail(addr); pool_near(addr, &be, &al); pthread_mutex_unlock(&g_mu);
+    char near[160] = "";
+    if (!room) snprintf(near, sizeof near, "; the nearest pool below ends %s%#llx bytes before it, the nearest above starts %s%#llx bytes after it",
+                        be ? "" : "(none) ", (unsigned long long)(be ? addr - be : 0), al != ~0ull ? "" : "(none) ", (unsigned long long)(al != ~0ull ? al - addr : 0));
+    MLOG("[RED] vertex stream %d's buffer %#llx (%llu bytes) %s; draw skipped (%llu draws skipped so far%s)", s, (unsigned long long)addr, (unsigned long long)size,
+         room ? "runs past its memory pool's end" : "is in no memory pool", (unsigned long long)n, near);
 }
 
