# scripts/local.env.example -- the settings of YOUR machine that the scripts under scripts/, app/ and crates/*/tools/ and the fixture-based tests need.
#
# Copy this file to scripts/local.env (it is gitignored: never commit it) and edit the values. Every script sources scripts/local.env first when it exists, and so do the Rust tests
# (ibuilder_testkit::local_env), so a plain `cargo test` finds the same inputs as the scripts. A variable that is already in the environment wins over this file: every line below has the form
# export X="${X-default}" (without a colon), so a variable exported EMPTY (IBUILDER_TEAM_SUFFIX= scripts/build-app.sh ...) also wins and switches that entry off. Keep that form when you edit.
# For the Python tools (crates/*/tools/*.py) run `. scripts/local.env` in your shell first: they read the environment only.
#
# Only IOSBUILDER is needed to build the app; the rest is for the oracle tests and the research tools. A test whose input is missing SKIPS (see scripts/test-report.sh); it never fails.

# A checkout of the original iOSBuilder project (Python + C# + C). The app build still needs it as an INPUT (prebuilt engine host, SPIRV-Cross archives, zsign and OpenSSL sources, zstd sources),
# and the byte-compare tests read its Python reference outputs. It is only ever READ. (IOSBUILDER_MAIN is accepted as an older name.)
export IOSBUILDER="${IOSBUILDER-/path/to/iOSBuilder}"

# The iOSBuilder tree that holds the newest, uncommitted work: out-load-ui/ (prebuilt hosts), out-spvc/, out-stage/out-engine/ (the patched engine), gameapp/, tools/, load/, paches/.
# Optional: it defaults to $IOSBUILDER (use it when the newest work lives in a separate git worktree of that project).
#export IOSBUILDER_WORKTREE="${IOSBUILDER_WORKTREE-/path/to/iOSBuilder-worktree}"

# A scratch folder for generated oracle outputs and Python reference environments (ref/venv, ref/engine, macho/, shader/, f1/, f2/, ocarina/ ...). Never inside the repository.
# IBUILDER_SCRATCH_OLD is an optional second folder for outputs of an earlier round of the work; it defaults to IBUILDER_SCRATCH (both may be the same folder).
# (The tools/*.sh scripts also accept S2 and OLD, their older names for the two.)
export IBUILDER_SCRATCH="${IBUILDER_SCRATCH-/path/to/scratch}"
#export IBUILDER_SCRATCH_OLD="${IBUILDER_SCRATCH_OLD-/path/to/earlier-scratch}"

# Optional: the third-party engine tree (the NX2Apple `engine/` folder), the last place ibuilder-profile's oracle test looks for an engine bundle.
#export IBUILDER_NX2APPLE_ENGINE="${IBUILDER_NX2APPLE_ENGINE-/path/to/NX2Apple/engine}"

# Optional: the team suffix your sideloading service gives the app's bundle id (dev.ibuilder.app.<SUFFIX>). scripts/build-app.sh adds `dev.ibuilder.app.<SUFFIX>.build.*` to the
# permitted background task ids of Info.plist (the system matches the id exactly). Leave it unset and the entry is left out.
#export IBUILDER_TEAM_SUFFIX="${IBUILDER_TEAM_SUFFIX-ABCDE12345}"

# Optional: <engine>/dm for scripts/check-patch-coverage.sh and the patch-coverage test of ibuilder-rewrite (the test's default: $IOSBUILDER_WORKTREE/out-stage/out-engine/engine/dm).
#export IBUILDER_ENGINE_DM="${IBUILDER_ENGINE_DM-/path/to/engine/dm}"
