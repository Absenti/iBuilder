#version 450
// a kernel with a local size, a storage buffer, a uniform texel buffer and a storage texel buffer, min() / clamp() (precise::)
layout(local_size_x = 8, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 3) buffer Out { float v[]; } outb;
layout(set = 0, binding = 1) uniform samplerBuffer src;
layout(set = 0, binding = 2, r32f) uniform imageBuffer dst;
void main() {
    uint i = gl_GlobalInvocationID.x;
    float x = texelFetch(src, int(i)).x;
    outb.v[i] = clamp(min(x, 4.0), 0.0, 1.0);
    imageStore(dst, int(i), vec4(x));
}
