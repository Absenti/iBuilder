using namespace metal;

static inline __attribute__((always_inline)) float dm_zsnap(float z, float d, float zw)   // see frag_z_snap
{
    float lo = as_type<float>(as_type<int>(z) - 1) - zw * 0x1p-20f;
    return (z > 0.0f && d < z && d >= lo) ? d : z;
}

