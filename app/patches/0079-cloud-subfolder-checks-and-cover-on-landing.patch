+    }
+
+    // ---- patch 0079: the cover pass of a file that has just landed ------------------------------------------------------------------------------
+
+    /// Worker thread, on the worker that placed the files (a NAS download, a Files-folder clone or copy, the folder flow), right after the last one landed and before the main thread hears of it (so
+    /// before a "Download and build" starts its build): each game file that landed gets its cover read ONCE, by the same per-file readers as the refresh passes (ReadPackageCover with prod.keys: the
+    /// control NCA's icon and the title id when the name has none; ReadNupCover: a .nup's own icon). Never while a build runs (the refresh passes read it after the build: the landing time lets them
+    /// through the markers). Writes games/<id>/icon.jpg or a "no icon" marker, never the person's cover.jpg. A package with no icon at all (the owner's Ocarina of Time .nup) is said once in the log,
+    /// as a fact: no alert, "Choose a cover…" stays the way. `how` names the add in the log ("downloaded from NAS"). Returns how many things the screen shows changed.
+    private int CoverPassForLanded(IEnumerable<string> landed, string how)
+    {
+        if (GameExport.IsPlayer) return 0;
+        try
+        {
+            var documents = GameAppMain.Documents;
+            var keys = Path.Combine(documents, "prod.keys");
+            bool haveKeys = File.Exists(keys), package = false;
+            int changed = 0;
+            var clock = System.Diagnostics.Stopwatch.StartNew();
+            var results = CoverPass.Run(landed, haveKeys,
+                name => GameFileContent(name) == SourceFileState.Content,
+                name => { var rel = GameAppUi.IconRelativePath(name); return rel != null && File.Exists(CoverFileOf(name, rel)); },
+                () => running || stop.Busy,
+                (name, reader) =>
+                {
+                    string verdict;
+                    if (reader == CoverPass.Reader.Nup) changed += ReadNupCover(documents, name, out verdict);
+                    else { package = true; changed += ReadPackageCover(keys, documents, name, out verdict); }
+                    return verdict;
+                });
+            if (package) GC.Collect();   // the dumps' file handles the NCAs held
+            var ms = clock.ElapsedMilliseconds;
+            var lines = results.Select(r => CoverPass.Line(r, how)).Where(l => l != null).ToList();
+            if (lines.Count > 0) BeginInvokeOnMainThread(() => { foreach (var l in lines) Write(l); NoteTime("cover pass/landed", ms); });
+            return changed;
+        }
+        catch (Exception error)
+        {
+            BeginInvokeOnMainThread(() => Write($"cover: the pass after the add stopped ({error.GetType().Name}: {error.Message}); the next refresh reads the covers"));
+            return 0;
+        }
     }
 }
