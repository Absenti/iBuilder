-    /// Worker thread. 1 when something the screen shows changed (an icon, or the game's id), else 0.
-    private static int ReadNupCover(string documents, string name)
+    /// Worker thread. 1 when something the screen shows changed (an icon, or the game's id), else 0. The per-file reader of FetchMissingNupIcons and of the pass that runs as soon as a file has
+    /// landed (patch 0079, CoverPassForLanded); `verdictOut` says what came of it.
+    private static int ReadNupCover(string documents, string name, out string verdictOut)
     {
+        lock (CoverPass.Gate) { var n = ReadNupCoverLocked(documents, name, out verdictOut); return n; }
+    }
+
+    private static int ReadNupCoverLocked(string documents, string name, out string verdictOut)
+    {
         int changed = 0;
         string verdict;
+        var known = GameAppUi.IconRelativePath(name);
+        if (known != null && File.Exists(CoverFileOf(name, known))) { verdictOut = "its icon is here already"; return 0; }   // another pass read it meanwhile
         try
         {
             var path = Path.Combine(documents, name);
@@ -284,6 +300,48 @@
         catch (Exception error) { verdict = error.GetType().Name + ": " + error.Message; }
         Console.Error.WriteLine($"[gameapp] icon of {name}: {verdict}");
         GameAppDiag.Event("icon", $"icon of {name}: {verdict}");
+        verdictOut = verdict;
