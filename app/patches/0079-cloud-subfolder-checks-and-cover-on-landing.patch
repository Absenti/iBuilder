+// ---- patch 0079: the cover pass of a file that has just landed ------------------------------------------------------------------------------------------------------------------------------
+//
+// A game added from the NAS (Download, Download and build), from a Files folder of the Cloud page (a clone, else a copy) or through the folder flow got its cover only from a later refresh pass, which
+// a build started at once skipped ("Download and build"), and which a "no icon" marker written while the game was only in the cloud stopped for good (FetchCloudIcons' verdict on the REMOTE copy,
+// checked against prod.keys' time only). Now the file's own cover is read on the worker that placed it, right after it landed and before anything else starts, by the same per-file readers as the
+// refresh passes; and a marker older than the file's landing (the import ledger's time) no longer stands for the file that is here now.
+
+/// Patch 0079: which landed files get the cover pass, once each, and whether a "no icon" marker still stands. It only ever leads to games/<id>/icon.jpg (or a marker) being written: the person's cover
+/// (GameCover.Candidates) is never a target, and wins over the icon (GameCover.Resolve).
+public static class CoverPass
+{
+    /// Every per-file cover read (the refresh passes, the landed pass, the cloud pass's write) holds this: one file is never read or written by two passes at once, and the second finds the icon.
+    public static readonly object Gate = new object();
+
+    public enum Reader { None, Package, Nup }
+
+    /// The reader a landed file gets: a .nup its own icon (no keys: gameapp_nup_icon), a .nsp .xci .nsz the package's control NCA (with prod.keys; the title id too when the name has none). An update
+    /// or a DLC gets none: the library shows its base game, whose icon is read from the base game's file. Anything else (an .ipa, prod.keys) gets none.
+    public static Reader ReaderFor(string fileName, bool haveKeys)
+    {
+        if (!Cloud.IsGameFile(fileName)) return Reader.None;
+        if (GameAppUi.ContentKindOf(fileName) is GameAppUi.ContentKind.Update or GameAppUi.ContentKind.AddOn) return Reader.None;
+        if (GameAppUi.IsNup(fileName)) return Reader.Nup;
+        return haveKeys ? Reader.Package : Reader.None;
+    }
+
+    /// The landed names, each once (Documents holds one file of a name, whatever its case), in the order they landed.
+    public static List<string> Once(IEnumerable<string> landed)
+    {
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        return (landed ?? Enumerable.Empty<string>()).Where(n => !string.IsNullOrEmpty(n) && seen.Add(n)).ToList();
+    }
+
+    /// A "no icon" marker (games/<id>/icon.none, games/_unresolved/<hash>.none) still stands when it is not older than `sinceUtc` (prod.keys for a package, the file itself for a .nup: as before) AND not
+    /// older than the file's landing (`landedUtc`, the import ledger's time; null for a file the app did not import: as before). A marker written while the game was only in the cloud, or before the
+    /// file was added again, is the verdict on another copy: the file that is here now is read.
+    public static bool MarkerStands(DateTime markerUtc, DateTime sinceUtc, DateTime? landedUtc) =>
+        markerUtc >= sinceUtc && (landedUtc == null || markerUtc >= landedUtc.Value);
+
+    /// The import ledger's time ("yyyy-MM-ddTHH:mm:ssZ", UTC, whole seconds), or null when there is none or it cannot be read.
+    public static DateTime? LandedAt(string at) =>
+        !string.IsNullOrEmpty(at) && DateTime.TryParseExact(at, "yyyy-MM-ddTHH:mm:ssZ", System.Globalization.CultureInfo.InvariantCulture,
+            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal, out var t) ? t : (DateTime?) null;
+
+    /// The base game's title id a control NCA names, as 0051 keeps it (low 12 bits cleared), or 0 when it is not a base game's (an update's control NCA, ...): a file whose name has no id is then
+    /// left to the extractor's own reading once it is here, as a local one (GameIconsContent reads the application's control NCA only).
+    public static ulong BaseIdFromControl(ulong titleId) => titleId != 0 && (titleId & 0xFFFUL) == 0 ? titleId : 0;
+
+    public enum CloudOutcome { Icon, NoIcon, Retry }
+
+    /// What the cloud pass keeps from one remote read: the icon; a "no icon" marker when the package was read and has none; nothing on disk when the read failed (the network, the NAS, a password):
+    /// tried again at the next launch, not marked for good.
+    public static CloudOutcome CloudOutcomeOf(byte[] jpeg, bool failed) =>
+        failed ? CloudOutcome.Retry : jpeg != null && jpeg.Length > 0 ? CloudOutcome.Icon : CloudOutcome.NoIcon;
+
+    public enum Outcome { Read, HasIcon, NotAGame, NoKeys, NoContent, BuildRunning }
+
+    public sealed record Result(string Name, Outcome Outcome, string Verdict);
+
+    /// The pass over the files that landed, once each, in order. `hasContent`: the file is there with its content (not a stub, not empty); `iconExists`: games/<id>/icon.jpg is there already (the
+    /// cloud pass read it, or an earlier pass); `buildBusy`: asked before each read (a build that started meanwhile gets the rest after it, from the refresh passes, which the landing time now lets
+    /// through); `read`: the per-file reader, which returns its verdict. Markers are not asked: the file has just landed, its own verdict is written by the reader.
+    public static List<Result> Run(IEnumerable<string> landed, bool haveKeys, Func<string, bool> hasContent, Func<string, bool> iconExists, Func<bool> buildBusy, Func<string, Reader, string> read)
+    {
+        var results = new List<Result>();
+        bool stopped = false;
+        foreach (var name in Once(landed))
+        {
+            var reader = ReaderFor(name, haveKeys);
+            if (reader == Reader.None)
+            {
+                bool wantsKeys = !haveKeys && ReaderFor(name, true) == Reader.Package;
+                results.Add(new Result(name, wantsKeys ? Outcome.NoKeys : Outcome.NotAGame, null));
+                continue;
+            }
+            if (stopped || buildBusy()) { stopped = true; results.Add(new Result(name, Outcome.BuildRunning, null)); continue; }
+            if (!hasContent(name)) { results.Add(new Result(name, Outcome.NoContent, null)); continue; }
+            if (iconExists(name)) { results.Add(new Result(name, Outcome.HasIcon, null)); continue; }
+            results.Add(new Result(name, Outcome.Read, read(name, reader)));
+        }
+        return results;
+    }
+
+    /// The log line of one landed file (`how`: "downloaded from NAS", "added from iCloud Drive · Games", ...), or null when there is nothing to say (not a game, a stub). A package with no icon is said
+    /// once, as a fact, not an error: "Choose a cover…" stays the way to give it one.
+    public static string Line(Result r, string how)
+    {
+        var head = $"cover: {r.Name} ({how}): ";
+        switch (r.Outcome)
+        {
+            case Outcome.Read:
+                var v = string.IsNullOrEmpty(r.Verdict) ? "read" : r.Verdict;
+                return head + v + (v.StartsWith("none", StringComparison.Ordinal) || v.StartsWith("no icon", StringComparison.Ordinal) ? " (Choose a cover… gives it one)" : "");
+            case Outcome.HasIcon: return head + "its icon is here already";
+            case Outcome.NoKeys: return head + "read once prod.keys is added";
+            case Outcome.BuildRunning: return head + "read after the build";
+            default: return null;
+        }
+    }
+}
