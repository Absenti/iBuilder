+    // ---- patch 0091: updates and DLC under their game (ContentSet, GameAppAttach.cs) --------------------------------------------------------------
+
+    /// What goes with a game: this iPhone's update and DLC ("update v327680 · 2 DLC"); for a cloud game, what its download brings (its source's files and this iPhone's).
+    private string ExtrasLine(LibraryEntry e, LibState state)
+    {
+        if (e == null || GameExport.IsPlayer) return "";
+        var local = libNames ?? Dumps().Select(Path.GetFileName).ToList();
+        if ((state == LibState.CloudOnly || state == LibState.Downloading) && e.Cloud != null)
+            return ContentSet.CloudSummary(e.Name, cloudFiles.Where(f => f.SourceId == e.Cloud.SourceId).Select(f => f.Name), local);
+        return ContentAttach.Summary(e.Name, local);
+    }
+
+    /// The bytes a cloud game's download takes: the game, its newest update and its DLC from the same source, minus what this iPhone has (Cloud.DownloadSet, what Download fetches).
+    private long CloudSetBytes(LibraryEntry e)
+    {
+        if (e?.Cloud == null) return 0;
+        var set = Cloud.DownloadSet(e.Name, e.Cloud.SourceId, cloudFiles, libNames ?? Dumps().Select(Path.GetFileName).ToList());
+        return set.Count == 0 ? e.Cloud.Size : set.Sum(f => Math.Max(0, f.Size));
+    }
+
+    private HashSet<string> knownExtras;   // the updates and DLC of Documents already seen (the first refresh only learns them)
+
+    /// After a refresh of Documents (an import, Open in, a folder import, a download): each update or DLC that arrived is attached to its game, said once ("Update v327680 attached to
+    /// South Park: rebuild to include it"), or kept and listed as waiting for its game. The flows that say it themselves (a download, "Add an update or DLC…") mark theirs as known first.
+    private void NoteArrivedExtras(List<string> names)
+    {
+        var extras = names.Where(n => ContentSet.Of(n) != ContentSet.Kind.Game).ToList();
+        if (knownExtras == null) { knownExtras = new HashSet<string>(extras, StringComparer.OrdinalIgnoreCase); return; }
+        var fresh = extras.Where(n => knownExtras.Add(n)).ToList();
+        if (fresh.Count == 0 || GameExport.IsPlayer) return;
+        UiFacts facts;
+        try { facts = GatherFacts(); } catch (Exception) { return; }
+        var games = GameAppUi.PlayableGames(names);
+        var lines = new List<string>();
+        foreach (var f in fresh)
+        {
+            var id = GameAppUi.BaseTitleIdOf(f);
+            var b = games.FirstOrDefault(g => GameAppUi.ContentKindOf(g) == GameAppUi.ContentKind.Base && string.Equals(GameAppUi.BaseTitleIdOf(g), id, StringComparison.OrdinalIgnoreCase));
+            lines.Add(ContentSet.Arrived(f, b, b != null && GameAppUi.GameStatusOf(b, facts) == GameAppUi.GameStatus.Ready));
+        }
+        foreach (var l in lines) Write("content: " + l);
+        var a = UIAlertController.Create(fresh.Count == 1 ? "Added to its game" : "Updates and DLC", string.Join("\n", lines), UIAlertControllerStyle.Alert);
+        a.AddAction(UIAlertAction.Create("OK", UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(a);
+    }
+
+    /// The flows that announce their own files: what they bring is not "arrived" again.
+    private void KnowExtras(IEnumerable<string> names) { if (knownExtras != null) foreach (var n in names ?? Enumerable.Empty<string>()) knownExtras.Add(Path.GetFileName(n)); }
+
+    private bool orphansOpen;
+
+    /// "Updates and DLC without their game (N)": collapsed; open, one line each with where it is. Null when there are none.
+    private UIView OrphansSection(List<(string Name, string Where)> orphans)
+    {
+        if (orphans.Count == 0) return null;
+        var head = new UIButton(UIButtonType.System) { AccessibilityIdentifier = "build-orphans" };
+        var c = UIButtonConfiguration.PlainButtonConfiguration;
+        c.AttributedTitle = new NSAttributedString($"{ContentSet.OrphansTitle} ({orphans.Count})", new UIStringAttributes { Font = Theme.Font(13, UIFontWeight.Semibold), ForegroundColor = Theme.Muted });
+        c.Image = UIImage.GetSystemImage(orphansOpen ? "chevron.down" : "chevron.right");
+        c.ImagePlacement = NSDirectionalRectEdge.Trailing;
+        c.ImagePadding = 6;
+        c.BaseForegroundColor = Theme.Muted;
+        c.ContentInsets = new NSDirectionalEdgeInsets(0, 0, 0, 0);
+        head.Configuration = c;
+        head.HorizontalAlignment = UIControlContentHorizontalAlignment.Leading;
+        head.AccessibilityValue = orphansOpen ? "open" : "closed";
+        head.TouchUpInside += (_, __) => { orphansOpen = !orphansOpen; buildKey = null; RefreshScreen(); };
+        var views = new List<UIView> { head };
+        if (orphansOpen)
+        {
+            var rows = orphans.Select(o => (UIView) Theme.Label(GameAppUi.DisplayName(o.Name) + " · " + ContentSet.Label(o.Name) + " · " + o.Where + " · waiting for its game",
+                                                               Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 2)).ToArray();
+            views.Add(Look.Card(Theme.Column(8, rows), 12, 14));
+        }
+        return Theme.Column(8, views.ToArray());
+    }
