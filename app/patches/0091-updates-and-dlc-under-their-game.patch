+
+/// Patch 0091 (the owner: updates and DLC detected automatically): every package is a game, an update or a DLC by its title id, from the file name's tag ("[0100…800][v327680]",
+/// "(0100…)", any other bracket after it such as "[US]") or, with none, from the package itself (its content meta NCA's title id, read by the cover pass, kept in .titleids.tsv). The
+/// rules are the extractor's and hactool's / nxdumptool's: a base game's id has its low 12 bits 000; its update is base | 0x800 (nx_extract opens the update as `app | 0x800`); a DLC
+/// is AddOnContentBaseId (base + 0x1000 unless the NACP says otherwise) + its index 1..0x7FF, so its base is (id - 0x1000) & ~0xFFF (GameAppUi.BaseTitleIdOf / ContentKindOf).
+/// An update or a DLC is never a game of its own: it is shown under its base game, downloaded with it, merged by its build; one whose base game is nowhere (on this iPhone or in any
+/// cloud source) is listed once in "Updates and DLC without their game".
+public static class ContentSet
+{
+    public enum Kind { Game, Update, Dlc }
+
+    /// A name with no title id is a game (the extractor decides), as the library has always treated it.
+    public static Kind Of(string name) => GameAppUi.ContentKindOf(name) switch
+    {
+        GameAppUi.ContentKind.Update => Kind.Update,
+        GameAppUi.ContentKind.AddOn => Kind.Dlc,
+        _ => Kind.Game,
+    };
+
+    /// The title the cover pass keeps for a name with no id: a base game's control NCA wins (an .xci may hold the game, its update and DLC: it is the game); else the content's own id
+    /// when the package is an update or a DLC (its meta NCA's: …800, or a DLC's), so ContentKindOf says what it is; else nothing (0).
+    public static ulong KeepTitle(ulong controlTitleId, ulong contentTitleId, bool cartridge = false)
+    {
+        if (CoverPass.BaseIdFromControl(controlTitleId) is ulong b && b != 0) return b;
+        if (cartridge) return CoverPass.BaseIdFromControl(contentTitleId);   // a cartridge image is a game, never an update or a DLC of one
+        if (contentTitleId != 0 && (contentTitleId & 0xFFFUL) != 0) return contentTitleId;
+        return CoverPass.BaseIdFromControl(contentTitleId);
+    }
+
+    /// The update and DLC of `game` among `names` (the files of this iPhone, or of a source and this iPhone): the newest update, the older ones (newest first), the DLC (one per id).
+    public static (string Update, List<string> Older, List<string> Dlc) ExtrasOf(string game, IEnumerable<string> names)
+    {
+        var list = (names ?? Enumerable.Empty<string>()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
+        if (GameAppUi.IsNup(game) || GameAppUi.ContentKindOf(game) != GameAppUi.ContentKind.Base) return (null, new List<string>(), new List<string>());
+        var update = GameAppUi.UpdateFor(game, list);
+        var id = GameAppUi.BaseTitleIdOf(game);
+        var older = list.Where(n => GameAppUi.ContentKindOf(n) == GameAppUi.ContentKind.Update && GameAppUi.BaseTitleIdOf(n) == id && !string.Equals(n, update, StringComparison.OrdinalIgnoreCase))
+                        .OrderByDescending(GameAppUi.VersionOf).ToList();
+        return (update, older, GameAppUi.DlcFor(game, list));
+    }
+
+    /// "update v327680 · 2 DLC", "1 DLC", "".
+    public static string Summary(string update, int dlc)
+    {
+        var parts = new List<string>();
+        if (update != null) { long v = GameAppUi.VersionOf(update); parts.Add(v > 0 ? "update v" + v.ToString(CultureInfo.InvariantCulture) : "update"); }
+        if (dlc > 0) parts.Add(dlc + " DLC");
+        return string.Join(" · ", parts);
+    }
+
+    /// A cloud game's: what its download brings (the source's files and this iPhone's): "update v327680 · 2 DLC".
+    public static string CloudSummary(string game, IEnumerable<string> sourceNames, IEnumerable<string> localNames)
+    {
+        var x = ExtrasOf(game, (sourceNames ?? Enumerable.Empty<string>()).Concat(localNames ?? Enumerable.Empty<string>()));
+        return Summary(x.Update, x.Dlc.Count);
+    }
+
+    /// The updates and DLC whose base game is in none of `games` (this iPhone's and every cloud source's): listed once, not as games. A name with no id is a game, never one of them.
+    public static List<string> Orphans(IEnumerable<string> names, IEnumerable<string> games)
+    {
+        var bases = new HashSet<string>((games ?? Enumerable.Empty<string>()).Where(g => GameAppUi.ContentKindOf(g) == GameAppUi.ContentKind.Base).Select(GameAppUi.BaseTitleIdOf).Where(i => i != null),
+                                        StringComparer.OrdinalIgnoreCase);
+        return (names ?? Enumerable.Empty<string>()).Where(n => Of(n) != Kind.Game && GameAppUi.BaseTitleIdOf(n) is string b && !bases.Contains(b))
+                                                     .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();
+    }
+
+    public const string OrphansTitle = "Updates and DLC without their game";
+
+    /// "update v327680", "DLC Danger Deck".
+    public static string Label(string file) => Of(file) == Kind.Update ? "update v" + GameAppUi.VersionOf(file).ToString(CultureInfo.InvariantCulture) : "DLC " + GameAppUi.DlcLabel(file);
+
+    /// A file that arrived (picked, opened in, imported): "Update v327680 attached to South Park: rebuild to include it" / "…: its build will include it".
+    public static string Arrived(string file, string baseGame, bool built)
+    {
+        var what = Label(file);
+        what = char.ToUpperInvariant(what[0]) + what.Substring(1);
+        return baseGame == null ? what + " (" + file + "): kept, waiting for its game"
+             : what + " attached to " + GameAppUi.DisplayName(baseGame) + (built ? ": rebuild to include it" : ": its build will include it");
+    }
+
+    /// "Older update v65536: remove to save 5.9 GB".
+    public static string OlderRow(string file, long bytes) => "Older update v" + GameAppUi.VersionOf(file).ToString(CultureInfo.InvariantCulture) + ": remove to save " + GameAppUi.SizeText(bytes);
+
+    /// "games found: 1 (+1 update, 2 DLC)" (the log at every refresh).
+    public static string FoundLine(IEnumerable<string> names)
+    {
+        var l = (names ?? Enumerable.Empty<string>()).ToList();
+        int u = l.Count(n => Of(n) == Kind.Update), d = l.Count(n => Of(n) == Kind.Dlc);
+        return "games found: " + (l.Count - u - d) + (u + d > 0 ? $" (+{u} update{(u == 1 ? "" : "s")}, {d} DLC)" : "");
+    }
 }
