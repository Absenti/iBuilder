# Any file is offered now (like the certificate and import pickers); UsePickedRomfs checks name, size and digest. The steps are logged (opened / picked). Applies after 0053.
diff -ruN a/GameAppLibrary.cs b/GameAppLibrary.cs
--- a/GameAppLibrary.cs
+++ b/GameAppLibrary.cs
@@ -681,10 +681,14 @@
