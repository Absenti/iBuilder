+/// Patch 0098 (the owner: Mario Kart's ~60,000 libraries kept South Park's preparation from ever getting its turn): the order of the shader preparation is the person's. The queue's titles
+/// in order, the games the person paused (held: passed over, kept in place), the games the person skipped (out of the queue until queued again); a game newly built goes to the END
+/// (it went first before); "Prepare this one now" moves a game first and the game being prepared stops at its next library (what it finished is kept in its warmed.tsv: it goes on from
+/// there when its turn comes back). Kept in gameapp.warmqueue.tsv ("held" and "skipped" rows beside "paused" and "title"; an older app reads the file and ignores them).
+public static class WarmOrder
+{
+    public const string Header = "# shader preparation queue v1";
+
+    private static string Norm(string t) => t?.Trim().ToUpperInvariant();
+    private static bool Ok(string t) => t != null && t.Length == 16 && t.All(Uri.IsHexDigit);
+
+    /// The queue against what owes a preparation now (`owing`, in the shelf's order): titles that owe nothing leave (and are forgotten as held or skipped); owing ones that are not in it and
+    /// not skipped are added at the END, in that order. The person's order is kept. Returns whether anything changed.
+    public static bool Sync(List<string> titles, ISet<string> held, ISet<string> skipped, IEnumerable<string> owing)
+    {
+        var before = string.Join(",", titles) + "|" + string.Join(",", held.OrderBy(x => x)) + "|" + string.Join(",", skipped.OrderBy(x => x));
+        var owe = (owing ?? Enumerable.Empty<string>()).Select(Norm).Where(Ok).Distinct().ToList();
+        var set = new HashSet<string>(owe, StringComparer.Ordinal);
+        titles.RemoveAll(x => !set.Contains(x));
+        foreach (var x in held.Where(x => !set.Contains(x)).ToList()) held.Remove(x);
+        foreach (var x in skipped.Where(x => !set.Contains(x)).ToList()) skipped.Remove(x);
+        foreach (var x in owe) if (!titles.Contains(x) && !skipped.Contains(x)) titles.Add(x);
+        return before != string.Join(",", titles) + "|" + string.Join(",", held.OrderBy(x => x)) + "|" + string.Join(",", skipped.OrderBy(x => x));
+    }
+
+    /// "Prepare this one now": first, not paused, not skipped. Returns whether it moved.
+    public static bool MoveFirst(List<string> titles, ISet<string> held, ISet<string> skipped, string title)
+    {
+        var t = Norm(title);
+        if (!Ok(t)) return false;
+        bool was = titles.Count > 0 && titles[0] == t && !held.Contains(t) && !skipped.Contains(t);
+        titles.Remove(t); titles.Insert(0, t);
+        held.Remove(t); skipped.Remove(t);
+        return !was;
+    }
+
+    /// Pause / Resume one game: a paused game keeps its place and is passed over.
+    public static bool Hold(List<string> titles, ISet<string> held, string title, bool on)
+    {
+        var t = Norm(title);
+        if (!titles.Contains(t)) return false;
+        return on ? held.Add(t) : held.Remove(t);
+    }
+
+    /// Skip: out of the queue, left unprepared, until it is queued again (Requeue) or moved first.
+    public static bool Skip(List<string> titles, ISet<string> held, ISet<string> skipped, string title)
+    {
+        var t = Norm(title);
+        if (!titles.Remove(t)) return false;
+        held.Remove(t);
+        skipped.Add(t);
+        return true;
+    }
+
+    /// A skipped game queued again: at the end.
+    public static bool Requeue(List<string> titles, ISet<string> skipped, string title)
+    {
+        var t = Norm(title);
+        if (!skipped.Remove(t)) return false;
+        if (!titles.Contains(t)) titles.Add(t);
+        return true;
+    }
+
+    /// The game to prepare now: the first one not paused by the person, unless the whole preparation is paused or something else has the phone. One run at a time: never while one runs.
+    public static string Next(IReadOnlyList<string> titles, ISet<string> held, bool allPaused, bool busy, bool running) =>
+        allPaused || busy || running ? null : titles.FirstOrDefault(x => !held.Contains(x));
+
+    /// "Mario Kart 8 Deluxe · 12,400 of 60,112" (being prepared), "South Park · waiting · 5,009" (its libraries; "1,200 of 5,009" once begun), "· paused", "· skipped".
+    public static string RowText(string name, int done, int total, bool active, bool held, bool skippedNow)
+    {
+        string N(int n) => n.ToString("N0", CultureInfo.InvariantCulture);
+        string count = total > 0 ? (done > 0 ? N(Math.Min(done, total)) + " of " + N(total) : N(total)) : done > 0 ? N(done) + " done" : "";
+        string state = active ? "" : skippedNow ? "skipped" : held ? "paused" : "waiting";
+        return string.Join(" · ", new[] { name, state, active && total > 0 ? N(Math.Min(done, total)) + " of " + N(total) : count }.Where(x => !string.IsNullOrEmpty(x)));
+    }
+
+    /// The log at a switch: "shader warm-up: South Park moved first by you (Mario Kart 8 Deluxe paused at 12,400 of 60,112)".
+    public static string SwitchLine(string chosen, string other, int done, int total) =>
+        "shader warm-up: " + chosen + " moved first by you" + (other == null ? "" : $" ({other} paused at {done.ToString("N0", CultureInfo.InvariantCulture)} of {total.ToString("N0", CultureInfo.InvariantCulture)})");
+
+    public static string Format(bool paused, IEnumerable<string> titles, IEnumerable<string> held, IEnumerable<string> skipped)
+    {
+        var sb = new System.Text.StringBuilder(Header).Append('\n').Append("paused\t").Append(paused ? "1" : "0").Append('\n');
+        foreach (var x in titles ?? Enumerable.Empty<string>()) sb.Append("title\t").Append(x).Append('\n');
+        foreach (var x in (held ?? Enumerable.Empty<string>()).OrderBy(x => x, StringComparer.Ordinal)) sb.Append("held\t").Append(x).Append('\n');
+        foreach (var x in (skipped ?? Enumerable.Empty<string>()).OrderBy(x => x, StringComparer.Ordinal)) sb.Append("skipped\t").Append(x).Append('\n');
+        return sb.ToString();
+    }
+
+    /// Null when the text is not a queue this reads. A bad or repeated title is dropped; a held title that is not in the queue is dropped.
+    public static (bool Paused, List<string> Titles, HashSet<string> Held, HashSet<string> Skipped)? Parse(string text)
+    {
+        if (string.IsNullOrEmpty(text)) return null;
+        var lines = text.Split('\n');
+        if (lines[0].TrimEnd('\r') != Header) return null;
+        bool paused = false;
+        var titles = new List<string>();
+        var held = new HashSet<string>(StringComparer.Ordinal);
+        var skipped = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var raw in lines.Skip(1))
+        {
+            var c = raw.TrimEnd('\r').Split('\t');
+            if (c.Length < 2) continue;
+            var v = Norm(c[1]);
+            if (c[0] == "paused") paused = c[1].Trim() == "1";
+            else if (!Ok(v)) continue;
+            else if (c[0] == "title" && !titles.Contains(v) && !skipped.Contains(v)) titles.Add(v);
+            else if (c[0] == "held") held.Add(v);
+            else if (c[0] == "skipped") { skipped.Add(v); titles.Remove(v); }
+        }
+        held.IntersectWith(titles);
+        return (paused, titles, held, skipped);
+    }
+}
