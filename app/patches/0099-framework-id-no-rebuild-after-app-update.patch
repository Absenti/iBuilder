diff -ruN t98/GameAppUi.cs t99/GameAppUi.cs
--- t98/GameAppUi.cs	2026-11-22 19:28:07
+++ t99/GameAppUi.cs	2026-11-22 19:39:41
@@ -22,13 +22,14 @@
 public enum BootRequestState { None, Armed, Attempted }
 
 /// Whether the framework on disk can be booted without a rebuild. NONE: there is none (or no extraction beside it).
-/// FRESH: this build of the app built it (Documents/gameapp.framework names the same build id). STALE: it exists, but
-/// another build of the app made it, or it predates the stamp: booting it would run an older host and rewrite.
+/// FRESH: this app may boot it as it is (Documents/gameapp.framework names this app's FRAMEWORK ID, or, for a stamp from before
+/// framework ids, the same build id: patch 0099). STALE: it exists, but an app with another framework id (another host, rewrite,
+/// profile or table: scripts/lib-hash.sh) made it, or it predates the stamp: booting it would run an older host and rewrite.
 public enum FrameworkState { None, Fresh, Stale }
 
 /// What gameapp_pipeline.py writes to Documents/gameapp.framework right after it signs a framework. `ExportOnly` (patch 0095): its `signature=adhoc-export` line: the chain found no
 /// .p12 here and signed the framework ad hoc, so the build is exported (the installer re-signs it), never played inside iBuilder until it is signed again with a .p12.
-public sealed record FrameworkStamp(string AppBuild, string Game, string Content = "", bool ExportOnly = false);
+public sealed record FrameworkStamp(string AppBuild, string Game, string Content = "", bool ExportOnly = false, string FrameworkId = "");
 
 /// What the main button does when tapped.
 public enum ActionKind { Busy, Import, Boot, Run, Export }
@@ -93,12 +94,13 @@
 
     // ---- the framework on disk ------------------------------------------------------------------------------
 
-    /// The stamp is `key=value` lines (app_build, game, built). Null when there is no stamp or it names no build.
+    /// The stamp is `key=value` lines (app_build, framework_id, game, built). Null when there is no stamp or it names no build.
     public static FrameworkStamp ParseFrameworkStamp(string content)
     {
         if (content == null) return null;
         string build = null, game = null, built = null;   // no content= line: a stamp from before builds recorded it
         bool exportOnly = false;   // patch 0095: signature=adhoc-export
+        string frameworkId = "";   // patch 0099: framework_id= (none in a stamp from before framework ids)
         foreach (var raw in content.Split('\n'))
         {
             var line = raw.Trim();
@@ -110,22 +112,35 @@
             else if (key == "game") game = value;
             else if (key == "content") built = value;
             else if (key == "signature") exportOnly = value == ExportOnlySignature;
+            else if (key == "framework_id") frameworkId = value;
         }
-        return string.IsNullOrEmpty(build) ? null : new FrameworkStamp(build, game ?? "", built, exportOnly);
+        return string.IsNullOrEmpty(build) ? null : new FrameworkStamp(build, game ?? "", built, exportOnly, frameworkId);
     }
 
     /// `onDisk`: the framework and the extraction it boots from are both there. `stampContent`: what
-    /// Documents/gameapp.framework says, null when it is missing or unreadable. `currentBuild`: this app's build id.
+    /// Documents/gameapp.framework says, null when it is missing or unreadable. `currentBuild`: this app's build id;
+    /// `currentFrameworkId`: this app's framework id (GameAppBuild.FrameworkId, patch 0099; "" for none).
     /// A framework with no usable stamp is STALE, not fresh: it predates builds being tracked, and the safe reading of
     /// "I cannot tell who built this" is "not this build".
-    public static FrameworkState ClassifyFramework(bool onDisk, string stampContent, string currentBuild)
+    public static FrameworkState ClassifyFramework(bool onDisk, string stampContent, string currentBuild, string currentFrameworkId = "")
     {
         if (!onDisk) return FrameworkState.None;
         var stamp = ParseFrameworkStamp(stampContent);
-        if (stamp == null || string.IsNullOrEmpty(currentBuild)) return FrameworkState.Stale;
-        return string.Equals(stamp.AppBuild, currentBuild, StringComparison.Ordinal)
+        if (stamp == null) return FrameworkState.Stale;
+        return FrameworkMatches(stamp.AppBuild, stamp.FrameworkId, currentBuild, currentFrameworkId)
             ? FrameworkState.Fresh
             : FrameworkState.Stale;
+    }
+
+    /// Patch 0099: whether a framework stamped `stampBuild` / `stampFrameworkId` is this app's to boot without a rebuild (the Rust chain's
+    /// state::framework_matches is the same rule). Both sides name a framework id: they must be equal, and the build ids do not matter (an
+    /// app update that changed nothing a built framework depends on keeps every built game playable: "Play", no rebuild). Otherwise (a stamp
+    /// from before framework ids): the build ids must be equal, as before. An empty id on this side never matches. Ordinal comparisons.
+    public static bool FrameworkMatches(string stampBuild, string stampFrameworkId, string currentBuild, string currentFrameworkId)
+    {
+        if (!string.IsNullOrEmpty(currentFrameworkId) && !string.IsNullOrEmpty(stampFrameworkId))
+            return string.Equals(stampFrameworkId, currentFrameworkId, StringComparison.Ordinal);
+        return !string.IsNullOrEmpty(currentBuild) && string.Equals(stampBuild, currentBuild, StringComparison.Ordinal);
     }
 
