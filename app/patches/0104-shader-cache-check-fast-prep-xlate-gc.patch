+/// The rules of GameWarmLogic.AutoWorkers stay first: none at thermal Serious or Critical, one in the background, and a core count chosen in "Shader preparation" wins over this.
+internal static class FastWarm
+{
+    public const string SettingKey = "shader_prep_fast";   // Documents/gameapp.settings.tsv, 1 or 0 (the default)
+    public const string Title = "Faster shader preparation";
