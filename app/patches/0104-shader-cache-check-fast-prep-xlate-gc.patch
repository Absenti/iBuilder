+/// Patch 0104 (B2): the translator's GC cost over one chain run, one line at its end. The counts are the process's (GC.CollectionCount), the translator being what allocates while a build
+/// translates (~2.7 MB a shader); `Forced` the compacting collections XlateEntry asks for itself (every 40 translations, and at each one below 1.5 GB left) and their own time, measured there,
+/// since GC.GetTotalPauseDuration may say 0 on this runtime.
+public static class TranslatorGc
+{
+    public readonly record struct Sample(int Gen0, int Gen1, int Gen2, TimeSpan Paused, long Translations, long Forced, TimeSpan ForcedTime);
+
+    public static Sample Now(long translations, long forced, TimeSpan forcedTime) =>
+        new Sample(GC.CollectionCount(0), GC.CollectionCount(1), GC.CollectionCount(2), GC.GetTotalPauseDuration(), translations, forced, forcedTime);
+
+    /// "translator GC: gen0 120, gen1 40, gen2 31 (30 forced, 12.4 s), paused 15.2 s, 1,200 translations"; null when the run translated nothing.
+    public static string Line(Sample a, Sample b)
+    {
+        long n = b.Translations - a.Translations;
+        if (n <= 0) return null;
+        string S(TimeSpan t) => t.TotalSeconds.ToString("F1", CultureInfo.InvariantCulture) + " s";
+        var paused = b.Paused - a.Paused;
+        return $"translator GC: gen0 {b.Gen0 - a.Gen0}, gen1 {b.Gen1 - a.Gen1}, gen2 {b.Gen2 - a.Gen2} ({b.Forced - a.Forced} forced, {S(b.ForcedTime - a.ForcedTime)}), "
+             + (paused > TimeSpan.Zero ? $"paused {S(paused)}" : "paused n/a (the runtime reports none)")
+             + $", {n.ToString("N0", CultureInfo.InvariantCulture)} translations";
+    }
+}
