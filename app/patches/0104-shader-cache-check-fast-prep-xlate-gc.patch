+/// Patch 0104 (B9): "Optimized translator (experimental)" (Settings › Build, off by default), saved as xlate_optimized 1/0 in Documents/gameapp.settings.tsv; the chain reads it at the start of
+/// every build (the Rust side). Smaller and faster shaders, but a game built with it may show graphics errors.
+public static class XlateOptimized
+{
+    public const string SettingKey = "xlate_optimized";
+    public const string Title = "Optimized translator (experimental)";
+    public const string Note = "Smaller and faster shaders, but experimental: a game built with it may show graphics errors. Applies to the next build; turn it off and rebuild if a game looks wrong.";
+}
