+/// Patch 0104 (W2): iOS's Metal shader cache (about 255 MB) is emptied at a reboot, a reinstall and an iOS update (developer.apple.com/forums/thread/659856). The markers (warmed.tsv,
+/// prepared.tsv) named only the app build and the chain, so after a reboot a game stayed "prepared" and its first Play compiled cold (1,061-1,708 s measured). Their first line now also names
+/// the boot (kern.boottime, seconds) and the OS build (kern.osversion) it was written under: "# warmed app_build <b> chain <c> boot <seconds> os <build>". With the setting "Check the shader
+/// cache" (on by default) a marker of another boot or OS build does not hold; off, only the app build and the chain count, as before. The epoch is always WRITTEN, whatever the setting.
+/// What the header cannot see (iOS emptied the cache for its own reasons) a probe at the warm-up's start sees: 3 libraries the markers say are done are compiled again and timed (Verdict).
+internal static class ShaderCacheCheck
+{
+    public const string SettingKey = "shader_cache_check";   // Documents/gameapp.settings.tsv, 1 (the default) or 0
+    public const string Title = "Check the shader cache";
+    public const string Note = "iOS empties its shader cache when the phone restarts or iOS is updated. On: a game prepared before that is prepared again, so its first play does not stop to compile.";
+
+    /// Two boot times this close are the same boot: iOS moves kern.boottime when it steps the clock (network time), never by a reboot's worth.
+    public const long BootSlackSeconds = 120;
+    /// A library the cache holds compiles in 1-4 ms (524.8 ms cold, then 1.4 ms, one library, iPhone 15 Pro); above this, every one of the probe, the cache was emptied.
+    public const double ColdMs = 50;
+    /// How many done libraries the probe compiles again (the first ones the markers name: the seed list's front, the first iOS keeps).
+    public const int ProbeCount = 3;
+    /// The file of games/<id>/ that says in which epoch the probe last reset the game's markers: a game found cold AGAIN in the same epoch is not reset again (iOS's cache may simply not
+    /// keep its libraries; resetting would prepare it for ever).
+    public const string ProbeFile = "cache_probe.tsv";
+
+    /// "boot 1763900000 os 23A341", or null when either is unknown (then nothing is checked against it).
+    public static string Epoch(long bootSeconds, string osBuild) =>
+        bootSeconds > 0 && !string.IsNullOrWhiteSpace(osBuild) && !osBuild.Trim().Contains(' ') ? $"boot {bootSeconds} os {osBuild.Trim()}" : null;
+
+    /// The header with the epoch after it (null epoch: the header as it is).
+    public static string WithEpoch(string header, string epoch) => epoch == null ? header : header + " " + epoch;
+
+    /// A marker's first line cut into the app build and chain part and the epoch part (null when it has none: a marker written before 0104).
+    public static (string Base, string Epoch) Split(string line)
+    {
+        line ??= "";
+        int i = line.LastIndexOf(" boot ", StringComparison.Ordinal);
+        return i < 0 ? (line, null) : (line.Substring(0, i), line.Substring(i + 1));
+    }
+
+    private static bool Parse(string epoch, out long boot, out string os)
+    {
+        boot = 0; os = null;
+        var p = (epoch ?? "").Split(' ');
+        if (p.Length != 4 || p[0] != "boot" || p[2] != "os" || !long.TryParse(p[1], NumberStyles.None, CultureInfo.InvariantCulture, out boot)) return false;
+        os = p[3];
+        return true;
+    }
+
+    /// Why a marker of epoch `was` does not hold now (`now`), or null when it does: "the phone restarted", "iOS was updated (23A341 to 23B82)", "it was written before the check".
+    public static string Changed(string was, string now)
+    {
+        if (now == null) return null;   // the epoch of this boot is unknown: nothing to check against
+        if (!Parse(was, out long b0, out string o0)) return "it was written before the check";
+        if (!Parse(now, out long b1, out string o1)) return null;
+        if (!string.Equals(o0, o1, StringComparison.Ordinal)) return $"iOS was updated ({o0} to {o1})";
+        return Math.Abs(b1 - b0) > BootSlackSeconds ? "the phone restarted" : null;
+    }
