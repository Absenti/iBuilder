# A player installed by FlareStore cannot complete a document picker: the folder picker opens and navigates, but "Open" returns nothing, and "Cancel" is the only button that closes it (iPhone 15 Pro, iOS 27.0.1,
# cable test 2026-11-19; the same picker call works in the main app installed by Xcode). What works is the copy the player made himself in Files: the .romfs from iBuilder > Exports into the player's own folder
# (a copy inside the phone is a clone: free space did not move), which the player finds in its Documents. So the player's first screen now says that, with an "Open Files" button that opens Files on its own
# folder, and the picker stays as a small second button for an install where it works; the export dialog says the same. Applies after 0058.
diff --color -ruN a/GameAppLibrary.cs b/GameAppLibrary.cs
--- a/GameAppLibrary.cs
+++ b/GameAppLibrary.cs
@@ -614,9 +614,14 @@
 
         playerPlay = new UIButton(UIButtonType.System) { AccessibilityIdentifier = "primary-action" };
         playerPlay.HeightAnchor.ConstraintEqualTo(64).Active = true;
-        playerPlay.TouchUpInside += (_, __) => { if (PlayerNeedsGameFiles) FindGameFiles(); else PrimaryTapped(); };
+        playerPlay.TouchUpInside += (_, __) => { if (PlayerNeedsGameFiles) ShowInFiles(Path.Combine(GameAppMain.Documents, "x")); else PrimaryTapped(); };
         playerStatus = Theme.Label("", Theme.Font(13, UIFontWeight.Medium), Theme.Muted, 0);
         playerStatus.TextAlignment = UITextAlignment.Center;
+        // The picker stays as a second way: it does not complete in a player installed by FlareStore (iOS 27.0.1: "Open" never returns, cable test 2026-11-19), where the copy in Files is the way.
+        playerPick = new UIButton(UIButtonType.System) { AccessibilityIdentifier = "player-pick-folder" };
+        playerPick.SetTitle("Pick the folder from iBuilder instead", UIControlState.Normal);
+        playerPick.TitleLabel.Font = Theme.Font(13, UIFontWeight.Medium);
+        playerPick.TouchUpInside += (_, __) => FindGameFiles();
 
         UIButton Tile(string name, out UILabel line, string id, Action tapped)
         {
@@ -650,7 +655,7 @@
         var footer = Theme.Label("Made with iBuilder", Theme.Font(12, UIFontWeight.Regular), Theme.Dim);
         footer.TextAlignment = UITextAlignment.Center;
 
