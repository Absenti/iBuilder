+    private volatile bool pauseRecorded;                     // the paused record is on disk (the system's task waits for it)
+    private PausedBuild resumedFrom;                         // the record of the pause this run resumes (PausedStore.Inherit)
+    private Timer stopNag;
+    private UIButton buildPause, buildResume, buildCancel, buildWatch;
+    private UIView buildStopRow;
+
+    private static string PausedPath => Path.Combine(GameAppMain.Documents, "gameapp.paused.tsv");
+
+    private void SavePaused()
+    {
