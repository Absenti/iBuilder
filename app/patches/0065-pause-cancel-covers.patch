diff -ruN a/GameAppStop.cs b/GameAppStop.cs
--- a/GameAppStop.cs
+++ b/GameAppStop.cs
@@ -0,0 +1,461 @@
+// gameapp/GameAppStop.cs -- Pause, Cancel and Resume of a running build: the state machine and the decisions, with no UIKit (the host harness compiles this file as it is; patch 0065).
+//
+// What the Rust chain gives (app/gameapp_shim_rust.c, docs/chain/PIPELINE-RUST.md):
+//   gameapp_request_stop(kind)   1 = pause, 2 = cancel, anything else withdraws; thread-safe, needs no handle; a cancel overrides a pause. The request is CLEARED when a run starts, so it is raised only while
+//                                gameapp_run_chain is on the stack; a Pause or Cancel pressed before that (the C# extraction of an NSP/XCI runs first, in the same process) is kept here (Pending) and applied
+//                                before the chain is called: nothing is started, the run ends as paused / cancelled at once.
+//   gameapp_run_chain() -> 131   paused: extract/, the rewrite cache, every finished shader in shadercache/ and the shader build's .work folder are kept, nothing is half written.
+//                       130      cancelled: the same state; the app decides what to delete (CancelPlan).
+//   Documents/shaders/<id>.work/stopped.by.user   "pause|cancel <iso time>", written only when stage 3 was cut; no gameapp.continue, no gameapp.killed: the app says "Paused" itself (Recovery).
+//   Resume = the chain called again with the same config (ResumePlan; a Switch 2 game also needs Documents/gameapp.continue.run or its 26 GB package is read again).
+//
+// The states (StopMachine):  Idle -> Running -> Pausing -> Paused -> Running (resume)
+//                                      Running|Pausing -> Cancelling -> Cancelled        Paused -> Cancelling -> Cancelled (no chain on the stack: only the cleanup)
+// Everything here is a function of plain values; GameAppStopUi.cs (the view controller's half) calls it and draws what comes back.
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+
+public enum StopState { Idle, Running, Pausing, Paused, Cancelling, Cancelled }
+
+/// The request, as gameapp_request_stop takes it.
+public enum StopKind { None = 0, Pause = 1, Cancel = 2 }
+
+/// Where a run is: the app's own extraction of an NSP/XCI (it cannot be interrupted: a stop waits for its end) or the chain (it stops at the next shader).
+public enum StopPhase { Extracting, Chain }
+
+/// What a run's end means.
+public enum StopOutcome { Finished, Failed, Paused, Cancelled }
+
+/// "Cancel and keep the extracted game (next build starts faster)" or "Cancel and free the space".
+public enum CancelChoice { KeepExtracted, FreeSpace }
+
+/// What a button press asks the app to do: Native = call gameapp_request_stop(Kind) now (off the main thread); Remembered = the chain is not running yet, the request waits for it; NoChain = nothing runs, the
+/// cleanup alone; Ignored = nothing (a second tap, a pause over a cancel, a stop of something that is not a build).
+public enum StopAct { Ignored, Native, Remembered, NoChain }
+
+public sealed record StopStep(StopAct Act, StopKind Kind);
+
+/// What to do just before gameapp_run_chain: Start it, or do not (a stop was asked for during the extraction).
+public sealed record ChainDecision(bool Start, StopKind Pending);
+
+public static class StopCodes
+{
+    /// gameapp_run_chain's results for a stop (passed through unchanged by the shim).
+    public const int Cancelled = 130, Paused = 131;
+    public static bool IsStop(int rc) => rc == Cancelled || rc == Paused;
+}
+
+/// The state of the build the user can stop. Thread-safe: the buttons are on the main thread, the chain's start and return are on the run's worker thread. Methods return what the caller must DO; they never
+/// call the library themselves (so the harness can run every transition).
+public sealed class StopMachine
+{
+    private readonly object gate = new object();
+    private StopState state = StopState.Idle;
+    private string game;
+    private StopPhase phase = StopPhase.Extracting;
+    private bool chainOnStack, stoppable = true, extracted;
+    private StopKind pending = StopKind.None;
+    private CancelChoice choice = CancelChoice.KeepExtracted;
+    private bool chainRan;
+
+    public StopState State { get { lock (gate) return state; } }
+    public string Game { get { lock (gate) return game; } }
+    public StopPhase Phase { get { lock (gate) return phase; } }
+    public bool ChainOnStack { get { lock (gate) return chainOnStack; } }
+    /// A request made before the chain was on the stack, waiting for it.
+    public StopKind Pending { get { lock (gate) return pending; } }
+    public CancelChoice Choice { get { lock (gate) return choice; } }
+    /// The app's extraction of this run ended well (or the run has none): extract/ holds this game.
+    public bool Extracted { get { lock (gate) return extracted; } }
+    /// The chain was entered in this run (it clears the previous build's stamp when it starts).
+    public bool ChainRan { get { lock (gate) return chainRan; } }
+
+    /// A run is going, a stop is being honoured, or a cleanup is going on: nothing else may start.
+    public bool Busy { get { lock (gate) return state is StopState.Running or StopState.Pausing or StopState.Cancelling; } }
+    /// The Pause / Cancel buttons of the running-build card.
+    public bool Stoppable { get { lock (gate) return stoppable && state is StopState.Running or StopState.Pausing or StopState.Cancelling; } }
+
+    /// A run starts (BeginRun: a new build, or the resume of a paused one). False when one is still going (the caller does not start another).
+    /// `stoppable`: a build (a boot of a built game is not stopped by Pause); `extracting`: the app's own extraction comes first.
+    public bool Begin(string gameFile, bool stoppable, bool extracting)
+    {
+        lock (gate)
+        {
+            if (state is StopState.Running or StopState.Pausing or StopState.Cancelling) return false;
+            state = StopState.Running;
+            game = gameFile;
+            this.stoppable = stoppable;
+            phase = extracting ? StopPhase.Extracting : StopPhase.Chain;
+            extracted = !extracting;
+            chainOnStack = false;
+            chainRan = false;
+            pending = StopKind.None;
+            choice = CancelChoice.KeepExtracted;
+            return true;
+        }
+    }
+
+    /// The Pause button (or the system ending the continued-processing task, which is a pause).
+    public StopStep Pause()
+    {
+        lock (gate)
+        {
+            if (state != StopState.Running || !stoppable) return new StopStep(StopAct.Ignored, StopKind.None);
+            state = StopState.Pausing;
+            if (chainOnStack) return new StopStep(StopAct.Native, StopKind.Pause);
+            pending = StopKind.Pause;
+            return new StopStep(StopAct.Remembered, StopKind.Pause);
+        }
+    }
+
+    /// The Cancel button, after the confirmation, with the choice of what to keep. A cancel overrides a pause. From Paused nothing runs: NoChain (the cleanup only).
+    public StopStep Cancel(CancelChoice what)
+    {
+        lock (gate)
+        {
+            if (state == StopState.Paused)
+            {
+                state = StopState.Cancelling;
+                choice = what;
+                chainOnStack = false;
+                return new StopStep(StopAct.NoChain, StopKind.Cancel);
+            }
+            if ((state != StopState.Running && state != StopState.Pausing) || !stoppable) return new StopStep(StopAct.Ignored, StopKind.None);
+            state = StopState.Cancelling;
+            choice = what;
+            if (chainOnStack) return new StopStep(StopAct.Native, StopKind.Cancel);
+            pending = StopKind.Cancel;
+            return new StopStep(StopAct.Remembered, StopKind.Cancel);
+        }
+    }
+
+    /// Just before gameapp_run_chain, on the worker thread: with a request waiting the chain is NOT started. Otherwise the chain is on the stack from here on (a button now raises the request itself).
+    public ChainDecision ChainStarting()
+    {
+        lock (gate)
+        {
+            if (pending != StopKind.None) return new ChainDecision(false, pending);
+            chainOnStack = true;
+            chainRan = true;
+            phase = StopPhase.Chain;
+            return new ChainDecision(true, StopKind.None);
+        }
+    }
+
+    /// The request to raise AGAIN, or None: the library clears a request at the start of its run, so one raised in the microseconds around that start would be lost. The app calls this every
+    /// two seconds while a stop is being honoured and raises what it says (raising twice is harmless: a cancel stays a cancel).
+    public StopKind Reassert()
+    {
+        lock (gate)
+        {
+            if (!chainOnStack) return StopKind.None;
+            return state == StopState.Cancelling ? StopKind.Cancel : state == StopState.Pausing ? StopKind.Pause : StopKind.None;
+        }
+    }
+
+    /// The extraction failed (the chain is not started): the run ends as a failure, whatever was asked.
+    public StopOutcome ExtractionFailed()
+    {
+        lock (gate) { Clear(); return StopOutcome.Failed; }
+    }
+
+    /// The chain was not started because a request was waiting: the run ends as paused (the extraction is done and kept) or cancelled (the cleanup follows; CleanupDone ends it).
+    public StopOutcome StoppedBeforeChain()
+    {
+        lock (gate)
+        {
+            extracted = true;
+            var kind = pending;
+            pending = StopKind.None;
+            if (kind == StopKind.Cancel || state == StopState.Cancelling) { state = StopState.Cancelling; return StopOutcome.Cancelled; }
+            state = StopState.Paused;
+            return StopOutcome.Paused;
+        }
+    }
+
+    /// gameapp_run_chain returned `rc` (or threw). 130 and 131 are not failures. A cancel wins over a pause that crossed it; a stop that came too late (the chain finished) is no stop.
+    public StopOutcome ChainReturned(int rc, bool threw)
+    {
+        lock (gate)
+        {
+            chainOnStack = false;
+            pending = StopKind.None;
+            if (threw) { Clear(); return StopOutcome.Failed; }
+            if (rc == StopCodes.Paused)
+            {
+                extracted = true;
+                if (state == StopState.Cancelling) return StopOutcome.Cancelled;
+                state = StopState.Paused;
+                return StopOutcome.Paused;
+            }
+            if (rc == StopCodes.Cancelled)
+            {
+                extracted = true;
+                state = StopState.Cancelling;   // the cleanup (the default choice when nobody chose) follows; CleanupDone ends it
+                return StopOutcome.Cancelled;
+            }
+            Clear();
+            return rc == 0 ? StopOutcome.Finished : StopOutcome.Failed;
+        }
+    }
+
+    /// The cleanup of a cancel is done (or there was none to do).
+    public bool CleanupDone()
+    {
+        lock (gate)
+        {
+            if (state != StopState.Cancelling || chainOnStack) return false;
+            state = StopState.Cancelled;
+            return true;
+        }
+    }
+
+    /// Forget a Paused / Cancelled state (another game was chosen, the build was deleted).
+    public void Forget()
+    {
+        lock (gate) if (state is StopState.Paused or StopState.Cancelled) Clear();
+    }
+
+    private void Clear() { state = StopState.Idle; chainOnStack = false; pending = StopKind.None; }
+}
+
+/// The words of the screen.
+public static class StopText
+{
+    private static readonly Regex Shaders = new Regex(@"\((\d+)/(\d+) shaders\)");
+
+    private static string Inv(FormattableString text) => text.ToString(CultureInfo.InvariantCulture);
+
+    /// "14,990 of 21,990 shaders" for the shader step, else the step in words ("rewrite the code for iPhone"), else null.
+    public static string Progress(string stageLine)
+    {
+        if (string.IsNullOrWhiteSpace(stageLine)) return null;
+        var s = GameAppUi.ParseStage(stageLine);
+        if (!s.Valid) return null;
+        var m = Shaders.Match(s.Text);
+        if (m.Success && long.TryParse(m.Groups[1].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var done) && long.TryParse(m.Groups[2].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var total))
+            return Inv($"{done:N0} of {total:N0} shaders");
+        if (s.Of == 5 && s.Step >= 0 && s.Step < GameAppUi.StepNames.Length) return char.ToLowerInvariant(GameAppUi.StepNames[s.Step][0]) + GameAppUi.StepNames[s.Step].Substring(1);
+        return null;
+    }
+
+    /// "Paused · 14,990 of 21,990 shaders" (the card), "Paused" alone when nothing is known of the progress.
+    public static string PausedLine(string stageLine, bool extractedOnly = false)
+    {
+        var progress = Progress(stageLine);
+        if (progress == null) progress = extractedOnly ? "the game is read" : null;
+        return progress == null ? "Paused" : "Paused · " + progress;
+    }
+
+    /// "Paused · 68%" (the chip on a library tile, which has no room for the line); "Paused" when the progress is not known.
+    public static string PausedChip(string stageLine)
+    {
+        var s = GameAppUi.ParseStage(stageLine);
+        return s.Valid && s.Fraction > 0 ? Inv($"Paused · {Math.Round(s.Fraction * 100):0}%") : "Paused";
+    }
+
+    /// The card's line while a stop is being honoured. The extraction cannot be cut: it is finished first; the chain stops after the shader it is on.
+    public static string Pausing(StopPhase phase, string stageLine)
+    {
+        if (phase == StopPhase.Extracting) return "Pausing… (finishes reading the game)";
+        var s = GameAppUi.ParseStage(stageLine);
+        return s.Valid && s.Of == 5 && s.Step == 3 ? "Pausing… (finishes the current shader)" : "Pausing… (finishes the current step)";
+    }
+
+    public static string Cancelling() => "Cancelling…";
+
+    public static string Cancelled() => "Cancelled";
+
+    /// The dialog's second choice: "Cancel and free the space (4.2 GB)", the size from the cached folder sizes (-1 = not known yet); with a part not known it says "about", with none it says no number.
+    public static string FreeChoice(long extractBytes, long workBytes)
+    {
+        long known = Math.Max(0, extractBytes) + Math.Max(0, workBytes);
+        bool all = extractBytes >= 0 && workBytes >= 0;
+        if (extractBytes < 0 && workBytes < 0) return "Cancel and free the space";
+        return "Cancel and free the space (" + (all ? "" : "at least ") + GameAppUi.SizeText(known) + ")";
+    }
+
+    public const string KeepChoice = "Cancel and keep the extracted game (next build starts faster)";
+}
+
+/// What a cancel deletes: only what the build made, never the shader cache (every finished shader), games/<id>/ (settings, saves, icon, cover, mods, rewrite cache) or the game file.
+public sealed record CancelPlan(IReadOnlyList<string> Folders, IReadOnlyList<string> Files)
+{
+    public const string Extract = "extract", Framework = "DmGameProbe.framework", FrameworkStamp = "gameapp.framework";
+
+    /// Paths relative to Documents. `tid`: the game's id (null when the file name has none and it was never read: its .work folder cannot be named, and is not guessed).
+    /// `extractIsThis`: extract/ still holds THIS game's extraction (a paused build whose extraction another game's build replaced has no extract/ to delete: that is the other game's). `frameworkIsPartial`: a framework folder is on disk and no finished build of ANOTHER game owns it (the stamp is absent or names this game). `chainRan`: the chain started in this run (it removed the previous
+    /// build's stamp itself); when it did not, the previous build's stamp is removed here, because the extraction has already replaced that build's extract/.
+    public static CancelPlan For(CancelChoice choice, string tid, bool frameworkIsPartial, bool chainRan, bool extractIsThis = true)
+    {
+        var folders = new List<string>();
+        var files = new List<string>();
+        if (!string.IsNullOrEmpty(tid)) folders.Add(StopFiles.WorkFolder(tid));
+        if (!extractIsThis) return new CancelPlan(folders, files);   // extract/ and the framework are another game's now (a later build replaced this game's extraction): only this game's own work folder goes
+        if (choice == CancelChoice.FreeSpace)
+        {
+            folders.Add(Extract);
+            if (frameworkIsPartial) folders.Add(Framework);
+        }
+        if (choice == CancelChoice.FreeSpace || !chainRan) files.Add(FrameworkStamp);
+        return new CancelPlan(folders, files);
+    }
+
+    /// The paths that must never be in a plan (the tests check every plan against them): the shader cache, games/, the game file.
+    public static bool Forbidden(string relative, string gameFile)
+    {
+        if (string.IsNullOrEmpty(relative)) return true;
+        var p = relative.Replace('\\', '/').Trim('/');
+        return p == "shadercache" || p.StartsWith("shadercache/", StringComparison.Ordinal)
+            || p == "games" || p.StartsWith("games/", StringComparison.Ordinal)
+            || p == "Documents" || p == "." || p.Contains("..")
+            || (gameFile != null && p == gameFile)
+            || p == "prod.keys" || p == "shaders" || (p.StartsWith("shaders/", StringComparison.Ordinal) && !p.EndsWith(".work", StringComparison.Ordinal));
+    }
+}
+
+/// The names of what the chain leaves.
+public static class StopFiles
+{
+    public const string Marker = "stopped.by.user";
+
+    /// `shaders/<id>.work`, relative to Documents.
+    public static string WorkFolder(string tid) => "shaders/" + tid + ".work";
+
+    public static string MarkerPath(string tid) => WorkFolder(tid) + "/" + Marker;
+
+    /// The marker's text: "pause 2026-11-20T01:02:03Z" or "cancel ...". Null kind for anything else.
+    public static (StopKind Kind, string At) ParseMarker(string text)
+    {
+        if (string.IsNullOrWhiteSpace(text)) return (StopKind.None, null);
+        var parts = text.Trim().Split(new[] { ' ', '\t', '\n' }, 2, StringSplitOptions.RemoveEmptyEntries);
+        var kind = parts[0] == "pause" ? StopKind.Pause : parts[0] == "cancel" ? StopKind.Cancel : StopKind.None;
+        return (kind, parts.Length > 1 ? parts[1].Trim() : null);
+    }
+
+    /// Documents/gameapp.continue.run for a Switch 2 or an already extracted game: the chain reads it once (take_continue). NEVER gameapp.continue: a launch would continue that by itself.
+    public static string ContinueRunText(string game, int stage, string why) => Inv($"game={game}\nstage={stage}\nwhy={why}\n");
+
+    private static string Inv(FormattableString text) => text.ToString(CultureInfo.InvariantCulture);
+}
+
+/// A build paused by the person: what Resume needs and what the cards say.
+public sealed record PausedBuild(string Game, string Tid, bool Extracted, int StageNumber, string StageLine, string At);
+
+/// Documents/gameapp.paused.tsv: the paused builds, one line each (game, id, extracted 0/1, stage number, time, the last stage line). The chain writes a marker only when stage 3 was cut; a pause during the
+/// extraction or the rewrite leaves none, and the progress ("14,990 of 21,990 shaders") is the app's to remember.
+public static class PausedStore
+{
+    public static List<PausedBuild> Parse(string text)
+    {
+        var list = new List<PausedBuild>();
+        foreach (var raw in (text ?? "").Split('\n'))
+        {
+            var line = raw.TrimEnd('\r');
+            if (line.Length == 0 || line.StartsWith("#", StringComparison.Ordinal)) continue;
+            var p = line.Split('\t');
+            if (p.Length < 6 || p[0].Length == 0 || list.Any(r => r.Game == p[0])) continue;
+            int.TryParse(p[3], NumberStyles.None, CultureInfo.InvariantCulture, out var n);
+            list.Add(new PausedBuild(p[0], p[1].Length == 0 ? null : p[1], p[2] == "1", n, p[5].Length == 0 ? null : p[5], p[4]));
+        }
+        return list;
+    }
+
+    public static string Format(IEnumerable<PausedBuild> list)
+    {
+        var sb = new StringBuilder("# paused builds: game, title id, extract/ holds it (0/1), stage number, paused at, last stage line\n");
+        foreach (var r in list)
+            sb.Append(Clean(r.Game)).Append('\t').Append(Clean(r.Tid)).Append('\t').Append(r.Extracted ? '1' : '0').Append('\t').Append(r.StageNumber.ToString(CultureInfo.InvariantCulture))
+              .Append('\t').Append(Clean(r.At)).Append('\t').Append(Clean(r.StageLine)).Append('\n');
+        return sb.ToString();
+    }
+
+    private static string Clean(string s) => (s ?? "").Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
+
+    /// Adds or replaces the game's record.
+    public static List<PausedBuild> Upsert(IEnumerable<PausedBuild> list, PausedBuild record)
+    {
+        var next = list.Where(r => r.Game != record.Game).ToList();
+        next.Add(record);
+        return next;
+    }
+
+    public static List<PausedBuild> Remove(IEnumerable<PausedBuild> list, string game) => list.Where(r => r.Game != game).ToList();
+
+    /// Another game's run replaced extract/: the others' extraction is gone, a resume of them reads their game again (their shaders are kept all the same).
+    public static List<PausedBuild> ExtractReplacedBy(IEnumerable<PausedBuild> list, string game) =>
+        list.Select(r => r.Game == game || !r.Extracted ? r : r with { Extracted = false }).ToList();
+
+    /// A pause pressed before the RESUMED run wrote a stage line of its own (it is in the seconds the chain skips what is done) knows nothing new: it keeps what the earlier pause knew, as long as extract/
+    /// was still that game's (a Switch 2 package is not read again for it).
+    public static PausedBuild Inherit(PausedBuild fresh, PausedBuild previous)
+    {
+        if (previous == null || !previous.Extracted || fresh.StageNumber > 0 || fresh.Game != previous.Game) return fresh;
+        return fresh with { Extracted = true, StageNumber = previous.StageNumber, StageLine = previous.StageLine };
+    }
+
+    /// The record a pause leaves.
+    public static PausedBuild For(string game, string tid, bool extracted, string stageLine, DateTime now)
+    {
+        var s = GameAppUi.ParseStage(stageLine);
+        return new PausedBuild(game, tid, extracted, s.Valid ? s.Step : 0, string.IsNullOrWhiteSpace(stageLine) ? null : stageLine.Trim(), now.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture));
+    }
+}
+
+/// One game of the library as the launch finds it on disk.
+public sealed record RecoveryGame(string Game, string Tid, string MarkerText);
+
+/// What the launch can see: gameapp.killed (the game iOS ended: that flow is not a pause), the game whose finished framework is on disk, the paused list's text, the games with their markers.
+public sealed record RecoveryFacts(string KilledGame, string FreshFrameworkGame, string PausedText, IReadOnlyList<RecoveryGame> Games);
+
+public sealed record Recovery(List<PausedBuild> Paused, List<string> CancelledWork, bool StoreChanged);
+
+public static class StopRecovery
+{
+    /// The paused builds after a launch, from the files: a game is paused when the shader build's marker says "pause" (or the app's own list says so: a pause before stage 3), gameapp.killed does not name it (iOS
+    /// ended that run: the "interrupted, resume" flow stays as it is) and its framework is not built. A marker that says "cancel" is a cancel whose cleanup never finished: its .work folder is to be removed
+    /// (the one part both choices have in common).
+    public static Recovery Rebuild(RecoveryFacts f)
+    {
+        var records = PausedStore.Parse(f.PausedText);
+        var paused = new List<PausedBuild>();
+        var cancelled = new List<string>();
+        foreach (var g in f.Games ?? Array.Empty<RecoveryGame>())
+        {
+            var record = records.FirstOrDefault(r => r.Game == g.Game);
+            var (kind, at) = string.IsNullOrEmpty(g.Tid) ? (StopKind.None, null) : StopFiles.ParseMarker(g.MarkerText);
+            if (kind == StopKind.Cancel) { cancelled.Add(g.Tid); continue; }
+            if (f.KilledGame == g.Game || f.FreshFrameworkGame == g.Game) continue;
+            if (kind != StopKind.Pause && record == null) continue;
+            paused.Add(record != null ? record with { Tid = string.IsNullOrEmpty(g.Tid) ? record.Tid : g.Tid } : new PausedBuild(g.Game, g.Tid, false, 0, null, at));
+        }
+        bool changed = !PausedStore.Format(paused).Equals(PausedStore.Format(records), StringComparison.Ordinal);
+        return new Recovery(paused, cancelled, changed);
+    }
+}
+
+public enum ResumeKind { Fresh, Continue }
+
+/// How a paused build starts again.
+public sealed record ResumePlan(ResumeKind Kind, int Stage)
+{
+    /// Fresh: the whole run again (the extraction, or the package read; the shaders already built still come from the cache and the .work folder). Continue: the chain on the files already in extract/, with the
+    /// continuation file for a Switch 2 package (stage 2 or later: the chain does not read it again when ExeFS/main and RomFS.img are there; a stage below 1 means the read itself was cut: it is done again).
+    public static ResumePlan Decide(bool isNup, PausedBuild p)
+    {
+        if (p == null || !p.Extracted) return new ResumePlan(ResumeKind.Fresh, 0);
+        if (isNup) return p.StageNumber >= 1 ? new ResumePlan(ResumeKind.Continue, Math.Max(2, p.StageNumber)) : new ResumePlan(ResumeKind.Fresh, 0);
+        return new ResumePlan(ResumeKind.Continue, Math.Max(1, p.StageNumber));
+    }
+}
+
+/// What "Start the queue" does about a paused build: it is never restarted behind the person's back.
+public sealed record QueueStartPlan(QueueItem PausedFirst, QueueItem NextQueued)
+{
+    public static QueueStartPlan For(BuildQueueState state) =>
+        new QueueStartPlan(state.Items.FirstOrDefault(i => i.State == BuildQueue.Paused), BuildQueue.Next(state));
+}
