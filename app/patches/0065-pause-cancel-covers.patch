+
+    /// From the files: which builds are paused (and which cancel left its work folder behind). Before the first screen is drawn; a few small reads, one stat a game.
+    private void RecoverStoppedBuilds()
+    {
+        if (GameExport.IsPlayer || running) return;
+        try
+        {
+            var docs = GameAppMain.Documents;
+            string killed = null;
+            try { if (File.Exists(KilledPath)) killed = KeyOf(File.ReadAllText(KilledPath), "game"); } catch (Exception) { }
+            var facts = GatherFacts();
+            var games = (facts.Games ?? new List<string>()).Select(g =>
+            {
+                var tid = GameAppUi.BaseTitleIdOf(g);
+                string marker = null;
+                if (tid != null)
+                    try { var p = Path.Combine(docs, StopFiles.MarkerPath(tid)); if (File.Exists(p)) marker = File.ReadAllText(p); } catch (Exception) { }
+                return new RecoveryGame(g, tid, marker);
+            }).ToList();
+            string text = null;
+            try { if (File.Exists(PausedPath)) text = File.ReadAllText(PausedPath); } catch (Exception) { }
+            var found = StopRecovery.Rebuild(new RecoveryFacts(string.IsNullOrEmpty(killed) ? null : killed, facts.Framework == FrameworkState.Fresh ? facts.FrameworkGame : null, text, games));
+            pausedBuilds = found.Paused;
+            if (found.StoreChanged) SavePaused();
+            foreach (var p in found.Paused) Write($"paused build: {GameAppUi.DisplayName(p.Game)}: {StopText.PausedLine(p.StageLine)} (Resume is on the Build tab)");
+            foreach (var tid in found.CancelledWork)
+            {
+                Write($"cancelled build: removing the work folder it left ({StopFiles.WorkFolder(tid)}) in the background");
+                DeleteFolderInBackground(Path.Combine(docs, StopFiles.WorkFolder(tid)), error => { if (error != null) Write($"cancelled build: the work folder could not be removed: {error}"); });
+            }
+        }
+        catch (Exception error) { Write($"paused builds: could not be read ({error.GetType().Name}: {error.Message})"); }
+    }
+
+    // ---- the run ------------------------------------------------------------------------------------------------------------
+
+    /// BeginRun: a run starts (a new build or a resume). The game's pause is over; extract/ is this game's now, so another paused game's extraction is gone.
+    private void StopBegin(string name, bool bootOnly, bool extracting)
+    {
+        runOutcome = StopOutcome.Finished;
+        pauseRecorded = false;
+        resumedFrom = bootOnly ? null : pausedBuilds.FirstOrDefault(r => r.Game == name);
+        stop.Begin(name, stoppable: !bootOnly, extracting);
+        if (bootOnly) return;
+        var next = PausedStore.ExtractReplacedBy(PausedStore.Remove(pausedBuilds, name), name);
+        if (PausedStore.Format(next) != PausedStore.Format(pausedBuilds)) { pausedBuilds = next; SavePaused(); }
+    }
+
+    /// Finish(): true when the run ended because the person stopped it. A pause is kept (the record, the queue, the system's task), a cancel does its cleanup; neither is a failure.
+    private bool StopEnding()
+    {
+        stopNag?.Dispose();
+        stopNag = null;
+        switch (runOutcome)
+        {
+            case StopOutcome.Paused: RecordPaused(); return true;
+            case StopOutcome.Cancelled: ApplyCancel(stop.Game ?? lastRunGame, stop.Choice, stop.ChainRan); return true;
+            default: return false;
+        }
+    }
+
+    private void RecordPaused()
+    {
+        var game = stop.Game ?? lastRunGame;
+        var tid = GameAppUi.BaseTitleIdOf(game);
+        var record = PausedStore.Inherit(PausedStore.For(game, tid, stop.Extracted, lastStage, DateTime.UtcNow), resumedFrom);
+        if (GameAppUi.IsNup(game)) record = record with { Extracted = record.StageNumber >= 1 };   // a Switch 2 package is read by the chain itself: it was read when the chain got to a stage of its own
+        pausedBuilds = PausedStore.Upsert(pausedBuilds, record);
+        SavePaused();
+        Write($"build paused: {GameAppUi.DisplayName(game)} · {StopText.PausedLine(lastStage)}. What was finished is kept (the extraction, the rewrite, every finished shader); Resume continues from it.");
+        QueuePaused(game, StopText.PausedLine(lastStage));
+        pauseRecorded = true;
+    }
+
+    private bool FrameworkIsPartial(string game)
+    {
+        if (!Directory.Exists(Path.Combine(GameAppMain.Documents, CancelPlan.Framework))) return false;
+        try
+        {
+            var stamp = GameAppUi.ParseFrameworkStamp(File.ReadAllText(FrameworkStampPath));
+            return stamp == null || string.IsNullOrEmpty(stamp.Game) || stamp.Game == game;
+        }
+        catch (Exception) { return true; }   // no stamp: nobody's finished build
+    }
+
+    /// A cancel: the run was cancelled (or a paused build is). What goes depends on the person's choice (CancelPlan); shadercache/, games/<id>/ and the game file never.
+    private void ApplyCancel(string game, CancelChoice choice, bool chainRan, bool extractIsThis = true)
+    {
+        var tid = GameAppUi.BaseTitleIdOf(game);
+        var plan = CancelPlan.For(choice, tid, FrameworkIsPartial(game), chainRan, extractIsThis);
+        pausedBuilds = PausedStore.Remove(pausedBuilds, game);
+        SavePaused();
+        QueueCancelled(game);
+        foreach (var rel in plan.Files)
+            try { var path = Path.Combine(GameAppMain.Documents, rel); if (File.Exists(path)) File.Delete(path); } catch (Exception) { }
+        Write($"build cancelled: {GameAppUi.DisplayName(game)} · {(choice == CancelChoice.FreeSpace ? "freeing the space: " : "keeping the extracted game: ")}{(plan.Folders.Count == 0 ? "nothing to remove" : string.Join(", ", plan.Folders))} (removed in the background)");
+        if (plan.Folders.Count == 0) { CancelCleanupFinished(game); return; }
+        int left = plan.Folders.Count;
+        foreach (var rel in plan.Folders)
+            DeleteFolderInBackground(Path.Combine(GameAppMain.Documents, rel), error =>
+            {
+                if (error != null) Write($"cancel: {rel} could not be removed: {error}");
+                if (--left == 0) CancelCleanupFinished(game);
+            });
+    }
+
+    private void CancelCleanupFinished(string game)
+    {
+        stop.CleanupDone();   // Cancelling -> Cancelled
+        Write($"cancelled: {GameAppUi.DisplayName(game)}");
+        RefreshScreen();
+        UpdateNowCard(null);
+    }
+
+    // ---- the queue ----------------------------------------------------------------------------------------------------------
+
+    /// Pausing stops the queue's auto start and keeps the item queued, as paused.
+    private void QueuePaused(string game, string note)
+    {
+        if (buildQueue.Items.Any(i => i.Game == game)) BuildQueue.Pause(buildQueue, game, note);
+        queueGame = null;
+        queueWanted = false;
+        buildQueue.AutoStart = false;
+        UIApplication.SharedApplication.IdleTimerDisabled = false;
+        SaveBuildQueue();
+    }
+
+    /// Cancelling removes the item from the queue and stops the queue.
+    private void QueueCancelled(string game)
+    {
+        BuildQueue.Cancelled(buildQueue, game);
+        queueGame = null;
+        queueWanted = false;
+        UIApplication.SharedApplication.IdleTimerDisabled = false;
+        SaveBuildQueue();
+    }
+
+    /// "Start the queue" with a paused build in it: it is not restarted behind the person's back. Asks; true when it did (the caller stops).
+    private bool AskAboutPausedInQueue()
+    {
+        var plan = QueueStartPlan.For(buildQueue);
+        if (plan.PausedFirst == null) return false;
+        var game = plan.PausedFirst.Game;
+        var name = GameAppUi.DisplayName(game);
+        var a = UIAlertController.Create($"{name} is paused",
+            $"{StopText.PausedLine(pausedBuilds.FirstOrDefault(r => r.Game == game)?.StageLine)}. Resume it now, and the queue goes on after it" + (plan.NextQueued != null ? ", or start the queue without it." : "."),
+            UIAlertControllerStyle.Alert);
+        a.AddAction(UIAlertAction.Create("Resume " + name, UIAlertActionStyle.Default, _ => ResumePaused(game)));
+        if (plan.NextQueued != null)
+            a.AddAction(UIAlertAction.Create("Start without it", UIAlertActionStyle.Default, _ => ToggleQueue(skipPausedQuestion: true)));
+        a.AddAction(UIAlertAction.Create("Not now", UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(a);
+        return true;
+    }
+
+    // ---- the buttons --------------------------------------------------------------------------------------------------------
+
+    private void RaiseStop(StopKind kind)
+    {
+        Task.Run(() =>
+        {
+            try { GameStopNative.gameapp_request_stop((int) kind); }
+            catch (Exception error) { BeginInvokeOnMainThread(() => Write($"stop: the request could not be raised ({error.GetType().Name}: {error.Message})")); }
+        });
+    }
+
+    private void StartStopNag()
+    {
+        stopNag?.Dispose();
+        stopNag = new Timer(_ =>
+        {
+            var kind = stop.Reassert();
+            if (kind != StopKind.None) RaiseStop(kind);
+        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
+    }
+
+    private void PausePressed()
+    {
+        var step = stop.Pause();
+        if (step.Act == StopAct.Ignored) return;
+        if (step.Act == StopAct.Native) RaiseStop(step.Kind);
+        StartStopNag();
+        Write(step.Act == StopAct.Native ? "pause asked for: the build stops after the shader it is on, and keeps what it finished"
+                                         : "pause asked for: the game is still being read; the build stops as soon as that is done (the chain is not started)");
+        RefreshStopViews();
+    }
+
+    private void RefreshStopViews()
+    {
+        UpdateNowCard(null);
+        RefreshBuildScreen();
+    }
+
+    /// The dialog of a cancel: what to keep. The space it frees is from the cached folder sizes (the extraction and the shader build's work folders), never a walk.
+    private void AskCancel(string game)
+    {
+        if (game == null) return;
+        bool live = running && stop.Game == game;
+        if (live && !stop.Stoppable) return;
+        var paused = live ? null : PausedOf(game, null);
+        if (!live && paused == null) return;
+        if (!live && running) { Write("cancel: another build is running: its extraction is in extract/; cancel this one when that has ended"); return; }
+        sizes.Request();
+        var name = GameAppUi.DisplayName(game);
+        bool extractIsThis = live || paused.Extracted;   // a paused build whose extraction another game's build replaced has no extract/ of its own to keep or free
+        var a = UIAlertController.Create($"Cancel the build of {name}?",
+            (live ? "The build stops after the shader it is on. " : "") + "Every shader already finished stays in the shader cache; the game's settings, saves, cover and mods are never touched. "
+            + (extractIsThis ? "Choose what happens to the files this build made." : "The extracted game belongs to another build now and is not touched: only this game's shader work folder goes."),
+            UIAlertControllerStyle.Alert);
+        if (extractIsThis)
+        {
+            a.AddAction(UIAlertAction.Create(StopText.KeepChoice, UIAlertActionStyle.Default, _ => CancelChosen(game, CancelChoice.KeepExtracted)));
+            a.AddAction(UIAlertAction.Create(StopText.FreeChoice(sizes.Get(FolderSizes.Extract), sizes.Get(FolderSizes.ShaderWork)), UIAlertActionStyle.Destructive, _ => CancelChosen(game, CancelChoice.FreeSpace)));
+        }
+        else a.AddAction(UIAlertAction.Create(StopText.FreeChoice(0, sizes.Get(FolderSizes.ShaderWork)), UIAlertActionStyle.Destructive, _ => CancelChosen(game, CancelChoice.KeepExtracted)));
+        a.AddAction(UIAlertAction.Create(live ? "Keep building" : "Not now", UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(a);
+    }
+
+    private void CancelChosen(string game, CancelChoice choice)
+    {
+        if (running && stop.Game == game)
+        {
+            var step = stop.Cancel(choice);
+            if (step.Act == StopAct.Ignored) return;
+            if (step.Act == StopAct.Native) RaiseStop(StopKind.Cancel);
+            StartStopNag();
+            Write("cancel asked for: the build stops after the shader it is on" + (step.Act == StopAct.Remembered ? " (the game is still being read; the chain is not started)" : ""));
+            RefreshStopViews();
+            return;
+        }
+        var record = pausedBuilds.FirstOrDefault(r => r.Game == game);
+        if (record == null || running) return;
+        bool inSession = stop.State == StopState.Paused && stop.Game == game;
+        if (inSession) stop.Cancel(choice);   // Paused -> Cancelling: nothing runs, only the cleanup
+        ApplyCancel(game, choice, inSession ? stop.ChainRan : record.StageNumber >= 1, extractIsThis: inSession || record.Extracted);
+        UpdateNowCard(null);
+        RefreshScreen();
+    }
+
+    /// Resume: the chain again on what was kept. The queue goes on after it when the game was queued.
+    private void ResumePaused(string game)
+    {
+        if (running) return;
+        if (deletes.Busy) { Write("a delete is still going: try again in a moment"); return; }
+        var record = pausedBuilds.FirstOrDefault(r => r.Game == game);
+        if (record == null) { selected = game; PrimaryTapped(); return; }
+        if (AskIfHot(() => ResumePaused(game))) return;
+        selected = game;
+        var plan = ResumePlan.Decide(GameAppUi.IsNup(game), record);
+        if (pythonRanThisProcess)   // a run already came back in this process: the existing restart flows do it (gameapp.args for a build from the start, gameapp.continue for a continuation)
+        {
+            if (plan.Kind == ResumeKind.Continue) AskToRestartToResume(game, plan); else SetUpAndPlay(game);
+            return;
+        }
+        if (buildQueue.Items.Any(i => i.Game == game && i.State == BuildQueue.Paused))
+        {
+            BuildQueue.MarkRunning(buildQueue, game);
+            queueGame = game;
+            queueWanted = true;
+            UIApplication.SharedApplication.IdleTimerDisabled = true;
+            SaveBuildQueue();
+            Write("build queue: continues with the resumed build");
+        }
+        Write($"resuming the build of {GameAppUi.DisplayName(game)} ({(plan.Kind == ResumeKind.Continue ? "on the files kept in Documents/extract" : "from the start: the shaders already finished come from the cache")})");
+        if (plan.Kind == ResumeKind.Continue) StartContinuedBuild(game, plan.Stage, "paused");
+        else SetUpAndPlay(game);
+        RefreshScreen();
+    }
+
+    /// A build already ran in this process (the runtime is started once per process): the app closes, and the next launch resumes by itself (gameapp.continue, the file the launch already reads).
+    private void AskToRestartToResume(string game, ResumePlan plan)
+    {
+        var a = UIAlertController.Create("GameApp starts again", "A run already happened in this session. GameApp closes; open it again and the build resumes by itself.", UIAlertControllerStyle.Alert);
+        a.AddAction(UIAlertAction.Create("Close", UIAlertActionStyle.Default, _ =>
+        {
+            try
+            {
+                File.WriteAllText(ContinuePath, $"game={game}\nstage={plan.Stage}\n");   // the file the launch reads (ContinueBuildAtLaunch): the person asked for it just now
+                Write($"resume of {game}: the app closes and the next launch does it");
+            }
+            catch (Exception error) { Write($"could not record the request: {error.Message}"); return; }
+            kill(getpid(), 15);
+        }));
+        a.AddAction(UIAlertAction.Create("Not now", UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(a);
+    }
+
+    // ---- the Build tab's card ------------------------------------------------------------------------------------------------
+
+    /// The card at the top of the Build tab: the running build (Pause, Cancel), a build being stopped (the same, disabled, with the words), or the paused one (Resume, Cancel). `facts` may be null.
+    private void UpdateNowCard(UiFacts facts)
+    {
+        if (buildNowCard == null || buildNowLine == null) return;
+        if (running)
+        {
+            var s = GameAppUi.ParseStage(lastStage);
+            var name = GameAppUi.DisplayName(selected ?? "");
+            var state = stop.State;
+            if (state == StopState.Pausing) buildNowLine.Text = name + "\n" + StopText.Pausing(stop.Phase, lastStage);
+            else if (state == StopState.Cancelling) buildNowLine.Text = name + "\n" + StopText.Cancelling();
+            else
+            {
+                var step = GameAppUi.BuildSteps(lastStage, stepStarts, DateTime.Now).FirstOrDefault(r => r.State == GameAppUi.StepState.Now);
+                buildNowLine.Text = $"{name} · {Math.Round(s.Fraction * 100):0}% · {step?.Name ?? "Starting"} · {GameAppUi.FormatElapsed(DateTime.Now - startedAt)}";
+            }
+            buildNowBar.Progress = (float) Math.Max(0.02, s.Fraction);
+            buildNowCard.Hidden = false;
+            bool stoppable = stop.Stoppable;
+            buildStopRow.Hidden = !stoppable;
+            buildPause.Hidden = false; buildResume.Hidden = true; buildCancel.Hidden = false;
+            buildPause.Enabled = buildCancel.Enabled = state == StopState.Running;   // while a stop is being honoured both are off: 'Pausing…' / 'Cancelling…' is the answer
+            buildWatch.Hidden = false;
+            return;
+        }
+        if (stop.State == StopState.Cancelling)
+        {
+            buildNowCard.Hidden = false;
+            buildNowLine.Text = GameAppUi.DisplayName(stop.Game ?? "") + "\n" + StopText.Cancelling();
+            buildStopRow.Hidden = true; buildWatch.Hidden = true;
+            return;
+        }
+        var paused = CardPaused(facts ?? GatherFacts());
+        buildNowCard.Hidden = paused == null;
+        if (paused == null) return;
+        var ps = GameAppUi.ParseStage(paused.StageLine);
+        buildNowLine.Text = GameAppUi.DisplayName(paused.Game) + "\n" + StopText.PausedLine(paused.StageLine);
+        buildNowBar.Progress = (float) Math.Max(0.02, ps.Valid ? ps.Fraction : 0);
+        buildStopRow.Hidden = false;
+        buildPause.Hidden = true; buildResume.Hidden = false; buildCancel.Hidden = false;
+        buildResume.Enabled = buildCancel.Enabled = !deletes.Busy;
+        buildWatch.Hidden = true;
+    }
+
+    /// The paused build the card shows: the one that was just paused, else the latest.
+    private PausedBuild CardPaused(UiFacts facts)
+    {
+        PausedBuild best = null;
+        foreach (var r in pausedBuilds)
+        {
+            if (PausedOf(r.Game, facts) == null) continue;
+            if (stop.State == StopState.Paused && stop.Game == r.Game) return r;
+            if (best == null || string.CompareOrdinal(r.At, best.At) > 0) best = r;
+        }
+        return best;
+    }
+
+    private void BuildStopButtons()
+    {
+        buildPause = Theme.Pill("Pause", "pause.fill", false, 44);
+        buildPause.AccessibilityIdentifier = "build-pause";
+        buildPause.TouchUpInside += (_, __) => PausePressed();
+        buildResume = Theme.Pill("Resume", "play.fill", true, 44);
+        buildResume.AccessibilityIdentifier = "build-resume";
+        buildResume.Hidden = true;
+        buildResume.TouchUpInside += (_, __) => { var g = CardPaused(GatherFacts())?.Game; if (g != null) ResumePaused(g); };
+        buildCancel = Theme.Pill("Cancel", "xmark", false, 44);
+        buildCancel.AccessibilityIdentifier = "build-cancel";
+        buildCancel.TouchUpInside += (_, __) =>
+        {
+            var g = running ? stop.Game : CardPaused(GatherFacts())?.Game;
+            if (g != null) AskCancel(g);
