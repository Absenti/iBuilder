diff -ruN a/GameAppCover.cs b/GameAppCover.cs
--- a/GameAppCover.cs
+++ b/GameAppCover.cs
@@ -0,0 +1,112 @@
+// gameapp/GameAppCover.cs -- "Choose a cover…": where a game's own cover lives, which picture wins, how a picked photo is cut (patch 0065). No UIKit: the host harness compiles this file as it is;
+// GameAppCoverUi.cs (the view controller's half) does the picking and the drawing.
+//
+//   Documents/games/<title id>/cover.jpg        the person's cover, 512 x 512, JPEG 0.9. A file of its own: the chain writes games/<id>/icon.jpg at every build, and a build never touches cover.jpg.
+//   Documents/games/_unresolved/<hash>.cover.jpg  a game whose file name carries no [title id] and whose id has not been read from the package yet: the same hash of the file name GameAppUi.UnresolvedMarker uses.
+//                                                 Once the id is known the cover is found at the id's path too (Candidates), and a new choice is written there.
+//   precedence (CoverOf, the tint, the list rows, the sheet's header, the Build tab, the exported app's icon):  cover.jpg, then icon.jpg, then the initials (CoverArt).
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+
+public static class GameCover
+{
+    public const string FileName = "cover.jpg";
+    public const int Size = 512;
+    public const double JpegQuality = 0.9;
+    /// The short side of the picture the photo is decoded to before it is cut: twice the cover, so the final reduction is a clean one. A photo smaller than that is not enlarged by the decoder.
+    public const int DecodeShortSide = 1024;
+
+    /// `games/<id>/cover.jpg` relative to Documents, or null when the file name carries no title id (an update or an add-on shares its base game's).
+    public static string RelativePath(string fileName)
+    {
+        var id = GameAppUi.BaseTitleIdOf(fileName);
+        return id == null ? null : "games/" + id + "/" + FileName;
+    }
+
+    /// `games/_unresolved/<hash>.cover.jpg`: the key of a game with no id (the hash of its file name, the one UnresolvedMarker uses).
+    public static string UnresolvedRelativePath(string fileName)
+    {
+        var marker = GameAppUi.UnresolvedMarker(fileName);
+        return marker.Substring(0, marker.Length - ".none".Length) + ".cover.jpg";
+    }
+
+    /// Where a new choice is written: the id's path when the id is known, else the file name's.
+    public static string WritePath(string fileName) => RelativePath(fileName) ?? UnresolvedRelativePath(fileName);
+
+    /// Where a cover may be, best first: the id's path, then the file name's (a cover chosen before the id was read stays found).
+    public static IReadOnlyList<string> Candidates(string fileName)
+    {
+        var list = new List<string>();
+        var byId = RelativePath(fileName);
+        if (byId != null) list.Add(byId);
+        list.Add(UnresolvedRelativePath(fileName));
+        return list;
+    }
+
+    /// The picture a game shows: its cover if there is one, else its icon, else null (the initials). Paths relative to Documents; `exists` asks the file system (the harness fakes it).
+    public static string Resolve(string fileName, Func<string, bool> exists)
+    {
+        foreach (var rel in Candidates(fileName)) if (exists(rel)) return rel;
+        var icon = GameAppUi.IconRelativePath(fileName);
+        return icon != null && exists(icon) ? icon : null;
+    }
+
+    /// The person's own cover of this game, or null.
+    public static string Custom(string fileName, Func<string, bool> exists) => Candidates(fileName).FirstOrDefault(exists);
+
+    /// The temporary name a cover or an icon is written to, renamed over the final one when it is whole.
+    public static string PartOf(string path) => path + ".part";
+
+    /// True for the temporary names the launch sweep removes in games/<id>/ and games/_unresolved/.
+    public static bool IsOurPart(string name) =>
+        name == FileName + ".part" || name == "icon.jpg.part" || (name != null && name.EndsWith(".cover.jpg.part", StringComparison.Ordinal));
+
+    /// The cover files a deletion of the game removes (paths relative to Documents).
+    public static IReadOnlyList<string> DeletionFiles(string fileName) => Candidates(fileName).SelectMany(p => new[] { p, PartOf(p) }).ToList();
+
+    /// The part of a photo that becomes the cover: the largest centred square.
+    public static (int X, int Y, int Side) SquareCrop(int width, int height)
+    {
+        int side = Math.Max(1, Math.Min(width, height));
+        return ((width - side) / 2, (height - side) / 2, side);
+    }
+
+    /// The longest side the decoder is asked for (kCGImageSourceThumbnailMaxPixelSize bounds the LONGER side): the shorter side comes out at DecodeShortSide, never more than the photo has.
+    public static int DecodeMaxPixel(int width, int height)
+    {
+        int shorter = Math.Max(1, Math.Min(width, height)), longer = Math.Max(width, height);
+        if (shorter <= DecodeShortSide) return Math.Max(1, longer);   // already small: as it is
+        return (int) Math.Min(longer, Math.Ceiling((double) longer * DecodeShortSide / shorter));
+    }
+
+    // ---- the exported app --------------------------------------------------------------------------------------------
+
+    /// The file the exported app's icon is made from: the cover, else games/<id>/icon.jpg, else null (CoverArt). `titleId`: the build's id (a dump with no id in its name is exported under it).
+    public static string ExportSource(string titleId, string dump, Func<string, bool> exists)
+    {
+        var byId = "games/" + titleId + "/" + FileName;
+        if (exists(byId)) return byId;
+        var byName = UnresolvedRelativePath(dump);
+        if (exists(byName)) return byName;
+        var icon = "games/" + titleId + "/icon.jpg";
+        return exists(icon) ? icon : null;
+    }
+
+    /// Where the player of an export finds the cover: its own Documents first (the copy PreparePlayerDocuments made, or one chosen there), then the bundle; the icon after the covers.
+    public static IReadOnlyList<string> PlayerCandidates(string documents, string bundleGame, string titleId) => new[]
+    {
+        Path.Combine(documents, "games", titleId, FileName),
+        Path.Combine(bundleGame, "documents", "games", titleId, FileName),
+        Path.Combine(documents, "games", titleId, "icon.jpg"),
+        Path.Combine(bundleGame, "documents", "games", titleId, "icon.jpg"),
+    };
+
+    /// The entry name a cover that is NOT already inside games/<id>/ (the export carries that folder whole) gets in the bundle, or null when the folder's own copy is the one.
+    public static string ExtraBundleEntry(string sourceRelative, string titleId)
+    {
+        if (sourceRelative == null || !sourceRelative.EndsWith(FileName, StringComparison.Ordinal)) return null;
+        return sourceRelative == "games/" + titleId + "/" + FileName ? null : "documents/games/" + titleId + "/" + FileName;
+    }
+}
diff -ruN a/GameAppCoverUi.cs b/GameAppCoverUi.cs
--- a/GameAppCoverUi.cs
+++ b/GameAppCoverUi.cs
@@ -0,0 +1,288 @@
+// gameapp/GameAppCoverUi.cs -- "Choose a cover…" and the Switch 2 package's own icon (patch 0065). The paths, the precedence and the cut of a photo are in GameAppCover.cs (no UIKit, run by the host harness).
+//
+//   * Choose a cover…   the long-press menu of a Library tile and row, the game sheet's GAME section and the Build tab row's menu: Photo Library… (PHPickerViewController: no permission prompt), Files…
+//                       (the document picker, images) and Remove custom cover when one is set. The picture is decoded OFF the main thread (ImageIO thumbnail, the orientation applied), cut to the centred square,
+//                       resized to 512 x 512 and written as JPEG 0.9 to games/<id>/cover.jpg through cover.jpg.part: a file of its own, so a build never overwrites it.
+//   * .nup icons        FetchMissingNupIcons: the icon of a Switch 2 package is read from the head of the file by the shim (gameapp_nup_icon: no keys, a few hundred KB to ~15 MB), on a background task, never while a
+//                       build runs; the package's title id names the game when its file name has none. A package without an icon (the owner's Ocarina of Time has none: its metadata has no NACP) gets the "no icon"
+//                       marker like the other formats, so it is not read again at every refresh; the initials stay.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Threading;
+using System.Threading.Tasks;
+
+using CoreGraphics;
+using Foundation;
+using ImageIO;
+using PhotosUI;
+using UIKit;
+using UniformTypeIdentifiers;
+
+internal static class NupNative
+{
+    /// The icon of a .nup (app/gameapp_shim_rust.c). > 0: its length (copied into buf only when <= cap: ask again with a bigger buffer); 0: no icon (titleId is still set); < 0: unreadable or damaged.
+    [DllImport("__Internal")] internal static extern int gameapp_nup_icon(string path, byte[] buf, int cap, out ulong titleId);
+}
+
+public sealed partial class GameAppViewController
+{
+    // ---- Choose a cover… -------------------------------------------------------------------------------------------------------
+
+    private static string CoverFileOf(string game, string rel) => Path.Combine(GameAppMain.Documents, rel.Replace('/', Path.DirectorySeparatorChar));
+
+    private static bool HasCustomCover(string game) => GameCover.Custom(game, rel => File.Exists(CoverFileOf(game, rel))) != null;
+
+    /// The submenu of the long-press menus and the Build tab's "More": Photo Library…, Files…, and Remove custom cover when one is set.
+    private UIMenu CoverMenu(string game)
+    {
+        var items = new List<UIMenuElement>
+        {
+            UIAction.Create("Photo Library…", UIImage.GetSystemImage("photo.on.rectangle"), "cover-photos", _ => ChooseCoverFromPhotos(game)),
+            UIAction.Create("Files…", UIImage.GetSystemImage("folder"), "cover-files", _ => ChooseCoverFromFiles(game)),
+        };
+        if (HasCustomCover(game))
+        {
+            var remove = UIAction.Create("Remove custom cover", UIImage.GetSystemImage("trash"), "cover-remove", _ => RemoveCover(game));
+            remove.Attributes = UIMenuElementAttributes.Destructive;
+            items.Add(remove);
+        }
+        return UIMenu.Create("Choose a cover…", UIImage.GetSystemImage("photo"), (NSString) "cover-choose", (UIMenuOptions) 0, items.ToArray());
+    }
+
+    /// The same choices as an action sheet (the game sheet's row opens it after the sheet is gone).
+    private void ShowCoverChooser(string game)
+    {
+        var sheet = UIAlertController.Create("Choose a cover", GameAppUi.DisplayName(game), UIAlertControllerStyle.ActionSheet);
+        sheet.AddAction(UIAlertAction.Create("Photo Library…", UIAlertActionStyle.Default, _ => ChooseCoverFromPhotos(game)));
+        sheet.AddAction(UIAlertAction.Create("Files…", UIAlertActionStyle.Default, _ => ChooseCoverFromFiles(game)));
+        if (HasCustomCover(game)) sheet.AddAction(UIAlertAction.Create("Remove custom cover", UIAlertActionStyle.Destructive, _ => RemoveCover(game)));
+        sheet.AddAction(UIAlertAction.Create("Cancel", UIAlertActionStyle.Cancel, null));
+        Theme.Anchor(sheet, null, View);
+        PresentWhenFree(sheet);
+    }
+
+    private NSObject coverPickerDelegate;   // alive while a picker is up
+
+    private void ChooseCoverFromPhotos(string game)
+    {
+        var configuration = new PHPickerConfiguration { Filter = PHPickerFilter.ImagesFilter, SelectionLimit = 1 };
+        var picker = new PHPickerViewController(configuration);
+        var picked = new CoverPhotoDelegate(this, game);
+        coverPickerDelegate = picked;
+        picker.Delegate = picked;
+        PresentWhenFree(picker);
+    }
+
+    private sealed class CoverPhotoDelegate : PHPickerViewControllerDelegate
+    {
+        private readonly GameAppViewController owner;
+        private readonly string game;
+        public CoverPhotoDelegate(GameAppViewController owner, string game) { this.owner = owner; this.game = game; }
+
+        public override void DidFinishPicking(PHPickerViewController picker, PHPickerResult[] results)
+        {
+            picker.DismissViewController(true, null);
+            if (results == null || results.Length == 0) return;
+            // The photo's bytes arrive on a background queue, and are decoded there: never on the main thread.
+            results[0].ItemProvider.LoadDataRepresentation("public.image", (data, error) =>
+            {
+                if (data == null) { owner.BeginInvokeOnMainThread(() => owner.Write($"cover: the photo could not be loaded ({error?.LocalizedDescription ?? "no data"})")); return; }
+                using var source = CGImageSource.FromData(data);
+                owner.SaveCover(game, source, "the Photo Library");
+            });
+        }
+    }
+
+    private void ChooseCoverFromFiles(string game)
+    {
+        var picker = new UIDocumentPickerViewController(new[] { UTTypes.Image }, true);   // asCopy: the picked file is copied into this app's container (and deleted again after the read)
+        var picked = new CoverFileDelegate(this, game);
+        coverPickerDelegate = picked;
+        picker.Delegate = picked;
+        PresentWhenFree(picker);
+    }
+
+    private sealed class CoverFileDelegate : NSObject, IUIDocumentPickerDelegate
+    {
+        private readonly GameAppViewController owner;
+        private readonly string game;
+        public CoverFileDelegate(GameAppViewController owner, string game) { this.owner = owner; this.game = game; }
+
+        public void DidPickDocument(UIDocumentPickerViewController controller, NSUrl url) => Pick(url);
+        public void DidPickDocumentAtUrls(UIDocumentPickerViewController controller, NSUrl[] urls) { if (urls != null && urls.Length > 0) Pick(urls[0]); }
+
+        private void Pick(NSUrl url)
+        {
+            var path = url?.Path;
+            if (string.IsNullOrEmpty(path)) return;
+            Task.Run(() =>
+            {
+                bool scoped = url.StartAccessingSecurityScopedResource();
+                try
+                {
+                    using var source = CGImageSource.FromUrl(url);
+                    owner.SaveCover(game, source, "Files");
+                }
+                finally
+                {
+                    if (scoped) url.StopAccessingSecurityScopedResource();
+                    if (IsPickerCopy(path)) try { File.Delete(path); } catch (Exception) { }   // the picker's own copy in our container
+                }
+            });
+        }
+    }
+
+    /// Cuts the picture to the centred square, 512 x 512, JPEG 0.9. Off the main thread. Null when it cannot be decoded.
+    private static byte[] MakeCoverJpeg(CGImageSource source)
+    {
+        if (source == null || source.ImageCount == 0) return null;
+        var properties = source.GetProperties(0);
+        int width = (int) (properties?.PixelWidth ?? 0), height = (int) (properties?.PixelHeight ?? 0);
+        var options = new CGImageThumbnailOptions
+        {
+            CreateThumbnailFromImageAlways = true,
+            CreateThumbnailWithTransform = true,   // the photo's orientation is applied
+            ShouldCache = false,
+            MaxPixelSize = width > 0 && height > 0 ? GameCover.DecodeMaxPixel(width, height) : 2048,
+        };
+        using var decoded = source.CreateThumbnail(0, options);
+        if (decoded == null) return null;
+        var (x, y, side) = GameCover.SquareCrop((int) decoded.Width, (int) decoded.Height);
+        using var square = decoded.WithImageInRect(new CGRect(x, y, side, side));
+        if (square == null) return null;
+        using var space = CGColorSpace.CreateDeviceRGB();
+        using var context = new CGBitmapContext(null, GameCover.Size, GameCover.Size, 8, GameCover.Size * 4, space, CGImageAlphaInfo.NoneSkipLast);
+        context.InterpolationQuality = CGInterpolationQuality.High;
+        context.DrawImage(new CGRect(0, 0, GameCover.Size, GameCover.Size), square);
+        using var scaled = context.ToImage();
+        var data = new NSMutableData();
+        using var destination = CGImageDestination.Create(data, "public.jpeg", 1);
+        if (destination == null) return null;
+        destination.AddImage(scaled, new CGImageDestinationOptions { LossyCompressionQuality = (float) GameCover.JpegQuality });
+        return destination.Close() ? data.ToArray() : null;
+    }
+
+    /// Worker thread: decode, cut, write games/<id>/cover.jpg through cover.jpg.part; then the screen is drawn again (main thread).
+    private void SaveCover(string game, CGImageSource source, string from)
+    {
+        string failure = null;
+        try
+        {
+            var jpeg = MakeCoverJpeg(source);
+            if (jpeg == null || jpeg.Length == 0) failure = "the picture could not be read";
+            else
+            {
+                var path = CoverFileOf(game, GameCover.WritePath(game));
+                Directory.CreateDirectory(Path.GetDirectoryName(path));
+                var part = GameCover.PartOf(path);
+                try { File.WriteAllBytes(part, jpeg); File.Move(part, path, true); }
+                catch { try { File.Delete(part); } catch (Exception) { } throw; }
+            }
+        }
+        catch (Exception error) { failure = $"{error.GetType().Name}: {error.Message}"; }
+        BeginInvokeOnMainThread(() =>
+        {
+            Write(failure == null ? $"cover: {GameAppUi.DisplayName(game)} has the cover chosen from {from}" : $"cover: not changed ({failure})");
+            RefreshScreen();
+        });
+    }
+
+    private void RemoveCover(string game)
+    {
+        Task.Run(() =>
+        {
+            int removed = 0;
+            foreach (var rel in GameCover.DeletionFiles(game))
+                try { var path = CoverFileOf(game, rel); if (File.Exists(path)) { File.Delete(path); removed++; } } catch (Exception) { }
+            BeginInvokeOnMainThread(() => { Write($"cover: {GameAppUi.DisplayName(game)} has its own cover again ({removed} file(s) removed)"); RefreshScreen(); });
+        });
+    }
+
+    // ---- the icon of a Switch 2 package ---------------------------------------------------------------------------------------
+
+    private static int nupIconsRunning;
+
+    /// The .nup games with no icon yet and none recorded as missing: read on a background task, one after another, never while a build runs. The package is not encrypted: no prod.keys.
+    private void FetchMissingNupIcons(UiFacts facts)
+    {
+        if (GameExport.IsPlayer || running || facts.Running || stop.Busy) return;
+        var documents = GameAppMain.Documents;
+        var todo = new List<string>();
+        foreach (var name in facts.Games ?? new List<string>())
+        {
+            if (!GameAppUi.IsNup(name)) continue;
+            var rel = GameAppUi.IconRelativePath(name);
+            if (rel != null && File.Exists(CoverFileOf(name, rel))) continue;
+            // a package that gave no icon (or could not be read) is tried again only when the file is newer than the note
+            var marker = CoverFileOf(name, rel != null ? GameAppUi.NoIconRelativePath(name) : GameAppUi.UnresolvedMarker(name));
+            try { if (File.Exists(marker) && File.GetLastWriteTimeUtc(marker) >= File.GetLastWriteTimeUtc(Path.Combine(documents, name))) continue; }
+            catch (Exception) { continue; }
+            todo.Add(name);
+        }
+        if (todo.Count == 0 || Interlocked.CompareExchange(ref nupIconsRunning, 1, 0) != 0) return;
+        Task.Run(() =>
+        {
+            int changed = 0;
+            var clock = System.Diagnostics.Stopwatch.StartNew();
+            try
+            {
+                foreach (var name in todo)
+                {
+                    if (stop.Busy) break;   // a build started meanwhile: the rest waits for the next refresh
+                    changed += ReadNupCover(documents, name);
+                }
+            }
+            finally { Interlocked.Exchange(ref nupIconsRunning, 0); }
+            var ms = clock.ElapsedMilliseconds;
+            BeginInvokeOnMainThread(() => { NoteTime("nup icons/worker", ms); if (changed > 0) RefreshScreen(); });   // a launch-profile line when the background read was long
+        });
+    }
+
+    /// Worker thread. 1 when something the screen shows changed (an icon, or the game's id), else 0.
+    private static int ReadNupCover(string documents, string name)
+    {
+        int changed = 0;
+        string verdict;
+        try
+        {
+            var path = Path.Combine(documents, name);
+            var buffer = new byte[1 << 20];
+            int rc = NupNative.gameapp_nup_icon(path, buffer, buffer.Length, out var titleId);
+            if (rc > buffer.Length) { buffer = new byte[rc]; rc = NupNative.gameapp_nup_icon(path, buffer, buffer.Length, out titleId); }
+            if (rc >= 0 && titleId != 0 && GameAppUi.IconRelativePath(name) == null)
+            {
+                // the file name has no [title id]: the package's own names the game (the same id the build names games/<id>/ by), like an NSP's control NCA
+                GameAppUi.SetTitleFromContent(name, titleId & ~0xFFFUL);
+                GameAppUi.SaveTitlesFromContent(documents);
+                GameAppDiag.Event("title-from-content", $"{name}: {titleId:X16}");
+                changed = 1;
+            }
+            var rel = GameAppUi.IconRelativePath(name);
+            if (rc > 0 && rel != null)
+            {
+                var icon = CoverFileOf(name, rel);
+                Directory.CreateDirectory(Path.GetDirectoryName(icon));
+                var part = GameCover.PartOf(icon);
+                try { using (var f = File.Create(part)) f.Write(buffer, 0, rc); File.Move(part, icon, true); }
+                catch { try { File.Delete(part); } catch (Exception) { } throw; }
+                changed = 1;
+                verdict = $"{rc} bytes";
+            }
+            else
+            {
+                // no icon (rc 0: the metadata has none), a damaged package (rc < 0), or an icon with no id to name it by: said once, not read again until the file changes
+                var marker = CoverFileOf(name, rel != null ? GameAppUi.NoIconRelativePath(name) : GameAppUi.UnresolvedMarker(name));
+                Directory.CreateDirectory(Path.GetDirectoryName(marker));
+                verdict = rc < 0 ? $"unreadable or damaged ({rc})" : rc == 0 ? "none: the package carries no icon" : "an icon but no title id to name it by";
+                File.WriteAllText(marker, verdict + "\n");
+            }
+        }
+        catch (Exception error) { verdict = error.GetType().Name + ": " + error.Message; }
+        Console.Error.WriteLine($"[gameapp] icon of {name}: {verdict}");
+        GameAppDiag.Event("icon", $"icon of {name}: {verdict}");
+        return changed;
+    }
+}
