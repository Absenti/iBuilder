+// gameapp/GameAppStopUi.cs -- Pause, Cancel and Resume of a running build: the view controller's half (patch 0065). The state machine and every decision are in GameAppStop.cs (no UIKit, run by the host harness).
+//
+//   * Pause / Cancel on the Build tab's running-build card (and the build screen); the card says "Pausing… (finishes the current shader)" / "Cancelling…" and its buttons are disabled while a stop is honoured.
+//   * A paused build keeps a card ("Paused · 14,990 of 21,990 shaders", Resume, Cancel), a chip on its library tile / row and its Build tab row, and survives a relaunch (Documents/gameapp.paused.tsv, the chain's
+//     marker Documents/shaders/<id>.work/stopped.by.user; StopRecovery): a relaunch shows "Paused", not the OS-kill "interrupted, resume" flow, which stays as it is for real kills.
+//   * Nothing here walks or deletes a folder on the main thread: a cancel's cleanup goes to DeleteFolderInBackground (patch 0064), the sizes in the dialog come from the cached FolderSizes, the native request is
+//     raised from a pool thread.
+//   * The request (gameapp_request_stop) is cleared by the chain when a run starts: a Pause or Cancel pressed before the chain is on the stack (the extraction of an NSP/XCI runs first) is kept in the StopMachine
+//     and applied before the chain is called; one raised in the microseconds around the chain's own clear is raised again every 2 s while the stop is honoured.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Threading;
+using System.Threading.Tasks;
+
+using BackgroundTasks;
+using Foundation;
+using UIKit;
+
+internal static class GameStopNative
+{
+    /// 1 = pause, 2 = cancel, anything else withdraws; returns the request in effect. Thread-safe, needs no handle (app/gameapp_shim_rust.c).
+    [DllImport("__Internal")] internal static extern int gameapp_request_stop(int kind);
+}
