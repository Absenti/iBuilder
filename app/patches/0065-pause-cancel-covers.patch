+        var row = Theme.Row(8, buildPause, buildResume, buildCancel);
+        row.Distribution = UIStackViewDistribution.FillEqually;
+        buildStopRow = row;
+    }
+
+    // ---- the system's own task (GameAppBackground.cs) ------------------------------------------------------------------------
+
+    /// iOS ended the continued-processing task, or the person tapped its stop button in the Dynamic Island: a PAUSE of the build. Runs on the system's queue. The request goes to the chain, the wait for its return is
+    /// bounded (about 5 s) and off the main thread, the paused record is written by Finish on the main thread (waited for the same way), then the task is completed. Never blocks the main thread.
+    private void PauseFromTheSystem(BGTask task)
+    {
+        Task.Run(() =>
+        {
+            var step = stop.Pause();
+            if (step.Act == StopAct.Native) { try { GameStopNative.gameapp_request_stop((int) StopKind.Pause); } catch (Exception) { } }
+            var until = DateTime.UtcNow + TimeSpan.FromSeconds(5);
+            bool Waiting() { var s = stop.State; return s == StopState.Running || s == StopState.Pausing || (s == StopState.Paused && !pauseRecorded); }
+            while (DateTime.UtcNow < until && Waiting()) Thread.Sleep(50);
+            bool paused = stop.State == StopState.Paused && pauseRecorded;
+            BeginInvokeOnMainThread(() => Write(paused
+                ? "background: the system ended the background task: the build is paused (Resume is on the Build tab)"
+                : "background: the system ended the background task before the build could stop (a build that reads the game cannot be paused until it is read); it goes on while iOS lets this process live"));
+            lock (backgroundLock)
+            {
+                if (backgroundTask != null && ReferenceEquals(backgroundTask, task))
+                {
+                    backgroundTask = null;
+                    if (paused)
+                    {
+                        // a pause is a completed task, not a failure: its title says so for the Dynamic Island and the lock screen
+                        try { if (task is BGContinuedProcessingTask continued) continued.UpdateTitle("Paused: " + GameAppUi.DisplayName(stop.Game ?? ""), StopText.PausedLine(lastStage)); } catch (Exception) { }
+                        try { task.SetTaskCompleted(true); } catch (Exception) { }
+                    }
+                }
+            }
+        });
+    }
