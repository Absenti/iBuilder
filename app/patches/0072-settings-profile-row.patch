     private void SetValue(string env, string value)
     {
         values[env] = value;
+        // patch 0072: a profile row ("Profile": Standard / Memory saver) gives its values to the rows it covers; they stay editable one by one afterwards
+        var row = launcher?.FirstOrDefault(r => r.Env == env);
+        var preset = GameAppUi.PresetValues(row, value);
+        foreach (var kv in preset)
+            if (launcher.Any(r => r.Env == kv.Key)) values[kv.Key] = kv.Value;
         valuesChanged?.Invoke(values);
+        if (preset.Count > 0) foreach (var refresh in valueRefreshers) refresh();
         RefreshVisibility();
     }
 
