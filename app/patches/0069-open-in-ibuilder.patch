+                    done.Add((new ImportOutcome(name, placed, error), route));
+                }
+            }
+            catch (Exception e) { log($"open-in: stopped: {e.GetType().Name}: {e.Message}"); }   // not expected: every file has its own catch
+            BeginInvokeOnMainThread(() =>
+            {
+                importBusy = false;
+                GameAppOpenInEntry.Queue.Finish();
+                if (importCard != null) importCard.Hidden = true;
+                if (awake) UIApplication.SharedApplication.IdleTimerDisabled = false;
+                EndTask();
+                Write(OpenIn.Summary(done));
+                RefreshGames();
+                RefreshScreen();
+                var failures = InPlaceImport.Failures(done.Select(d => d.Outcome).ToList());
+                if (failures != null)
+                {
+                    var alert = UIAlertController.Create("Not all were added", failures, UIAlertControllerStyle.Alert);
+                    alert.AddAction(UIAlertAction.Create("OK", UIAlertActionStyle.Cancel, null));
+                    PresentWhenFree(alert);
+                }
+                OpenInPumpNow();   // what arrived while this batch ran
+            });
+        });
+    }
+
+    // ---- the hint ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+
+    private bool openInMenuDone;
+
+    /// The + button of the Build tab (id import-file, built in BuildBuildTab with the pickers' entries, GameAppImportUi.cs) gets, apart at the end of the menu it HAS, the row "How to add from Files": an alert with the steps and an
+    /// "Open Files" button. Done once, by looking the button up and adding to its current menu, so whatever entries the pickers' file offers stay exactly as they are.
+    private void EnsureOpenInMenu()
+    {
+        if (openInMenuDone) return;
+        if (GameExport.IsPlayer) { openInMenuDone = true; return; }   // a player has no Build tab
+        if (!(OpenInFindView(pages[7], "import-file") is UIButton plus) || plus.Menu == null) return;   // not built yet: the next pump looks again
+        openInMenuDone = true;
+        var howTo = UIAction.Create(OpenIn.MenuTitle, UIImage.GetSystemImage("questionmark.circle"), "import-howto", _ => ShowOpenInHowTo());
+        howTo.Subtitle = OpenIn.MenuSubtitle;
+        var apart = UIMenu.Create("", null, UIMenuIdentifier.None, UIMenuOptions.DisplayInline, new UIMenuElement[] { howTo });
+        plus.Menu = UIMenu.Create(plus.Menu.Children.Concat(new UIMenuElement[] { apart }).ToArray());
+    }
+
+    private static UIView OpenInFindView(UIView root, string identifier)
+    {
+        if (root == null) return null;
+        if (root.AccessibilityIdentifier == identifier) return root;
+        foreach (var child in root.Subviews)
+            if (OpenInFindView(child, identifier) is UIView found) return found;
+        return null;
+    }
+
+    private void ShowOpenInHowTo()
+    {
+        var alert = UIAlertController.Create(OpenIn.HowToTitle, OpenIn.HowToMessage, UIAlertControllerStyle.Alert);
+        alert.AddAction(UIAlertAction.Create(OpenIn.HowToOpenFiles, UIAlertActionStyle.Default, _ => UIApplication.SharedApplication.OpenUrl(new NSUrl("shareddocuments://"), new UIApplicationOpenUrlOptions(), null)));
+        alert.AddAction(UIAlertAction.Create(OpenIn.HowToClose, UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(alert);
+    }
+
+    /// The Build tab's empty state, second line, under the line that is already there: flat, muted.
+    private static void AddOpenInHint(UIStackView list)
+    {
+        if (list.ArrangedSubviews.Length > 0) list.SetCustomSpacing(8, list.ArrangedSubviews[list.ArrangedSubviews.Length - 1]);
+        var hint = Theme.Label(OpenIn.Hint, Theme.Font(13, UIFontWeight.Regular), Theme.Muted, 0);
+        hint.AccessibilityIdentifier = "open-in-hint";
+        list.AddArrangedSubview(hint);
+    }
+}
