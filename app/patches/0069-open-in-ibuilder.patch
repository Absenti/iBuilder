+// gameapp/GameAppOpenInUi.cs -- "Open in iBuilder": the UIKit half (patch 0069). The decisions (which files, the queue, in place or iOS's copy, the words, the player's plist) are in GameAppOpenIn.cs (no UIKit, run by the host harness).
+//
+//   * The doors. iOS hands a file to the app in one of three ways, and all three end in GameAppOpenInEntry.Deliver: GameAppSceneDelegate.WillConnect (a COLD start through the Share sheet: options.UrlContexts),
+//     GameAppSceneDelegate.OpenUrlContexts (the app is running or suspended) and GameAppAppDelegate.OpenUrl (an app without scenes; iOS does not use it for this one, it is there so a delivery is never lost). A delivery
+//     only queues the URLs (a few property reads); the work is on a worker.
+//   * The pump (main thread, a few property reads): when nothing is being added it takes everything that waits as ONE batch, logs what was received, and starts the worker. A delivery that arrives while a batch runs waits
+//     behind it and starts when it ends; one that arrives while another import (a picker's) runs is looked at again every second. Nothing runs twice, nothing is lost.
+//   * The worker (Task.Run), the same steps as "Add from Files without copying" (GameAppImportUi.cs, patch 0066) and the same progress card, background task and awake screen: for a file that is where its owner keeps it, a security
+//     scope and an NSFileCoordinator read, then GameImport.Place (an APFS clone into Documents/<name>, the copy as the fallback, always through <name>.part and one rename); for a file iOS copied into this app's own container
+//     (Documents/Inbox, tmp/: not in place) a MOVE (a rename onto the .part), never a clone and never a second copy. The original of a file in place is never touched. Naming is the other import paths': the file's own name in
+//     Documents; update, DLC and title id are read from it by the refresh that follows (RefreshGames, RefreshScreen).
+//   * The hint: a row "How to add from Files" at the end of the + menu (an alert with the steps and an "Open Files" button; added to the menu the button HAS, once, when the first delivery or the scene's attach pumps), and the same
+//     sentence in the Build tab's empty state (one line GameAppShelf.cs calls).
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+
+using Foundation;
+using UIKit;
+
+/// The three doors of "Open in", and what they have in common: queue the URLs, then wake the library's pump.
+internal static class GameAppOpenInEntry
+{
+    internal static readonly OpenInQueue Queue = new OpenInQueue();
+    private static readonly object gate = new object();
+    private static readonly List<string> notes = new List<string>();   // what the doors say before the library exists (a cold start): written to the log by the pump, in order
+    private static GameAppViewController target;
+
+    /// The scene delegate, once its window and the library are up: what came before them (a cold start) starts now.
+    internal static void Attach(GameAppViewController owner)
+    {
+        if (owner == null) return;
+        target = owner;
+        owner.OpenInPump();
+    }
+
+    /// scene:willConnectToSession:options: (cold start) and scene:openURLContexts:. A set has no order: the files are taken by name, so a game and its update come the same way every time.
+    internal static void FromScene(IEnumerable<UIOpenUrlContext> contexts, string door)
+    {
+        var urls = (contexts ?? Enumerable.Empty<UIOpenUrlContext>()).Where(c => c?.Url != null)
+                   .Select(c => (Url: c.Url, InPlace: c.Options?.OpenInPlace ?? false))
+                   .OrderBy(u => u.Url.LastPathComponent ?? "", StringComparer.OrdinalIgnoreCase).ToList();
+        Deliver(urls, door);
+    }
+
+    /// application:openURL:options: -- the options carry UIApplicationOpenURLOptionsOpenInPlaceKey (a bool).
+    internal static void FromApplication(NSUrl url, NSDictionary options)
+    {
+        if (url == null) return;
+        bool inPlace = options != null && new UIApplicationOpenUrlOptions(options).OpenInPlace == true;   // the SDK's typed view of the options dictionary (UIApplicationOpenURLOptionsOpenInPlaceKey)
+        Deliver(new List<(NSUrl Url, bool InPlace)> { (url, inPlace) }, "application:openURL:options:");
+    }
+
+    private static void Deliver(List<(NSUrl Url, bool InPlace)> urls, string door)
+    {
+        if (urls.Count == 0) return;
+        var requests = urls.Select(u => new OpenInRequest(u.Url.IsFileUrl ? (u.Url.Path ?? "") : "", u.Url.LastPathComponent ?? "", u.InPlace, u.Url)).ToList();
+        var ignored = Queue.Add(requests);
+        lock (gate)
+        {
+            notes.Add($"open-in: {door} delivered {urls.Count} URL(s)");
+            foreach (var request in ignored) notes.Add(OpenIn.DuplicateLine(Cloud.RealName(request.Name)));
+        }
+        target?.OpenInPump();
+    }
+
+    internal static List<string> TakeNotes()
+    {
+        lock (gate) { var taken = notes.ToList(); notes.Clear(); return taken; }
+    }
+}
+
+public sealed partial class GameAppViewController
+{
+    private bool openInRetry;
+
+    /// Wakes the pump on the next turn of the run loop (a delivery is never worked on inside UIKit's callback).
+    internal void OpenInPump() => BeginInvokeOnMainThread(OpenInPumpNow);
+
+    private void OpenInPumpNow()
+    {
+        EnsureOpenInMenu();   // once: the + menu's row "How to add from Files"
+        foreach (var note in GameAppOpenInEntry.TakeNotes()) Write(note);
+        var queue = GameAppOpenInEntry.Queue;
+        if (queue.Pending == 0) return;
+        if (GameExport.IsPlayer)   // an exported player is no door for game files (its Info.plist has no document type either)
+        {
+            foreach (var request in queue.TakeBatch()) Write(OpenIn.SkippedLine(Cloud.RealName(request.Name), "this app only plays its game"));
+            queue.Finish();
+            return;
+        }
+        if (queue.Running) return;   // a batch of "Open in" is going: its end pumps again
+        if (importBusy)               // an import of a picker is going: the next look is in a second (a bool read: nothing else is done)
+        {
+            if (!openInRetry)
+            {
+                openInRetry = true;
+                Write("open-in: waiting for the import that is running");
+                NSTimer.CreateScheduledTimer(1.0, _ => { openInRetry = false; OpenInPumpNow(); });
+            }
+            return;
+        }
+        var batch = queue.TakeBatch();
+        var plan = OpenIn.Plan(batch);
+        foreach (var request in batch) Write(OpenIn.ReceivedLine(Cloud.RealName(request.Name), request.InPlace));
+        foreach (var (_, line) in plan.Skipped) Write(line);
+        if (plan.Accepted.Count == 0) { queue.Finish(); OpenInPumpNow(); return; }
+        OpenInRun(plan.Accepted);
+    }
+
+    /// One batch, on a worker. Main thread: planning and the card; every result comes back with BeginInvokeOnMainThread.
+    private void OpenInRun(IReadOnlyList<OpenInRequest> jobs)
+    {
+        importBusy = true;   // the pickers' imports say "Still adding" meanwhile, and one card is shared
+        bool awake = !UIApplication.SharedApplication.IdleTimerDisabled;   // not undone when a build already keeps the screen awake
+        if (awake) UIApplication.SharedApplication.IdleTimerDisabled = true;
+        // The background task keeps the copy going when the app is left (a clone or a rename is over before that matters). When the system's time for it runs out the task is ended, not the app.
+        nint task = UIApplication.BackgroundTaskInvalid;
+        void EndTask() { var t = task; task = UIApplication.BackgroundTaskInvalid; if (t != UIApplication.BackgroundTaskInvalid) UIApplication.SharedApplication.EndBackgroundTask(t); }
+        task = UIApplication.SharedApplication.BeginBackgroundTask("open-in", EndTask);   // the handler runs on the main thread and must end the task before it returns
+        if (currentTab == 0) ShowTab(7);   // the library: show the Build tab, where the card is (never taken from a screen the person is using: the build, Settings)
+        ShowImportProgress(0, jobs.Count, jobs[0].Name, 0, "Adding");
+        var documents = GameAppMain.Documents;
+        var home = Environment.GetEnvironmentVariable("HOME") ?? "";
+        var temp = Path.GetTempPath();
+        Action<string> log = line => BeginInvokeOnMainThread(() => Write(line));
+        Task.Run(() =>
+        {
+            var done = new List<(ImportOutcome Outcome, OpenInRoute Route)>();
+            try
+            {
+                for (int k = 0; k < jobs.Count; k++)
+                {
+                    int index = k;
+                    var request = jobs[k];
+                    var name = request.Name;
+                    var destination = Path.Combine(documents, name);
+                    var route = OpenIn.Route(request.Path, destination, home, temp);
+                    BeginInvokeOnMainThread(() => ShowImportProgress(index, jobs.Count, name, 0, "Adding"));
+                    Action<string, string> copy = (from, part) => GameImport.CopyBytes(from, part, (written, total) =>
+                        BeginInvokeOnMainThread(() => ShowImportProgress(index, jobs.Count, name, total > 0 ? written / (double) total : 0, "Copying")));
+                    Placed placed = null;
+                    string error = null;
+                    try
+                    {
+                        if (route == OpenInRoute.MoveFromInbox)
+                        {
+                            // iOS's own copy, in this container: renamed onto the .part (nothing copied again). Place's one log line is replaced by ours, which says "moved".
+                            placed = GameImport.Place(request.Path, destination, OpenIn.TryMove, copy, null, FreeBytes);
+                            if (placed.How == PlacedHow.Cloned) log(OpenIn.MovedLine(name, placed.Bytes, (long) placed.Took.TotalMilliseconds));
+                            else if (placed.How == PlacedHow.Copied)
+                            {
+                                log(GameImport.CopiedLine(name, placed.Bytes, placed.Took.TotalSeconds, placed.Why));   // the rename was refused: copied, and iOS's copy is ours to remove
+                                try { File.Delete(request.Path); } catch (Exception) { }
+                            }
+                        }
+                        else
+                        {
+                            var url = request.Handle as NSUrl;
+                            bool scoped = url != null && url.StartAccessingSecurityScopedResource();
+                            try
+                            {
+                                if (url == null) placed = GameImport.Place(request.Path, destination, FileClone.Try, copy, log, FreeBytes);
+                                else
+                                {
+                                    new NSFileCoordinator().CoordinateRead(url, (NSFileCoordinatorReadingOptions) 0, out NSError coordination, readable =>
+                                    {
+                                        try { placed = GameImport.Place(readable.Path, destination, FileClone.Try, copy, log, FreeBytes); }   // an original: cloned or copied, never changed or deleted
+                                        catch (Exception e) { error = e.Message; }
+                                    });
+                                    if (placed == null && error == null) error = coordination?.LocalizedDescription ?? "the file could not be read";
+                                }
+                            }
+                            finally { if (scoped) url.StopAccessingSecurityScopedResource(); }
+                        }
+                    }
+                    catch (Exception e) { error ??= e.Message; }
+                    if (error != null) log($"open-in: {name} could not be added: {error}");
+                    // the app made this file (a clone of the original, or iOS's own copy moved here): patch 0068 may free it after a successful build; an AlreadyThere file was the library's own and is never recorded
+                    if (error == null && placed != null && placed.How != PlacedHow.AlreadyThere)
