diff -ruN a/GameAppOpenIn.cs b/GameAppOpenIn.cs
--- a/GameAppOpenIn.cs
+++ b/GameAppOpenIn.cs
@@ -0,0 +1,311 @@
+// gameapp/GameAppOpenIn.cs -- "Open in iBuilder": a game file handed over by the Files app's Share sheet (or any app's Open In), with no UIKit (patch 0069; the host harness compiles this file as it is).
+//
+// Why: on the owner's iPhone (iOS 27.2.1) no Open-mode document picker delivers its selection any more, so a game that is already on the phone cannot be added through a picker. The route that does not depend on a picker is
+// the other direction: in Files, touch and hold the game, Share, iBuilder. When the app says it can open documents in place (LSSupportsOpeningDocumentsInPlace, and a document type for the game containers), iOS hands over
+// the ORIGINAL file as a security-scoped URL; GameImport.Place (patch 0066) then clones it into Documents (instant, no extra space), or copies it when a clone is refused.
+//
+//   OpenIn         which names are game files (the four containers, nothing else: not prod.keys), what a batch of received URLs becomes (accepted / skipped, with the log line of each), where a file is (in place, or a copy iOS
+//                  made inside this app's own container: Documents/Inbox or tmp/), the way it goes in (clone/copy for a file where it is, a MOVE for iOS's copy), and the words of the log and of the hint.
+//   OpenInQueue    the URLs that arrived and wait: FIFO, a second delivery of the same file is dropped, a delivery while an import runs waits behind it (nothing is lost, nothing runs twice).
+//   OpenInPlist    the exported player's Info.plist (it must not become an "Open in" target for game files): the transform of the plist's XML text, the same function the app runs at an export.
+// The UIKit half is GameAppOpenInUi.cs (the callbacks of the app and scene delegates, the worker, the menu row and the hint).
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+using System.Xml;
+using System.Xml.Linq;
+
+/// One URL that was handed to the app. Path is where iOS says the file is (NSUrl.Path), Name its last component as iOS gave it (an iCloud placeholder's ".X.nsp.icloud" is made "X.nsp" by Plan), InPlace what the delivery
+/// said (UIApplicationOpenURLOptionsOpenInPlaceKey / UISceneOpenURLOptions.openInPlace), Handle the NSUrl itself (the UI keeps it: its security scope belongs to it; the harness leaves it null).
+public sealed record OpenInRequest(string Path, string Name, bool InPlace, object Handle);
+
+/// What a batch of requests becomes: the ones that are imported (with their real names), and for every other one the line the log gets.
+public sealed record OpenInPlan(IReadOnlyList<OpenInRequest> Accepted, IReadOnlyList<(OpenInRequest Request, string Line)> Skipped);
+
+/// How a file goes in: AlreadyThere = it IS the library's own file (nothing to do); MoveFromInbox = iOS copied it into this app's container (Documents/Inbox, tmp/), a rename puts it in the library; InPlace = it is
+/// where its owner keeps it (a clone, else a copy, and the original is never touched).
+public enum OpenInRoute { AlreadyThere, MoveFromInbox, InPlace }
+
+public static class OpenIn
+{
+    public static readonly string[] Extensions = { ".nsp", ".xci", ".nsz", ".nup" };
+
+    /// The UTIs the Info.plist declares for the four extensions (UTImportedTypeDeclarations, patch 0069), in the order of Extensions.
+    public static readonly string[] TypeIdentifiers = { "dev.nxpocket.ibuilder.nsp", "dev.nxpocket.ibuilder.xci", "dev.nxpocket.ibuilder.nsz", "dev.nxpocket.ibuilder.nup" };
+
+    // ---- the words (also in the harness: a changed sentence is a changed test) ----------------------------------------------------------------------------------------------------------------------------
+
+    public const string Hint = "In Files, touch and hold the game, Share, iBuilder: it is added without a copy.";
+    public const string MenuTitle = "How to add from Files";
+    public const string MenuSubtitle = "Touch and hold the game, Share, iBuilder";
+    public const string HowToTitle = "Add from Files";
+    public const string HowToMessage = "In Files, touch and hold the game, tap Share, then iBuilder. The game is added where it is, without a copy.\n\nSeveral files (a game with its update and DLC) can be shared together.";
+    public const string HowToOpenFiles = "Open Files";
+    public const string HowToClose = "Close";
+
+    private static string Inv(FormattableString text) => text.ToString(CultureInfo.InvariantCulture);
+
+    public static string ReceivedLine(string name, bool inPlace) => $"open-in: received {name} (in place: {(inPlace ? "yes" : "no")})";
+
+    public static string NotAGameLine(string name) => $"open-in: not a game file: {name}";
+
+    public static string SkippedLine(string name, string why) => $"open-in: {name} skipped: {why}";
+
+    public static string DuplicateLine(string name) => $"open-in: {name} is already waiting or being added: ignored";
+
+    public static string MovedLine(string name, long bytes, long milliseconds) =>
+        Inv($"import: moved {name} ({GameAppUi.SizeText(bytes)}) in {milliseconds} ms (iOS had copied it into this app, not in place: renamed into the library, nothing copied again)");
+
+    // ---- which files ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+
+    /// A game container by its name: .nsp .xci .nsz .nup in any case, and a name Documents can hold (InPlaceImport.SafeName: no separator, room for the .part). prod.keys is NOT accepted here: the Info.plist declares the four
+    /// extensions only, so nothing else is offered the app, and a keys file arrives by the pickers.
+    public static bool Accepts(string name)
+    {
+        if (!InPlaceImport.SafeName(name)) return false;
+        var extension = Path.GetExtension(name);
+        return name.Length > extension.Length && Extensions.Contains(extension, StringComparer.OrdinalIgnoreCase);
+    }
+
+    /// What a batch of received URLs becomes. Every request gets its real name (Cloud.RealName); a request with no path, an unusable name, not one of the four extensions, or a name that came twice in this batch (Documents is
+    /// case-insensitive: two of one name are one file) is skipped with the log line that says so. Order is kept: the accepted ones are imported in the order they came.
+    public static OpenInPlan Plan(IReadOnlyList<OpenInRequest> requests)
+    {
+        var accepted = new List<OpenInRequest>();
+        var skipped = new List<(OpenInRequest, string)>();
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var request in requests)
+        {
+            var name = Cloud.RealName(request.Name ?? "");
+            var real = request with { Name = name };
+            if (string.IsNullOrEmpty(request.Path)) skipped.Add((real, SkippedLine(string.IsNullOrEmpty(name) ? "(no name)" : name, "it is not a file on this device")));
+            else if (!InPlaceImport.SafeName(name)) skipped.Add((real, SkippedLine(string.IsNullOrEmpty(name) ? "(no name)" : name, "its name cannot be used")));
+            else if (!Accepts(name)) skipped.Add((real, NotAGameLine(name)));
+            else if (!seen.Add(name)) skipped.Add((real, SkippedLine(name, "it came twice in one go")));
+            else accepted.Add(real);
+        }
+        return new OpenInPlan(accepted, skipped);
+    }
+
+    // ---- where the file is, and how it goes in ---------------------------------------------------------------------------------------------------------------------------------------------------------------
+
+    /// True for a file iOS copied into this app's own container when the source did not hand it over in place: Documents/Inbox/, the container's tmp/, the process's temp folder. Only such a file may be MOVED (it is iOS's copy,
+    /// ours to take): anything else is somebody's original and is only ever read. Paths are compared as the file system sees them (/private/var and /var are one place, ".." is resolved), and by whole folders (Inbox-x is not Inbox).
+    public static bool IsContainerCopy(string path, string home, string temp)
+    {
+        if (string.IsNullOrEmpty(path)) return false;
+        string p;
+        try { p = GameImport.Normal(path); } catch (Exception) { return false; }
+        foreach (var root in CopyFolders(home, temp))
+            if (p.StartsWith(root + "/", StringComparison.Ordinal)) return true;
+        return false;
+    }
+
+    private static IEnumerable<string> CopyFolders(string home, string temp)
+    {
+        var roots = new List<string>();
+        if (!string.IsNullOrEmpty(home)) { roots.Add(Path.Combine(home, "Documents", "Inbox")); roots.Add(Path.Combine(home, "tmp")); }
+        if (!string.IsNullOrEmpty(temp)) roots.Add(temp);
+        foreach (var root in roots)
+        {
+            string normal;
+            try { normal = GameImport.Normal(root).TrimEnd('/'); } catch (Exception) { continue; }
+            if (normal.Length > 1) yield return normal;   // never "/" itself: that would make every file a copy of ours
+        }
+    }
+
+    /// The route of one file. `destination` is where the library keeps it (Documents/<name>).
+    public static OpenInRoute Route(string path, string destination, string home, string temp)
+    {
+        if (GameImport.SamePath(path, destination)) return OpenInRoute.AlreadyThere;
+        return IsContainerCopy(path, home, temp) ? OpenInRoute.MoveFromInbox : OpenInRoute.InPlace;
+    }
+
+    /// The log line when a batch is over: what was added (and how: moved, cloned, copied) and what was not (and why). The files that failed are listed by InPlaceImport.Failures for the alert.
+    public static string Summary(IReadOnlyList<(ImportOutcome Outcome, OpenInRoute Route)> done)
+    {
+        var added = done.Where(d => d.Outcome.Placed != null).ToList();
+        var failed = done.Where(d => d.Outcome.Placed == null).ToList();
+        if (added.Count == 0 && failed.Count == 0) return "open-in: nothing was added";
+        var parts = new List<string>();
+        if (added.Count > 0)
+            parts.Add("imported: " + string.Join(", ", added.Select(d => d.Outcome.Name + (d.Outcome.Placed.How == PlacedHow.Cloned ? (d.Route == OpenInRoute.MoveFromInbox ? " (moved)" : " (cloned)")
+                                                                                                 : d.Outcome.Placed.How == PlacedHow.Copied ? " (copied)" : " (already there)"))));
+        if (failed.Count > 0)
+            parts.Add("import failed: " + string.Join("; ", failed.Select(d => $"{d.Outcome.Name}: {d.Outcome.Error}")));
+        return "open-in: " + string.Join(" · ", parts);
+    }
+
+    /// The "clone" delegate of GameImport.Place for iOS's own copy: rename it onto Place's `<dest>.part` (the same volume: rename(2), instant, no space). null = done, else why not (Place then copies, and the line says why).
+    public static string TryMove(string source, string part)
+    {
+        try { File.Move(source, part, false); return null; }
+        catch (Exception e) { return $"{e.GetType().Name}: {e.Message}"; }
+    }
+}
+
+/// The URLs that arrived and wait to be imported. Thread-safe (the callbacks come on the main thread, the harness uses several).
+public sealed class OpenInQueue
+{
+    private readonly object gate = new object();
+    private readonly List<OpenInRequest> pending = new List<OpenInRequest>();
+    private readonly HashSet<string> flying = new HashSet<string>(StringComparer.Ordinal);   // the paths of the batch that is being imported
+    private bool running;
+
+    public int Pending { get { lock (gate) return pending.Count; } }
+
+    public bool Running { get { lock (gate) return running; } }
+
+    private static string Key(string path) => string.IsNullOrEmpty(path) ? null : GameImport.Normal(path);
+
+    /// Queues the requests, in order. A request whose file (the same path) already waits, or is in the batch that is being imported, is NOT queued: it is returned, so the caller can say so. (iOS delivers a URL once; this is the
+    /// safety for a delivery through both of its doors.)
+    public IReadOnlyList<OpenInRequest> Add(IEnumerable<OpenInRequest> requests)
+    {
+        var ignored = new List<OpenInRequest>();
+        lock (gate)
+            foreach (var request in requests)
+            {
+                var key = Key(request.Path);
+                if (key != null && (flying.Contains(key) || pending.Any(p => Key(p.Path) == key))) ignored.Add(request);
+                else pending.Add(request);
+            }
+        return ignored;
+    }
+
+    /// Everything that waits, in order, and the queue is now "running" until Finish. Empty when nothing waits or a batch is still running: the caller starts the next one when the running one ends.
+    public IReadOnlyList<OpenInRequest> TakeBatch()
+    {
+        lock (gate)
+        {
+            if (running || pending.Count == 0) return Array.Empty<OpenInRequest>();
+            var batch = pending.ToList();
+            pending.Clear();
+            flying.Clear();
+            foreach (var request in batch) { var key = Key(request.Path); if (key != null) flying.Add(key); }
+            running = true;
+            return batch;
+        }
+    }
+
+    /// The batch is done (whatever became of it): the next one may start.
+    public void Finish()
+    {
+        lock (gate) { running = false; flying.Clear(); }
+    }
+}
+
+/// The Info.plist of an exported player. A player is made of this app's own bundle and Info.plist; the "Open in" door is for game files of iBuilder itself, so a player must not carry it: its document types (and the
+/// types the game files are declared with) go. What the player needs stays: its own .romfs type (UTExportedTypeDeclarations), UIFileSharingEnabled, and LSSupportsOpeningDocumentsInPlace (see below).
+public static class OpenInPlist
+{
+    /// Top-level keys removed from a player's plist. Without CFBundleDocumentTypes the app is offered nowhere in a Share sheet or an Open In list.
+    public static readonly string[] PlayerRemovedKeys = { "CFBundleDocumentTypes" };
+
+    public const string ImportedTypes = "UTImportedTypeDeclarations";
+    public const string InPlaceKey = "LSSupportsOpeningDocumentsInPlace";
+
+    /// `dropInPlaceKey`: also remove LSSupportsOpeningDocumentsInPlace. It stays by default: together with UIFileSharingEnabled it is what shows a player's own Documents folder in Files (the exported player's "Open Files"
+    /// button, patch 0060, lands there), and without CFBundleDocumentTypes it makes the player an "Open in" target for nothing.
+    public static string ForPlayer(string xml, bool dropInPlaceKey = false) => Encoding.UTF8.GetString(ForPlayer(Encoding.UTF8.GetBytes(xml), dropInPlaceKey));
+
+    /// The same on the bytes of an XML property list (what NSPropertyListSerialization writes). Everything that is not removed is kept as it is, comments and white space included. Throws FormatException for what is not a plist.
+    public static byte[] ForPlayer(byte[] xml, bool dropInPlaceKey = false)
+    {
+        var doc = Load(xml);
+        var dict = RootDict(doc);
+        var nodes = dict.Elements().ToList();
+        var gone = new List<XElement>();
+        for (int i = 0; i + 1 < nodes.Count; i += 2)
+        {
+            if (nodes[i].Name.LocalName != "key") throw new FormatException("a property list's dictionary alternates key and value");
+            var key = nodes[i].Value;
+            var value = nodes[i + 1];
+            if (PlayerRemovedKeys.Contains(key, StringComparer.Ordinal) || (dropInPlaceKey && key == InPlaceKey)) { gone.Add(nodes[i]); gone.Add(value); }
+            else if (key == ImportedTypes && value.Name.LocalName == "array")
+            {
+                foreach (var entry in value.Elements("dict").Where(d => OpenIn.TypeIdentifiers.Contains(ValueOf(d, "UTTypeIdentifier"), StringComparer.Ordinal)).ToList()) Remove(entry);
+                if (!value.Elements().Any()) { gone.Add(nodes[i]); gone.Add(value); }   // nothing else was declared there: the key goes
+            }
+        }
+        foreach (var node in gone) Remove(node);
+        return Save(doc, xml);
+    }
+
+    /// What the export calls: the transform, and when the plist cannot be read as one (not expected: NSPropertyListSerialization wrote it a moment ago) the plist as it is, with the reason said: an export is not refused for a
+    /// player that would also be offered game files.
+    public static byte[] ForPlayerOrAsIs(byte[] xml, Action<string> problem = null)
+    {
+        try { return ForPlayer(xml); }
+        catch (Exception e) { problem?.Invoke($"open-in: the player's Info.plist keeps its document types: {e.GetType().Name}: {e.Message}"); return xml; }
+    }
+
+    /// The top-level keys of a plist's XML, in order.
+    public static IReadOnlyList<string> TopLevelKeys(string xml) => RootDict(Load(Encoding.UTF8.GetBytes(xml))).Elements("key").Select(k => k.Value).ToList();
+
+    /// The content types the plist's document types handle (CFBundleDocumentTypes > LSItemContentTypes), in order.
+    public static IReadOnlyList<string> DocumentTypeIdentifiers(string xml)
+    {
+        var dict = RootDict(Load(Encoding.UTF8.GetBytes(xml)));
+        var types = ValueElement(dict, "CFBundleDocumentTypes");
+        if (types == null) return Array.Empty<string>();
+        return types.Elements("dict").SelectMany(d => ValueElement(d, "LSItemContentTypes")?.Elements("string").Select(s => s.Value) ?? Enumerable.Empty<string>()).ToList();
+    }
+
+    /// The identifiers of the types the plist imports (UTImportedTypeDeclarations > UTTypeIdentifier), in order.
+    public static IReadOnlyList<string> ImportedTypeIdentifiers(string xml)
+    {
+        var array = ValueElement(RootDict(Load(Encoding.UTF8.GetBytes(xml))), ImportedTypes);
+        return array == null ? Array.Empty<string>() : array.Elements("dict").Select(d => ValueOf(d, "UTTypeIdentifier")).Where(s => s != null).ToList();
+    }
+
+    private static XDocument Load(byte[] xml)
+    {
+        try
+        {
+            var settings = new XmlReaderSettings { DtdProcessing = DtdProcessing.Ignore, XmlResolver = null };   // the plist's DOCTYPE names a DTD on apple.com: never fetched
+            using var reader = XmlReader.Create(new MemoryStream(xml), settings);
+            return XDocument.Load(reader, LoadOptions.PreserveWhitespace);
+        }
+        catch (XmlException e) { throw new FormatException("not an XML property list: " + e.Message); }
+    }
+
+    private static XElement RootDict(XDocument doc)
+    {
+        if (doc.Root == null || doc.Root.Name.LocalName != "plist") throw new FormatException("not a property list (no <plist>)");
+        return doc.Root.Elements("dict").FirstOrDefault() ?? throw new FormatException("a property list with no top-level dictionary");
+    }
+
+    /// The value element that follows `key` in `dict` (null when the key is not there).
+    private static XElement ValueElement(XElement dict, string key)
+    {
+        var nodes = dict.Elements().ToList();
+        for (int i = 0; i + 1 < nodes.Count; i += 2)
+            if (nodes[i].Name.LocalName == "key" && nodes[i].Value == key) return nodes[i + 1];
+        return null;
+    }
+
+    private static string ValueOf(XElement dict, string key) => ValueElement(dict, key)?.Value;
+
+    /// Removes the element and the white space in front of it, so no blank line is left.
+    private static void Remove(XNode node)
+    {
+        if (node.PreviousNode is XText before && string.IsNullOrWhiteSpace(before.Value)) before.Remove();
+        node.Remove();
+    }
+
+    private static byte[] Save(XDocument doc, byte[] original)
+    {
+        // The prolog is written by hand (an XDocument does not keep the line breaks between the declaration, the DOCTYPE and <plist>); the root keeps every white space node, comment and attribute it had. DtdProcessing.Ignore drops the
+        // DOCTYPE, so it is written back, always the plist DTD of Apple's own files, when the original had one.
+        var text = new StringBuilder("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
+        if (Encoding.UTF8.GetString(original, 0, Math.Min(original.Length, 2048)).Contains("<!DOCTYPE"))
+            text.Append("<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n");
+        text.Append(doc.Root.ToString(SaveOptions.DisableFormatting)).Append('\n');
+        return new UTF8Encoding(false).GetBytes(text.ToString());
+    }
+}
