+
+/// Patch 0088 (the owner: "a game whose build was PAUSED part-way cannot be deleted"): "Discard the partial build", wherever the paused game shows (its touch-and-hold menu, the Build tab's
+/// card beside Resume, the iPad's hero). It asks first, with what goes and its size, then removes what the paused build made (extract/, the rewrite's partial framework and stamp, the shader
+/// work folder with its pause marker, the extraction marker, profile.tsv), off the main thread; the paused record goes, the game is "Not built" again. Never the shader cache, games/<id>/
+/// (settings, saves, cover, mods), the game file, its update or DLC. Refused, greyed with the reason, while that build runs (pause it first), while another build runs (extract/ may be
+/// that one's), and when the game file is a stub (Optimize storage: the extraction is all that is left to build it from).
+public static class PartialDiscard
+{
+    public enum Offer { None, Offered, Refused }
+
+    public const string Title = "Discard the partial build";
+    public const string RunningWhy = "It is building: pause it first, then discard it.";
+    public const string OtherWhy = "Another build is running: discard this one once it has ended.";
+    public const string StubWhy = "Its game file has no content (Optimize storage removed it): the extracted game is all that is left to build it from.";
+    public const string Keeps = "Every finished shader stays in the shader cache (a new build reuses it); the game's settings, saves, cover and mods are not touched. The game is \"Not built\" again.";
+
+    /// `busy`: a build runs (for a paused game: another game's); `contentMissing`: the game file is a stub (patch 0073).
+    public static (Offer Offer, string Why) For(LibState state, bool busy, bool contentMissing)
+    {
+        if (state == LibState.Building) return (Offer.Refused, RunningWhy);
+        if (state != LibState.Paused) return (Offer.None, null);
+        if (busy) return (Offer.Refused, OtherWhy);
+        if (contentMissing) return (Offer.Refused, StubWhy);
+        return (Offer.Offered, null);
+    }
+
+    private static readonly Regex Shaders = new Regex(@"\((\d+)/(\d+) shaders\)");
+
+    /// The shaders the paused build translated, from its stage line ("… (1234/5009 shaders)"); 0 before the shader step; -1 when its line says nothing.
+    public static long ShadersDone(string stageLine)
+    {
+        if (string.IsNullOrWhiteSpace(stageLine)) return -1;
+        var s = GameAppUi.ParseStage(stageLine);
+        if (!s.Valid) return -1;
+        var m = Shaders.Match(s.Text ?? "");
+        if (m.Success && long.TryParse(m.Groups[1].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var done)) return done;
+        return s.Of == 5 && s.Step >= 1 && s.Step < 3 ? 0 : -1;   // stage 1 (reading) or 2 (the rewrite): no shader yet
+    }
+
+    /// The question's text: "Removes the extracted game (13.0 GB), the rewrite and the 1,234 shaders translated so far; the game file itself stays." then what stays.
+    public static string Note(long extractBytes, long shaders, bool extractIsThis)
+    {
+        var parts = new List<string>();
+        if (extractIsThis) parts.Add(extractBytes >= 0 ? "the extracted game (" + GameAppUi.SizeText(extractBytes) + ")" : "the extracted game");
+        parts.Add("the rewrite");
+        if (shaders > 0) parts.Add("the " + shaders.ToString("N0", CultureInfo.InvariantCulture) + (shaders == 1 ? " shader" : " shaders") + " translated so far");
+        else if (shaders < 0) parts.Add("the shaders translated so far");
+        var list = parts.Count == 1 ? parts[0] : string.Join(", ", parts.Take(parts.Count - 1)) + " and " + parts[parts.Count - 1];
+        return "Removes " + list + (extractIsThis ? "" : " (the extracted game is another build's now: it stays)") + "; the game file itself stays.\n" + Keeps;
+    }
+
+    /// What goes: a cancel that frees the space (CancelPlan, the chain having run), and the extraction marker and profile.tsv when extract/ is this game's.
+    public static CancelPlan Plan(string tid, bool frameworkIsPartial, bool extractIsThis)
+    {
+        var p = CancelPlan.For(CancelChoice.FreeSpace, tid, frameworkIsPartial, chainRan: true, extractIsThis);
+        var files = p.Files.ToList();
+        if (extractIsThis) files.AddRange(new[] { "gameapp.extracted", "profile.tsv" });
+        return new CancelPlan(p.Folders, files);
+    }
+
+    /// The log line: "partial build discarded: South Park, 13.4 GB freed".
+    public static string Line(string name, long freedBytes) => "partial build discarded: " + name + ", " + GameAppUi.SizeText(Math.Max(0, freedBytes)) + " freed";
+}
