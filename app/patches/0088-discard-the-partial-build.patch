+    /// The red "Discard the partial build" button (trash), greyed with its reason as a subtitle when refused, hidden when there is nothing to discard. The Build tab's card and the iPad's hero.
+    private static void StyleDiscardButton(UIButton b, PartialDiscard.Offer offer, string why)
+    {
+        var c = UIButtonConfiguration.FilledButtonConfiguration;
+        c.AttributedTitle = new NSAttributedString(PartialDiscard.Title, new UIStringAttributes { Font = Theme.Font(15, UIFontWeight.Medium) });
+        c.Image = UIImage.GetSystemImage("trash");
+        c.ImagePadding = 8;
+        c.BaseBackgroundColor = Look.Raised;
+        c.BaseForegroundColor = offer == PartialDiscard.Offer.Offered ? Theme.Error : Theme.Text.ColorWithAlpha(0.38f);
+        if (offer == PartialDiscard.Offer.Refused && why != null)
+        {
+            c.AttributedSubtitle = new NSAttributedString(why, new UIStringAttributes { Font = Theme.Font(11, UIFontWeight.Regular), ForegroundColor = Theme.Muted });
+            c.TitleAlignment = UIButtonConfigurationTitleAlignment.Center;
+        }
+        var bg = c.Background; bg.CornerRadius = 12; c.Background = bg;
+        b.Configuration = c;
+        b.Enabled = offer == PartialDiscard.Offer.Offered;
+        b.AccessibilityLabel = PartialDiscard.Title;
+        b.AccessibilityHint = offer == PartialDiscard.Offer.Refused ? why : null;
+        b.Hidden = offer == PartialDiscard.Offer.None;
+    }
