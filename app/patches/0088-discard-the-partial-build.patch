+    /// Whether extract/ holds THIS game's extraction (ApplyCancel decides the same way): the paused record says it was extracted, and the slot in Documents is not another game's.
+    private bool DiscardExtractIsThis(string game, PausedBuild record)
+    {
+        bool mine = (stop.State == StopState.Paused && stop.Game == game) || record.Extracted;
+        if (!mine) return false;
+        var inSlot = SlotStore.Read(GameAppMain.Documents);
+        return inSlot.Tid == null || inSlot.BelongsTo(game, GameAppUi.BaseTitleIdOf(game));
+    }
+
+    /// The question, with what goes and its size (the folders measured off the main thread), then the discard.
+    private void AskDiscardPartial(string game)
+    {
+        var offer = DiscardOfferFor(game);
+        if (offer.Offer == PartialDiscard.Offer.Refused) { ShowDiscardRefused(offer.Why); return; }
+        var record = pausedBuilds.FirstOrDefault(r => r.Game == game);
+        if (offer.Offer != PartialDiscard.Offer.Offered || record == null || discardSizing) return;
+        bool extractIsThis = DiscardExtractIsThis(game, record);
+        var plan = PartialDiscard.Plan(GameAppUi.BaseTitleIdOf(game), FrameworkIsPartial(game), extractIsThis);
+        long shaders = PartialDiscard.ShadersDone(record.StageLine);
+        var docs = GameAppMain.Documents;
+        discardSizing = true;
+        Task.Run(() =>
+        {
+            long extract = -1, total = 0;
+            foreach (var rel in plan.Folders)
+            {
+                long b = 0;
+                try { b = FolderWalk.Bytes(Path.Combine(docs, rel)); } catch (Exception) { }
+                if (rel == CancelPlan.Extract) extract = b;
+                total += b;
+            }
+            foreach (var rel in plan.Files)
+                try { var f = new FileInfo(Path.Combine(docs, rel)); if (f.Exists) total += f.Length; } catch (Exception) { }
+            BeginInvokeOnMainThread(() =>
+            {
+                discardSizing = false;
+                var name = GameAppUi.DisplayName(game);
+                var a = UIAlertController.Create($"Discard the partial build of {name}?", PartialDiscard.Note(extract, shaders, extractIsThis), UIAlertControllerStyle.Alert);
+                a.AddAction(UIAlertAction.Create(total > 0 ? $"Discard ({GameAppUi.SizeText(total)})" : "Discard", UIAlertActionStyle.Destructive, _ => DiscardPartial(game, total)));
+                a.AddAction(UIAlertAction.Create("Keep it", UIAlertActionStyle.Cancel, null));
+                PresentWhenFree(a);
+            });
+        });
+    }
+
+    private void DiscardPartial(string game, long bytes)
+    {
+        var offer = DiscardOfferFor(game);   // asked again: a Resume or another build may have started while the question was up
+        if (offer.Offer != PartialDiscard.Offer.Offered) { ShowDiscardRefused(offer.Why ?? "The build is no longer paused."); return; }
+        CancelChosen(game, CancelChoice.FreeSpace, discard: true, freed: bytes);
+    }
