+    private static bool partsSwept;
+
+    /// The extensions of the files this app copies or downloads through <name>.part (CopyIn, CopyWithProgress and the NAS download: games, an exported .ipa, a .romfs; the export itself and PlaceRomfs).
+    private static readonly string[] OurPartExtensions = { ".nsp", ".xci", ".nsz", ".nup", ".ipa", ".romfs" };
+
+    /// True for a file name that is `<something><one of extensions>.part`, ".part" exactly (lower case), the extension in any case (the cloud's own spelling is kept in the name).
+    private static bool IsPartOf(string name, params string[] extensions)
+    {
+        if (name == null || name.Length <= 5 || !name.EndsWith(".part", StringComparison.Ordinal)) return false;
+        var stem = name.Substring(0, name.Length - 5);
+        var extension = Path.GetExtension(stem);
+        return extension.Length > 0 && stem.Length > extension.Length && extensions.Contains(extension, StringComparer.OrdinalIgnoreCase);
+    }
+
+    /// Deletes, in `dir` only (nothing below it), the files `ours` accepts by name; a link is never followed or deleted, a folder is never touched. Logs the count and the size when there was any.
+    private static void SweepPartsIn(string dir, string label, Func<string, bool> ours, Action<string> log)
+    {
+        int removed = 0, failed = 0;
+        long bytes = 0;
+        try
+        {
+            foreach (var file in Directory.EnumerateFiles(dir))
+            {
+                if (!ours(Path.GetFileName(file))) continue;
+                try
+                {
+                    var info = new FileInfo(file);
+                    if (info.LinkTarget != null) continue;   // a link is not ours: this app writes none
+                    long size = info.Length;
+                    File.Delete(file);
+                    removed++;
+                    bytes += size;
+                }
+                catch (Exception) { failed++; }
+            }
+        }
+        catch (Exception) { }
+        if (removed > 0 || failed > 0)
+            log($"launch: {label}: {removed} leftover .part file(s) of a copy, download or export cut short removed ({bytes / 1048576.0:0.0} MB)" + (failed > 0 ? $"; {failed} could not be removed" : ""));
+    }
+
+    /// The folders directly in `dir` that are real folders (not links).
+    private static List<string> RealSubfolders(string dir)
+    {
+        var folders = new List<string>();
+        try
+        {
+            foreach (var folder in Directory.EnumerateDirectories(dir))
+                if (new DirectoryInfo(folder).LinkTarget == null) folders.Add(folder);
+        }
+        catch (Exception) { }
+        return folders;
+    }
+
+    /// A copy, a download or an export writes <name>.part and renames it when it is whole (patches 0040, 0041, 0063's exports; GameAppNas.cs); a kill or a power loss in the middle leaves that .part, possibly
+    /// gigabytes, for good. At launch, before anything can start a copy, the .part files of OUR families are deleted, at fixed places and no deeper, by exact name:
+    ///   Documents/                     <name>.nsp|.xci|.nsz|.nup|.ipa|.romfs.part (an import or a download), prod.keys.part, .titleids.tsv.part
+    ///   Documents/Exports/             <name>.ipa.part (an export, a downloaded app)
+    ///   Documents/Exports/<folder>/    <name> [<title id>].romfs.part (a slim export's game files)
+    ///   Documents/SaveBackups/<folder>/ <date time kind>.zip.part (a save copy: the name has the shape GameSaves.ParseCopyName reads)
+    /// Any other name, a folder and a link are left as they are. Once per process: a copy running in this process is never one to sweep.
+    private static void SweepLeftoverParts(Action<string> log)
+    {
+        if (partsSwept) return;
+        partsSwept = true;
+        var documents = GameAppMain.Documents;
+        SweepPartsIn(documents, "Documents", name => name == "prod.keys.part" || name == ".titleids.tsv.part" || IsPartOf(name, OurPartExtensions), log);
+        var exports = Path.Combine(documents, "Exports");
+        if (Directory.Exists(exports) && new DirectoryInfo(exports).LinkTarget == null)
+        {
+            SweepPartsIn(exports, "Documents/Exports", name => IsPartOf(name, ".ipa"), log);
+            foreach (var folder in RealSubfolders(exports))
+                SweepPartsIn(folder, "Documents/Exports/" + Path.GetFileName(folder), name => IsPartOf(name, ".romfs"), log);
+        }
+        var backups = Path.Combine(documents, GameSaves.Root);
+        if (Directory.Exists(backups) && new DirectoryInfo(backups).LinkTarget == null)
+            foreach (var folder in RealSubfolders(backups))
+                SweepPartsIn(folder, GameSaves.Root + "/" + Path.GetFileName(folder),
+                             name => IsPartOf(name, ".zip") && GameSaves.ParseCopyName(name.Substring(0, name.Length - 5)) != null, log);
+    }
+
