+// gameapp/GameAppAttachUi.cs: app/patches/0084 (UIKit): an update or DLC attached before the build (several files at once, from Files, a folder or a cloud source; one removed again), and
+// the covers of the cloud games before their download (one NAS session for a pass, a cache per remote file, .nup covers read over SFTP, one log line per game without a cover).
+// The decisions are GameAppAttach.cs (pure, run by the host harness).
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Threading;
+using Foundation;
+using UIKit;
+
+/// A .nup on the NAS: its head read through the shim's gameapp_nup_icon_read, the bytes asked of an SFTP stream (crates/ibuilder-ffi ibuilder_nup_icon_read).
+internal static unsafe class NupRemote
+{
+    [DllImport("__Internal")] private static extern int gameapp_nup_icon_read(delegate* unmanaged<IntPtr, ulong, byte*, int, long> read, IntPtr ctx, ulong size, byte[] buf, int cap, out ulong titleId);
+
+    [UnmanagedCallersOnly]
+    private static long Read(IntPtr ctx, ulong offset, byte* buf, int len)
+    {
+        try
+        {
+            var s = (Stream) GCHandle.FromIntPtr(ctx).Target;
+            s.Position = (long) offset;
+            var span = new Span<byte>(buf, len);
+            int total = 0;
+            while (total < len)
+            {
+                int n = s.Read(span.Slice(total));
+                if (n <= 0) break;
+                total += n;
+            }
+            return total;
+        }
+        catch (Exception) { return -1; }
+    }
+
+    /// (the icon or null, the title the build names the game by, why there is none)
+    public static (byte[] Icon, ulong TitleId, string Why) Icon(Stream stream, long size)
+    {
+        var handle = GCHandle.Alloc(stream);
+        try
+        {
+            var buf = new byte[1 << 20];
+            int rc = gameapp_nup_icon_read(&Read, GCHandle.ToIntPtr(handle), (ulong) size, buf, buf.Length, out var tid);
+            if (rc > buf.Length) { buf = new byte[rc]; rc = gameapp_nup_icon_read(&Read, GCHandle.ToIntPtr(handle), (ulong) size, buf, buf.Length, out tid); }
+            if (rc > 0 && rc <= buf.Length) return (buf.AsSpan(0, rc).ToArray(), tid, null);
+            return rc == 0 ? (null, tid, "the package carries no icon") : (null, 0, "not a readable Switch 2 package (the shim's log says why)");
+        }
+        finally { handle.Free(); }
+    }
+}
+
+/// A short list with a tick per row, "Add N": the files of a folder or a cloud source to attach to a game (several at once).
+internal sealed class ChecklistSheet : UIViewController
+{
+    private readonly string title, note;
+    private readonly List<(string Name, string Detail)> rows;
+    private readonly bool[] on;
+    private readonly Action<List<int>> done;
+    private UIButton add;
+
+    public ChecklistSheet(string title, string note, List<(string Name, string Detail)> rows, Action<List<int>> done)
+    {
+        this.title = title; this.note = note; this.rows = rows; this.done = done;
+        on = Enumerable.Repeat(true, rows.Count).ToArray();
+    }
+
+    public override void ViewDidLoad()
+    {
+        base.ViewDidLoad();
+        View.BackgroundColor = Theme.Hex(0x121217);
+        var cancel = Look.Capsule("Cancel", null, false, null, 36, 14);
+        cancel.TouchUpInside += (_, __) => DismissViewController(true, null);
+        add = Look.Capsule("", null, true, null, 36, 14);
+        add.AccessibilityIdentifier = "checklist-add";
+        add.TouchUpInside += (_, __) => { var picked = Enumerable.Range(0, rows.Count).Where(i => on[i]).ToList(); DismissViewController(true, () => done(picked)); };
+        var head = Theme.Row(10, cancel, new UIView(), add);
+        var t = Theme.Label(title, Theme.Font(20, UIFontWeight.Bold), Theme.Text, 2);
+        t.AccessibilityTraits = UIAccessibilityTrait.Header;
+        var list = Theme.Column(0);
+        for (int i = 0; i < rows.Count; i++)
+        {
+            int k = i;
+            var b = new UIButton(UIButtonType.Custom) { AccessibilityIdentifier = "checklist-row-" + i };
+            var mark = Theme.Symbol("checkmark.circle.fill", 22, Theme.Accent);
+            var name = Theme.Label(rows[i].Name, Theme.Font(15, UIFontWeight.Regular), Theme.Text, 2);
+            var detail = Theme.Label(rows[i].Detail ?? "", Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 2);
+            var row = Theme.Row(12, mark, Theme.Column(2, name, detail));
+            row.UserInteractionEnabled = false;
+            row.TranslatesAutoresizingMaskIntoConstraints = false;
+            b.AddSubview(row);
+            NSLayoutConstraint.ActivateConstraints(new[] { row.TopAnchor.ConstraintEqualTo(b.TopAnchor, 10), row.BottomAnchor.ConstraintEqualTo(b.BottomAnchor, -10), row.LeadingAnchor.ConstraintEqualTo(b.LeadingAnchor), row.TrailingAnchor.ConstraintEqualTo(b.TrailingAnchor), b.HeightAnchor.ConstraintGreaterThanOrEqualTo(44) });
+            void Show() { mark.Image = UIImage.GetSystemImage(on[k] ? "checkmark.circle.fill" : "circle"); mark.TintColor = on[k] ? Theme.Accent : Theme.Muted; b.AccessibilityLabel = rows[k].Name; b.AccessibilityValue = on[k] ? "chosen" : "not chosen"; }
+            b.TouchUpInside += (_, __) => { on[k] = !on[k]; Show(); Count(); };
+            Show();
+            if (i > 0) { var rule = new UIView { BackgroundColor = Look.Line }; rule.HeightAnchor.ConstraintEqualTo(1).Active = true; list.AddArrangedSubview(rule); }
+            list.AddArrangedSubview(b);
+        }
+        var column = Theme.Column(14, head, t, Theme.Label(note ?? "", Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 0), Look.Card(list, 2, 16));
+        var scroll = new UIScrollView { AlwaysBounceVertical = true, AlwaysBounceHorizontal = false, TranslatesAutoresizingMaskIntoConstraints = false };
+        column.TranslatesAutoresizingMaskIntoConstraints = false;
+        scroll.AddSubview(column);
+        Theme.PinColumn(scroll, column, 16, 32, 20);
+        View.AddSubview(scroll);
+        NSLayoutConstraint.ActivateConstraints(new[] { scroll.TopAnchor.ConstraintEqualTo(View.SafeAreaLayoutGuide.TopAnchor), scroll.BottomAnchor.ConstraintEqualTo(View.BottomAnchor), scroll.LeadingAnchor.ConstraintEqualTo(View.LeadingAnchor), scroll.TrailingAnchor.ConstraintEqualTo(View.TrailingAnchor) });
+        Count();
+    }
+
+    private void Count()
+    {
+        int n = on.Count(x => x);
+        var c = add.Configuration;
+        c.AttributedTitle = new NSAttributedString(n == 0 ? "Add" : $"Add {n}", new UIStringAttributes { Font = Theme.Font(14, UIFontWeight.Semibold) });
+        add.Configuration = c;
+        add.Enabled = n > 0;
+    }
+}
