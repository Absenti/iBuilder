+// gameapp/GameAppAttach.cs: the pure part of app/patches/0084: an update or DLC attached to a game before its build (classified by title id, summed up on the Build row), an Atmosphere
+// cheat file picked alone, and the covers of the games on the NAS / in a Files folder before their download (what to read, a cache per remote file, one line per game that has none).
+// No UIKit: the host harness compiles it as it is.
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+
+/// The files picked to attach to one game: each one is its update, one of its DLC, or refused with a short reason (another game's, a base game, not a game file). The pairing is the
+/// chain's own (GameAppUi.UpdateFor / DlcFor: base 0100…000, update …800, DLC …1xxx of the same base id); a file attached is simply in Documents under its own name.
+public static class ContentAttach
+{
+    public enum Kind { Update, Dlc, Refused }
+
+    public sealed record Pick(string Name, Kind Kind, string Why);
+
+    public static List<Pick> Classify(string game, IEnumerable<string> picked)
+    {
+        var list = new List<Pick>();
+        var baseId = GameAppUi.BaseTitleIdOf(game);
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var raw in picked ?? Enumerable.Empty<string>())
+        {
+            var name = Path.GetFileName(raw ?? "");
+            if (name.Length == 0 || !seen.Add(name)) continue;
+            if (!Cloud.IsGameFile(name)) { list.Add(new Pick(name, Kind.Refused, "not a game file (.nsp, .xci, .nsz)")); continue; }
+            if (GameAppUi.IsNup(name)) { list.Add(new Pick(name, Kind.Refused, "a Switch 2 package: its update is inside it")); continue; }
+            var kind = GameAppUi.ContentKindOf(name);
+            var id = GameAppUi.BaseTitleIdOf(name);
+            if (id == null) { list.Add(new Pick(name, Kind.Refused, "its name carries no [title id]")); continue; }
+            if (baseId == null || !string.Equals(id, baseId, StringComparison.OrdinalIgnoreCase)) { list.Add(new Pick(name, Kind.Refused, "it belongs to another game")); continue; }
+            if (kind == GameAppUi.ContentKind.Base) { list.Add(new Pick(name, Kind.Refused, "it is the base game, not an update or a DLC")); continue; }
+            list.Add(new Pick(name, kind == GameAppUi.ContentKind.Update ? Kind.Update : Kind.Dlc, null));
+        }
+        return list;
+    }
+
+    /// "update v131072 · 1 DLC", "2 DLC", "" (what the build will merge, as UpdateFor / DlcFor pick it).
+    public static string Summary(string game, IEnumerable<string> local)
+    {
+        var names = (local ?? Enumerable.Empty<string>()).ToList();
+        if (GameAppUi.IsNup(game) || GameAppUi.ContentKindOf(game) != GameAppUi.ContentKind.Base) return "";
+        var update = GameAppUi.UpdateFor(game, names);
+        int dlc = GameAppUi.DlcFor(game, names).Count;
+        var parts = new List<string>();
+        if (update != null) { long v = GameAppUi.VersionOf(update); parts.Add(v > 0 ? "update v" + v.ToString(CultureInfo.InvariantCulture) : "update"); }
+        if (dlc > 0) parts.Add(dlc + " DLC");
+        return string.Join(" · ", parts);
+    }
+
+    /// The attached files of a game, the ones a person may remove before the build: its update(s) and DLC in Documents.
+    public static List<string> Attached(string game, IEnumerable<string> local) =>
+        GameAppUi.IsNup(game) ? new List<string>() :
+        (local ?? Enumerable.Empty<string>()).Where(n => !string.Equals(n, game, StringComparison.OrdinalIgnoreCase)
+                                                        && string.Equals(GameAppUi.BaseTitleIdOf(n), GameAppUi.BaseTitleIdOf(game), StringComparison.OrdinalIgnoreCase)
+                                                        && GameAppUi.ContentKindOf(n) is GameAppUi.ContentKind.Update or GameAppUi.ContentKind.AddOn).ToList();
+
+    /// The answer after a pick: "Attached: X, Y. Not attached: Z (it belongs to another game)."
+    public static string Report(IEnumerable<Pick> picks)
+    {
+        var l = (picks ?? Enumerable.Empty<Pick>()).ToList();
+        var ok = l.Where(p => p.Kind != Kind.Refused).Select(p => p.Name).ToList();
+        var no = l.Where(p => p.Kind == Kind.Refused).Select(p => $"{p.Name} ({p.Why})").ToList();
+        var parts = new List<string>();
+        if (ok.Count > 0) parts.Add("Attached: " + string.Join(", ", ok) + ".");
+        if (no.Count > 0) parts.Add("Not attached: " + string.Join(", ", no) + ".");
+        return parts.Count == 0 ? "Nothing was picked." : string.Join(" ", parts);
+    }
+}
+
+/// An Atmosphere cheat file picked alone (`atmosphere/contents/<title id>/cheats/<build id>.txt`, or the same .txt from Files): its name must be the build id (16 hex digits), which is how
+/// the boot matches it to the game's code (ibuilder-mods boot.rs cheat_file_bid).
+public static class CheatImport
+{
+    public static string BuildIdOf(string fileName) =>
+        fileName != null && fileName.EndsWith(".txt", StringComparison.OrdinalIgnoreCase) ? GameMods.BidOfName(Path.GetFileName(fileName)) : null;
+
+    public const string NeedsBuildId = "A cheat file is named after the game's build id: 16 hex digits, then .txt (as in atmosphere/contents/<title id>/cheats/).";
+
+    /// The mod a lone cheat file becomes: "Cheats 0123ABCD" (the first 8 digits of its build id).
+    public static string ModName(string buildId) => "Cheats " + (buildId ?? "").Substring(0, Math.Min(8, (buildId ?? "").Length));
+}
+
+/// The covers of cloud games before their download (patch 0084).
+public static class CloudCovers
+{
+    public enum Do { Skip, Package, Nup, NeedsKeys }
+
+    /// What the pass does with one cloud file. `iconHere`: games/<id>/icon.jpg (or the person's cover) exists; `cached`: this remote file (same size) was read already and gave no cover;
+    /// `failedNow`: a read failed in this session (tried again at the next launch).
+    public static Do Decide(string name, bool hasKeys, bool iconHere, bool cached, bool failedNow, bool placeholder)
+    {
+        if (!Cloud.IsGameFile(name) || iconHere || failedNow || cached || placeholder) return Do.Skip;
+        if (GameAppUi.ContentKindOf(name) != GameAppUi.ContentKind.Base) return Do.Skip;   // an update / DLC shows its base game
+        if (GameAppUi.IsNup(name)) return Do.Nup;                                         // not encrypted: no keys
+        return hasKeys ? Do.Package : Do.NeedsKeys;                                        // .nsp .xci .nsz: the control NCA needs prod.keys
+    }
+
+    public sealed record Entry(string Source, string Remote, long Size, string Outcome, string Why, string At);
+
+    public const string FileName = "gameapp.cloudcovers.tsv";
+
+    private static string Clean(string s) => (s ?? "").Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
+
+    public static string Format(IEnumerable<Entry> list) =>
+        "# cloud covers read before the download (app patch 0084): source, remote, size, outcome, why, when\n"
+        + string.Concat((list ?? Enumerable.Empty<Entry>()).Select(e => $"{Clean(e.Source)}\t{Clean(e.Remote)}\t{e.Size.ToString(CultureInfo.InvariantCulture)}\t{Clean(e.Outcome)}\t{Clean(e.Why)}\t{Clean(e.At)}\n"));
+
+    public static List<Entry> Parse(string text)
+    {
+        var list = new List<Entry>();
+        foreach (var raw in (text ?? "").Split('\n'))
+        {
+            var c = raw.TrimEnd('\r').Split('\t');
+            if (c.Length != 6 || raw.StartsWith("#", StringComparison.Ordinal) || !long.TryParse(c[2], NumberStyles.None, CultureInfo.InvariantCulture, out var size)) continue;
+            list.Add(new Entry(c[0], c[1], size, c[3], c[4], c[5]));
+        }
+        return list;
+    }
+
+    /// The entry of this remote file: same source, same remote path, same size (a file replaced on the NAS by another of another size is read again).
+    public static Entry Find(IEnumerable<Entry> list, string source, string remote, long size) =>
+        (list ?? Enumerable.Empty<Entry>()).LastOrDefault(e => e.Source == source && e.Remote == remote && e.Size == size);
+
+    public static List<Entry> Upsert(IEnumerable<Entry> list, Entry e) =>
+        (list ?? Enumerable.Empty<Entry>()).Where(x => !(x.Source == e.Source && x.Remote == e.Remote)).Append(e).ToList();
+
+    /// A cached "none" stands (no read again) while the file is the same size; an icon outcome needs its icon file (it was deleted: read again).
+    public static bool Stands(Entry e, bool iconHere) => e != null && (e.Outcome == "none" || (e.Outcome == "icon" && iconHere));
+
+    /// One line per game that has no cover, and one for a cover read: what the owner's log says.
+    public static string Line(string name, string where, string outcome, string why) => outcome switch
+    {
+        "icon" => $"cover: {name} ({where}): read before the download",
+        "none" => $"cover: {name} ({where}): none: {why ?? "the package carries no icon"} (Choose a cover… gives it one once it is on this iPhone)",
+        "keys" => $"cover: {name} ({where}): needs prod.keys (an .nsp, .xci or .nsz cover is read with them)",
+        _ => $"cover: {name} ({where}): read failed: {why ?? "no answer"} (tried again at the next launch)",
+    };
+}
