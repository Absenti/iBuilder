+public sealed partial class GameAppViewController
+{
+    // ---- an update or DLC, attached before the build ---------------------------------------------------------------
+
+    /// "Add an update or DLC…": files (several at once, the Import-mode picker: the Open-mode one delivers nothing on iOS 27.2.1, DEVICE-FINDINGS), a folder, or a cloud source.
+    private void ShowContentChooser(string game, UIView source)
+    {
+        var names = Dumps().Select(Path.GetFileName).ToList();
+        var inCloud = GameAppUi.RelatedContent(game, cloudFiles.Select(f => f.Name)).Where(n => !names.Contains(n, StringComparer.OrdinalIgnoreCase))
+                               .Select(n => Cloud.CloudCopyOf(n, cloudFiles)).Where(f => f != null).ToList();
+        var sheet = UIAlertController.Create("Add an update or DLC", GameAppUi.DisplayName(game) + ": the build merges them (matched by title id).", UIAlertControllerStyle.ActionSheet);
+        sheet.AddAction(UIAlertAction.Create("Pick files… (several at once)", UIAlertActionStyle.Default, _ => AttachPicked(game)));
+        sheet.AddAction(UIAlertAction.Create("Find them in a folder…", UIAlertActionStyle.Default, _ => PresentFolderPicker("update and DLC folder", url => ScanFolderForContent(game, url))));
+        if (inCloud.Count > 0)
+            sheet.AddAction(UIAlertAction.Create($"From the cloud ({inCloud.Count})…", UIAlertActionStyle.Default, _ => AttachFromCloud(game, inCloud)));
+        sheet.AddAction(UIAlertAction.Create("Cancel", UIAlertActionStyle.Cancel, null));
+        Theme.Anchor(sheet, source, View);
+        PresentWhenFree(sheet);
+    }
+
+    private void AttachFromCloud(string game, List<CloudFile> files)
+    {
+        var rows = files.Select(f => (f.Name, Cloud.Where(f, cloudSources))).ToList();
+        PresentWhenFree(new ChecklistSheet("Attach to " + GameAppUi.DisplayName(game), "Downloaded, then merged by the build.", rows,
+            picked => { var set = picked.Select(i => files[i]).ToList(); if (set.Count > 0) Download(set, GameAppMain.Documents); }));
+    }
+
+    private NSObject attachDelegate;
+
+    /// Several files at once; each is this game's update or DLC, or refused with its reason; the valid ones are moved in (CopyIn: the import record, so 0068/0073 can free them later).
+    private void AttachPicked(string game)
+    {
+#pragma warning disable CA1422   // the Import-mode picker on purpose: the Open-mode pickers deliver nothing on the owner's iOS 27.2.1 (DEVICE-FINDINGS)
+        var picker = new UIDocumentPickerViewController(new[] { "public.item" }, UIDocumentPickerMode.Import) { AllowsMultipleSelection = true };
+#pragma warning restore CA1422
+        var d = new AttachDelegate(urls => BeginInvokeOnMainThread(() =>
+        {
+            var picks = ContentAttach.Classify(game, urls.Select(u => u.LastPathComponent));
+            foreach (var url in urls)
+            {
+                var p = picks.FirstOrDefault(x => string.Equals(x.Name, url.LastPathComponent, StringComparison.OrdinalIgnoreCase));
+                if (p != null && p.Kind != ContentAttach.Kind.Refused) CopyIn(url);
+                else { try { File.Delete(url.Path); } catch (Exception) { } }   // the picker's own copy in our tmp/
+            }
+            var text = ContentAttach.Report(picks);
+            Write($"attach: {GameAppUi.DisplayName(game)}: {text}");
+            var a = UIAlertController.Create(GameAppUi.DisplayName(game), text, UIAlertControllerStyle.Alert);
+            a.AddAction(UIAlertAction.Create("OK", UIAlertActionStyle.Cancel, null));
+            PresentWhenFree(a);
+            RefreshScreen();
+        }));
+        attachDelegate = d;
+        picker.Delegate = d;
+        PresentWhenFree(picker);
+    }
+
+    private sealed class AttachDelegate : NSObject, IUIDocumentPickerDelegate
+    {
+        private readonly Action<NSUrl[]> picked;
+        public AttachDelegate(Action<NSUrl[]> picked) => this.picked = picked;
+        public void DidPickDocument(UIDocumentPickerViewController controller, NSUrl url) => picked(new[] { url });
+        [Export("documentPicker:didPickDocumentsAtURLs:")]
+        public void DidPickDocumentAtUrls(UIDocumentPickerViewController controller, NSUrl[] urls) => picked(urls);
+    }
+
+    /// One attached file removed before the build (its update or a DLC).
+    private void RemoveAttached(string file)
+    {
+        var path = Path.Combine(GameAppMain.Documents, file);
+        if (!File.Exists(path)) return;
+        RemoveFiles(new List<string> { path }, Cloud.CloudCopyOf(file, cloudFiles) != null);   // the app's own question (it says whether it stays in the cloud)
+    }
+
+    // ---- covers before the download --------------------------------------------------------------------------------
+
+    private readonly HashSet<string> coverKeysNoted = new HashSet<string>(StringComparer.Ordinal);
+    private static readonly object coverCacheGate = new object();
+
+    private static string CoverCachePath => Path.Combine(GameAppMain.Documents, CloudCovers.FileName);
+
+    private static List<CloudCovers.Entry> LoadCoverCache()
+    {
+        try { return File.Exists(CoverCachePath) ? CloudCovers.Parse(File.ReadAllText(CoverCachePath)) : new List<CloudCovers.Entry>(); }
+        catch (Exception) { return new List<CloudCovers.Entry>(); }
+    }
+
+    private static void SaveCoverCache(List<CloudCovers.Entry> list)
+    {
+        lock (coverCacheGate)
+        {
+            var part = CoverCachePath + ".part";
+            try { File.WriteAllText(part, CloudCovers.Format(list)); File.Move(part, CoverCachePath, true); }
+            catch (Exception) { try { File.Delete(part); } catch (Exception) { } }
+        }
+    }
+
+    /// The covers of the games only in a cloud source, before their download (it replaces the pass of 0051 / 0079, same files: games/<id>/icon.jpg, the person's cover still first).
+    /// Off the main thread, never while a build runs, never in the listing's way: the listing ends, then this starts. ONE NAS session for the whole pass; a Files folder opened once.
+    private void FetchCloudCovers()
+    {
+        if (GameExport.IsPlayer || running) return;
+        var docs = GameAppMain.Documents;
+        var keys = Path.Combine(docs, "prod.keys");
+        bool hasKeys = File.Exists(keys);
+        string Doc(string rel) => Path.Combine(docs, rel.Replace('/', Path.DirectorySeparatorChar));
+        string Key(CloudFile f) => f.SourceId + "\t" + (f.Remote ?? f.Name);
+        var local = Dumps().Select(Path.GetFileName).ToList();
+        var cache = LoadCoverCache();
+        var todo = new List<(CloudFile F, CloudCovers.Do Do)>();
+        foreach (var f in Cloud.CloudOnlyGames(local, cloudFiles))
+        {
+            var rel = GameAppUi.IconRelativePath(f.Name);
+            bool iconHere = (rel != null && File.Exists(Doc(rel))) || HasCustomCover(f.Name);
+            var entry = CloudCovers.Find(cache, f.SourceId, f.Remote ?? f.Name, f.Size);
+            var d = CloudCovers.Decide(f.Name, hasKeys, iconHere, CloudCovers.Stands(entry, iconHere), cloudIconFailed.Contains(Key(f)), false);
+            if (d == CloudCovers.Do.NeedsKeys) { if (coverKeysNoted.Add(Key(f))) Write(CloudCovers.Line(f.Name, CloudWords(f).Where, "keys", null)); }
+            else if (d != CloudCovers.Do.Skip) todo.Add((f, d));
+        }
+        if (todo.Count == 0 || Interlocked.CompareExchange(ref cloudIconsRunning, 1, 0) != 0) return;
+        var nas = LoadNas();
+        var password = NasPassword();
+        var sources = cloudSources;
+        System.Threading.Tasks.Task.Run(() =>
+        {
+            int got = 0;
+            var failed = new List<string>();
+            var lines = new List<string>();
+            void Post() { var l = lines.ToList(); lines.Clear(); if (l.Count > 0) BeginInvokeOnMainThread(() => { foreach (var x in l) Write(x); }); }
+            // one result: the icon, the title the package names, why there is none, whether the read failed
+            (byte[] Jpeg, ulong Title, string Why, bool Failed) ReadOne(CloudCovers.Do how, Stream stream, long size)
+            {
+                try
+                {
+                    if (how == CloudCovers.Do.Nup) { var r = NupRemote.Icon(stream, size); return (r.Icon, r.TitleId & ~0xFFFUL, r.Why, r.Why != null && r.Why.StartsWith("not a readable", StringComparison.Ordinal)); }
+                    var jpeg = GameIconsStream.Read(keys, stream, out var control, out var why);
+                    return (jpeg, CoverPass.BaseIdFromControl(control), why, false);
+                }
+                catch (Exception e) { return (null, 0, (e.InnerException ?? e).Message, true); }
+            }
+            void Land(CloudFile f, (byte[] Jpeg, ulong Title, string Why, bool Failed) r)
+            {
+                var where = CloudWords(f).Where;
+                if (r.Failed) { failed.Add(Key(f)); lines.Add(CloudCovers.Line(f.Name, where, "failed", r.Why)); return; }
+                if (GameAppUi.IconRelativePath(f.Name) == null && r.Title != 0)
+                {
+                    GameAppUi.SetTitleFromContent(f.Name, r.Title);   // a name with no [title id]: the package names it (0051, 0079)
+                    GameAppUi.SaveTitlesFromContent(GameAppMain.Documents);
+                    got++;
+                }
+                var rel = GameAppUi.IconRelativePath(f.Name);
+                string outcome = r.Jpeg != null && rel != null ? "icon" : "none";
+                if (outcome == "icon")
+                {
+                    lock (CoverPass.Gate)
+                    {
+                        var icon = Doc(rel);
+                        if (!File.Exists(icon))
+                        {
+                            Directory.CreateDirectory(Path.GetDirectoryName(icon));
+                            var part = GameCover.PartOf(icon);
+                            File.WriteAllBytes(part, r.Jpeg);
+                            File.Move(part, icon, true);
+                            got++;
+                        }
+                    }
+                }
+                lock (coverCacheGate) cache = CloudCovers.Upsert(cache, new CloudCovers.Entry(f.SourceId, f.Remote ?? f.Name, f.Size, outcome, outcome == "none" ? r.Why ?? (rel == null ? "the package names no title" : null) : null, DateTime.UtcNow.ToString("o")));
+                lines.Add(CloudCovers.Line(f.Name, where, outcome, r.Why ?? (rel == null ? "the package names no title" : null)));
+            }
+            try
+            {
+                foreach (var group in todo.GroupBy(x => x.F.SourceId))
+                {
+                    if (running) break;   // a build started: the rest waits for the next pass
+                    var source = sources.FirstOrDefault(s => s.Id == group.Key);
+                    if (source == null) continue;
+                    try
+                    {
+                        if (source.Kind == CloudKind.Nas)
+                        {
+                            if (string.IsNullOrEmpty(password)) continue;
+                            Nas.WithSession(nas, Nas.Password(nas.User, password), open =>   // ONE connection for the whole source (it was one per cover)
+                            {
+                                foreach (var (f, how) in group)
+                                {
+                                    if (running) break;
+                                    (byte[], ulong, string, bool) r;
+                                    try { var (stream, size) = open(f.Remote); using (stream) r = ReadOne(how, stream, size); }
+                                    catch (Exception e) { r = (null, 0, (e.InnerException ?? e).Message, true); }
+                                    Land(f, r);
+                                    Post();
+                                    if (got > 0 && got % 3 == 0) BeginInvokeOnMainThread(RefreshScreen);
+                                }
+                            });
+                        }
+                        else
+                        {
+                            var folder = ResolveFolder(source, out var whyNot);
+                            if (folder == null) continue;
+                            bool scoped = folder.StartAccessingSecurityScopedResource();
+                            try
+                            {
+                                foreach (var (f, how) in group)
+                                {
+                                    if (running) break;
+                                    var path = Path.Combine(folder.Path, f.Remote ?? f.Name);
+                                    if (!File.Exists(path)) continue;   // only in iCloud (a placeholder): not downloaded for a cover
+                                    if (how == CloudCovers.Do.Nup)
+                                    {
+                                        var buf = new byte[1 << 20];
+                                        int rc = NupNative.gameapp_nup_icon(path, buf, buf.Length, out var tid);
+                                        if (rc > buf.Length) { buf = new byte[rc]; rc = NupNative.gameapp_nup_icon(path, buf, buf.Length, out tid); }
+                                        Land(f, rc > 0 && rc <= buf.Length ? (buf.AsSpan(0, rc).ToArray(), tid & ~0xFFFUL, null, false) : rc == 0 ? (null, tid & ~0xFFFUL, "the package carries no icon", false) : (null, 0, "not a readable Switch 2 package", true));
+                                    }
+                                    else
+                                    {
+                                        using var stream = File.OpenRead(path);
+                                        Land(f, ReadOne(how, stream, stream.Length));
+                                    }
+                                    Post();
+                                }
+                            }
+                            finally { if (scoped) folder.StopAccessingSecurityScopedResource(); }
+                        }
+                    }
+                    catch (Exception e)
+                    {
+                        // the session itself failed (the NAS is not reachable, its key changed...): every cover of the source says it, and is tried again at the next launch
+                        foreach (var (f, _) in group) if (!failed.Contains(Key(f))) { failed.Add(Key(f)); lines.Add(CloudCovers.Line(f.Name, CloudWords(f).Where, "failed", (e.InnerException ?? e).Message)); }
+                        Post();
+                    }
+                }
+                List<CloudCovers.Entry> snapshot;
+                lock (coverCacheGate) snapshot = cache.ToList();
+                SaveCoverCache(snapshot);
+            }
+            finally { Interlocked.Exchange(ref cloudIconsRunning, 0); }
+            BeginInvokeOnMainThread(() => { foreach (var k in failed) cloudIconFailed.Add(k); if (got > 0) RefreshScreen(); });
+        });
+    }
+}
