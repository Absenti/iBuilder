+    /// What an exported player's first start prepares: the keys of its pack's seed list (pso_manifest.tsv) and of this phone's learned list (pso_user.tsv), then the ones used before (same key
+    /// rules as the used file). The host prepares exactly these at a boot, so what is warmed here is what the boot would otherwise compile in front of its progress screen.
+    public static List<string> NeededKeys(string manifestText, string userText, IReadOnlyList<string> usedKeys)
+    {
+        var keys = new List<string>(); var seen = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var k in KeysFromPsoRows(manifestText)) if (seen.Add(k)) keys.Add(k);
+        foreach (var k in KeysFromPsoRows(userText)) if (seen.Add(k)) keys.Add(k);
+        foreach (var k in usedKeys ?? new List<string>()) if (seen.Add(k)) keys.Add(k);
+        return keys;
+    }
