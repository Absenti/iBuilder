+/// Patch 0090 (the owner's log of 2026-11-21 23:51: every .nsp and .nsz cover on the NAS "read failed: ResultFsOutOfRange (2002-3005)"): LibHac's StreamStorage reads with ONE
+/// Stream.Read and takes a short count as the whole answer (measured: a stream that gives 7 bytes per Read makes PartitionFileSystem.Initialize fail with exactly
+/// ResultFsOutOfRange), and SSH.NET's SftpFileStream.Read gives what one SFTP reply holds. A file in Files gives full counts, which is why the same packages read from Files had covers.
+/// This stream is put between a remote stream and anything that expects full reads: every Read fills what was asked (up to the end of the file), from aligned blocks fetched with as
+/// few requests as the remote stream needs and kept in a small LRU (LibHac's many small header reads cost few round trips); its Length is the size the remote listing gave.
+public sealed class RemoteReadStream : Stream
+{
+    private readonly Stream inner;
+    private readonly long length;
+    private readonly int block;
+    private readonly int maxBlocks;
+    private readonly bool leaveOpen;
+    private readonly LinkedList<(long Index, byte[] Data)> lru = new LinkedList<(long, byte[])>();
+    private readonly Dictionary<long, LinkedListNode<(long Index, byte[] Data)>> byIndex = new Dictionary<long, LinkedListNode<(long, byte[])>>();
+    private long position;
+
+    public const int DefaultBlock = 256 * 1024, DefaultBlocks = 16;
+
+    /// The remote stream's Read calls (each one a round trip or less) and the bytes they gave.
+    public int Requests { get; private set; }
+    public long Fetched { get; private set; }
+
+    public RemoteReadStream(Stream inner, long length, int blockSize = DefaultBlock, int maxBlocks = DefaultBlocks, bool leaveOpen = false)
+    {
+        this.inner = inner ?? throw new ArgumentNullException(nameof(inner));
+        this.length = Math.Max(0, length);
+        block = Math.Max(1, blockSize);
+        this.maxBlocks = Math.Max(1, maxBlocks);
+        this.leaveOpen = leaveOpen;
+    }
+
+    public override bool CanRead => true;
+    public override bool CanSeek => true;
+    public override bool CanWrite => false;
+    public override long Length => length;
+    public override long Position { get => position; set => position = value < 0 ? throw new ArgumentOutOfRangeException(nameof(value)) : value; }
+    public override void Flush() { }
+    public override void SetLength(long value) => throw new NotSupportedException();
+    public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();
+
+    public override long Seek(long offset, SeekOrigin origin)
+    {
+        long to = origin switch { SeekOrigin.Begin => offset, SeekOrigin.Current => position + offset, _ => length + offset };
+        if (to < 0) throw new IOException("a seek before the start of the file");
+        return position = to;
+    }
+
+    public override int Read(byte[] buffer, int offset, int count) => Read(buffer.AsSpan(offset, count));
+
+    public override int Read(Span<byte> destination)
+    {
+        int done = 0;
+        while (done < destination.Length && position < length)
+        {
+            long index = position / block;
+            var data = Block(index);
+            int at = (int) (position - index * block);
+            int n = Math.Min(destination.Length - done, data.Length - at);
+            if (n <= 0) break;   // the remote file ended before its listed size
+            data.AsSpan(at, n).CopyTo(destination.Slice(done));
+            done += n;
+            position += n;
+        }
+        return done;
+    }
+
+    private byte[] Block(long index)
+    {
+        if (byIndex.TryGetValue(index, out var node)) { lru.Remove(node); lru.AddFirst(node); return node.Value.Data; }
+        long start = index * block;
+        var data = new byte[(int) Math.Min(block, length - start)];
+        inner.Position = start;
+        int got = 0;
+        while (got < data.Length)
+        {
+            int n = inner.Read(data, got, data.Length - got);
+            Requests++;
+            if (n <= 0) break;
+            got += n;
+            Fetched += n;
+        }
+        if (got < data.Length) Array.Resize(ref data, got);   // shorter than listed: what there is (a later Read ends there)
+        var added = lru.AddFirst((index, data));
+        byIndex[index] = added;
+        while (lru.Count > maxBlocks) { var last = lru.Last; lru.RemoveLast(); byIndex.Remove(last.Value.Index); }
+        return data;
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing && !leaveOpen) inner.Dispose();
+        base.Dispose(disposing);
+    }
+
+    /// "cover: Zelda … (On the NAS): read in 12 requests, 1,536 KB".
+    public static string Line(string name, string where, int requests, long bytes) =>
+        $"cover: {name} ({where}): read in {requests.ToString(CultureInfo.InvariantCulture)} request{(requests == 1 ? "" : "s")}, {(Math.Max(0, bytes) / 1024).ToString("N0", CultureInfo.InvariantCulture)} KB";
 }
