# The player's game-files FILE picker (Open mode) does nothing on iOS 27.0.1 (a tap on the 12 GB .romfs or on a 94-byte file never reaches the delegate; the old and the content-type initialisers alike: cable tests on
# the re-exported players, 2026-11-19), while a FOLDER picker has its blue "Open" button and works. The player now asks for the FOLDER (On My iPhone > iBuilder > Exports > <the game>) and finds the .romfs inside it,
# read in place through the folder's security scope; the bookmark is the folder (an older bookmark of the file still works). Applies after 0057.
diff -ruN a/GameAppExport.cs b/GameAppExport.cs
--- a/GameAppExport.cs
+++ b/GameAppExport.cs
@@ -128,15 +128,34 @@
                 var url = NSUrl.FromBookmarkData(data, NSUrlBookmarkResolutionOptions.WithoutUI, null, out bool stale, out NSError error);
                 if (url == null) return null;
                 url.StartAccessingSecurityScopedResource();
-                if (!File.Exists(url.Path) || Mismatch(url.Path) != null) { url.StopAccessingSecurityScopedResource(); return null; }
+                // the bookmark is the folder the player picked (or, from an earlier version, the file itself)
+                var target = Directory.Exists(url.Path) ? FindRomfsIn(url.Path) : url.Path;
+                if (target == null || !File.Exists(target) || Mismatch(target) != null) { url.StopAccessingSecurityScopedResource(); return null; }
