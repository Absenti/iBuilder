+            // the folder that holds the game files (the picker of the player), or the file itself
+            var file = url.Path;
+            if (Directory.Exists(file))
+            {
+                var folder = file;
+                file = FindRomfsIn(folder);
+                if (file == null)
+                {
+                    if (accessed) url.StopAccessingSecurityScopedResource();
+                    return $"{Path.GetFileName(folder.TrimEnd('/'))} holds no game files for this app (a file named {PlayerRomfsName ?? "*" + GameAppUi.RomfsExtension}). Pick the folder in On My iPhone › iBuilder › Exports.";
+                }
+            }
+            var why = Mismatch(file);
             if (why != null) { if (accessed) url.StopAccessingSecurityScopedResource(); return why; }
             SaveBookmark(url);
             romfsUrl?.StopAccessingSecurityScopedResource();
-            romfsUrl = url;            // stays accessed: the boot opens it by path
-            romfsPath = url.Path;
+            romfsUrl = url;            // stays accessed: the boot opens the file by path
+            romfsPath = file;
             return null;
         }
         catch (Exception e)
