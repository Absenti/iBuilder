+    /// The game files inside a picked folder: the file the manifest names, else any .romfs that is this game's.
+    private static string FindRomfsIn(string folder)
+    {
+        try
+        {
+            if (PlayerManifest != null && PlayerManifest.TryGetValue("romfs_file", out var wanted) && !string.IsNullOrEmpty(wanted))
+            {
+                var exact = Path.Combine(folder, wanted);
+                if (File.Exists(exact)) return exact;
+            }
+            foreach (var f in Directory.EnumerateFiles(folder, "*" + GameAppUi.RomfsExtension))
+                if (Mismatch(f) == null) return f;
+        }
+        catch (Exception) { }
+        return null;
+    }
+
     private static string Mismatch(string path)
     {
         long size = new FileInfo(path).Length;
