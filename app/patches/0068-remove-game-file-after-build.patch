--- a/GameAppSourceUi.cs
+++ b/GameAppSourceUi.cs
@@ -0,0 +1,148 @@
+// gameapp/GameAppSourceUi.cs -- "Remove the game file after a successful build": the view controller's half (patch 0068). The records, the decision, the stub and the words are in GameAppSourceRemoval.cs (no UIKit, run by the
+// host harness).
+//
+//   * Every import path writes a record into Documents/gameapp.imports.tsv (file name, size, how, source, time): the old Import picker (CopyIn: iOS copied the file into tmp/, the app moved it), "Add from a folder without
+//     copying" (a clone, else a copy), the Cloud page's Download / Download and build (a Files-folder source: a clone, else a copy; the NAS: a download) and "Find them in a folder" (an update or DLC). A file the owner put
+//     into Documents by hand has no record and is never removed.
+//   * RemoveSourceAfterBuild runs when a build's chain returned 0 (after Finish): on a worker thread it replaces the game file (and its update and DLC, each by its own record) by an empty stub of the same name, and logs
+//     `source: removed <name> (<size>) after the build (it was <how>, from <source>)`. The stub keeps the game in the library (the library is built from the game files in Documents) and everything that goes by its name.
+//   * What needs the content asks first (GameFileHasContent): Set up / Rebuild / Update, "Add to the build queue", the queue's own start (no alert there: the item fails with the reason), the icon passes (they skip it).
+//     The message is "The game file was removed after the build to free space. Add it again to rebuild." with "Add it again from <source>" when the Files-folder source it came from still lists it (a clone: instant) and
+//     the two ways of the + menu.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+
+using Foundation;
+using UIKit;
+
+/// What a game file in Documents holds: content, nothing because the app removed it after the build (a stub), nothing at all (an empty file), or it is not there.
+internal enum SourceFileState { Content, Stub, Empty, Missing }
+
+public sealed partial class GameAppViewController
+{
+    private static SourceFileState GameFileContent(string name)
+    {
+        try
+        {
+            var f = new FileInfo(Path.Combine(GameAppMain.Documents, name));
+            if (!f.Exists) return SourceFileState.Missing;
+            if (f.Length > 0) return SourceFileState.Content;
+            return SourceStub.IsStub(0, ImportLedger.Find(ImportLedger.Load(GameAppMain.Documents), name)) ? SourceFileState.Stub : SourceFileState.Empty;
+        }
+        catch (Exception) { return SourceFileState.Missing; }
+    }
+
+    /// The size column of a game: its size, "File removed" for a stub (never "0 MB"), "Empty file" for a file with nothing in it.
+    private static string GameFileSizeText(string name)
+    {
+        long size = 0;
+        try { var f = new FileInfo(Path.Combine(GameAppMain.Documents, name)); if (f.Exists) size = f.Length; else return GameAppUi.SizeText(0); } catch (Exception) { return GameAppUi.SizeText(0); }
+        if (size > 0) return GameAppUi.SizeText(size);
+        return GameFileContent(name) == SourceFileState.Stub ? SourceText.Removed_ : "Empty file";
+    }
+
+    // ---- the records ---------------------------------------------------------------------------------------------------------
+
+    /// The app made this file now (`how`: clone / copy / download; `source`: a short label). Any thread: a small file, under a lock, off the main thread when it is called from there.
+    private void RecordImportFile(string path, string how, string source, string sourceId = "")
+    {
+        try
+        {
+            var name = Path.GetFileName(path);
+            if (!InPlaceImport.Accepts(name)) return;
+            ImportLedger.RecordImport(GameAppMain.Documents, name, new FileInfo(path).Length, how, source, sourceId);
+        }
+        catch (Exception error) { BeginInvokeOnMainThread(() => Write($"source: the import of {Path.GetFileName(path)} could not be recorded ({error.Message}): it will not be removed after a build")); }
+    }
+
+    /// From the main thread (CopyIn): the same, on a worker.
+    private void RecordImport(string path, string how, string source) => Task.Run(() => RecordImportFile(path, how, source));
+
+    // ---- after a build ---------------------------------------------------------------------------------------------------------
+
+    /// A build's chain ended: `outcome` says how. Main thread: the facts are a few small reads; the ledger, the stubs and the sizes are on a worker.
+    private void RemoveSourceAfterBuild(string game, StopOutcome outcome)
+    {
+        if (GameExport.IsPlayer || outcome != StopOutcome.Finished || failedRun || !InPlaceImport.Accepts(game)) return;
+        bool toggle = SourceRemoval.ToggleOn(ReadAppSettings());
+        if (!toggle) return;
+        var documents = GameAppMain.Documents;
+        string stampGame = null, stampContent = null;
+        try
+        {
+            var stamp = GameAppUi.ParseFrameworkStamp(File.Exists(FrameworkStampPath) ? File.ReadAllText(FrameworkStampPath) : null);
+            stampGame = stamp?.Game; stampContent = stamp?.Content;
+        }
+        catch (Exception) { }
+        var names = Dumps().Select(Path.GetFileName).ToList();
+        var state = new SourceState(game, stampGame, stampContent, GameAppUi.ContentSignature(game, names),
+                                    BuildRunning: running && stop.Game == game, PausedHere: pausedBuilds.Any(r => r.Game == game),
+                                    QueuedHere: buildQueue.Items.Any(i => i.Game == game && i.State != BuildQueue.Failed));
+        Task.Run(() =>
+        {
+            var lines = new List<string>();
+            try
+            {
+                var plan = SourceRemoval.Plan(game, names, ImportLedger.Load(documents), f => { try { var i = new FileInfo(Path.Combine(documents, f)); return i.Exists ? i.Length : -1; } catch (Exception) { return -1; } }, outcome, toggle, state);
+                foreach (var d in plan) { var why = SourceText.Kept(d.File, d.Why); if (why != null) lines.Add(why); }
+                long freed = plan.Any(d => d.Why == RemoveWhy.Remove) ? SourceRemoval.Execute(documents, plan, lines.Add) : 0;
+                BeginInvokeOnMainThread(() =>
+                {
+                    foreach (var line in lines) Write(line);
+                    if (freed > 0) { sizes.Invalidate(); RefreshScreen(); }
+                });
+            }
+            catch (Exception error) { BeginInvokeOnMainThread(() => Write($"source: the removal after the build failed ({error.GetType().Name}: {error.Message})")); }
+        });
+    }
+
+    // ---- what needs the content ----------------------------------------------------------------------------------------------------
+
+    /// The files of this game a build reads (the base game, its update, its DLC) that have no content: removed after a build (a stub) or empty. Empty when a build can read them all.
+    private List<string> ContentMissing(string game) =>
+        SourceGroup.Files(game, Dumps().Select(Path.GetFileName).ToList()).Where(n => GameFileContent(n) is SourceFileState.Stub or SourceFileState.Empty).ToList();
+
+    /// true: go on. false: a file the build reads has no content and the person was told (the alert) -- callers just return. A file that is not there is the callers' own message.
+    private bool GameFileHasContent(string game)
+    {
+        var missing = ContentMissing(game);
+        if (missing.Count == 0) return true;
+        ShowSourceRemoved(game, missing);
+        return false;
+    }
+
+    private string SourceNameOf(string sourceId) => cloudSources.FirstOrDefault(s => s.Id == sourceId)?.Name ?? "its source";
+
+    private void ShowSourceRemoved(string game, List<string> missing)
+    {
+        var ledger = ImportLedger.Load(GameAppMain.Documents);
+        bool stub = missing.Any(n => GameFileContent(n) == SourceFileState.Stub);
+        // the Files-folder source the first of them came from, when it still lists it: one button adds back every missing file that source lists
+        var listed = cloudFiles.Select(f => (f.SourceId, SourceNameOf(f.SourceId), f.Name)).ToList();
+        (string SourceId, string SourceName)? again = null;
+        foreach (var n in missing) { again = SourceReAdd.Find(ImportLedger.Find(ledger, n), listed); if (again != null) break; }
+        Write($"source: {GameAppUi.DisplayName(game)}: {(stub ? "the game file was removed after the build" : "the game file is empty")} ({string.Join(", ", missing)}): nothing to build from");
+        var a = UIAlertController.Create(stub ? SourceText.Title : "The game file is empty", stub ? SourceText.Message : "The game file has no content. Add it again to build it.", UIAlertControllerStyle.Alert);
+        if (again != null)
+        {
+            var id = again.Value.SourceId;
+            a.AddAction(UIAlertAction.Create(SourceText.ReAdd(again.Value.SourceName), UIAlertActionStyle.Default, _ => ReAddFromSource(missing, id)));
+        }
+        a.AddAction(UIAlertAction.Create("Add a game file…", UIAlertActionStyle.Default, _ => Import()));
+        a.AddAction(UIAlertAction.Create("Add from a folder…", UIAlertActionStyle.Default, _ => ImportFromFolder()));
+        a.AddAction(UIAlertAction.Create("Not now", UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(a);
+    }
+
+    /// "Add it again from <source>": the Files-folder source still lists them; Download clones each (a copy when it cannot) over its stub.
+    private void ReAddFromSource(List<string> files, string sourceId)
+    {
+        var list = files.Select(n => cloudFiles.FirstOrDefault(f => f.SourceId == sourceId && string.Equals(f.Name, n, StringComparison.OrdinalIgnoreCase))).Where(f => f != null).ToList();
+        if (list.Count == 0 || downloads.ContainsKey(list[0].Name)) return;
+        Write($"source: adding {string.Join(", ", list.Select(f => f.Name))} again from {SourceNameOf(sourceId)}");
+        Download(list, GameAppMain.Documents);
+    }
+}
