--- a/GameAppSourceRemoval.cs
+++ b/GameAppSourceRemoval.cs
@@ -0,0 +1,305 @@
+// gameapp/GameAppSourceRemoval.cs -- "Remove the game file after a successful build": which files the app imported itself (the provenance record), when such a file is replaced by an empty stub of the same name, how the stub
+// is made, and what a stub means to the rest of the app, with no UIKit (patch 0068; the host harness compiles this file as it is).
+//
+// Why (the owner's decision): a game that was imported is a clone or a copy of a file that exists somewhere else ("since the game is cloned it is already somewhere"), and after a successful build iBuilder needs only its
+// build, not the game file. So after a build the file is replaced by a ZERO-BYTE STUB with the same name: the library is made from the game files in Documents (Dumps()), so the game stays, keeps its name, its title id,
+// its cover, its settings, saves and mods, its Ready status (the stamp), Play and Export IPA; only what needs the CONTENT (Rebuild, Update, Set up again, the icon pass) says "The game file was removed after the build to free
+// space. Add it again to rebuild." and offers to add it again.
+//
+//   ImportRecord / ImportLedger   Documents/gameapp.imports.tsv: what the APP imported (file name, size, how: clone / copy / download, where from, when, and when its content was removed). A file the owner put into
+//                                 Documents by hand has no record and is NEVER removed.
+//   SourceRemoval                 ShouldRemove (one file) and Plan (a game's base file, its update and its DLC): the table of every case in which nothing is removed; Execute (the ledger first, then the stub).
+//   SourceStub                    IsStub, and the stub itself: written as <name>.part and renamed over the file in one step (atomic); a failure leaves the file as it was.
+//   SourceReAdd                   whether a Files-folder source that the file came from still lists it (an instant clone to add it again).
+//   SourceText                    the words.
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+
+/// One import the app did. `How`: clone, copy (iOS or the app copied the bytes) or download (a NAS). `Source`: a short label ("picker", "folder switch_games", the Cloud page's source name, "NAS"); `SourceId`: the Cloud
+/// source's id when the file came from one (the folder can then be asked for it again), else "". `At`, `RemovedAt`: UTC "yyyy-MM-ddTHH:mm:ssZ"; RemovedAt "" = the content is still here.
+public sealed record ImportRecord(string Name, long Size, string How, string Source, string SourceId, string At, string RemovedAt)
+{
+    public bool Removed => !string.IsNullOrEmpty(RemovedAt);
+}
+
+/// How a file came to be here.
+public static class ImportHow
+{
+    public const string Clone = "clone", Copy = "copy", Download = "download";
+}
+
+public static class ImportLedger
+{
+    public const string FileName = "gameapp.imports.tsv";
+
+    private static readonly object gate = new object();
+    private static readonly Dictionary<string, (long Stamp, List<ImportRecord> Records)> cache = new Dictionary<string, (long, List<ImportRecord>)>(StringComparer.Ordinal);
+
+    public static string PathIn(string documents) => System.IO.Path.Combine(documents, FileName);
+
+    public static string Now() => DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture);
+
+    private static string Clean(string s) => (s ?? "").Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
+
+    public static List<ImportRecord> Parse(string text)
+    {
+        var list = new List<ImportRecord>();
+        foreach (var raw in (text ?? "").Split('\n'))
+        {
+            var line = raw.TrimEnd('\r');
+            if (line.Length == 0 || line.StartsWith("#", StringComparison.Ordinal)) continue;
+            var p = line.Split('\t');
+            if (p.Length < 7 || p[0].Length == 0) continue;
+            long.TryParse(p[1], NumberStyles.None, CultureInfo.InvariantCulture, out var size);
+            var record = new ImportRecord(p[0], size, p[2], p[3], p[4], p[5], p[6]);
+            list.RemoveAll(r => string.Equals(r.Name, record.Name, StringComparison.OrdinalIgnoreCase));   // Documents is on a case-insensitive file system: one record per name, the last wins
+            list.Add(record);
+        }
+        return list;
+    }
+
+    public static string Format(IEnumerable<ImportRecord> list)
+    {
+        var sb = new StringBuilder("# what this app imported (it may remove the content after a successful build): file name, size, how (clone|copy|download), source, source id, imported at, content removed at\n");
+        foreach (var r in list)
+            sb.Append(Clean(r.Name)).Append('\t').Append(r.Size.ToString(CultureInfo.InvariantCulture)).Append('\t').Append(Clean(r.How)).Append('\t').Append(Clean(r.Source)).Append('\t')
+              .Append(Clean(r.SourceId)).Append('\t').Append(Clean(r.At)).Append('\t').Append(Clean(r.RemovedAt)).Append('\n');
+        return sb.ToString();
+    }
+
+    public static ImportRecord Find(IEnumerable<ImportRecord> list, string name) =>
+        list?.FirstOrDefault(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase));
+
+    /// Adds the record, or replaces the one of the same name (importing again over a file, or over a stub, is a new import: its content is here).
+    public static List<ImportRecord> Upsert(IEnumerable<ImportRecord> list, ImportRecord record)
+    {
+        var next = list.Where(r => !string.Equals(r.Name, record.Name, StringComparison.OrdinalIgnoreCase)).ToList();
+        next.Add(record);
+        return next;
+    }
+
+    public static List<ImportRecord> Remove(IEnumerable<ImportRecord> list, IEnumerable<string> names)
+    {
+        var gone = new HashSet<string>(names ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);
+        return list.Where(r => !gone.Contains(r.Name)).ToList();
+    }
+
+    // ---- the file: read when it changed, written through a .part and one rename, under one lock (imports run on workers) --------------
+
+    private static long StampOf(string path)
+    {
+        try { var f = new FileInfo(path); return f.Exists ? f.LastWriteTimeUtc.Ticks ^ (f.Length << 20) : 0; } catch (Exception) { return -1; }
+    }
+
+    /// The records now. A small file, read again only when it changed. Never throws (an unreadable file is an empty ledger: nothing is removed).
+    public static List<ImportRecord> Load(string documents)
+    {
+        var path = PathIn(documents);
+        lock (gate)
+        {
+            var stamp = StampOf(path);
+            if (cache.TryGetValue(path, out var hit) && hit.Stamp == stamp) return hit.Records.ToList();
+            List<ImportRecord> records;
+            try { records = stamp == 0 ? new List<ImportRecord>() : Parse(File.ReadAllText(path)); } catch (Exception) { records = new List<ImportRecord>(); }
+            cache[path] = (stamp, records);
+            return records.ToList();
+        }
+    }
+
+    /// Changes the ledger: `change` gets the records and returns the new ones; the file is written only when they differ. Throws when the file cannot be written (the callers say so in the log).
+    public static List<ImportRecord> Update(string documents, Func<List<ImportRecord>, List<ImportRecord>> change)
+    {
+        var path = PathIn(documents);
+        lock (gate)
+        {
+            List<ImportRecord> before;
+            try { before = File.Exists(path) ? Parse(File.ReadAllText(path)) : new List<ImportRecord>(); } catch (Exception) { before = new List<ImportRecord>(); }
+            var after = change(before.ToList());
+            if (Format(after) == Format(before)) { cache[path] = (StampOf(path), after); return after.ToList(); }
+            Directory.CreateDirectory(documents);
+            var part = path + ".part";
+            try { File.WriteAllText(part, Format(after)); File.Move(part, path, true); }
+            catch { try { File.Delete(part); } catch (Exception) { } throw; }
+            cache[path] = (StampOf(path), after);
+            return after.ToList();
+        }
+    }
+
+    /// One import: the app made this file, now. (Only game files are recorded; prod.keys never.) Replaces the record of the same name.
+    public static void RecordImport(string documents, string name, long size, string how, string source, string sourceId = "")
+    {
+        if (!InPlaceImport.Accepts(name) || string.Equals(name, InPlaceImport.Keys, StringComparison.Ordinal)) return;
+        Update(documents, list => Upsert(list, new ImportRecord(name, size, how, source ?? "", sourceId ?? "", Now(), "")));
+    }
+}
+
+/// What a build ended with and what else is going on, read by the app right before it decides. `Game`: the base game file that was built. `StampGame` / `StampContent`: Documents/gameapp.framework (`game=`, `content=`).
+/// `CurrentContent`: the update / DLC signature of the files in Documents now. `BuildRunning`, `PausedHere`, `QueuedHere`: a build of THIS game runs / is paused / waits in the queue.
+public sealed record SourceState(string Game, string StampGame, string StampContent, string CurrentContent, bool BuildRunning, bool PausedHere, bool QueuedHere);
+
+public enum RemoveWhy { Remove, NotAGameFile, ToggleOff, BuildNotFinished, StampMismatch, ContentChanged, BuildBusy, NoRecord, AlreadyRemoved, Missing, SizeChanged }
+
+public sealed record SourceDecision(string File, RemoveWhy Why, ImportRecord Record);
+
+public static class SourceRemoval
+{
+    public const string SettingKey = "remove_source_after_build";
+
+    /// The Settings toggle: on unless the settings file says 0 / off / no / false. (The default is ON: the owner asked for it.)
+    public static bool ToggleOn(string settingsText) =>
+        GameAppUi.AppSetting(settingsText, SettingKey, "1").ToLowerInvariant() is not ("0" or "off" or "no" or "false");
+
+    /// Whether `file` (the base game's file, or its update's or a DLC's) has its content removed now. NOTHING is removed unless every line holds:
+    ///   a game file (never prod.keys, a certificate, anything else) / the Settings toggle is on / the build's chain returned 0 (not a pause, a cancel, a failure; an OS kill never gets here) / the build stamp names this
+    ///   game and its update / DLC are what the build included / no build of this game runs, is paused or waits in the queue / the app has a record that IT imported the file, not removed yet / the file is still what was
+    ///   imported (its size is the record's: a file the owner replaced by hand is not ours any more) and has content.
+    /// `actualSize`: the file's length now, -1 when it is not there.
+    public static RemoveWhy ShouldRemove(string file, ImportRecord record, long actualSize, StopOutcome outcome, bool toggle, SourceState state)
+    {
+        if (string.IsNullOrEmpty(file) || string.Equals(file, InPlaceImport.Keys, StringComparison.OrdinalIgnoreCase) || !InPlaceImport.Accepts(file)) return RemoveWhy.NotAGameFile;
+        if (!toggle) return RemoveWhy.ToggleOff;
+        if (outcome != StopOutcome.Finished) return RemoveWhy.BuildNotFinished;
+        if (state == null || string.IsNullOrEmpty(state.StampGame) || !string.Equals(state.StampGame, state.Game, StringComparison.Ordinal)) return RemoveWhy.StampMismatch;
+        bool isBase = string.Equals(file, state.Game, StringComparison.Ordinal);
+        if (state.StampContent == null ? !isBase : !string.Equals(state.StampContent, state.CurrentContent ?? "", StringComparison.Ordinal)) return RemoveWhy.ContentChanged;   // an update or DLC the build did not include stays
+        if (state.BuildRunning || state.PausedHere || state.QueuedHere) return RemoveWhy.BuildBusy;
+        if (record == null) return RemoveWhy.NoRecord;
+        if (actualSize < 0) return RemoveWhy.Missing;
+        if (record.Removed) return actualSize == 0 ? RemoveWhy.AlreadyRemoved : RemoveWhy.NoRecord;   // content again under a "removed" record: put there by hand (an import writes a new record), so it is not ours
+        if (actualSize == 0) return RemoveWhy.Missing;
+        if (record.Size != actualSize) return RemoveWhy.SizeChanged;
+        return RemoveWhy.Remove;
+    }
+
+    /// The base game file, its update and its DLC (the files a build of the game reads), each decided on its own. `names`: the game files in Documents.
+    public static List<SourceDecision> Plan(string game, IReadOnlyList<string> names, IReadOnlyList<ImportRecord> ledger, Func<string, long> sizeOf, StopOutcome outcome, bool toggle, SourceState state) =>
+        SourceGroup.Files(game, names).Select(f => { var r = ImportLedger.Find(ledger, f); return new SourceDecision(f, ShouldRemove(f, r, sizeOf(f), outcome, toggle, state), r); }).ToList();
+
+    /// Removes what `decisions` say (Why == Remove): for each file the ledger FIRST (the record says "removed" now), then the stub (SourceStub.Replace). If the stub cannot be made the record is put back and the file is as it
+    /// was. `log` gets one line per file (SourceText.Removed) and, before the very first removal ever, the line that says what this is. Returns the bytes freed (sizes in the records). Worker threads only.
+    public static long Execute(string documents, IEnumerable<SourceDecision> decisions, Action<string> log, Action<string, string> move = null)
+    {
+        long freed = 0;
+        bool first = !ImportLedger.Load(documents).Any(r => r.Removed);
+        foreach (var d in decisions.Where(d => d.Why == RemoveWhy.Remove))
+        {
+            var path = Path.Combine(documents, d.File);
+            try
+            {
+                var when = ImportLedger.Now();
+                ImportLedger.Update(documents, list => ImportLedger.Upsert(list, d.Record with { RemovedAt = when }));
+                try { SourceStub.Replace(path, move); }
+                catch
+                {
+                    ImportLedger.Update(documents, list => ImportLedger.Upsert(list, d.Record));   // the stub was not made: the file is as it was, the record says so
+                    throw;
+                }
+                freed += d.Record.Size;
+                if (first) { log?.Invoke(SourceText.FirstRemoval); first = false; }
+                log?.Invoke(SourceText.Removed(d.File, d.Record.Size, d.Record.How, d.Record.Source));
+            }
+            catch (Exception e) { log?.Invoke($"source: {d.File} was not removed ({e.Message})"); }
+        }
+        return freed;
+    }
+}
+
+/// The files a build of a game reads: its base file, its newest update and its DLC (GameAppUi.UpdateFor / DlcFor). A rebuild needs the content of ALL of them.
+public static class SourceGroup
+{
+    public static List<string> Files(string game, IReadOnlyList<string> names)
+    {
+        var files = new List<string>();
+        var own = names.FirstOrDefault(n => string.Equals(n, game, StringComparison.OrdinalIgnoreCase));
+        if (own != null) files.Add(own);
+        var update = GameAppUi.UpdateFor(game, names);
+        if (update != null) files.Add(update);
+        files.AddRange(GameAppUi.DlcFor(game, names));
+        return files.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
+    }
+}
+
+public static class SourceStub
+{
+    /// A stub: no content, and the ledger says the app removed it. (A zero-byte file with no such record is just an empty file: IsEmpty.)
+    public static bool IsStub(long size, ImportRecord record) => size == 0 && record != null && record.Removed;
+
+    public static bool IsStub(string documents, string name, IReadOnlyList<ImportRecord> ledger)
+    {
+        try { var f = new FileInfo(Path.Combine(documents, name)); return f.Exists && IsStub(f.Length, ImportLedger.Find(ledger, name)); } catch (Exception) { return false; }
+    }
+
+    /// A game file with no content, stub or not: nothing can be built from it, and an import of the same name replaces it (it is not "in the library").
+    public static bool IsEmpty(long size) => size == 0;
+
+    /// Replaces `path` by an empty file: the stub is written as `<path>.part` and renamed over `path` (one rename: the file is the old one or the stub, never half of either); a failure removes the .part and leaves the file
+    /// as it was. `move`: the rename (File.Move with overwrite by default; the harness makes it fail).
+    public static void Replace(string path, Action<string, string> move = null)
+    {
+        var part = path + GameImport.PartSuffix;
+        try
+        {
+            using (File.Create(part)) { }
+            (move ?? ((from, to) => File.Move(from, to, true)))(part, path);
+        }
+        catch
+        {
+            try { File.Delete(part); } catch (Exception) { }
+            throw;
+        }
+    }
+}
+
+/// "Add it again from <source>": the Files-folder source the file came from, when it still lists the file.
+public static class SourceReAdd
+{
+    /// `listed`: what the Cloud sources list now (source id, its name, the file name). null when the file did not come from a source or the source no longer lists it.
+    public static (string SourceId, string SourceName)? Find(ImportRecord record, IEnumerable<(string SourceId, string SourceName, string Name)> listed)
+    {
+        if (record == null || string.IsNullOrEmpty(record.SourceId)) return null;
+        foreach (var l in listed ?? Array.Empty<(string, string, string)>())
+            if (l.SourceId == record.SourceId && string.Equals(l.Name, record.Name, StringComparison.OrdinalIgnoreCase)) return (l.SourceId, l.SourceName);
+        return null;
+    }
+}
+
+/// The words.
+public static class SourceText
+{
+    public const string Message = "The game file was removed after the build to free space. Add it again to rebuild.";
+    public const string Title = "The game file was removed";
+    public const string Removed_ = "File removed";
+    public const string SettingTitle = "Remove the game file after a successful build";
+    public const string SettingNote = "iBuilder imported the file as a clone or a copy of one that is somewhere else: once the game is built it keeps the game (its name, cover, settings and saves) and frees the file. Add the file again to rebuild. Files you put into iBuilder's folder yourself are never removed.";
+    public const string FirstRemoval = "source: from now on a built game's file is replaced by an empty stub of the same name, the game stays in the library (Settings > Remove the game file after a successful build turns this off)";
+
+    private static string Inv(FormattableString text) => text.ToString(CultureInfo.InvariantCulture);
+
+    /// `source: removed <name> (<size>) after the build (it was <how>, from <source>)`
+    public static string Removed(string name, long size, string how, string source) =>
+        Inv($"source: removed {name} ({GameAppUi.SizeText(size)}) after the build (it was {HowText(how)}, from {(string.IsNullOrEmpty(source) ? "a file picker" : source)})");
+
+    public static string HowText(string how) => how switch { ImportHow.Clone => "cloned", ImportHow.Copy => "copied", ImportHow.Download => "downloaded", _ => string.IsNullOrEmpty(how) ? "imported" : how };
+
+    public static string ReAdd(string source) => "Add it again from " + source;
+
+    /// The line the log gets when nothing was removed and the reason is worth saying (not for a file with no record: that is every hand-placed file).
+    public static string Kept(string file, RemoveWhy why) => why switch
+    {
+        RemoveWhy.ToggleOff => null,
+        RemoveWhy.NoRecord => null,
+        RemoveWhy.NotAGameFile => null,
+        RemoveWhy.AlreadyRemoved => null,
+        RemoveWhy.BuildNotFinished => null,
+        RemoveWhy.StampMismatch => $"source: {file} kept (the build on disk is not this game's)",
+        RemoveWhy.ContentChanged => $"source: {file} kept (the update / DLC in iBuilder are not what the build included)",
+        RemoveWhy.BuildBusy => $"source: {file} kept (a build of this game is running, paused or queued)",
+        RemoveWhy.SizeChanged => $"source: {file} kept (it is not the file iBuilder imported any more)",
+        RemoveWhy.Missing => null,
+        _ => null,
+    };
+}
