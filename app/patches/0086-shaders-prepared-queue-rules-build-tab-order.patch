+/// Patch 0086: what the build queue offers a game: Add (not built yet, or paused: the queue builds it), Rebuild (built but out of date: the queue replaces its build when it reaches it), None
+/// (built and up to date, or being built: nothing to queue).
+public static class QueuePlan
+{
+    public enum Entry { None, Add, Rebuild }
+
+    public static Entry For(LibState state, bool outdated) => state switch
+    {
+        LibState.NotBuilt or LibState.Paused => Entry.Add,
+        LibState.Built => outdated ? Entry.Rebuild : Entry.None,
+        _ => Entry.None,
+    };
+
+    public const string RebuildTitle = "Queue a rebuild?";
+
+    public static string RebuildNote(string game) =>
+        $"{game} is built. When the queue reaches it, its build is replaced by a new one (with the update, DLC or mods added since). The shaders already translated come from the cache.";
+
+    /// The queue row's words: "Build" for a game that is not built, "Rebuild" for one that is.
+    public static string RowWord(bool built) => built ? "Rebuild" : "Build";
 }
 
