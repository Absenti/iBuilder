+/// Patch 0086 (the owner: "Preparing the shaders · 5,009 of 5,009" never became "prepared", and the preparation started again at every open): a worker that had nothing left to take still
+/// WAITED first (a worker numbered above the allowed count, at Serious heat, in the background with one worker, or below 700 MiB) and looked again every 2-3 s for ever; the run joined its
+/// workers, so it never ended: no prepared.tsv, the bar full, "Preparing", Pause, and the next launch's sync owed the game again. A worker now leaves as soon as nothing is left to take.
+public static class WarmWorkers
+{
+    /// `nextTaken`: the run's index of the last library taken (-1 before the first), `total`: its libraries.
+    public static bool NothingLeft(int nextTaken, int total) => nextTaken + 1 >= total;
+}
+
+/// The finished preparation, as the game's sheet says it: prepared.tsv's "all<TAB><count><TAB><time>" row.
+public static class WarmDone
+{
+    public static int Count(string preparedText)
+    {
+        foreach (var raw in (preparedText ?? "").Split('\n'))
+        {
+            var c = raw.TrimEnd('\r').Split('\t');
+            if (c.Length >= 2 && c[0] == "all" && int.TryParse(c[1], NumberStyles.None, CultureInfo.InvariantCulture, out var n)) return n;
+        }
+        return -1;
+    }
+
+    public static string Label(int count) => count > 0 ? count.ToString("N0", CultureInfo.InvariantCulture) + " prepared" : "Prepared";
+
+    /// The log line of a completed run: "shader warm-up: done, 5,009 libraries in 412 s".
+    public static string Line(int libraries, double seconds) => $"shader warm-up: done, {libraries.ToString("N0", CultureInfo.InvariantCulture)} libraries in {seconds.ToString("0", CultureInfo.InvariantCulture)} s";
+}
+
+/// Patch 0086 (the owner): the Build tab's order: Now building (only while a build runs or is paused) → Queue (only with at least one item: no header, card, note or Start button when
+/// empty) → the shader preparation while it RUNS → Ready to build / In the cloud → the shader preparation when it does not run. The import card leads (it shows only while files are added).
+public static class BuildOrder
+{
+    public const string Import = "import", Now = "now", Queue = "queue", Shaders = "shaders", Games = "games";
+
+    public static List<string> Of(bool nowShown, int queueItems, bool shadersRunning)
+    {
+        var order = new List<string> { Import };
+        if (nowShown) order.Add(Now);
+        if (queueItems > 0) order.Add(Queue);
+        if (shadersRunning) order.Add(Shaders);
+        order.Add(Games);
+        if (!shadersRunning) order.Add(Shaders);
+        return order;
+    }
+}
