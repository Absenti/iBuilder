+        inspector.Transform = CGAffineTransform.MakeTranslation(PadLayout.InspectorWidth, 0);
+        UIView.AnimateNotify(0.3, 0, 0.9f, 0.3f, UIViewAnimationOptions.AllowUserInteraction, () => { inspector.Transform = CGAffineTransform.MakeIdentity(); View.LayoutIfNeeded(); }, null);
+        UIAccessibility.PostNotification(UIAccessibilityPostNotification.ScreenChanged, inspector);
+        RefreshScreen();
+    }
+
+    private void CloseInspector(bool refresh = true)
+    {
+        if (inspectorNav == null) return;
+        sheetLaunchFill = null;
+        inspectorNav.WillMoveToParentViewController(null);
+        inspectorNav.View.RemoveFromSuperview();
+        inspectorNav.RemoveFromParentViewController();
+        inspectorNav = null;
+        inspectorGame = null;
+        inspector.Hidden = true;
+        if (pageTrail[0] != null) pageTrail[0].Constant = 0;
+        if (refresh) RefreshScreen();
+    }
+
+    // ---- Build and Settings in two columns -------------------------------------------------------------------------
+
+    private UIStackView buildBody, settingsBody;
+    private UIView[] buildLeft, buildRight, buildNarrow, settingsTop, settingsLeft, settingsRight;
+    private UIStackView tilesOuter;
+
+    private static void Restack(UIStackView body, bool wide, UIView[] left, UIView[] right, UIView[] narrowOrder, nfloat spacing)
+    {
+        foreach (var v in body.ArrangedSubviews.ToArray()) { body.RemoveArrangedSubview(v); v.RemoveFromSuperview(); }   // the two columns (iPad) or the blocks themselves (phone)
+        foreach (var v in left.Concat(right)) v.RemoveFromSuperview();   // out of a column of before
+        if (wide)
+        {
+            body.Axis = UILayoutConstraintAxis.Horizontal;
+            body.Alignment = UIStackViewAlignment.Top;
+            body.Distribution = UIStackViewDistribution.FillEqually;
+            body.Spacing = 16;
+            foreach (var side in new[] { left, right })
+            {
+                var col = Theme.Column(spacing, side);
+                foreach (var v in side) if (!(v is UILabel)) col.SetCustomSpacing(spacing < 12 ? 20 : spacing, v);
+                body.AddArrangedSubview(col);
+            }
+        }
+        else
+        {
+            body.Axis = UILayoutConstraintAxis.Vertical;
+            body.Alignment = UIStackViewAlignment.Fill;
+            body.Distribution = UIStackViewDistribution.Fill;
+            body.Spacing = spacing;
+            foreach (var v in narrowOrder) { body.AddArrangedSubview(v); if (!(v is UILabel)) body.SetCustomSpacing(spacing < 12 ? 20 : spacing, v); }
+        }
+    }
+
+    private void ArrangeBuildTab(bool wide)
+    {
+        if (buildBody == null) return;
+        Restack(buildBody, wide, buildLeft, buildRight, buildNarrow, 18);
+    }
+
+    private void ArrangeSettings(bool wide)
+    {
+        if (settingsBody == null) return;
+        // the four tiles in one row on an iPad, two rows of two on a phone
+        if (tilesOuter != null) tilesOuter.Axis = wide ? UILayoutConstraintAxis.Horizontal : UILayoutConstraintAxis.Vertical;
+        if (tilesOuter != null) tilesOuter.Distribution = wide ? UIStackViewDistribution.FillEqually : UIStackViewDistribution.Fill;
+        if (tilesOuter != null) tilesOuter.Spacing = wide ? 14 : 12;
+        Restack(settingsBody, wide, settingsLeft, settingsRight, settingsTop, 8);
+    }
+}
