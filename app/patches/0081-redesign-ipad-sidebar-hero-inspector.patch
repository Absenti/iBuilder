+// gameapp/GameAppPad.cs: the pure part of the iPad layout (app/patches/0081, the owner's iPad.dc.html): when the iPad layout applies, its sizes, the grid's columns, the sidebar's counts.
+// No UIKit: the host harness compiles it as it is. The views are GameAppPadUi.cs.
+
+using System;
+
+public static class PadLayout
+{
+    public const float SidebarWidth = 250, InspectorWidth = 360, HeroCover = 250;
+
+    /// The width from which the iPad layout is used (the app's WideFrom since 0062): an iPad's full screen or a wide Stage Manager window, never an iPhone, never Split View's halves.
+    public const double MinWidth = 820;
+
+    /// The iPad layout: a REGULAR horizontal size class and at least MinWidth points. A compact one (an iPhone, Slide Over, a narrow Split View) keeps the iPhone layout.
+    public static bool Applies(bool regularWidth, double width, bool player) => !player && regularWidth && width >= MinWidth;
+
+    /// The grid's columns: 2 on the phone layout; 4 in the iPad layout, 3 while its inspector is open.
+    public static int Columns(bool padWide, bool inspectorOpen) => !padWide ? 2 : inspectorOpen ? 3 : 4;
+
+    /// The count beside a sidebar entry: the games, what the Build tab is doing, the log's errors.
+    public static string NavCount(int entry, int games, int queued, bool building, int errors) => entry switch
+    {
+        0 => games > 0 ? games.ToString(System.Globalization.CultureInfo.InvariantCulture) : "",
+        1 => building ? "1 building" + (queued > 0 ? " · " + queued + " queued" : "") : queued > 0 ? queued + " queued" : "",
+        _ => errors > 0 ? errors + (errors == 1 ? " error" : " errors") : "",
+    };
+}
