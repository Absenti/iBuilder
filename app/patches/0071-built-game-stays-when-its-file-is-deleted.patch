+
+// ---- patch 0071: a built game stays in the library when its file is deleted by hand ----------------------------------------------------------------------------------------
+//
+// The library is made from the game files in Documents (Dumps()). A file the owner deletes in the Files app to save space leaves nothing, so a built game vanished with its name, cover, settings and saves. The app now
+// records the games it built; at launch (and back from the background) a recorded game whose file is not in Documents gets an empty placeholder of the same name (SourceStub.Replace, never over an existing file) and a
+// "removed" import record, which makes it a stub for 0068: "File removed", Play and Export IPA when it is the build on disk, and "Add it again" for everything that needs the content.
+// LIMIT: one game is built at a time (one Documents/DmGameProbe.framework and one extract/): a placeholder keeps a game VISIBLE with its data; only the last built game can still be played from it, any other needs its file again.
+
+/// One game the app built: its base game file's name, its title id ("" when unknown), the file's size when it was built (0 when unknown) and when (UTC "yyyy-MM-ddTHH:mm:ssZ").
+public sealed record BuiltRecord(string Name, string TitleId, long Size, string At);
+
+public static class BuiltLedger
+{
+    public const string FileName = "gameapp.built.tsv";
+
+    private static readonly object gate = new object();
+
+    public static string PathIn(string documents) => System.IO.Path.Combine(documents, FileName);
+
+    private static string Clean(string s) => (s ?? "").Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
+
+    /// A game file the library lists (.nsp .xci .nsz .nup, a plain name), never prod.keys or anything else.
+    public static bool IsGameFile(string name) => InPlaceImport.Accepts(name) && !string.Equals(name, InPlaceImport.Keys, StringComparison.OrdinalIgnoreCase);
+
+    public static List<BuiltRecord> Parse(string text)
+    {
+        var list = new List<BuiltRecord>();
+        foreach (var raw in (text ?? "").Split('\n'))
+        {
+            var line = raw.TrimEnd('\r');
+            if (line.Length == 0 || line.StartsWith("#", StringComparison.Ordinal)) continue;
+            var p = line.Split('\t');
+            if (p.Length < 4 || p[0].Length == 0) continue;
+            long.TryParse(p[2], NumberStyles.None, CultureInfo.InvariantCulture, out var size);
+            var record = new BuiltRecord(p[0], p[1], size, p[3]);
+            list.RemoveAll(r => string.Equals(r.Name, record.Name, StringComparison.OrdinalIgnoreCase));   // one record per name (case-insensitive file system), the last wins
+            list.Add(record);
+        }
+        return list;
+    }
+
+    public static string Format(IEnumerable<BuiltRecord> list)
+    {
+        var sb = new StringBuilder("# the games this app built (a game whose file is deleted by hand keeps an empty placeholder in the library): file name, title id, size at the build, built at\n");
+        foreach (var r in list)
+            sb.Append(Clean(r.Name)).Append('\t').Append(Clean(r.TitleId)).Append('\t').Append(r.Size.ToString(CultureInfo.InvariantCulture)).Append('\t').Append(Clean(r.At)).Append('\n');
+        return sb.ToString();
+    }
+
+    public static BuiltRecord Find(IEnumerable<BuiltRecord> list, string name) =>
+        list?.FirstOrDefault(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase));
+
+    public static List<BuiltRecord> Upsert(IEnumerable<BuiltRecord> list, BuiltRecord record)
+    {
+        var next = list.Where(r => !string.Equals(r.Name, record.Name, StringComparison.OrdinalIgnoreCase)).ToList();
+        next.Add(record);
+        return next;
+    }
+
+    public static List<BuiltRecord> Remove(IEnumerable<BuiltRecord> list, IEnumerable<string> names)
+    {
+        var gone = new HashSet<string>(names ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);
+        return list.Where(r => !gone.Contains(r.Name)).ToList();
+    }
+
+    /// The records now. Never throws (an unreadable file is an empty record: no placeholder is made).
+    public static List<BuiltRecord> Load(string documents)
+    {
+        lock (gate)
+        {
+            try { var path = PathIn(documents); return File.Exists(path) ? Parse(File.ReadAllText(path)) : new List<BuiltRecord>(); }
+            catch (Exception) { return new List<BuiltRecord>(); }
+        }
+    }
+
+    /// Changes the record: written only when it differs, through <file>.part and one rename, under one lock. Throws when it cannot be written (the callers say so in the log).
+    public static List<BuiltRecord> Update(string documents, Func<List<BuiltRecord>, List<BuiltRecord>> change)
+    {
+        var path = PathIn(documents);
+        lock (gate)
+        {
+            List<BuiltRecord> before;
+            try { before = File.Exists(path) ? Parse(File.ReadAllText(path)) : new List<BuiltRecord>(); } catch (Exception) { before = new List<BuiltRecord>(); }
+            var after = change(before.ToList());
+            if (Format(after) == Format(before)) return after.ToList();
+            Directory.CreateDirectory(documents);
+            var part = path + ".part";
+            try { File.WriteAllText(part, Format(after)); File.Move(part, path, true); }
+            catch { try { File.Delete(part); } catch (Exception) { } throw; }
+            return after.ToList();
+        }
+    }
+
+    /// A build of `name` ended with StopOutcome.Finished: the record of that name is replaced (a rebuild updates its size and time). Only game files.
+    public static void RecordBuilt(string documents, string name, string titleId, long size)
+    {
+        if (!IsGameFile(name)) return;
+        Update(documents, list => Upsert(list, new BuiltRecord(name, titleId ?? "", Math.Max(0, size), ImportLedger.Now())));
+    }
+
+    /// A game built before this record existed (the build stamp's game=): added when it has no record, an existing record is left as it is. True when it was added.
+    public static bool Seed(string documents, string name, string titleId, long size)
+    {
+        if (!IsGameFile(name)) return false;
+        bool added = false;
+        Update(documents, list =>
+        {
+            if (Find(list, name) != null) return list;
+            added = true;
+            return Upsert(list, new BuiltRecord(name, titleId ?? "", Math.Max(0, size), ImportLedger.Now()));
+        });
+        return added;
+    }
+}
+
+public enum KeepWhy { Placeholder, Present, NotAGameFile, Renamed }
+
+/// What happens to one built record now. `RenamedTo`: for Renamed, the other game file of exactly the recorded size.
+public sealed record KeepDecision(BuiltRecord Built, KeepWhy Why, string RenamedTo = null);
+
+public static class BuiltKeep
+{
+    /// The source label of the import record a placeholder gets when the app has no record of the file (it was put into Documents by hand, or before 0068 recorded imports).
+    public const string Source = "Files";
+
+    /// `actualSize`: the recorded file's length now, -1 when it is not in Documents. `others`: the game files in Documents (name, size).
+    ///   NotAGameFile  never a placeholder for anything but a game file (a damaged record, prod.keys).
+    ///   Present       the file is there (with content, a 0068 stub, or an empty file the owner put there: each is what 0068 says it is): nothing to do.
+    ///   Renamed       missing, but another game file has exactly the size recorded at the build: the owner renamed (or kept another copy of) it: the record follows that name, no placeholder.
+    ///   Placeholder   missing: an empty placeholder of the same name, and a "removed" import record (a stub).
+    public static KeepDecision Decide(BuiltRecord built, long actualSize, IReadOnlyList<(string Name, long Size)> others)
+    {
+        if (built == null || !BuiltLedger.IsGameFile(built.Name)) return new KeepDecision(built, KeepWhy.NotAGameFile);
+        if (actualSize >= 0) return new KeepDecision(built, KeepWhy.Present);
+        if (built.Size > 0)
+            foreach (var o in others ?? Array.Empty<(string, long)>())
+                if (o.Size == built.Size && !string.Equals(o.Name, built.Name, StringComparison.OrdinalIgnoreCase) && BuiltLedger.IsGameFile(o.Name))
+                    return new KeepDecision(built, KeepWhy.Renamed, o.Name);
+        return new KeepDecision(built, KeepWhy.Placeholder);
+    }
+
+    public static List<KeepDecision> Plan(IReadOnlyList<BuiltRecord> built, Func<string, long> sizeOf, IReadOnlyList<(string Name, long Size)> files) =>
+        (built ?? Array.Empty<BuiltRecord>()).Select(b => Decide(b, b != null && BuiltLedger.IsGameFile(b.Name) ? sizeOf(b.Name) : -1, files)).ToList();
+
+    /// The import record that makes the placeholder a stub (SourceStub.IsStub: size 0 and Removed). The app's own record of the file when it has one, so its source stays ("Add it again from <source>"), marked removed
+    /// now (a record already removed stays as it is: its 0068 stub was deleted by hand); else a new one: how "deleted", source "Files".
+    public static ImportRecord StubRecord(BuiltRecord built, ImportRecord existing, string now) =>
+        existing == null ? new ImportRecord(built.Name, built.Size, ImportHow.DeletedByHand, Source, "", now, now)
+        : existing.Removed ? existing
+        : existing with { RemovedAt = now };
+
+    /// Carries out `plan`: for each Placeholder the import ledger FIRST (the record says "removed"), then the placeholder: SourceStub's writer (an empty <name>.part renamed onto the name), with a rename that NEVER
+    /// replaces a file (one that appeared meanwhile, an import, stays and the import record is put back). For each Renamed the built record takes the other name. `log` gets one line per game. Returns the names of the
+    /// placeholders made. Worker threads only.
+    public static List<string> Execute(string documents, IEnumerable<KeepDecision> plan, Action<string> log, Action<string, string> move = null)
+    {
+        var made = new List<string>();
+        foreach (var d in plan ?? Array.Empty<KeepDecision>())
+        {
+            if (d.Why == KeepWhy.Placeholder)
+            {
+                var name = d.Built.Name;
+                try
+                {
+                    ImportRecord before = null;
+                    var now = ImportLedger.Now();
+                    ImportLedger.Update(documents, list => { before = ImportLedger.Find(list, name); return ImportLedger.Upsert(list, StubRecord(d.Built, before, now)); });
+                    try { SourceStub.Replace(Path.Combine(documents, name), move ?? ((from, to) => File.Move(from, to, false))); }
+                    catch
+                    {
+                        ImportLedger.Update(documents, list => before != null ? ImportLedger.Upsert(list, before) : ImportLedger.Remove(list, new[] { name }));   // no placeholder: the ledger is as it was
+                        throw;
+                    }
+                    made.Add(name);
+                    log?.Invoke(BuiltText.Placeholder(name));
+                }
+                catch (Exception e) { log?.Invoke(BuiltText.NoPlaceholder(name, e.Message)); }
+            }
+            else if (d.Why == KeepWhy.Renamed)
+            {
+                try
+                {
+                    BuiltLedger.Update(documents, list =>
+                    {
+                        var next = BuiltLedger.Remove(list, new[] { d.Built.Name });
+                        return BuiltLedger.Find(next, d.RenamedTo) != null ? next : BuiltLedger.Upsert(next, d.Built with { Name = d.RenamedTo });
+                    });
+                    log?.Invoke(BuiltText.Renamed(d.Built.Name, d.RenamedTo));
+                }
+                catch (Exception e) { log?.Invoke($"library: the built record of {d.Built.Name} could not follow {d.RenamedTo} ({e.Message})"); }
+            }
+        }
+        return made;
+    }
+}
+
+/// The words of patch 0071.
+public static class BuiltText
+{
+    public static string Placeholder(string name) =>
+        $"library: {name} was deleted from Documents after its build: an empty placeholder keeps it in the library (put the file back to rebuild it)";
+
+    public static string NoPlaceholder(string name, string why) => $"library: {name} was deleted from Documents after its build and no placeholder could be made ({why}): it is not in the library";
+
+    public static string Renamed(string name, string other) => $"library: {name} is not in Documents but {other} has the size it had at its build: taken as the same game renamed, no placeholder";
