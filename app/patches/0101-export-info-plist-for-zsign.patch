+
+/// Patch 0101 (the FlareStore signing failure, reproduced on the Mac by the main agent): NSPropertyListSerialization writes the empty elements of an XML plist as `<true />`, `<false />`
+/// (a SPACE before the slash): valid XML, but zsign's own plist reader (jvalue::read_plist, FlareStore's signer) takes only `<true/>`; it stops ("Syntax error: value, dictionary or array
+/// expected"), finds no CFBundleIdentifier / CFBundleExecutable and the signing fails: "Can't get BundleID, BundleVersion, or BundleExecute in Info.plist!". Every self-closing tag of the
+/// exported Info.plists is written without the space, and the written one is checked the way zsign reads it.
+public static class PlistText
+{
+    // a tag name, spaces, "/>": never inside a value (a value's "<" is written "&lt;")
+    private static readonly Regex SelfClosing = new Regex(@"<([A-Za-z][A-Za-z0-9_.:-]*)\s+/>");
+
+    public static string Normalize(string xml, out int count)
+    {
+        int n = 0;
+        var outText = SelfClosing.Replace(xml ?? "", m => { n++; return "<" + m.Groups[1].Value + "/>"; });
+        count = n;
+        return outText;
+    }
+
+    public static byte[] Normalize(byte[] xml, out int count) => System.Text.Encoding.UTF8.GetBytes(Normalize(System.Text.Encoding.UTF8.GetString(xml ?? Array.Empty<byte>()), out count));
+
+    public static bool HasSpacedSelfClosing(string xml) => SelfClosing.IsMatch(xml ?? "");
+
+    /// The string value of `key` read the strict way (a scan, as a simple signer's parser reads it): `<key>K</key>`, white space, `<string>…</string>`; null when it is not so.
+    public static string StrictString(string xml, string key)
+    {
+        if (xml == null || HasSpacedSelfClosing(xml)) return null;   // zsign's reader stops at the first `<x />`: nothing after it is read
+        var k = "<key>" + key + "</key>";
+        int i = xml.IndexOf(k, StringComparison.Ordinal);
+        if (i < 0) return null;
+        i += k.Length;
+        while (i < xml.Length && char.IsWhiteSpace(xml[i])) i++;
+        const string open = "<string>", close = "</string>";
+        if (string.CompareOrdinal(xml, i, open, 0, open.Length) != 0) return null;
+        int end = xml.IndexOf(close, i + open.Length, StringComparison.Ordinal);
+        if (end < 0) return null;
+        return System.Net.WebUtility.HtmlDecode(xml.Substring(i + open.Length, end - i - open.Length));
+    }
+
+    /// What a strict reader would not find: the required keys (ExportZip.Required) it cannot read, and "spaced self-closing tags" when the text has any.
+    public static List<string> StrictMissing(string xml)
+    {
+        var missing = new List<string>();
+        if (HasSpacedSelfClosing(xml)) missing.Add("spaced self-closing tags (<x />)");
+        missing.AddRange(ExportZip.Required.Where(k => string.IsNullOrEmpty(StrictString(xml, k))));
+        return missing;
+    }
+
+    public static string NormalizedLine(int count) => "export: Info.plist normalized for signers (" + count.ToString(CultureInfo.InvariantCulture) + " self-closing tag" + (count == 1 ? "" : "s") + ")";
+}
