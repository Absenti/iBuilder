+/// Patch 0094 (the owner's field report): the FIRST build of a game takes its update and DLC (T), the NAS listing says what it holds (V).
+public static class ContentFetch
+{
+    /// The update or DLC files of `game` still being copied in (a `<name>.part` in Documents): a build started now would miss them (South Park's first build had
+    /// "content: u:… [v327680] (5.92 GB).nsz.part": it started while its update was still downloading, so the update came only with a second build).
+    public static List<string> StillComing(string game, IEnumerable<string> documentNames)
+    {
+        var id = GameAppUi.BaseTitleIdOf(game);
+        if (id == null || GameAppUi.IsNup(game)) return new List<string>();
+        return (documentNames ?? Enumerable.Empty<string>()).Where(n => n.EndsWith(".part", StringComparison.OrdinalIgnoreCase)).Select(n => n.Substring(0, n.Length - 5))
+            .Where(n => Cloud.IsGameFile(n) && ContentSet.Of(n) != ContentSet.Kind.Game && string.Equals(GameAppUi.BaseTitleIdOf(n), id, StringComparison.OrdinalIgnoreCase)).ToList();
+    }
+
+    /// The names a build reads: the game files of Documents, never a `.part` (the content signature took "…nsz.part" as the update).
+    public static List<string> Whole(IEnumerable<string> documentNames) =>
+        (documentNames ?? Enumerable.Empty<string>()).Where(n => !n.EndsWith(".part", StringComparison.OrdinalIgnoreCase)).ToList();
+
+    /// What to fetch before the build of a game on this iPhone: from every cloud source, its NEWEST update when it is newer than the one here (or there is none here), and each DLC
+    /// this iPhone does not have (its newest copy). Empty for a .nup, a name with no id, or when nothing is missing.
+    public static List<CloudFile> ToFetch(string game, IEnumerable<CloudFile> cloud, IEnumerable<string> local)
+    {
+        var l = (local ?? Enumerable.Empty<string>()).ToList();
+        var c = (cloud ?? Enumerable.Empty<CloudFile>()).Where(f => Cloud.IsGameFile(f.Name)).ToList();
+        if (GameAppUi.IsNup(game) || GameAppUi.ContentKindOf(game) != GameAppUi.ContentKind.Base) return new List<CloudFile>();
+        var here = ContentSet.ExtrasOf(game, l);
+        var there = ContentSet.ExtrasOf(game, c.Select(f => f.Name));
+        var want = new List<string>();
+        if (there.Update != null && (here.Update == null || GameAppUi.VersionOf(there.Update) > GameAppUi.VersionOf(here.Update))) want.Add(there.Update);
+        var haveDlc = new HashSet<string>(here.Dlc.Select(GameAppUi.TitleIdHexOf), StringComparer.OrdinalIgnoreCase);
+        want.AddRange(there.Dlc.Where(d => !haveDlc.Contains(GameAppUi.TitleIdHexOf(d))));
+        return want.Select(n => c.First(f => string.Equals(f.Name, n, StringComparison.OrdinalIgnoreCase))).ToList();
+    }
+
+    /// The Build row / the card before a build: "update v327680 · 1 DLC (from the NAS: 5.9 GB, fetched before the build)", or what this iPhone has, or "".
+    public static string BuildLine(string game, IEnumerable<string> local, IReadOnlyList<CloudFile> fetch, string where)
+    {
+        var l = (local ?? Enumerable.Empty<string>()).ToList();
+        var all = ContentSet.ExtrasOf(game, l.Concat((fetch ?? new List<CloudFile>()).Select(f => f.Name)));
+        var line = ContentSet.Summary(all.Update, all.Dlc.Count);
+        if (fetch == null || fetch.Count == 0 || line.Length == 0) return line;
+        return line + $" ({where ?? "in the cloud"}: {GameAppUi.SizeText(fetch.Sum(f => Math.Max(0, f.Size)))}, fetched before the build)";
+    }
+
+    /// A built game's: "update v327680 on the NAS" (a newer update, or DLC, the build does not have yet), or "".
+    public static string NewerLine(IReadOnlyList<CloudFile> fetch, string where)
+    {
+        if (fetch == null || fetch.Count == 0) return "";
+        var u = fetch.FirstOrDefault(f => ContentSet.Of(f.Name) == ContentSet.Kind.Update);
+        int d = fetch.Count(f => ContentSet.Of(f.Name) == ContentSet.Kind.Dlc);
+        var parts = new List<string>();
+        if (u != null) parts.Add("update v" + GameAppUi.VersionOf(u.Name).ToString(CultureInfo.InvariantCulture));
+        if (d > 0) parts.Add(d + " DLC");
+        return string.Join(" · ", parts) + " " + (where ?? "in the cloud").Replace("On the", "on the").Replace("In ", "in ");
+    }
+
+    public static string FetchLabel(long bytes) => "Download its update and DLC (" + GameAppUi.SizeText(bytes) + ")";
+
+    /// The log of a cloud listing: "NAS: 4 games, 2 updates, 3 DLC (1 classified by content)".
+    public static string ListingLine(string who, IEnumerable<string> names, Func<string, bool> byContent)
+    {
+        var l = (names ?? Enumerable.Empty<string>()).Where(Cloud.IsGameFile).ToList();
+        int u = l.Count(n => ContentSet.Of(n) == ContentSet.Kind.Update), d = l.Count(n => ContentSet.Of(n) == ContentSet.Kind.Dlc);
+        int c = byContent == null ? 0 : l.Count(byContent);
+        return $"{who}: {l.Count - u - d} game{(l.Count - u - d == 1 ? "" : "s")}, {u} update{(u == 1 ? "" : "s")}, {d} DLC ({c} classified by content)";
+    }
+}
+
+/// Patch 0094 (S, the owner's screenshot: the game sheet wider than the screen, "Delete" and the segmented rows cut): a row of the sheet keeps its label beside its control while both fit,
+/// else the label goes ABOVE the control (which then takes the whole width). Widths in points.
+public static class SheetFit
+{
+    public static bool Stacked(double labelWidth, double controlWidth, double available, double spacing = 10) => labelWidth + spacing + controlWidth > available;
+
+    /// The width a row of the settings card has on a screen `screen` points wide: the sheet's margins (20 each side) and the card's insets (16 each side).
+    public static double RowWidth(double screen) => screen - 2 * 20 - 2 * 16;
+
+    /// A rough width of `text` at `points` (the harness's estimate of SF Pro: 0.56 em a character on average, 0.62 for semibold).
+    public static double Estimate(string text, double points, bool semibold = false) => (text ?? "").Length * points * (semibold ? 0.62 : 0.56);
+
+    /// A UISegmentedControl's width: its segments are as wide as its widest title, plus 16 points of padding each.
+    public static double SegmentedWidth(IEnumerable<string> titles, double points) => (titles ?? Enumerable.Empty<string>()).Select(x => Estimate(x, points, true) + 16).DefaultIfEmpty(0).Max() * (titles ?? Enumerable.Empty<string>()).Count();
+}
+
+/// Patch 0094 (S): the priorities that keep the game sheet as wide as the screen: the page's width is 999 (Theme.PinColumn), so nothing inside may be required (1000) at its full width.
+public static class SheetPriority
+{
+    public const float Title = 900, Control = 800;
+}
