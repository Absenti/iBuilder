+    // ---- patch 0094 (T): the FIRST build takes the update and DLC (ContentFetch, GameAppAttach.cs) -------------------------------------------------------
+
+    private readonly HashSet<string> buildsAfterDownload = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+    private readonly HashSet<string> fetchTried = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+    /// Before a build: its update or DLC still being copied in -> the build waits for them (it starts when they have landed); its update or DLC in a cloud source and not here -> they are
+    /// downloaded first (one download, its own progress), then the build starts. True when the build waits. A failed or cancelled fetch is tried once: the next Build goes on without it.
+    private bool WaitForExtras(string game)
+    {
+        if (GameExport.IsPlayer) return false;
+        var docs = GameAppMain.Documents;
+        List<string> names;
+        try { names = Directory.EnumerateFiles(docs).Select(Path.GetFileName).ToList(); } catch (Exception) { return false; }
+        var coming = ContentFetch.StillComing(game, names);
+        if (coming.Count > 0)
+        {
+            buildsAfterDownload.Add(game);
+            Write($"build: {GameAppUi.DisplayName(game)} waits for {string.Join(", ", coming.Select(ContentSet.Label))} (still downloading): it starts when they have landed");
+            return true;
+        }
+        var fetch = ContentFetch.ToFetch(game, cloudFiles, ContentFetch.Whole(names));
+        if (fetch.Count == 0 || !fetchTried.Add(game)) return false;
+        Write($"build: {GameAppUi.DisplayName(game)}: first its {string.Join(", ", fetch.Select(f => ContentSet.Label(f.Name)))} from {string.Join(", ", fetch.Select(f => CloudWords(f).Where).Distinct())} "
+              + $"({GameAppUi.SizeText(fetch.Sum(f => Math.Max(0, f.Size)))}), then the build: it includes them");
+        Download(fetch, docs, _ => { fetchTried.Remove(game); KnowExtras(fetch.Select(f => f.Name)); QueueNow(game); });
+        return true;
+    }
+
+    /// A download ended: a build that waited for its update or DLC starts when nothing of it is still coming.
+    private void StartBuildsAfterDownload()
+    {
+        if (buildsAfterDownload.Count == 0) return;
+        List<string> names;
+        try { names = Directory.EnumerateFiles(GameAppMain.Documents).Select(Path.GetFileName).ToList(); } catch (Exception) { return; }
+        foreach (var g in buildsAfterDownload.ToList())
+            if (ContentFetch.StillComing(g, names).Count == 0) { buildsAfterDownload.Remove(g); Write($"build: {GameAppUi.DisplayName(g)}: its update and DLC are here, the build starts"); QueueNow(g); }
+    }
+
+    /// What a game on this iPhone lacks from the cloud (its newer update, its DLC), for its row, its card and its menu.
+    private List<CloudFile> ExtrasToFetch(string game) =>
+        GameExport.IsPlayer ? new List<CloudFile>() : ContentFetch.ToFetch(game, cloudFiles, libNames ?? Dumps().Select(Path.GetFileName).ToList());
+
+    private void FetchExtras(string game)
+    {
+        var fetch = ExtrasToFetch(game);
+        if (fetch.Count == 0) return;
+        Download(fetch, GameAppMain.Documents, _ => KnowExtras(fetch.Select(f => f.Name)));
     }
 
     // ---- covers before the download --------------------------------------------------------------------------------
