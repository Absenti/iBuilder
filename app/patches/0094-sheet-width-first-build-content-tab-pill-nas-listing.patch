+/// Patch 0094 (S): a settings row: its label beside its control while both fit (SheetFit.Stacked), else the label above and the control on the whole width. Decided again at every layout
+/// (another size class, the iPad's inspector, a rotation).
+internal sealed class FitRow : UIStackView
+{
+    private readonly UIView label, control, spacer = new UIView();
+
+    public FitRow(UIView label, UIView control) : base(new[] { label })
+    {
+        this.label = label;
+        this.control = control;
+        Spacing = 10;
+        Axis = UILayoutConstraintAxis.Horizontal;
+        Alignment = UIStackViewAlignment.Center;
+        AddArrangedSubview(spacer);
+        AddArrangedSubview(control);
+    }
+
+    public override void LayoutSubviews()
+    {
+        var w = Bounds.Width;
+        if (w > 0)
+        {
+            bool stack = SheetFit.Stacked((double) label.IntrinsicContentSize.Width, (double) control.IntrinsicContentSize.Width, (double) w, (double) Spacing);
+            var axis = stack ? UILayoutConstraintAxis.Vertical : UILayoutConstraintAxis.Horizontal;
+            if (Axis != axis)
+            {
+                Axis = axis;
+                Alignment = stack ? UIStackViewAlignment.Fill : UIStackViewAlignment.Center;
+                Spacing = stack ? 8 : 10;
+                spacer.Hidden = stack;
+            }
+        }
+        base.LayoutSubviews();
     }
 }
