+// gameapp/GameAppFieldUi.cs: app/patches/0085 (UIKit side): the free space iOS really gives, the download meters, the last reading line of stage 3, the shared NAS session's end.
+// The decisions are GameAppField.cs (pure, run by the host harness).
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using Foundation;
+using UIKit;
+
+/// The free space for an important use (NSURLVolumeAvailableCapacityForImportantUsageKey on Documents: what iOS frees purgeable space for, the figure Settings shows), else the plain free
+/// space of Documents' volume; kept 10 s (every screen and every "Not enough space" check reads it). Any thread.
+internal static class DiskFreeNow
+{
+    private static readonly object gate = new object();
+    private static readonly TtlCache<(long Important, long Plain)> cache = new TtlCache<(long, long)>(TimeSpan.FromSeconds(10));
+
+    public static (long Important, long Plain) Both()
+    {
+        lock (gate) return cache.Get(Read, DateTime.UtcNow);
+    }
+
+    public static long Bytes() { var b = Both(); return DiskSpace.Choose(b.Important, b.Plain); }
+
+    public static void Invalidate() { lock (gate) cache.Invalidate(); }
+
+    private static (long, long) Read()
+    {
+        long important = -1, plain = 0;
+        try
+        {
+            using var url = NSUrl.FromFilename(GameAppMain.Documents);
+            if (url.TryGetResource(NSUrl.VolumeAvailableCapacityForImportantUsageKey, out NSObject value) && value is NSNumber n) important = n.Int64Value;
+        }
+        catch (Exception) { important = -1; }
+        try { plain = new DriveInfo(GameAppMain.Documents).AvailableFreeSpace; } catch (Exception) { plain = 0; }
+        return (important, plain);
+    }
+}
+
+public sealed partial class GameAppViewController
+{
+    private static long DiskFree() => DiskFreeNow.Bytes();
+
+    /// "storage: 103.2 GB free for important use (24.5 GB without purgeable space)": at the launch, at a build's start, at a download's start.
+    private static string StorageLine() { var b = DiskFreeNow.Both(); return DiskSpace.Line(b.Important, b.Plain); }
+
+    private DateTime? lastCloudListUtc;   // the last cloud listing that ended (CloudRelist)
+    private string lastReadingLine;       // stage 3's last "progress: N/M" (BuildProgress)
+    private readonly Dictionary<string, DownloadMeter> downloadMeters = new Dictionary<string, DownloadMeter>(StringComparer.OrdinalIgnoreCase);
+    private NSObject nasBackgroundObserver;
+
+    /// The text of the log as it is appended (main thread): stage 3's reading counter is kept for the bar and for iOS's progress.
+    private void NoteLogText(string text)
+    {
+        if (text == null || text.IndexOf("progress: ", StringComparison.Ordinal) < 0) return;
+        foreach (var line in text.Split('\n'))
+            if (BuildProgress.IsReadingLine(line)) lastReadingLine = line.Trim();
+    }
+
+    /// The meter's words for a game being downloaded, "" when none.
+    private string MeterLong(string name) => name != null && downloadMeters.TryGetValue(name, out var m) ? m.Long(DateTime.UtcNow) : "";
+    private string MeterCompact(string name) => name != null && downloadMeters.TryGetValue(name, out var m) ? m.Compact(DateTime.UtcNow) : "";
+
+    /// The refresh button: the cloud is listed now, unless a build or a download runs (then it says so; it is listed after it, at the next return or refresh).
+    private void RefreshCloudAsked()
+    {
+        if (CloudRelist.Should(CloudRelist.Why.Explicit, lastCloudListUtc, DateTime.UtcNow, running, downloads.Count > 0)) RefreshCloud(null);
+        else Write("cloud: not listed again now: a build or a download is running (the listing of before stays; tap refresh once it is over)");
+    }
+
+    private volatile bool systemPause;   // the pause being honoured came from iOS's expiration, not from the person
+    private volatile bool gameOnScreen;  // the game view is up (a Play's boot): the app does nothing periodic on the main thread
+    private bool refreshOwed;            // a screen refresh asked while the game was on screen: done when it ends
+
+    /// The person is back in the app: a pause iOS asked for that has not taken effect yet is withdrawn (the South Park build paused itself after its extraction: the expiration's request had
+    /// stayed pending through the extraction and was applied at the chain's start although the owner was back).
+    private void WithdrawSystemPause()
+    {
+        if (!systemPause) return;
+        systemPause = false;
+        if (!stop.WithdrawPause(out bool native)) return;
+        if (native) { try { GameStopNative.gameapp_request_stop((int) StopKind.None); } catch (Exception) { } }
+        Write("background: back in the app: the pause iOS asked for (its task expired) is withdrawn; the build goes on");
+    }
+
+    /// The shared NAS session (GameAppNas.cs, patch 0085) ends when the app goes to the background; it is made again at the next listing or cover.
+    private void WatchNasSession()
+    {
+        nasBackgroundObserver ??= NSNotificationCenter.DefaultCenter.AddObserver(UIApplication.DidEnterBackgroundNotification, _ => System.Threading.Tasks.Task.Run(Nas.CloseShared));
+    }
+}
