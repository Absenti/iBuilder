diff -ruN f/GameAppField.cs g/GameAppField.cs
--- f/GameAppField.cs	1970-01-01 01:00:00
+++ g/GameAppField.cs	2026-11-21 23:39:09
@@ -0,0 +1,249 @@
+// gameapp/GameAppField.cs: the pure part of app/patches/0085, the owner's field report on the IPA of 2026-11-21 21:59 (its logs read, never copied): the build's progress as iOS sees
+// it (the background task was expired when its bar had not moved), what an expiration may do, when the cloud is listed again, adding to the queue during a build, a download's speed and
+// time left, the free space iOS really gives, and the short caches that keep the main thread light. No UIKit: the host harness compiles it as it is.
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Text.RegularExpressions;
+
+/// The build's progress from what the chain says: its stage line (gameapp.stage) and, in stage 3, its last "progress: N/M" log line (the shaders being read, before any "(N/M shaders)").
+/// GameAppUi.ParseStage moved the bar only for the rewrite's modules and the translation's shader count: stage 1 (75 s of "unpacking 2.3 of 26.2 GB" for Ocarina) and the start of stage 3
+/// stood still, and iOS expires a BGContinuedProcessingTask whose progress stalls.
+public static class BuildProgress
+{
+    private static readonly Regex Unpacking = new Regex(@"(?:unpacking|ExeFS)\s+([\d.]+)\s+of\s+([\d.]+)\s*GB");
+    private static readonly Regex Reading = new Regex(@"^\s*progress:\s*(\d+)/(\d+)\s*$");
+    private static readonly Regex Shaders = new Regex(@"\((\d+)/(\d+) shaders\)");
+
+    /// The part of stage 3 that is the reading of the game's shaders (the translation is the rest).
+    public const double ReadingShare = 0.15;
+
+    private static (double Start, double Width) Span(int step, int of)
+    {
+        double start = GameAppUi.ParseStage($"stage {step}/{of}: x").Fraction;
+        double end = step < of ? GameAppUi.ParseStage($"stage {step + 1}/{of}: x").Fraction : 1.0;
+        return (start, Math.Max(0, end - start));
+    }
+
+    /// 0..1 for the whole build. `readingLine`: the last "progress: N/M" line of the log (null when none since the stage began).
+    public static double Fraction(string stageLine, string readingLine)
+    {
+        var s = GameAppUi.ParseStage(stageLine);
+        if (!s.Valid) return 0;
+        var (start, width) = Span(s.Step, s.Of);
+        double within = 0;
+        var u = Unpacking.Match(s.Text);
+        if (u.Success && double.TryParse(u.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var a) && double.TryParse(u.Groups[2].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var b) && b > 0)
+            within = Math.Min(1, a / b);
+        else if (s.Of == 5 && s.Step == 3)
+        {
+            var sc = Shaders.Match(s.Text);
+            if (sc.Success && long.TryParse(sc.Groups[1].Value, out var d) && long.TryParse(sc.Groups[2].Value, out var t) && t > 0) within = ReadingShare + (1 - ReadingShare) * Math.Min(1, d / (double) t);
+            else if (readingLine != null && Reading.Match(readingLine) is { Success: true } r && long.TryParse(r.Groups[1].Value, out var rd) && long.TryParse(r.Groups[2].Value, out var rt) && rt > 0)
+                within = ReadingShare * Math.Min(1, rd / (double) rt);
+        }
+        else return s.Fraction;   // the rewrite's modules: ParseStage's own
+        return Math.Min(1, Math.Max(s.Fraction, start + width * within));
+    }
+
+    /// The stage line the build's STEPS are drawn from: a .nup's stage 1 ("reading the Switch 2 package …: unpacking 2.3 of 26.2 GB", 75 s for Ocarina) is the step "Read the game", not
+    /// "Prepare the profile" (GameAppUi.BuildSteps maps stage k to step k: right for an .nsp whose reading is the app's own extraction, step 0, but the build screen said "STEP 2 OF 5 ·
+    /// Profile" through the whole read of a .nup).
+    public static string StepLine(string stageLine)
+    {
+        var s = GameAppUi.ParseStage(stageLine);
+        return s.Valid && s.Of == 5 && s.Step == 1 && s.Text.StartsWith("reading the Switch 2 package", StringComparison.Ordinal) ? null : stageLine;
+    }
+
+    /// The "progress: N/M" lines of the log (the reading of the shaders), as they come.
+    public static bool IsReadingLine(string line) => line != null && Reading.IsMatch(line);
+}
+
+/// The units iOS is given for the task's bar: never backwards, and at least one more every few seconds while the build runs (a stage that reads a 26 GB package says nothing iOS counts),
+/// without passing the end of the stage it is in.
+public static class BackgroundHeartbeat
+{
+    public const int Every = 3;   // seconds
+
+    public static long Next(long last, long real, long stageEnd, double secondsSinceAdvance)
+    {
+        long next = Math.Max(last, real);
+        if (next == last && secondsSinceAdvance >= Every && last + 1 < stageEnd) next = last + 1;
+        return next;
+    }
+
+    /// The stage's end in units, for the cap.
+    public static long StageEnd(string stageLine, long units)
+    {
+        var s = GameAppUi.ParseStage(stageLine);
+        if (!s.Valid) return (long) (units * GameAppUi.ParseStage("stage 1/5: x").Fraction) + units / 50;
+        double end = s.Step < s.Of ? GameAppUi.ParseStage($"stage {s.Step + 1}/{s.Of}: x").Fraction : 1.0;
+        return (long) (end * units);
+    }
+}
+
+/// What iOS's expiration of the build's task does. Before: a PAUSE request whenever the build was stoppable; during the reading of a package or of the shaders the chain cannot stop there,
+/// the request stayed raised and paused the build later, in the background, by itself. Now: a pause only while the shaders are TRANSLATED (it stops after the current one); otherwise it is
+/// logged and the build goes on while iOS lets the process run.
+public static class ExpirationPolicy
+{
+    public static bool Pauses(bool stoppable, bool extracting, string stageLine)
+    {
+        if (!stoppable || extracting) return false;
+        var s = GameAppUi.ParseStage(stageLine);
+        return s.Valid && s.Of == 5 && s.Step == 3 && s.Text.Contains(" shaders)", StringComparison.Ordinal);
+    }
+}
+
+/// When the cloud sources are listed again (each NAS listing is an SSH connection): at the launch, on an explicit refresh, when the last listing is older than 15 minutes; never while a
+/// build or a download runs (it was at every return to the app).
+public static class CloudRelist
+{
+    public enum Why { Launch, Explicit, Foreground, SourceChanged }
+
+    public static readonly TimeSpan MaxAge = TimeSpan.FromMinutes(15);
+
+    public static bool Should(Why why, DateTime? lastListedUtc, DateTime nowUtc, bool building, bool downloading)
+    {
+        if (building || downloading) return false;
+        if (why == Why.Explicit || why == Why.SourceChanged || why == Why.Launch) return true;
+        return lastListedUtc == null || nowUtc - lastListedUtc.Value >= MaxAge;
+    }
+}
+
+/// The queue during a build: a game that is not built can always be added (its button says "Add to queue" while another game builds); the game being built and a game already queued say so.
+public static class QueueRule
+{
+    public enum Answer { Add, AlreadyQueued, IsBuilding, Nothing }
+
+    public static Answer Ask(string game, string building, IEnumerable<string> queued)
+    {
+        if (string.IsNullOrEmpty(game)) return Answer.Nothing;
+        if (building != null && string.Equals(game, building, StringComparison.OrdinalIgnoreCase)) return Answer.IsBuilding;
+        foreach (var q in queued ?? Array.Empty<string>()) if (string.Equals(q, game, StringComparison.OrdinalIgnoreCase)) return Answer.AlreadyQueued;
+        return Answer.Add;
+    }
+
+    public static string Words(Answer a, string display) => a switch
+    {
+        Answer.IsBuilding => display + " is being built now.",
+        Answer.AlreadyQueued => display + " is already in the queue.",
+        _ => display + " waits in the queue: it starts after the current build.",
+    };
+}
+
+/// A download's speed and time left: an exponential moving average of the rate, sampled at most twice a second; shown after 2 s of data ("estimating…" before), "stalled" after 5 s with no
+/// byte; Reset after a pause, a resume or a reconnect. Decimal units, as the rest of the app's sizes say "GB".
+public sealed class DownloadMeter
+{
+    public const double SampleEvery = 0.5, ShowAfter = 2.0, StallAfter = 5.0, Alpha = 0.25;
+
+    private DateTime start, lastSample, lastByte;
+    private long lastBytes;
+    private bool started;
+    public double Rate { get; private set; }   // bytes a second, smoothed
+    public long Bytes { get; private set; }
+    public long Total { get; private set; }
+
+    public void Reset() { started = false; Rate = 0; Bytes = 0; }
+
+    public void Update(long bytes, long total, DateTime nowUtc)
+    {
+        Total = total;
+        if (!started) { started = true; start = lastSample = lastByte = nowUtc; lastBytes = bytes; Bytes = bytes; return; }
+        if (bytes < lastBytes) { start = lastSample = lastByte = nowUtc; lastBytes = bytes; Bytes = bytes; Rate = 0; return; }   // a new file of the set, a restart
+        if (bytes > Bytes) lastByte = nowUtc;
+        Bytes = bytes;
+        double dt = (nowUtc - lastSample).TotalSeconds;
+        if (dt < SampleEvery) return;
+        double inst = (bytes - lastBytes) / dt;
+        Rate = Rate <= 0 ? inst : Alpha * inst + (1 - Alpha) * Rate;
+        lastSample = nowUtc;
+        lastBytes = bytes;
+    }
+
+    public bool Estimating(DateTime nowUtc) => !started || (nowUtc - start).TotalSeconds < ShowAfter || Rate <= 0;
+    public bool Stalled(DateTime nowUtc) => started && (nowUtc - lastByte).TotalSeconds > StallAfter;
+
+    public static string Size(double bytes) =>
+        bytes >= 1e9 ? (bytes / 1e9).ToString("0.0", CultureInfo.InvariantCulture) + " GB" : bytes >= 1e6 ? (bytes / 1e6).ToString("0", CultureInfo.InvariantCulture) + " MB" : (bytes / 1e3).ToString("0", CultureInfo.InvariantCulture) + " kB";
+
+    public static string Speed(double rate) =>
+        rate >= 1e9 ? (rate / 1e9).ToString("0.0", CultureInfo.InvariantCulture) + " GB/s" : rate >= 1e6 ? (rate / 1e6).ToString("0", CultureInfo.InvariantCulture) + " MB/s" : (rate / 1e3).ToString("0", CultureInfo.InvariantCulture) + " kB/s";
+
+    public static string Left(double seconds)
+    {
+        if (double.IsNaN(seconds) || double.IsInfinity(seconds) || seconds < 0) return "";
+        var s = (long) Math.Round(seconds);
+        return s >= 3600 ? $"{s / 3600} h {s % 3600 / 60} min left" : s >= 60 ? $"{s / 60} min {s % 60} s left" : $"{s} s left";
+    }
+
+    public static string Clock(double seconds)
+    {
+        var s = (long) Math.Max(0, Math.Round(seconds));
+        return s >= 3600 ? $"{s / 3600}:{s % 3600 / 60:00}:{s % 60:00}" : $"{s / 60}:{s % 60:00}";
+    }
+
+    /// "1.2 of 4.8 GB · 38 MB/s · 1 min 35 s left" (or "· estimating…", "· stalled").
+    public string Long(DateTime nowUtc)
+    {
+        var head = Total > 0 ? $"{Size(Bytes).Replace(" GB", "").Replace(" MB", "")} of {Size(Total)}" : Size(Bytes);
+        if (Total > 0 && Size(Bytes).Split(' ')[1] != Size(Total).Split(' ')[1]) head = $"{Size(Bytes)} of {Size(Total)}";
+        if (Stalled(nowUtc)) return head + " · stalled";
+        if (Estimating(nowUtc)) return head + " · estimating…";
+        var left = Total > Bytes && Rate > 0 ? " · " + Left((Total - Bytes) / Rate) : "";
+        return head + " · " + Speed(Rate) + left;
+    }
+
+    /// "38 MB/s · 1:35" for a small card.
+    public string Compact(DateTime nowUtc)
+    {
+        if (Stalled(nowUtc)) return "stalled";
+        if (Estimating(nowUtc)) return "estimating…";
+        return Speed(Rate) + (Total > Bytes && Rate > 0 ? " · " + Clock((Total - Bytes) / Rate) : "");
+    }
+
+    /// The end of a download, for the log: "4.8 GB in 2 min 6 s (38 MB/s on average)".
+    public static string Summary(long bytes, TimeSpan took)
+    {
+        double s = Math.Max(0.001, took.TotalSeconds);
+        return $"{Size(bytes)} in {Left(s).Replace(" left", "")} ({Speed(bytes / s)} on average)";
+    }
+}
+
+/// The free space the screens show and the "Not enough space" checks use: what iOS gives an important use (a build, a download the person asked for: iOS purges caches for it, which is what
+/// Settings counts), else the volume's plain free space (DriveInfo of Documents' volume, not "/": the system volume's figure was ~24.5 GB when Settings said >100 GB).
+public static class DiskSpace
+{
+    public static long Choose(long important, long plain) => important > 0 ? important : Math.Max(0, plain);
+
+    public static string Line(long important, long plain) =>
+        $"storage: {GameAppUi.SizeText(Choose(important, plain))} free for important use ({GameAppUi.SizeText(Math.Max(0, plain))} without purgeable space)";
+}
+
+/// The build screen's Pause / Cancel row (patch 0085): while a build runs both are shown (off when they cannot act), paused only Cancel (Resume is the main button), else none.
+public static class BuildScreenButtons
+{
+    public static (bool Row, bool Pause, bool Cancel) Shown(bool running, bool canPause, bool canCancel) =>
+        running ? (true, true, true) : canCancel ? (true, false, true) : (false, false, false);
+}
+
+/// A value kept for a while (the facts the screen reads every second that cannot change that fast: the signing identity, the entitlements, the address space): computed again only after `ttl`.
+public sealed class TtlCache<T>
+{
+    private readonly TimeSpan ttl;
+    private T value;
+    private DateTime at = DateTime.MinValue;
+    private bool has;
+
+    public TtlCache(TimeSpan ttl) => this.ttl = ttl;
+
+    public T Get(Func<T> make, DateTime nowUtc)
+    {
+        if (!has || nowUtc - at >= ttl) { value = make(); at = nowUtc; has = true; }
+        return value;
+    }
+
+    public void Invalidate() => has = false;
+}
