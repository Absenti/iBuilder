+    // ---- patch 0085: one SSH session while the app is active ------------------------------------------------------------
+    private static readonly object sharedGate = new object();
+    private static SftpClient shared;
+    private static string sharedKey;
+
+    /// `work` on the shared connection (made, or made again when it dropped or the NAS changed), one caller at a time. A connection error drops it (the next call connects again).
+    public static T WithShared<T>(NasConfig cfg, AuthenticationMethod auth, Action<string> log, Func<SftpClient, T> work)
+    {
+        lock (sharedGate)
+        {
+            var key = cfg.Host + "|" + cfg.Port + "|" + cfg.User;
+            if (shared == null || !shared.IsConnected || sharedKey != key)
+            {
+                try { shared?.Dispose(); } catch (Exception) { }
+                shared = null;
+                shared = Connect(cfg, auth, log, out _);
+                sharedKey = key;
+            }
+            try { return work(shared); }
+            catch (Exception e) when (e is Renci.SshNet.Common.SshConnectionException || e is System.Net.Sockets.SocketException || e is ObjectDisposedException || !shared.IsConnected)
+            {
+                try { shared.Dispose(); } catch (Exception) { }
+                shared = null;
+                throw;
+            }
+        }
+    }
+
+    /// The app went to the background (or the NAS settings changed): the shared connection ends.
+    public static void CloseShared()
+    {
+        lock (sharedGate)
+        {
+            try { if (shared != null && shared.IsConnected) shared.Disconnect(); } catch (Exception) { }
+            try { shared?.Dispose(); } catch (Exception) { }
+            shared = null;
+        }
+    }
