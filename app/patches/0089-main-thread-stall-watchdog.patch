+
+/// Patch 0089 (the owner: South Park's picture and pad froze together): while a game is on screen a watchdog thread asks the main queue for a no-op every 50 ms and measures, from two
+/// monotonic timestamps (posted, ran), how long the main thread took to run it; a wait over 100 ms is one line in the log with the wall-clock time it began, to set beside the game's own
+/// log: "main thread stalled 230 ms at 23:41:07.512". One request in flight at a time, so one stall is one line.
+public static class MainStall
+{
+    public const int PingMs = 50, ThresholdMs = 100;
+
+    public static bool Counts(double waitedMs) => waitedMs > ThresholdMs;
+
+    /// `began`: the local wall-clock time the no-op was posted (the stall's start, give or take PingMs).
+    public static string Line(double waitedMs, DateTime began) =>
+        "main thread stalled " + Math.Round(waitedMs).ToString("0", CultureInfo.InvariantCulture) + " ms at " + began.ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture);
+}
