+    // ---- patch 0089: the main-thread watchdog while a game is on screen (GameAppField.cs MainStall) -----------------------------------------------------
+
+    private volatile bool stallWatching;
+    private long stallRanSeq, stallRanTicks;
+
+    /// From ShowGameWindowAtBoot to DismissGameWindow. The thread never waits on the main thread: it posts (BeginInvokeOnMainThread, asynchronous) and looks every 10 ms whether the no-op ran;
+    /// the wait is the difference of the two Stopwatch timestamps, so the watchdog's own scheduling does not count. The main thread's cost: one empty block every 50 ms.
+    private void StartStallWatch()
+    {
+        if (stallWatching) return;
+        stallWatching = true;
+        var thread = new Thread(() =>
+        {
+            long seq = 0;
+            while (stallWatching)
+            {
+                long mine = ++seq, sent = Stopwatch.GetTimestamp();
+                var began = DateTime.Now;
+                BeginInvokeOnMainThread(() => { Volatile.Write(ref stallRanTicks, Stopwatch.GetTimestamp()); Volatile.Write(ref stallRanSeq, mine); });
+                while (stallWatching && Volatile.Read(ref stallRanSeq) != mine) Thread.Sleep(10);
+                if (!stallWatching) return;
+                double waited = (Volatile.Read(ref stallRanTicks) - sent) * 1000.0 / Stopwatch.Frequency;
+                if (MainStall.Counts(waited)) { var line = MainStall.Line(waited, began); BeginInvokeOnMainThread(() => Write(line)); }
+                Thread.Sleep(MainStall.PingMs);
+            }
+        })
+        { IsBackground = true, Name = "main-stall-watch" };
+        thread.Start();
+        Write($"main thread watchdog: on while the game is on screen (a stall over {MainStall.ThresholdMs} ms is logged with its time)");
+    }
+
+    private void StopStallWatch() => stallWatching = false;
 
