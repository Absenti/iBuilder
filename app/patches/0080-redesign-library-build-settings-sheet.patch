+    private void RefreshLibrary(UiFacts facts, IReadOnlyList<string> games)
+    {
+        if (flow == null) return;
+        libFacts = facts;
+        foreach (var row in banner.ArrangedSubviews.ToArray()) { banner.RemoveArrangedSubview(row); row.RemoveFromSuperview(); }
+        foreach (var need in GameAppUi.Prerequisites(facts))
+        {
+            var importer = need.Importer;
+            var view = new BannerView(ChecklistLabel(need.Row), need.Row.Level == CheckLevel.Missing ? UIColor.SystemRed : UIColor.SystemOrange);
+            view.AccessibilityLabel = $"{need.Row.Label}: {need.Row.Detail}";
+            view.AccessibilityIdentifier = importer == GameAppUi.Importer.Keys ? "banner-keys" : "banner-certificate";
+            view.TouchUpInside += (_, __) => { if (importer == GameAppUi.Importer.Keys) Import(); else ImportCertificate(); };
+            banner.AddArrangedSubview(view);
+        }
+        AddKilledBanner();   // GameAppResume.cs: "iOS ended the last build (memory). Resume"
+        banner.Hidden = banner.ArrangedSubviews.Length == 0;
+
+        // the games of this iPhone, then the ones only in a cloud source (the cached listing; each game once, the local one wins: LibraryMerge)
+        var localNames = Dumps().Select(Path.GetFileName).ToList();
+        libNames = localNames;   // one listing of Documents for the whole redraw (the cards' "Update available" and menus read it)
+        var list = games.Select(g => new LibraryEntry(g, Cloud.CloudCopyOf(g, cloudFiles), CoverOf(g, facts))).ToList();
+        var cloudOnly = Cloud.CloudOnlyGames(localNames, cloudFiles);
+        list.AddRange(cloudOnly.Select(f => new LibraryEntry(f.Name, f, CoverOf(f.Name, facts))));
+        entries = list;   // the download flows look a cloud game up here
+        // "Hide from the library" (a cloud game's menu): kept in NSUserDefaults "library_hidden"; a hidden game that is on this iPhone now is forgotten
+        var hiddenText = NSUserDefaults.StandardUserDefaults.StringForKey(HiddenKey) ?? "";
+        var stillHidden = HiddenGames.Without(hiddenText, localNames);
+        if (stillHidden != hiddenText) NSUserDefaults.StandardUserDefaults.SetString(stillHidden, HiddenKey);
+        var shownCloud = LibraryMerge.CloudShown(games, cloudOnly, HiddenGames.Parse(stillHidden));
+        libShown = list.Where(e => games.Contains(e.Name) || shownCloud.Any(c => c.Name == e.Name)).ToList();
+        if (selected == null || !entries.Any(e => e.Name == selected)) selected = libShown.FirstOrDefault()?.Name;
+
+        long localBytes = DumpBytes();
+        shelfSubtitle.Text = LibraryStatus.Summary(libShown.Count, localBytes > 0 ? GameAppUi.SizeText(localBytes) : null, GameAppUi.SizeText(FreeBytes()));
+        bool grid = shelfView == "grid";
+        var toggleConfig = libToggle.Configuration;
+        toggleConfig.Image = UIImage.GetSystemImage(grid ? "rectangle.stack" : "square.grid.2x2");
+        libToggle.Configuration = toggleConfig;
+        libToggle.AccessibilityValue = grid ? "Grid" : "Carousel";
+        bool any = libShown.Count > 0;
+        libEmpty.Hidden = any;
+        carouselBlock.Hidden = !any || grid;
+        gridBlock.Hidden = !any || !grid;
+
+        shelfKeep.Clear();
+        warmShelfViews.Clear();   // GameAppWarm.cs: the cards drawn below add their bars again
+        warmShelfTitle = WarmShownTitle();
+        warmShelfPaused = warmQueue.Paused;
+
+        // the cover flow is updated in place (a redraw every second while a game downloads must not reset a swipe)
+        var items = libShown.Select(e =>
+        {
+            var state = LibStateOf(e, facts, out var fraction);
+            var status = StatusOf(e, state, fraction, facts);
+            bool grey = state == LibState.CloudOnly || state == LibState.Downloading;
+            return new FlowItem(e.Name, GameAppUi.DisplayName(e.Name), e.Icon, grey, grey, status.Text, status.Tone, state == LibState.Downloading || state == LibState.Building ? fraction : null);
+        }).ToList();
+        int focus = Math.Max(0, libShown.FindIndex(e => e.Name == selected));
+        flow.SetItems(items, focus);
+        RefreshFlowFocus();
+
+        // the grid is drawn again
+        foreach (var v in gridRows.ArrangedSubviews.ToArray()) { gridRows.RemoveArrangedSubview(v); v.RemoveFromSuperview(); }
+        if (grid)
+        {
+            var cells = libShown.Select((e, i) => GridCard(e, i, libShown.Count, facts)).ToList();
+            for (int i = 0; i < cells.Count; i += 2)
+            {
+                var pair = new UIStackView(new UIView[] { cells[i], i + 1 < cells.Count ? cells[i + 1] : new UIView() })
+                    { Axis = UILayoutConstraintAxis.Horizontal, Distribution = UIStackViewDistribution.FillEqually, Spacing = 14, Alignment = UIStackViewAlignment.Top };
+                gridRows.AddArrangedSubview(pair);
+            }
+        }
+
+        int appCount = FillApps(appsList);
+        appsTitle.Hidden = shelfAppsCard.Hidden = appCount == 0;
+    }
