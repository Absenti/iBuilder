+    /// The entries of the touch-and-hold menu (HoldMenuPlan), each an existing action of the app.
+    private List<HoldOverlay.Entry> HoldEntries(LibraryEntry e, UiFacts facts)
+    {
+        var state = LibStateOf(e, facts, out _);
+        bool canRun = CanRunHere(facts);
+        var name = e.Name;
+        var path = Path.Combine(GameAppMain.Documents, name);
+        bool local = e.Cloud == null || File.Exists(path);
+        var tid = GameAppUi.BaseTitleIdOf(name);
+        bool warmShown = tid != null && string.Equals(tid, WarmShownTitle(), StringComparison.OrdinalIgnoreCase);
+        bool warmQueued = tid != null && warmQueue.Titles.Contains(tid.ToUpperInvariant());
+        bool update = state == LibState.Built && GameAppUi.ContentChangedSinceBuild(name, libNames ?? Dumps().Select(Path.GetFileName).ToList(), facts);
+        var targets = UploadTargets().Where(t => e.Cloud == null || e.Cloud.SourceId != t.Id).ToList();
+        var plan = HoldMenuPlan.Items(new HoldFacts(state, canRun, update, local, facts.Running, warmShown, warmQueued, targets.Count, e.Cloud != null));
+        var list = new List<HoldOverlay.Entry>();
+        var primary = LibraryActions.For(state, canRun)[0];
+        foreach (var item in plan)
+        {
+            switch (item)
+            {
+                case HoldItem.Primary:
+                    if (LibraryActions.Enabled(primary.Act, facts.Running))
+                        list.Add(new HoldOverlay.Entry(HoldMenuPlan.PrimaryLabel(state, canRun), primary.Symbol, false, () => RunLibAct(primary.Act, e), "hold-primary"));
+                    break;
+                case HoldItem.Settings: list.Add(new HoldOverlay.Entry("Settings", "slider.horizontal.3", false, () => ShowGameSheet(e), "hold-settings")); break;
+                case HoldItem.ChooseCover: list.Add(new HoldOverlay.Entry("Choose a cover…", "photo", false, () => ShowCoverChooser(name), "cover-choose")); break;
+                case HoldItem.Export: list.Add(new HoldOverlay.Entry("Export IPA", "square.and.arrow.up", false, () => { selected = name; ConfirmExport(name); }, "hold-export")); break;
+                case HoldItem.Update: list.Add(new HoldOverlay.Entry("Update (build again with the update or DLC)", "arrow.triangle.2.circlepath", false, () => DoUpdate(name), "hold-update")); break;
+                case HoldItem.WarmToggle: list.Add(new HoldOverlay.Entry(warmQueue.Paused ? "Resume the shader preparation" : "Pause the shader preparation", warmQueue.Paused ? "play.fill" : "pause.fill", false, ToggleWarmPause, "hold-warm")); break;
+                case HoldItem.WarmNow: list.Add(new HoldOverlay.Entry("Prepare the shaders now", "bolt.fill", false, () => PrepareNow(name), "hold-warm-now")); break;
+                case HoldItem.CancelPaused: list.Add(new HoldOverlay.Entry("Cancel the paused build…", "xmark", false, () => AskCancel(name), "build-cancel")); break;
+                case HoldItem.AddToQueue: if (!facts.Running) list.Add(new HoldOverlay.Entry("Add to the build queue", "list.number", false, () => AddToBuildQueue(name), "hold-queue")); break;
+                case HoldItem.Upload:
+                    foreach (var t in targets) { var target = t; list.Add(new HoldOverlay.Entry("Upload to " + target.Name, "icloud.and.arrow.up", false, () => UploadTo(target, path, false), "hold-upload")); }
+                    break;
+                case HoldItem.RemoveDownload: list.Add(new HoldOverlay.Entry("Remove download (stays in the cloud)", "icloud.slash", false, () => RemoveGameDownload(name), "hold-remove-download")); break;
+                case HoldItem.Delete: list.Add(new HoldOverlay.Entry("Delete…", "trash", true, () => ConfirmDelete(name), "hold-delete")); break;
+                case HoldItem.Hide: list.Add(new HoldOverlay.Entry("Hide from the library", "eye.slash", true, () => HideFromLibrary(name), "hold-hide")); break;
+            }
+        }
+        return list;
+    }
+
+    private void ShowHold(LibraryEntry e, UIView card, nfloat radius, int index, int count, int columns)
+    {
+        if (holdOverlay != null || PresentedViewController != null || libFacts == null) return;
+        var entries = HoldEntries(e, libFacts);
+        if (entries.Count == 0) return;
+        holdOverlay = new HoldOverlay(View, card, radius, index, count, columns, entries, () => holdOverlay = null);
+        View.AddSubview(holdOverlay);
+    }
