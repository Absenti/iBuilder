+/// Where a game of the library stands, as its buttons see it.
+public enum LibState { CloudOnly, Downloading, Building, Paused, NotBuilt, Built }
+
+/// What a library button does (the owner's rule: Download / Cancel / Build / Play + Export IPA / Export IPA alone), plus the two states a build already had (Watch, Resume).
+public enum LibAct { Download, CancelDownload, Watch, Resume, Build, Play, ExportIpa }
+
+public sealed record LibButton(LibAct Act, string Label, bool Primary, string Symbol, string Id);
+
+public static class LibraryActions
+{
+    /// The line under the carousel's buttons when the installed certificate has no get-task-allow (a distribution one): the game is exported, never played here.
+    public const string NoGetTaskAllowNote = "This certificate has no get-task-allow: a game cannot run inside iBuilder. Export it and install it as its own app.";
+
+    /// The state from the facts the screen has: only in a cloud source (and being downloaded or not), being built, paused, built (a framework this app build made, GameAppUi.GameStatusOf Ready), or not.
+    public static LibState StateOf(bool cloudOnly, bool downloading, bool building, bool paused, bool ready)
+    {
+        if (cloudOnly) return downloading ? LibState.Downloading : LibState.CloudOnly;
+        if (building) return LibState.Building;
+        if (paused) return LibState.Paused;
+        return ready ? LibState.Built : LibState.NotBuilt;
+    }
+
+    /// The buttons, the primary first. `canRunHere`: the signature has get-task-allow (GameAppUi.CannotRunHere is false); without it a built game is exported, never played here.
+    public static IReadOnlyList<LibButton> For(LibState state, bool canRunHere)
+    {
+        switch (state)
+        {
+            case LibState.CloudOnly: return new[] { new LibButton(LibAct.Download, "Download", true, "icloud.and.arrow.down", "game-download") };
+            case LibState.Downloading: return new[] { new LibButton(LibAct.CancelDownload, "Cancel", false, "xmark", "game-download-cancel") };
+            case LibState.Building: return new[] { new LibButton(LibAct.Watch, "Watch the build", false, "list.bullet.rectangle", "game-watch") };
+            case LibState.Paused: return new[] { new LibButton(LibAct.Resume, "Resume", true, "play.fill", "game-resume") };
+            case LibState.NotBuilt: return new[] { new LibButton(LibAct.Build, "Build", true, "hammer.fill", "game-build") };
+            default:
+                return canRunHere
+                    ? new[] { new LibButton(LibAct.Play, "Play", true, "play.fill", "game-play"), new LibButton(LibAct.ExportIpa, "Export IPA", false, "square.and.arrow.up", "game-export") }
+                    : new[] { new LibButton(LibAct.ExportIpa, "Export IPA", true, "square.and.arrow.up", "game-export") };
+        }
+    }
+
+    /// The get-task-allow line shows under the carousel's buttons for a built game only.
+    public static bool ShowsNote(LibState state, bool canRunHere) => state == LibState.Built && !canRunHere;
+
+    /// While a build or a boot has the phone (UiFacts.Running) every button is off, except the two that act on what is going on.
+    public static bool Enabled(LibAct act, bool busy) => !busy || act == LibAct.Watch || act == LibAct.CancelDownload;
+}
