+
+    private TileRef Tile(string title, string id, Action tap)
+    {
+        var b = new UIButton(UIButtonType.Custom) { BackgroundColor = Look.Surface, AccessibilityIdentifier = id };
+        b.Layer.CornerRadius = 16;
+        b.Layer.BorderWidth = 1;
+        b.Layer.BorderColor = Look.Line.CGColor;
+        var head = Theme.Label(title.ToUpperInvariant(), Theme.Font(11, UIFontWeight.Semibold), Theme.Muted);
+        var value = Theme.Label("—", Theme.Font(17, UIFontWeight.Semibold), Theme.Text, 2);
+        value.AdjustsFontSizeToFitWidth = true;
+        value.MinimumScaleFactor = 0.75f;
+        var note = Theme.Label("", Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 3);
+        var col = Theme.Column(0, head, value, note);
+        col.SetCustomSpacing(6, head);
+        col.UserInteractionEnabled = false;
+        col.TranslatesAutoresizingMaskIntoConstraints = false;
+        b.AddSubview(col);
+        NSLayoutConstraint.ActivateConstraints(new[]
+        {
+            col.TopAnchor.ConstraintEqualTo(b.TopAnchor, 14), col.BottomAnchor.ConstraintLessThanOrEqualTo(b.BottomAnchor, -14),
+            col.LeadingAnchor.ConstraintEqualTo(b.LeadingAnchor, 14), col.TrailingAnchor.ConstraintEqualTo(b.TrailingAnchor, -14),
+            b.HeightAnchor.ConstraintGreaterThanOrEqualTo(96),
+        });
+        b.TouchUpInside += (_, __) => tap();
+        return new TileRef { Button = b, Value = value, Note = note };
+    }
+
+    private UIView SettingsTiles()
+    {
+        tileKeys = Tile("Keys", "settings-keys", () => { if (GatherFacts().HasKeys) ShowTab(2); else Import(); });
+        tileCert = Tile("Certificate", "settings-certificate", () => { if (GameAppMain.IdentityState().Holding == 1) ShowTab(2); else ImportCertificate(); });
+        tileMemory = Tile("Extended memory", "settings-memory", () => ShowTab(2));
+        tileAddress = Tile("Extended address", "settings-address", () => ShowTab(2));
+        navRows[2] = tileCert.Button;
+        UIStackView Pair(UIView a, UIView b) => new UIStackView(new[] { a, b }) { Axis = UILayoutConstraintAxis.Horizontal, Distribution = UIStackViewDistribution.FillEqually, Alignment = UIStackViewAlignment.Fill, Spacing = 12 };
+        return Theme.Column(12, Pair(tileKeys.Button, tileCert.Button), Pair(tileMemory.Button, tileAddress.Button));
+    }
+
+    private static void ReadProvisionOnce()
+    {
+        if (provisionRead) return;
+        provisionRead = true;
+        try
+        {
+            var path = Path.Combine(NSBundle.MainBundle.BundlePath, "embedded.mobileprovision");
+            if (File.Exists(path) && new FileInfo(path).Length < (1 << 20)) provision = ProvisionText.Parse(System.Text.Encoding.Latin1.GetString(File.ReadAllBytes(path)));   // a small file of the bundle
+            altKeys = NSBundle.MainBundle.ObjectForInfoDictionary("ALTBundleIdentifier") != null;
+        }
+        catch (Exception) { provision = null; }
+    }
+
+    private static double LargestHoleGiB()
+    {
+        try { gameapp_address_space(out _, out long largest); return largest / 1073741824.0; }
+        catch (Exception) { return -1; }
+    }
+
+    private static readonly Dictionary<string, double> needCache = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
+
+    /// What the game asks of the address space: its table's mem_reserve (the bundle's dm/games/<id>/game.tsv), 0 when it has no table.
+    private static double NeedGiB(string game)
+    {
+        var tid = GameAppUi.BaseTitleIdOf(game ?? "");
+        if (tid == null) return 0;
+        if (needCache.TryGetValue(tid, out var known)) return known;
+        double need = 0;
+        try
+        {
+            var path = Path.Combine(NSBundle.MainBundle.BundlePath, "dm", "games", tid.ToUpperInvariant(), "game.tsv");
+            if (File.Exists(path)) need = DeviceTiles.ReserveGiB(File.ReadAllText(path));
+        }
+        catch (Exception) { need = 0; }
+        needCache[tid] = need;
+        return need;
+    }
+
+    private void RefreshSettingsTiles(UiFacts facts)
+    {
+        if (tileKeys == null) return;
+        void Set(TileRef t, string value, UIColor tone, string note) { t.Value.Text = value; t.Value.TextColor = tone ?? Theme.Text; t.Note.Text = note; t.Button.AccessibilityLabel = $"{t.Button.AccessibilityIdentifier?.Replace("settings-", "")}: {value}. {note}"; }
+        Set(tileKeys, facts.HasKeys ? "Imported" : "Missing", facts.HasKeys ? Theme.Ok : Theme.Error, facts.HasKeys ? "prod.keys, this " + GameAppUi.DeviceName + " only" : "Tap to import your prod.keys");
+        ReadProvisionOnce();
+        int gta = -1;
+        try { gta = gameapp_get_task_allow(); } catch (Exception) { gta = -1; }
+        var note = ProvisionText.Note(gta == 1 ? 1 : gta == 0 ? 0 : -1, ProvisionText.Installer(provision, altKeys));
+        if (facts.IdentityState == 1)
+        {
+            var left = ProvisionText.TimeLeft(provision?.Expires, DateTime.UtcNow);
+            bool expired = left == "Expired", soon = left == "Less than a day left" || left == "1 day left";
+            Set(tileCert, left == "—" ? "In the Keychain" : left, expired ? Theme.Error : soon ? Theme.Warn : Theme.Text, note);
+        }
+        else Set(tileCert, "Missing", Theme.Error, "Tap to import your .p12 · " + note);
+        if (launchCeilingMiB == -2) launchCeilingMiB = facts.AvailableMiB;   // the ceiling at launch (the first refresh), the figure the launch log gives
+        var memory = DeviceTiles.Memory(facts.IncreasedMemory, launchCeilingMiB);
+        Set(tileMemory, memory.Value, memory.Good ? Theme.Ok : null, "What iOS lets a game use");
+        var game = selected != null && !IsCloudOnly(selected) ? selected : facts.FrameworkGame;
+        double largest = LargestHoleGiB(), need = NeedGiB(game);
+        var address = DeviceTiles.Address(facts.ExtendedAddressing, largest, need);
+        Set(tileAddress, address.Value, address.Good ? Theme.Ok : facts.ExtendedAddressing == 0 ? Theme.Warn : null, DeviceTiles.AddressNote(game == null ? null : GameAppUi.DisplayName(game), need, largest));
+    }
