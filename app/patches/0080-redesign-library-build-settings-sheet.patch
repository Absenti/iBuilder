+/// A download the person cancels: the flag the copy loop and the NAS stream look at (they run on a worker thread).
+public sealed class CancelFlags
+{
+    private readonly HashSet<string> wanted = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+    private readonly object gate = new object();
+
+    public void Request(string key) { if (key == null) return; lock (gate) wanted.Add(key); }
+    public bool IsRequested(string key) { if (key == null) return false; lock (gate) return wanted.Contains(key); }
+    public void Clear(string key) { if (key == null) return; lock (gate) wanted.Remove(key); }
+}
+
+/// The output stream of a NAS download: every write first asks whether the person cancelled it, and stops the download by throwing (Nas.Download removes the .part).
+public sealed class CancelWriteStream : Stream
+{
+    private readonly Stream inner;
+    private readonly Func<bool> cancelled;
+
+    public CancelWriteStream(Stream inner, Func<bool> cancelled) { this.inner = inner; this.cancelled = cancelled; }
+
+    private void Ask() { if (cancelled != null && cancelled()) throw new OperationCanceledException("the download was cancelled"); }
+
+    public override bool CanRead => false;
+    public override bool CanSeek => inner.CanSeek;
+    public override bool CanWrite => true;
+    public override long Length => inner.Length;
+    public override long Position { get => inner.Position; set => inner.Position = value; }
+    public override void Flush() => inner.Flush();
+    public override int Read(byte[] buffer, int offset, int count) => throw new NotSupportedException();
+    public override long Seek(long offset, SeekOrigin origin) => inner.Seek(offset, origin);
+    public override void SetLength(long value) => inner.SetLength(value);
+    public override void Write(byte[] buffer, int offset, int count) { Ask(); inner.Write(buffer, offset, count); }
+    public override void Write(ReadOnlySpan<byte> buffer) { Ask(); inner.Write(buffer); }
+    protected override void Dispose(bool disposing) { if (disposing) inner.Dispose(); base.Dispose(disposing); }
+}
