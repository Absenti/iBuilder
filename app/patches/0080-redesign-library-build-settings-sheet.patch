+/// The owner's rule (2026-11-21): a build ends on "Ready" and never starts the game by itself; Play is the only way a game starts.
+public static class NoAutorun
+{
+    /// The config line the app writes for every run, whatever GAMEAPP_BOOT_AFTER_BUILD says (the chain's stage 5 after a build starts only with boot_after_build=1: crates/ibuilder-pipeline
+    /// boot.rs boot_after_build; with 0 it logs "stage 5 not started ... it starts when you tap Play" and clears the running marker).
+    public const string ConfigLine = "boot_after_build=0";
+
+    /// The words the two Play paths write into Documents/gameapp.boot-only when the game must start in a fresh process: "Close and play" (Play right after a build in this process) and
+    /// "GameApp starts again" (Play after a run already came back in this process). Only these are a Play the next launch carries out.
+    public const string PlayAfterBuild = "(the player tapped Play after a build)";
+    public const string PlayAfterRun = "(a run already came back in the last one)";
+
+    public static bool WrittenByPlay(string request) =>
+        request != null && (request.Contains(PlayAfterBuild, StringComparison.Ordinal) || request.Contains(PlayAfterRun, StringComparison.Ordinal));
+
+    /// What a launch does with Documents/gameapp.boot-only: start it (an ARMED request a Play wrote: the second half of that Play), leave it (ATTEMPTED: a boot began from it and never
+    /// came back; a tap boots again, as before), or withdraw it (ARMED but not written by a Play: the chain's own request after a build, which only boot_after_build=1 wrote, or a Play
+    /// whose process died before the boot: the game stays Ready and Play starts it).
+    public enum LaunchBoot { Start, Leave, Withdraw }
+
+    public static LaunchBoot AtLaunch(BootRequestState state, string request) =>
+        state == BootRequestState.Armed ? (WrittenByPlay(request) ? LaunchBoot.Start : LaunchBoot.Withdraw) : LaunchBoot.Leave;
+
+    /// The build screen's main button. While a build runs it closes the screen ("Close"; it said "Play when it is done", which read as a promise to start the game by itself).
+    public static string BuildScreenPrimary(bool running, bool paused, bool failed, string gameAction) =>
+        running ? "Close" : paused ? "Resume" : failed ? "See what stopped it" : string.IsNullOrEmpty(gameAction) ? "Close" : gameAction;
+
+    /// The steps a BUILD shows: GameAppUi.BuildSteps' six without "Launch" (a build ends on Ready; the launch is Play's).
+    public static List<GameAppUi.BuildStep> BuildRows(IEnumerable<GameAppUi.BuildStep> steps) =>
+        (steps ?? Enumerable.Empty<GameAppUi.BuildStep>()).Where(s => s.Name != "Launch").ToList();
