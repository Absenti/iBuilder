+/// The library shows the games of this iPhone and, after them, the games only in a cloud source: each game once.
+public static class LibraryMerge
+{
+    /// The cloud games to show after `localGames`: the base games of Cloud.CloudOnlyGames (already: not a local NAME, updates and DLC ride with their game) that no local game already
+    /// stands for by its base title id (a game here as "X [id].nsp" and in the cloud as "X [id][v0].nsz" shows once: the local one), and each title id once (the first source wins, as
+    /// CloudOnlyGames keeps the first of a name). A name with no title id is told apart by its name only.
+    /// `hidden`: the cloud games the person hid from the library ("Hide from the library"; they stay on the Cloud page and come back once on this iPhone).
+    public static List<CloudFile> CloudShown(IEnumerable<string> localGames, IEnumerable<CloudFile> cloudOnly, IEnumerable<string> hidden = null)
+    {
+        var hide = new HashSet<string>(hidden ?? Enumerable.Empty<string>(), StringComparer.OrdinalIgnoreCase);
+        var localNames = new HashSet<string>(localGames ?? Enumerable.Empty<string>(), StringComparer.OrdinalIgnoreCase);
+        var ids = new HashSet<string>(localNames.Select(GameAppUi.BaseTitleIdOf).Where(id => id != null), StringComparer.OrdinalIgnoreCase);
+        var shown = new List<CloudFile>();
+        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var f in cloudOnly ?? Enumerable.Empty<CloudFile>())
+        {
+            if (f == null || localNames.Contains(f.Name) || hide.Contains(f.Name) || !names.Add(f.Name)) continue;
+            var id = GameAppUi.BaseTitleIdOf(f.Name);
+            if (id != null && !ids.Add(id)) continue;
+            shown.Add(f);
+        }
+        return shown;
+    }
+}
