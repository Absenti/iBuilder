+/// What the app reads of its own embedded.mobileprovision (the plist the installer signed it with), for the Certificate tile: when it expires, its names, get-task-allow.
+public sealed record Provision(DateTime? Expires, string Name, string TeamName, bool? GetTaskAllow);
+
+public static class ProvisionText
+{
+    private static string After(string text, string key, string tag)
+    {
+        var m = Regex.Match(text, "<key>" + Regex.Escape(key) + @"</key>\s*<" + tag + ">([^<]*)</" + tag + ">");
+        return m.Success ? m.Groups[1].Value.Trim() : null;
+    }
+
+    /// The XML plist inside the CMS envelope (the file is DER with the plist as its content, in clear). Null when there is none (a simulator, a damaged file).
+    public static Provision Parse(string text)
+    {
+        if (string.IsNullOrEmpty(text)) return null;
+        int start = text.IndexOf("<?xml", StringComparison.Ordinal), end = text.IndexOf("</plist>", StringComparison.Ordinal);
+        if (start < 0 || end < start) return null;
+        var plist = text.Substring(start, end - start);
+        DateTime? expires = null;
+        var date = After(plist, "ExpirationDate", "date");
+        if (date != null && DateTime.TryParse(date, CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal, out var d)) expires = d;
+        bool? gta = null;
+        var g = Regex.Match(plist, @"<key>get-task-allow</key>\s*<(true|false)\s*/>");
+        if (g.Success) gta = g.Groups[1].Value == "true";
+        return new Provision(expires, After(plist, "Name", "string"), After(plist, "TeamName", "string"), gta);
+    }
+
+    /// "6 days left", "1 day left", "Less than a day left", "Expired", "—" when the date is not known.
+    public static string TimeLeft(DateTime? expiresUtc, DateTime nowUtc)
+    {
+        if (expiresUtc == null) return "—";
+        var left = expiresUtc.Value - nowUtc;
+        if (left <= TimeSpan.Zero) return "Expired";
+        int days = (int) Math.Floor(left.TotalDays);
+        return days == 0 ? "Less than a day left" : days == 1 ? "1 day left" : $"{days} days left";
+    }
+
+    private static readonly string[] Installers = { "SideStore", "AltStore", "FlareStore", "Sideloadly", "ESign", "Feather", "Scarlet", "TrollStore" };
+
+    /// The installer, when the profile's name says it, else "SideStore or AltStore" when the installed bundle carries their ALT keys, else null (not known: the tile says the type alone).
+    public static string Installer(Provision p, bool altKeys)
+    {
+        foreach (var n in new[] { p?.Name, p?.TeamName })
+            if (n != null)
+                foreach (var i in Installers)
+                    if (n.IndexOf(i, StringComparison.OrdinalIgnoreCase) >= 0) return i;
+        return altKeys ? "SideStore or AltStore" : null;
+    }
+
+    /// The tile's second line: "Development · SideStore · can play here", "Distribution · FlareStore · export only". `getTaskAllow`: the app's own signature (gameapp_get_task_allow,
+    /// the value GameAppUi.CannotRunHere reads): 1 development, 0 distribution, -1 unknown.
+    public static string Note(int getTaskAllow, string installer)
+    {
+        var who = string.IsNullOrEmpty(installer) ? "" : " · " + installer;
+        return getTaskAllow == 1 ? "Development" + who + " · can play here"
+             : getTaskAllow == 0 ? "Distribution" + who + " · export only"
+             : "Type not known" + who;
+    }
+}
+
+/// The two Settings tiles about the phone: what iOS lets a game use (the os_proc_available_memory ceiling at launch, with the increased-memory-limit entitlement) and the largest free
+/// hole of the address space (gameapp_address_space, measured by the app) against what the game asks for (its table's mem_reserve).
+public static class DeviceTiles
+{
+    private static string Gb(double gib) => gib >= 10 ? gib.ToString("0", CultureInfo.InvariantCulture) : gib.ToString("0.0", CultureInfo.InvariantCulture);
+
+    /// "On · 6.5 GB" (entitlement in effect), "Off · 3.3 GB", "—". `ceilingMiB` < 0: not known.
+    public static (string Value, bool Good) Memory(int increased, long ceilingMiB)
+    {
+        var size = ceilingMiB > 0 ? " · " + Gb(ceilingMiB / 1024.0) + " GB" : "";
+        return increased == 1 ? ("On" + size, true) : increased == 0 ? ("Off" + size, false) : (ceilingMiB > 0 ? Gb(ceilingMiB / 1024.0) + " GB" : "—", false);
+    }
+
+    /// "64 GB" (the largest hole), good when Extended Virtual Addressing is in the signature and the hole is at least what the game needs.
+    public static (string Value, bool Good) Address(int extended, double largestGiB, double needGiB)
+    {
+        if (largestGiB <= 0) return ("—", false);
+        return (Gb(largestGiB) + " GB", extended == 1 && (needGiB <= 0 || largestGiB >= needGiB));
+    }
+
+    /// "In one hole · Ocarina of Time needs 16.5", "In one hole · Ocarina of Time needs 16.5: not enough", "In one hole".
+    public static string AddressNote(string game, double needGiB, double largestGiB)
+    {
+        if (needGiB <= 0 || string.IsNullOrEmpty(game)) return "In one hole";
+        var need = needGiB.ToString("0.#", CultureInfo.InvariantCulture);
+        return $"In one hole · {game} needs {need}" + (largestGiB > 0 && largestGiB < needGiB ? ": not enough" : "");
+    }
+
+    /// The game table's mem_reserve (dm/games/<id>/game.tsv: "mem_reserve<TAB>0x420000000"), in GiB; 0 when there is none.
+    public static double ReserveGiB(string gameTsv)
+    {
+        if (gameTsv == null) return 0;
+        foreach (var raw in gameTsv.Split('\n'))
+        {
+            var c = raw.Trim().Split('\t', ' ');
+            if (c.Length < 2 || c[0] != "mem_reserve") continue;
+            var v = c.Last(x => x.Length > 0);
+            long bytes;
+            if (v.StartsWith("0x", StringComparison.OrdinalIgnoreCase) ? long.TryParse(v.Substring(2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out bytes)
+                                                                       : long.TryParse(v, NumberStyles.None, CultureInfo.InvariantCulture, out bytes))
+                return bytes / 1073741824.0;
+        }
+        return 0;
+    }
+
+    /// "56 GB free of 235 GB".
+    public static string StorageHeadline(long free, long total) =>
+        total > 0 ? $"{GameAppUi.SizeText(free)} free of {GameAppUi.SizeText(total)}" : $"{GameAppUi.SizeText(free)} free";
+}
+
+/// The Build tab's card: the stages with their times, the shader count, the note.
+public static class BuildCardText
+{
+    /// The design's names of GameAppUi.StepNames' first five (the sixth, "Launch", is not a build's: NoAutorun.BuildRows).
+    public static readonly string[] StageLabels = { "Extract", "Profile", "Rewrite", "Translate shaders", "Assemble and sign" };
+
+    public static string Label(string stepName)
+    {
+        int i = Array.IndexOf(GameAppUi.StepNames, stepName);
+        return i >= 0 && i < StageLabels.Length ? StageLabels[i] : stepName;
+    }
+
+    private static readonly Regex Shaders = new Regex(@"\((\d+)/(\d+) shaders\)");
+
+    /// "Shaders 15,383 of 42,848 · 36 %" while the shaders are translated, else "<stage> · 12 %"; "Starting" before the first stage line.
+    public static string Line(string stageLine)
+    {
+        var s = GameAppUi.ParseStage(stageLine);
+        if (!s.Valid) return "Starting";
+        string pct = Math.Round(s.Fraction * 100).ToString("0", CultureInfo.InvariantCulture) + " %";
+        var m = Shaders.Match(s.Text);
+        if (m.Success && long.TryParse(m.Groups[1].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var done) && long.TryParse(m.Groups[2].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var total))
+            return string.Format(CultureInfo.InvariantCulture, "Shaders {0:N0} of {1:N0} · {2}", done, total, pct);
+        var step = s.Of == 5 && s.Step >= 0 && s.Step < StageLabels.Length ? StageLabels[s.Step] : "Building";
+        return step + " · " + pct;
+    }
+
+    /// The card's note: the build goes on in the background, what happens to the game file (0073's "Optimize storage"), and that it ends on Ready.
+    public static string Note(bool optimizeStorage) =>
+        "The build continues if you leave the app. " + (optimizeStorage ? "Optimize storage is on: once the game is extracted, its file is removed to free space. " : "")
+        + "It ends on Ready: Play starts the game.";
+}
