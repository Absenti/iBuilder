+/// The library's hidden cloud games, as kept (one name a line).
+public static class HiddenGames
+{
+    public static List<string> Parse(string text) =>
+        (text ?? "").Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
+
+    public static string With(string text, string name) => string.Join("\n", Parse(text).Append(name).Distinct(StringComparer.OrdinalIgnoreCase));
+
+    /// A hidden game that is on this iPhone now is forgotten (it shows as the local game anyway; hidden again only by asking again).
+    public static string Without(string text, IEnumerable<string> local)
+    {
+        var here = new HashSet<string>(local ?? Enumerable.Empty<string>(), StringComparer.OrdinalIgnoreCase);
+        return string.Join("\n", Parse(text).Where(n => !here.Contains(n)));
+    }
+}
