+    /// The focused game's words, dots, buttons and the ground's glow.
+    private void RefreshFlowFocus()
+    {
+        if (flow == null || libFacts == null) return;
+        var facts = libFacts;
+        int fi = flow.Focus;
+        foreach (var v in flowDots.ArrangedSubviews.ToArray()) { flowDots.RemoveArrangedSubview(v); v.RemoveFromSuperview(); }
+        foreach (var v in flowButtons.ArrangedSubviews.ToArray()) { flowButtons.RemoveArrangedSubview(v); v.RemoveFromSuperview(); }
+        if (fi < 0 || fi >= libShown.Count) { flowTitle.Text = flowMeta.Text = ""; flowNote.Hidden = true; ambient.SetHue(-1, true); return; }
+        var e = libShown[fi];
+        var state = LibStateOf(e, facts, out _);
+        bool canRun = CanRunHere(facts);
+        flowTitle.Text = GameAppUi.DisplayName(e.Name);
+        long size = e.Cloud != null && (state == LibState.CloudOnly || state == LibState.Downloading) ? e.Cloud.Size : 0;
+        var sizeText = size > 0 ? GameAppUi.SizeText(size) : ShelfMeta(e);
+        flowMeta.Text = LibraryStatus.Meta(state, e.Name, sizeText, CloudWords(e.Cloud).Long, canRun, GameAppUi.DeviceName);
+        int shown = Math.Min(libShown.Count, 15);
+        int first = Math.Max(0, Math.Min(fi - shown / 2, libShown.Count - shown));
+        for (int i = first; i < first + shown; i++)
+        {
+            var dot = new UIView { BackgroundColor = i == fi ? Theme.Text : UIColor.FromWhiteAlpha(1f, 0.3f), UserInteractionEnabled = false };
+            dot.Layer.CornerRadius = 3;
+            dot.WidthAnchor.ConstraintEqualTo(i == fi ? 22 : 6).Active = true;
+            dot.HeightAnchor.ConstraintEqualTo(6).Active = true;
+            flowDots.AddArrangedSubview(dot);
+        }
+        flowDots.AccessibilityLabel = $"Game {fi + 1} of {libShown.Count}";
+
+        var settings = Look.RoundIcon("slider.horizontal.3", "Settings of this game", 54);
+        settings.AccessibilityIdentifier = "library-game-settings";
+        settings.TouchUpInside += (_, __) => ShowGameSheet(e);
+        flowButtons.AddArrangedSubview(settings);
+        bool grey = state == LibState.CloudOnly || state == LibState.Downloading;
+        var accent = Look.AccentOf(e.Icon, grey);
+        foreach (var b in LibraryActions.For(state, canRun))
+        {
+            var button = Look.Capsule(state == LibState.Built && b.Act == LibAct.Play && running && launchingGame == e.Name ? "Starting…" : b.Label, b.Symbol, b.Primary, accent, 54, b.Primary ? 16 : 15);
+            button.AccessibilityIdentifier = b.Id;
+            button.Enabled = LibraryActions.Enabled(b.Act, facts.Running);
+            var act = b.Act;
+            button.TouchUpInside += (_, __) => RunLibAct(act, e);
+            flowButtons.AddArrangedSubview(button);
+        }
+        flowNote.Hidden = !LibraryActions.ShowsNote(state, canRun);
+        // the ground's glow: the dominant hue of the cover in focus (a fixed amber when it has none)
+        ambient.SetHue(e.Icon != null ? Look.HueOf(e.Icon) : -1, true);
+        currentTint = accent;
+    }
