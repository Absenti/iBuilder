+        if (firstRow != null) UIAccessibility.PostNotification(UIAccessibilityPostNotification.ScreenChanged, firstRow);
+    }
+
+    public void Close(Action then)
+    {
+        if (closing) return;
+        closing = true;
+        UIView.Animate(0.15, () => Alpha = 0, () =>
