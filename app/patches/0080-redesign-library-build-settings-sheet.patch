+/// The ambient glow: the hue that dominates the focused game's cover (a fixed amber when it has none, or no colour), and the colours made from it.
+public static class CoverHue
+{
+    /// The accent's hue (#efb15a): the glow of a game with no cover.
+    public const double FallbackHue = 35;
+
+    public static (double H, double S, double V) ToHsv(double r, double g, double b)
+    {
+        double max = Math.Max(r, Math.Max(g, b)), min = Math.Min(r, Math.Min(g, b)), d = max - min;
+        double h = 0;
+        if (d > 1e-9)
+        {
+            if (max == r) h = 60 * (((g - b) / d) % 6);
+            else if (max == g) h = 60 * ((b - r) / d + 2);
+            else h = 60 * ((r - g) / d + 4);
+        }
+        if (h < 0) h += 360;
+        return (h, max <= 0 ? 0 : d / max, max);
+    }
+
+    public static (double R, double G, double B) FromHsv(double h, double s, double v)
+    {
+        h = ((h % 360) + 360) % 360;
+        double c = v * s, x = c * (1 - Math.Abs((h / 60) % 2 - 1)), m = v - c;
+        (double r, double g, double b) = h < 60 ? (c, x, 0.0) : h < 120 ? (x, c, 0.0) : h < 180 ? (0.0, c, x) : h < 240 ? (0.0, x, c) : h < 300 ? (x, 0.0, c) : (c, 0.0, x);
+        return (r + m, g + m, b + m);
+    }
+
+    /// The dominant hue of `pixels` RGBA pixels (8 bits each; a transparent pixel counts for nothing): a 36-bucket histogram of the hues weighted by saturation × value, so a cover's
+    /// colourful part wins over its grey or dark background; the bucket's own mean hue. -1 when the picture has no colour (grey, black, white, empty).
+    public static double Dominant(byte[] rgba, int pixels)
+    {
+        if (rgba == null || pixels <= 0) return -1;
+        pixels = Math.Min(pixels, rgba.Length / 4);
+        var weight = new double[36];
+        var sumX = new double[36];
+        var sumY = new double[36];
+        double total = 0;
+        for (int i = 0; i < pixels; i++)
+        {
+            int a = rgba[i * 4 + 3];
+            if (a < 16) continue;
+            var (h, s, v) = ToHsv(rgba[i * 4] / 255.0, rgba[i * 4 + 1] / 255.0, rgba[i * 4 + 2] / 255.0);
+            if (s < 0.12 || v < 0.12) continue;
+            double w = s * v * (a / 255.0);
+            int bucket = Math.Min(35, (int) (h / 10));
+            weight[bucket] += w;
+            sumX[bucket] += w * Math.Cos(h * Math.PI / 180);
+            sumY[bucket] += w * Math.Sin(h * Math.PI / 180);
+            total += w;
+        }
+        if (total < pixels * 0.01) return -1;   // almost nothing has colour: the picture is grey
+        int best = 0;
+        for (int k = 1; k < 36; k++) if (weight[k] > weight[best]) best = k;
+        var mean = Math.Atan2(sumY[best], sumX[best]) * 180 / Math.PI;
+        return mean < 0 ? mean + 360 : mean;
+    }
+
+    public static double OrFallback(double hue) => hue < 0 ? FallbackHue : hue;
+
+    /// The glow's centre and middle colours (the ground #0e0e12 is its edge): a deep, then a darker, shade of the hue.
+    public static ((double R, double G, double B) Centre, (double R, double G, double B) Middle) Glow(double hue) =>
+        (FromHsv(OrFallback(hue), 0.62, 0.38), FromHsv(OrFallback(hue), 0.55, 0.17));
+
+    /// The game's own accent (its primary button, black text on it): a light shade of the hue.
+    public static (double R, double G, double B) Accent(double hue) => FromHsv(OrFallback(hue), 0.40, 0.95);
+}
