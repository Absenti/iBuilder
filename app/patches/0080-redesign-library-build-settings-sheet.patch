+/// The words of a game's state: the cover's pill, the grid card's line, the carousel's meta line.
+public static class LibraryStatus
+{
+    public enum Tone { Good, Accent, Cloud, Warn }
+
+    /// "On the NAS", "In iCloud", "In Google Drive": the source a cloud game is in.
+    public static string CloudWhere(bool nas, string provider) =>
+        nas ? "On the NAS" : provider == "iCloud Drive" ? "In iCloud" : "In " + (string.IsNullOrEmpty(provider) ? "the cloud" : provider);
+
+    /// The longer name for the meta line: "the NAS", "iCloud Drive".
+    public static string CloudLong(bool nas, string provider) => nas ? "On the NAS" : "In " + (string.IsNullOrEmpty(provider) ? "the cloud" : provider);
+
+    public static (string Text, Tone Tone) Of(LibState state, double? fraction, string cloudWhere, bool update, string pausedChip)
+    {
+        string Pct(double? f) => Math.Round(Math.Max(0, Math.Min(1, f ?? 0)) * 100).ToString("0", CultureInfo.InvariantCulture);
+        switch (state)
+        {
+            case LibState.CloudOnly: return (cloudWhere ?? "In the cloud", Tone.Cloud);
+            case LibState.Downloading: return ($"Downloading {Pct(fraction)} %", Tone.Cloud);
+            case LibState.Building: return ($"Building {Pct(fraction)} %", Tone.Accent);
+            case LibState.Paused: return (string.IsNullOrEmpty(pausedChip) ? "Paused" : pausedChip, Tone.Warn);
+            case LibState.NotBuilt: return ("Not built", Tone.Accent);
+            default: return update ? ("Update available", Tone.Accent) : ("Ready", Tone.Good);
+        }
+    }
+
+    /// "Switch · .nsp", "Switch 2 · .nup".
+    public static string KindText(string fileName) =>
+        GameAppUi.IsNup(fileName) ? "Switch 2 · .nup" : "Switch · " + Path.GetExtension(fileName ?? "").ToLowerInvariant();
+
+    /// The carousel's line under the title.
+    public static string Meta(LibState state, string fileName, string size, string cloudLong, bool canRunHere, string device)
+    {
+        var parts = new List<string>();
+        bool cloud = state == LibState.CloudOnly || state == LibState.Downloading;
+        parts.Add(cloud ? cloudLong ?? "In the cloud" : KindText(fileName));
+        if (!string.IsNullOrEmpty(size)) parts.Add(size);
+        parts.Add(state switch
+        {
+            LibState.CloudOnly => "not on this " + device + " yet",
+            LibState.Downloading => "downloading",
+            LibState.Building => "building",
+            LibState.Paused => "build paused",
+            LibState.NotBuilt => "on this " + device + ", not built",
+            _ => canRunHere ? "ready to play" : "ready to export",
+        });
+        return string.Join(" · ", parts);
+    }
+
+    /// The header's line: "4 games · 32.7 GB · 56 GB free" (the size is the game files on this iPhone).
+    public static string Summary(int games, string localSize, string free) =>
+        $"{games} game{(games == 1 ? "" : "s")}" + (string.IsNullOrEmpty(localSize) ? "" : " · " + localSize) + " · " + free + " free";
+}
