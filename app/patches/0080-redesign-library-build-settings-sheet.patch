+    /// A card of the grid: cover, name, status (and the shader preparation's strip, 0070 / 0076), then its buttons one under the other, the card's full width (Play above Export IPA).
+    private UIView GridCard(LibraryEntry e, int index, int count, UiFacts facts)
+    {
+        var state = LibStateOf(e, facts, out var fraction);
+        var status = StatusOf(e, state, fraction, facts);
+        bool grey = state == LibState.CloudOnly || state == LibState.Downloading;
+        var display = GameAppUi.DisplayName(e.Name);
+
+        var open = new UIControl { AccessibilityIdentifier = "game-tile", IsAccessibilityElement = true, AccessibilityTraits = UIAccessibilityTrait.Button };
+        open.AccessibilityLabel = display + ", " + status.Text;
+        open.AccessibilityHint = "Touch and hold for actions";
+        var art = new UIView { BackgroundColor = Look.Raised, ClipsToBounds = true, UserInteractionEnabled = false };
+        art.Layer.CornerRadius = 10;
+        art.Layer.CornerCurve = CACornerCurve.Continuous;
+        art.HeightAnchor.ConstraintEqualTo(110).Active = true;
+        if (e.Icon != null)
+        {
+            var image = new UIImageView(grey ? Look.Grey(e.Icon) : e.Icon) { ContentMode = UIViewContentMode.ScaleAspectFill, ClipsToBounds = true, Alpha = grey ? 0.8f : 1f };
+            image.TranslatesAutoresizingMaskIntoConstraints = false;
+            art.AddSubview(image);
+            NSLayoutConstraint.ActivateConstraints(new[]
+            {
+                image.TopAnchor.ConstraintEqualTo(art.TopAnchor), image.BottomAnchor.ConstraintEqualTo(art.BottomAnchor),
+                image.LeadingAnchor.ConstraintEqualTo(art.LeadingAnchor), image.TrailingAnchor.ConstraintEqualTo(art.TrailingAnchor),
+            });
+        }
+        else
+        {
+            var initial = Theme.Label(Theme.Initials(display), Theme.Font(40, UIFontWeight.Heavy), UIColor.FromWhiteAlpha(1f, 0.85f));
+            initial.TranslatesAutoresizingMaskIntoConstraints = false;
+            art.AddSubview(initial);
+            initial.LeadingAnchor.ConstraintEqualTo(art.LeadingAnchor, 10).Active = true;
+            initial.BottomAnchor.ConstraintEqualTo(art.BottomAnchor, -4).Active = true;
+        }
+        if (grey)
+        {
+            var badge = Look.CloudBadge(28);
+            art.AddSubview(badge);
+            badge.TopAnchor.ConstraintEqualTo(art.TopAnchor, 8).Active = true;
+            badge.TrailingAnchor.ConstraintEqualTo(art.TrailingAnchor, -8).Active = true;
+        }
+        var name = Theme.Label(display, Theme.Font(14, UIFontWeight.Semibold), Theme.Text, 1);
+        name.LineBreakMode = UILineBreakMode.TailTruncation;   // one line, with an ellipsis
+        var line = Theme.Label(status.Text, Theme.Font(12, UIFontWeight.Regular), Look.ToneColor(status.Tone), 2);
+        var texts = new List<UIView> { art, name, line };
+        var info = Theme.Column(0, texts.ToArray());
+        info.SetCustomSpacing(8, art);
+        info.UserInteractionEnabled = false;
+        info.TranslatesAutoresizingMaskIntoConstraints = false;
+        open.AddSubview(info);
+        NSLayoutConstraint.ActivateConstraints(new[]
+        {
+            info.TopAnchor.ConstraintEqualTo(open.TopAnchor), info.BottomAnchor.ConstraintEqualTo(open.BottomAnchor),
+            info.LeadingAnchor.ConstraintEqualTo(open.LeadingAnchor), info.TrailingAnchor.ConstraintEqualTo(open.TrailingAnchor),
+        });
+        open.TouchUpInside += (_, __) => ShowGameSheet(e);
+
+        var parts = new List<UIView> { open };
+        if (fraction != null && (state == LibState.Downloading || state == LibState.Building)) parts.Add(Look.Bar((float) fraction.Value, Theme.Accent, 4));
+        if (WarmStrip(e.Name, false) is UIView warm) parts.Add(warm);   // GameAppWarm.cs (0070, 0076): the shaders being prepared, with its bar
+        // the actions on ONE row (the owner's third correction): the primary a pill filling the width, a second action (Export IPA beside Play) a 36 pt round icon-only button at its right
+        bool canRun = CanRunHere(facts);
+        var accent = Look.AccentOf(e.Icon, grey);
+        var acts = LibraryActions.For(state, canRun);
+        var row = new UIStackView { Axis = UILayoutConstraintAxis.Horizontal, Spacing = 6, Alignment = UIStackViewAlignment.Center };
+        for (int k = 0; k < acts.Count; k++)
+        {
+            var b = acts[k];
+            var act = b.Act;
+            UIButton button;
+            if (k == 0) button = Look.Capsule(b.Label, b.Symbol, b.Primary, accent, 36, 13);
+            else
+            {
+                button = Look.RoundIcon(b.Act == LibAct.ExportIpa ? "arrow.up" : b.Symbol, b.Label, 36, Look.Raised);
+                button.Layer.BorderWidth = 1;
+                button.Layer.BorderColor = UIColor.FromWhiteAlpha(1f, 0.12f).CGColor;
+                button.SetContentHuggingPriority(1000, UILayoutConstraintAxis.Horizontal);
+            }
+            button.AccessibilityIdentifier = b.Id;
+            button.Enabled = LibraryActions.Enabled(b.Act, facts.Running);
+            button.TouchUpInside += (_, __) => RunLibAct(act, e);
+            row.AddArrangedSubview(button);
+        }
+        var stack = Theme.Column(8, parts.ToArray());
+        stack.SetCustomSpacing(10, parts[^1]);
+        stack.AddArrangedSubview(row);
+        var card = Look.Card(stack, 10, 10);
+        card.ClipsToBounds = true;
+
+        var hold = new UILongPressGestureRecognizer(g => { if (g.State == UIGestureRecognizerState.Began) ShowHold(e, card, 16, index, count, 2); }) { MinimumPressDuration = 0.5 };
+        open.AddGestureRecognizer(hold);
+        // VoiceOver: the menu's entries are the card's own actions
+        open.AccessibilityCustomActions = HoldEntries(e, facts).Select(x => new UIAccessibilityCustomAction(x.Title, (Func<UIAccessibilityCustomAction, bool>) (a => { x.Run(); return true; }))).ToArray();
+        return card;
+    }
