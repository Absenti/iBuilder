+/// The touch-and-hold of a grid card (or of the focused cover): the card lifts where it is (a copy of it, 1.03, on the raised ground), the rest of the screen dims, and a compact menu opens
+/// anchored to it (HoldMenuLayout). A tap outside closes it. It is a layer over the screen, not a page.
+internal sealed class HoldOverlay : UIView
+{
+    public sealed record Entry(string Title, string Symbol, bool Destructive, Action Run, string Id);
+    private readonly UIView menu = new UIView();
+    private readonly Action closed;
