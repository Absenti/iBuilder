+    // ---- the capsule tab bar: the lit tab is an ink capsule with its label, the others an icon (their label for VoiceOver) ----
+
+    private void StyleTabs(int lit)
+    {
+        for (int i = 0; i < tabs.Length; i++)
+        {
+            bool on = i == lit;
+            var config = on ? UIButtonConfiguration.FilledButtonConfiguration : UIButtonConfiguration.PlainButtonConfiguration;
+            config.Image = UIImage.GetSystemImage(TabIcons[i], UIImageSymbolConfiguration.Create(UIFont.SystemFontOfSize(16, UIFontWeight.Semibold)));
+            config.ImagePadding = 7;
+            config.ContentInsets = new NSDirectionalEdgeInsets(0, 8, 0, 8);
+            config.AttributedTitle = on ? new NSAttributedString(TabTitles[i], new UIStringAttributes { Font = Theme.Font(13, UIFontWeight.Semibold) }) : null;
+            config.CornerStyle = UIButtonConfigurationCornerStyle.Capsule;
+            config.BaseBackgroundColor = Theme.Text;
+            config.BaseForegroundColor = on ? UIColor.Black : UIColor.FromWhiteAlpha(1f, 0.66f);
+            tabs[i].Configuration = config;
+            tabs[i].AccessibilityLabel = TabTitles[i];
+            tabs[i].AccessibilityTraits = on ? UIAccessibilityTrait.Button | UIAccessibilityTrait.Selected : UIAccessibilityTrait.Button;
+        }
+    }
