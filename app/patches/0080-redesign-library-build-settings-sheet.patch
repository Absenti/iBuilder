+        flow.Open = i => { if (i >= 0 && i < libShown.Count) ShowGameSheet(libShown[i]); };
+        flow.Hold = (i, cell) => { if (i >= 0 && i < libShown.Count) ShowHold(libShown[i], cell, 38, 0, 1, 1); };
