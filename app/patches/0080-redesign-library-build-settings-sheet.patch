+    /// Where a library entry stands (LibraryActions.StateOf) and its progress.
+    private LibState LibStateOf(LibraryEntry e, UiFacts facts, out double? fraction)
+    {
+        bool cloudOnly = e.Cloud != null && !File.Exists(Path.Combine(GameAppMain.Documents, e.Name));
+        bool downloading = downloads.TryGetValue(e.Name, out var d);
+        bool building = running && !string.IsNullOrEmpty(e.Name) && e.Name == selected && launchingGame == null && facts.Running;
+        fraction = downloading ? Math.Max(0.02, d) : building ? Math.Max(0.02, GameAppUi.ParseStage(lastStage).Fraction) : (double?) null;
+        bool paused = !cloudOnly && PausedOf(e.Name, facts) != null;
+        bool ready = !cloudOnly && GameAppUi.GameStatusOf(e.Name, facts) == GameAppUi.GameStatus.Ready;
+        return LibraryActions.StateOf(cloudOnly, downloading, building, paused, ready);
+    }
