+// gameapp/GameAppRedesign.cs: the pure part of the redesign of app/patches/0080 (the owner's approved prototype, 2026-11-21): which buttons a game has in each state, the
+// library's merge of the games on this iPhone with the ones only in a cloud source, where the touch-and-hold menu of a grid card opens, the cover's dominant hue for the
+// ambient glow, the rule that a finished build never starts the game by itself, the Settings tiles' words, and the game sheet's inline settings.
+//
+// No UIKit here: the host harness (target/agent-work/redesign/harness) compiles this file as it is, with GameAppUi.cs and GameAppCloud.cs. The views are GameAppRedesignUi.cs.
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
