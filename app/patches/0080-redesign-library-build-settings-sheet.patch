+    private (string Where, string Long) CloudWords(CloudFile f)
+    {
+        var s = f == null ? null : cloudSources.FirstOrDefault(x => x.Id == f.SourceId);
+        bool nas = s?.Kind == CloudKind.Nas;
+        var provider = s == null ? null : Cloud.ProviderName(s.Location);
+        return (LibraryStatus.CloudWhere(nas, provider), LibraryStatus.CloudLong(nas, provider));
+    }
