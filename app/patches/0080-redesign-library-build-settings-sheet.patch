+/// A rectangle in points (the layout math is checked on a Mac, where there is no CGRect).
+public readonly record struct Box(double X, double Y, double W, double H)
+{
+    public double Right => X + W;
+    public double Bottom => Y + H;
+}
+
+/// Where the compact menu of a touch-and-hold opens: ANCHORED to the card it belongs to, below it, or above it for the last row of the grid (or when it does not fit below), aligned to the
+/// card's column (the left column's menu starts at the card's left edge, the right column's ends at its right edge; the carousel's is centred on the cover), and never off the screen.
+public static class HoldMenuLayout
+{
+    public const double Width = 232, Gap = 8, Margin = 16;
+
+    public enum Align { Left, Right, Centre }
+
+    /// The last row of a grid of `count` cards in `columns`: its menu opens above. A grid of one row (two cards or fewer) opens below, as the prototype does.
+    public static bool IsLastRow(int index, int count, int columns = 2) =>
+        columns > 0 && count > columns && index / columns == (count - 1) / columns;
+
+    public static Align AlignOf(int index, int columns) => columns <= 1 ? Align.Centre : index % columns == columns - 1 ? Align.Right : Align.Left;
+
+    /// `card` and `visible` are in the same coordinates (the screen); `visible` is the part a menu may use (the safe area, above the tab bar).
+    public static (Box Menu, bool Above) Place(Box card, int index, int count, double menuHeight, Box visible, int columns = 2)
+    {
+        var align = AlignOf(index, columns);
+        double x = align == Align.Left ? card.X : align == Align.Right ? card.Right - Width : card.X + (card.W - Width) / 2;
+        x = Math.Max(visible.X + Margin, Math.Min(x, visible.Right - Margin - Width));
+        bool above = columns > 1 && IsLastRow(index, count, columns);
+        double below = card.Bottom + Gap, over = card.Y - Gap - menuHeight;
+        bool fitsBelow = below + menuHeight <= visible.Bottom, fitsAbove = over >= visible.Y;
+        if (!above && !fitsBelow && fitsAbove) above = true;
+        else if (above && !fitsAbove && fitsBelow) above = false;
+        double y = above ? over : below;
+        // neither fits (a very tall menu, or a card at the very edge): kept on the screen, over the card if it must
+        if (y + menuHeight > visible.Bottom) y = visible.Bottom - menuHeight;
+        if (y < visible.Y) y = visible.Y;
+        return (new Box(x, y, Width, menuHeight), above);
+    }
+}
+
+/// The entries of the touch-and-hold menu, in order (the owner, 2026-11-21: the menu follows the game's state like its buttons): the state's action (Download, Cancel the download, Build,
+/// Play with a development certificate), Export IPA for a built game, Settings, Choose a cover… (not for a game only in the cloud), then the long-press menu's items of the patches before
+/// where they apply (Update, 0076 the shader preparation's Pause / Resume and "Prepare the shaders now", 0065 the paused build's Cancel, the queue, the uploads, Remove download), and last
+/// Delete… (a game on this iPhone) or Hide from the library (a game only in the cloud).
+public enum HoldItem { Primary, Settings, ChooseCover, Export, Update, WarmToggle, WarmNow, CancelPaused, AddToQueue, Upload, RemoveDownload, Delete, Hide }
+
+public sealed record HoldFacts(LibState State, bool CanRunHere, bool Update, bool LocalFile, bool Busy, bool WarmShown, bool WarmQueued, int UploadTargets, bool HasCloudCopy);
+
+public static class HoldMenuPlan
+{
+    public static List<HoldItem> Items(HoldFacts f)
+    {
+        var items = new List<HoldItem> { HoldItem.Primary };
+        bool built = f.State == LibState.Built;
+        // a distribution certificate: the primary IS the export (Export IPA), not twice
+        if (built && f.CanRunHere && !f.Busy) items.Add(HoldItem.Export);
+        items.Add(HoldItem.Settings);
+        bool cloud = f.State == LibState.CloudOnly || f.State == LibState.Downloading;
+        if (f.LocalFile && !cloud) items.Add(HoldItem.ChooseCover);
+        if (built && f.Update && !f.Busy) items.Add(HoldItem.Update);
+        if (built && !f.Busy && f.WarmShown) items.Add(HoldItem.WarmToggle);
+        else if (built && !f.Busy && f.WarmQueued) items.Add(HoldItem.WarmNow);
+        if (f.State == LibState.Paused) items.Add(HoldItem.CancelPaused);
+        if (f.LocalFile && f.State != LibState.Building) items.Add(HoldItem.AddToQueue);
+        if (f.LocalFile && f.UploadTargets > 0) items.Add(HoldItem.Upload);
+        if (f.LocalFile && f.HasCloudCopy) items.Add(HoldItem.RemoveDownload);
+        if (f.LocalFile && !f.Busy) items.Add(HoldItem.Delete);
+        else if (!f.LocalFile && cloud) items.Add(HoldItem.Hide);
+        return items;
+    }
+
+    /// The first entry's words: the state's primary button ("Play" for a built game that can run here, "Export IPA" with a distribution certificate), "Cancel the download" while one runs.
+    public static string PrimaryLabel(LibState state, bool canRunHere)
+    {
+        var b = LibraryActions.For(state, canRunHere)[0];
+        return b.Act == LibAct.CancelDownload ? "Cancel the download" : b.Label;
+    }
+}
