+
+    private sealed class Box<T> { public T Value; }
+    private static readonly ConditionalWeakTable<UIImage, Box<double>> hues = new ConditionalWeakTable<UIImage, Box<double>>();
+    private static readonly ConditionalWeakTable<UIImage, UIImage> greys = new ConditionalWeakTable<UIImage, UIImage>();
+
+    /// The cover's dominant hue (CoverHue.Dominant over a 24 x 24 copy), -1 for none.
+    public static double HueOf(UIImage image)
+    {
+        if (image?.CGImage == null) return -1;
+        if (hues.TryGetValue(image, out var known)) return known.Value;
+        double hue = -1;
+        try
+        {
+            const int n = 24;
+            var data = new byte[n * n * 4];
+            using var space = CGColorSpace.CreateDeviceRGB();
+            using var ctx = new CGBitmapContext(data, n, n, 8, n * 4, space, CGImageAlphaInfo.PremultipliedLast);
+            ctx.InterpolationQuality = CGInterpolationQuality.Medium;
+            ctx.DrawImage(new CGRect(0, 0, n, n), image.CGImage);
+            hue = CoverHue.Dominant(data, n * n);
+        }
+        catch (Exception) { hue = -1; }
+        hues.Add(image, new Box<double> { Value = hue });
+        return hue;
+    }
+
+    /// The cover of a game only in the cloud: the same picture, without its colour and a little darker.
+    public static UIImage Grey(UIImage image)
+    {
+        if (image?.CGImage == null) return image;
+        if (greys.TryGetValue(image, out var known)) return known;
+        UIImage grey = image;
+        try
+        {
+            using var input = new CIImage(image.CGImage);
+            using var filter = new CIColorControls { InputImage = input, Saturation = 0f, Brightness = -0.08f, Contrast = 0.92f };
+            using var output = filter.OutputImage;
+            using var context = CIContext.FromOptions(null);
+            using var cg = context.CreateCGImage(output, input.Extent);
+            if (cg != null) grey = UIImage.FromImage(cg, image.CurrentScale, image.Orientation);
+        }
+        catch (Exception) { grey = image; }
+        greys.Add(image, grey);
+        return grey;
+    }
+
+    /// The game's own primary colour (light, black words on it); the accent for a game only in the cloud.
+    public static UIColor AccentOf(UIImage icon, bool grey) => grey ? Theme.Accent : Rgb(CoverHue.Accent(HueOf(icon)));
+}
