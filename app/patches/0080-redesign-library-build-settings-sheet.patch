+
+    private CoverView nowArt;
+    private UILabel nowName, nowPill, nowNote, buildIdle, nowSectionLabel;
+    private readonly List<(UILabel Mark, UILabel Name, UILabel Time)> nowStages = new List<(UILabel, UILabel, UILabel)>();
+
+    private UIView MakeNowCard()
+    {
+        nowArt = new CoverView { UserInteractionEnabled = false, TranslatesAutoresizingMaskIntoConstraints = false };
+        nowArt.WidthAnchor.ConstraintEqualTo(46).Active = true;
+        nowArt.HeightAnchor.ConstraintEqualTo(46).Active = true;
+        nowName = Theme.Label("", Theme.Font(15, UIFontWeight.Semibold), Theme.Text, 2);
+        buildNowLine = Theme.Label("", Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 0);
+        buildNowLine.AccessibilityIdentifier = "build-now-line";
+        nowPill = Theme.Label("", Theme.Font(11, UIFontWeight.Medium), Theme.Accent);
+        nowPill.TextAlignment = UITextAlignment.Center;
+        nowPill.Layer.CornerRadius = 11;
+        nowPill.ClipsToBounds = true;
+        nowPill.SetContentHuggingPriority(1000, UILayoutConstraintAxis.Horizontal);
+        nowPill.HeightAnchor.ConstraintEqualTo(22).Active = true;
+        nowPill.WidthAnchor.ConstraintGreaterThanOrEqualTo(70).Active = true;
+        var texts = Theme.Column(2, nowName, buildNowLine);
+        texts.SetContentHuggingPriority(1, UILayoutConstraintAxis.Horizontal);
+        var head = Theme.Row(12, nowArt, texts, nowPill);
+        var stages = Theme.Column(9);
+        nowStages.Clear();
+        foreach (var label in BuildCardText.StageLabels)
+        {
+            var mark = Theme.Label("", Theme.Font(11, UIFontWeight.Bold), UIColor.Black);
+            mark.TextAlignment = UITextAlignment.Center;
+            mark.Layer.CornerRadius = 9;
+            mark.ClipsToBounds = true;
+            mark.WidthAnchor.ConstraintEqualTo(18).Active = true;
+            mark.HeightAnchor.ConstraintEqualTo(18).Active = true;
+            var name = Theme.Label(label, Theme.Font(14, UIFontWeight.Regular), Theme.Text);
+            var time = Theme.Label("", Theme.Mono(12), Theme.Muted);
+            time.SetContentHuggingPriority(1000, UILayoutConstraintAxis.Horizontal);
+            var row = Theme.Row(10, mark, name, new UIView(), time);
+            row.IsAccessibilityElement = true;
+            stages.AddArrangedSubview(row);
+            nowStages.Add((mark, name, time));
+        }
+        buildNowBar = Look.Bar(0, Theme.Accent, 6);
+        BuildStopButtons();   // GameAppStopUi.cs: Pause, Resume, Cancel (their handlers are 0065's)
+        foreach (var (b, words) in new[] { (buildPause, "Pause"), (buildResume, "Resume"), (buildCancel, "Cancel") })
+        {
+            var c = UIButtonConfiguration.FilledButtonConfiguration;
+            c.AttributedTitle = new NSAttributedString(words, new UIStringAttributes { Font = Theme.Font(15, UIFontWeight.Medium) });
+            c.BaseBackgroundColor = Look.Raised;
+            c.BaseForegroundColor = b == buildCancel ? Theme.Error : Theme.Text;
+            var bg = c.Background; bg.CornerRadius = 12; c.Background = bg;
+            b.Configuration = c;
+        }
+        var watch = Look.Capsule("Watch the build", "list.bullet.rectangle", false, null, 44, 14);
+        watch.TouchUpInside += (_, __) => ShowBuildScreen();
+        buildWatch = watch;
+        nowNote = Theme.Label("", Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 0);
+        var column = Theme.Column(14, head, stages, buildNowBar, buildStopRow, watch, nowNote);
+        column.SetCustomSpacing(10, buildStopRow);
+        buildNowCard = Look.Card(column, 16, 16);
+        buildNowCard.AccessibilityIdentifier = "build-now-card";
+        buildNowCard.Hidden = true;
+        return buildNowCard;
+    }
+
+    /// After UpdateNowCard (GameAppStopUi.cs, which decides what the card is about and its buttons): the design's words, pill, stages and times.
+    private void UpdateNowCardLook(UiFacts facts)
+    {
+        if (nowName == null || buildNowCard == null) return;
+        bool shown = !buildNowCard.Hidden;
+        if (buildIdle != null) buildIdle.Hidden = shown;
+        if (!shown) return;
+        string game; string stageLine; bool live = running;
+        PausedBuild paused = null;
+        if (running) { game = stop.Game ?? selected; stageLine = lastStage; }
+        else { paused = CardPaused(facts ?? libFacts ?? GatherFacts()); game = paused?.Game ?? stop.Game; stageLine = paused?.StageLine; }
+        nowName.Text = game == null ? "Build" : GameAppUi.DisplayName(game);
+        nowArt.Set(game == null ? null : CoverOf(game, facts ?? libFacts ?? GatherFacts()), nowName.Text, false, null);
+        var state = stop.State;
+        string pill; UIColor tone;
+        if (running && state == StopState.Pausing) { pill = "Pausing…"; tone = Theme.Warn; buildNowLine.Text = StopText.Pausing(stop.Phase, lastStage); }
+        else if (state == StopState.Cancelling) { pill = "Cancelling…"; tone = Theme.Error; buildNowLine.Text = StopText.Cancelling(); }
+        else if (running && launchingGame != null) { pill = "Starting"; tone = Theme.Accent; buildNowLine.Text = LaunchLine(launchingGame).Text; }
+        else if (running) { pill = "Building"; tone = Theme.Accent; buildNowLine.Text = BuildCardText.Line(lastStage) + " · " + GameAppUi.FormatElapsed(DateTime.Now - startedAt); }
+        else { pill = "Paused"; tone = UIColor.FromWhiteAlpha(1f, 0.75f); buildNowLine.Text = paused != null ? StopText.PausedLine(paused.StageLine) : "Paused"; }
+        nowPill.Text = "  " + pill + "  ";
+        nowPill.TextColor = tone;
+        nowPill.BackgroundColor = tone.ColorWithAlpha(running ? 0.18f : 0.1f);
+        var steps = NoAutorun.BuildRows(GameAppUi.BuildSteps(stageLine, live ? stepStarts : null, DateTime.Now));
+        for (int i = 0; i < nowStages.Count && i < steps.Count; i++)
+        {
+            var s = steps[i];
+            var (mark, name, time) = nowStages[i];
+            mark.Text = s.State == GameAppUi.StepState.Done ? "✓" : s.State == GameAppUi.StepState.Now ? "•" : "";
+            mark.BackgroundColor = s.State == GameAppUi.StepState.Done ? Theme.Ok : s.State == GameAppUi.StepState.Now ? Theme.Accent : UIColor.FromWhiteAlpha(1f, 0.12f);
+            name.TextColor = s.State == GameAppUi.StepState.Next ? UIColor.FromWhiteAlpha(1f, 0.55f) : Theme.Text;
+            time.Text = s.Time ?? "";
+            var row = mark.Superview;
+            if (row != null) row.AccessibilityLabel = name.Text + (s.State == GameAppUi.StepState.Done ? ", done" : s.State == GameAppUi.StepState.Now ? ", now" : "") + (string.IsNullOrEmpty(s.Time) ? "" : ", " + s.Time);
+        }
+    }
+
+    // ---- the game sheet's launch line (Play) ----------------------------------------------------------------------
+
+    private Action sheetLaunchFill;
+
+    private (string Text, float Fraction, bool Show) LaunchLine(string game)
+    {
+        if (game == null) return ("", 0, false);
+        if (savesCopying && selected == game) return ("Copying the save before the launch", 0.05f, true);
+        if (!running || launchingGame != game) return ("", 0, false);
+        var s = GameAppUi.ParseStage(lastStage);
+        return (s.Valid ? s.Text : "Loading the game", (float) Math.Max(0.05, s.Valid ? s.Fraction : 0.05), true);
+    }
+}
