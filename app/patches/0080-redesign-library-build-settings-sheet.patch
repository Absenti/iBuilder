+    private (string Text, LibraryStatus.Tone Tone) StatusOf(LibraryEntry e, LibState state, double? fraction, UiFacts facts)
+    {
+        bool update = state == LibState.Built && GameAppUi.ContentChangedSinceBuild(e.Name, libNames ?? Dumps().Select(Path.GetFileName).ToList(), facts);
+        var paused = state == LibState.Paused ? PausedOf(e.Name, facts) : null;
+        return LibraryStatus.Of(state, fraction, CloudWords(e.Cloud).Where, update, paused == null ? null : StopText.PausedChip(paused.StageLine));
