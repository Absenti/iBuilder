+/// The game sheet's "Settings for this game": the per-game rows the settings page has, the short ones as segmented controls in the sheet (the rest stay on the page, one tap away).
+public static class SheetOptions
+{
+    public const int MaxInline = 4;
+
+    /// The launcher rows (launcher.json, GameAppUi.LauncherRow) the sheet shows inline: visible, basic, a toggle or a choice of 2 or 3 short options (13 characters at most: "Memory saver"); at most MaxInline, in their order.
+    public static List<GameAppUi.LauncherRow> Inline(IReadOnlyList<GameAppUi.LauncherRow> rows, IReadOnlyDictionary<string, string> values)
+    {
+        if (rows == null) return new List<GameAppUi.LauncherRow>();
+        return rows.Where(r => r.Basic && GameAppUi.IsVisible(rows, r, values)
+                               && (r.Kind == "toggle" || (r.Kind != "range" && r.Options != null && r.Options.Count >= 2 && r.Options.Count <= 3 && r.Options.All(o => (o.Label ?? "").Length <= 13))))
+                   .Take(MaxInline).ToList();
+    }
+
+    public static (string[] Labels, string[] Values) Choices(GameAppUi.LauncherRow row) =>
+        row.Kind == "toggle" ? (new[] { "Off", "On" }, new[] { row.Off, row.On })
+                             : (row.Options.Select(o => o.Label).ToArray(), row.Options.Select(o => o.Value).ToArray());
+
+    /// A choice made in the sheet, exactly as the settings page's SetValue does it (GameAppSettingsViewController): the value, then the values a profile row gives the rows it covers.
+    public static Dictionary<string, string> Apply(IReadOnlyList<GameAppUi.LauncherRow> rows, IReadOnlyDictionary<string, string> values, string env, string value)
+    {
+        var next = new Dictionary<string, string>(values ?? new Dictionary<string, string>());
+        next[env] = value;
+        var row = rows?.FirstOrDefault(r => r.Env == env);
+        foreach (var kv in GameAppUi.PresetValues(row, value))
+            if (rows.Any(r => r.Env == kv.Key)) next[kv.Key] = kv.Value;
+        return next;
+    }
+
+    /// Without a launcher (a game not built yet): the page's fixed rows, short.
+    public static readonly (string Label, string[] Labels, string[] Values)[] Fixed =
+    {
+        ("Mode", new[] { "Auto", "Handheld", "Docked" }, new[] { "auto", "handheld", "docked" }),
+        ("Frame rate", new[] { "Game", "30", "60" }, new[] { "auto", "30", "60" }),
+        ("Picture", new[] { "Fit", "Fill" }, new[] { "fit", "fill" }),
+    };
+}
