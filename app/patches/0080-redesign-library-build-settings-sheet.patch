+        dim.TouchUpInside += (_, __) => Close(null);
+        AddSubview(dim);
+
+        // the lifted card: its own picture, where it is on the screen
+        var frame = card.ConvertRectToView(card.Bounds, host);
+        var lifted = card.SnapshotView(false) ?? new UIView();
+        var holder = new UIView { Frame = frame, BackgroundColor = Look.Raised, UserInteractionEnabled = false, IsAccessibilityElement = false };
+        holder.Layer.CornerRadius = cardRadius;
+        holder.Layer.CornerCurve = CACornerCurve.Continuous;
+        holder.Layer.BorderWidth = 1;
+        holder.Layer.BorderColor = UIColor.FromWhiteAlpha(1f, 0.18f).CGColor;
+        holder.ClipsToBounds = true;
+        lifted.Frame = holder.Bounds;
+        holder.AddSubview(lifted);
+        AddSubview(holder);
+
+        // the menu's rows
+        var stack = new UIStackView { Axis = UILayoutConstraintAxis.Vertical };
+        UIView firstRow = null;
+        for (int i = 0; i < entries.Count; i++)
+        {
+            var e = entries[i];
+            if (i > 0) { var rule = new UIView { BackgroundColor = UIColor.FromWhiteAlpha(1f, 0.07f) }; rule.HeightAnchor.ConstraintEqualTo(1).Active = true; stack.AddArrangedSubview(rule); }
+            var ink = e.Destructive ? Theme.Error : Theme.Text;
+            var b = new UIButton(UIButtonType.System) { AccessibilityLabel = e.Title, AccessibilityIdentifier = e.Id };
+            var title = Theme.Label(e.Title, Theme.Font(15, UIFontWeight.Regular), ink);
+            var row = Theme.Row(10, title, new UIView(), Theme.Symbol(e.Symbol ?? "circle", 17, ink));
+            row.UserInteractionEnabled = false;
+            row.TranslatesAutoresizingMaskIntoConstraints = false;
+            b.AddSubview(row);
+            NSLayoutConstraint.ActivateConstraints(new[]
+            {
+                row.LeadingAnchor.ConstraintEqualTo(b.LeadingAnchor, 12), row.TrailingAnchor.ConstraintEqualTo(b.TrailingAnchor, -12),
+                row.CenterYAnchor.ConstraintEqualTo(b.CenterYAnchor), b.HeightAnchor.ConstraintEqualTo(44),
+            });
+            var run = e.Run;
+            b.TouchUpInside += (_, __) => Close(run);
+            stack.AddArrangedSubview(b);
+            firstRow ??= b;
+        }
+        menu.BackgroundColor = UIColor.FromRGBA(37 / 255f, 37 / 255f, 43 / 255f, 0.98f);
+        menu.Layer.CornerRadius = 14;
+        menu.Layer.BorderWidth = 1;
+        menu.Layer.BorderColor = UIColor.FromWhiteAlpha(1f, 0.12f).CGColor;
+        menu.ClipsToBounds = true;
+        stack.TranslatesAutoresizingMaskIntoConstraints = false;
+        menu.AddSubview(stack);
+        NSLayoutConstraint.ActivateConstraints(new[]
+        {
+            stack.TopAnchor.ConstraintEqualTo(menu.TopAnchor, 2), stack.BottomAnchor.ConstraintEqualTo(menu.BottomAnchor, -2),
+            stack.LeadingAnchor.ConstraintEqualTo(menu.LeadingAnchor, 4), stack.TrailingAnchor.ConstraintEqualTo(menu.TrailingAnchor, -4),
+        });
+        double height = 4 + entries.Count * 44 + Math.Max(0, entries.Count - 1);
+        var safe = host.SafeAreaLayoutGuide.LayoutFrame;
+        var visible = new Box((double) safe.X, (double) safe.Y, (double) safe.Width, (double) safe.Height - 70);   // above the tab bar
+        var place = HoldMenuLayout.Place(new Box((double) frame.X, (double) frame.Y, (double) frame.Width, (double) frame.Height), index, count, height, visible, columns);
+        menu.Frame = new CGRect(place.Menu.X, place.Menu.Y, place.Menu.W, place.Menu.H);
+        // the menu grows from the corner nearest the card
+        var align = HoldMenuLayout.AlignOf(index, columns);
+        menu.Layer.AnchorPoint = new CGPoint(align == HoldMenuLayout.Align.Right ? 1 : align == HoldMenuLayout.Align.Left ? 0 : 0.5, place.Above ? 1 : 0);
+        menu.Frame = new CGRect(place.Menu.X, place.Menu.Y, place.Menu.W, place.Menu.H);
+        AddSubview(menu);
