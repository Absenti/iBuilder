+/// The library's 3D cover flow (the prototype's carousel): the focused cover 230 pt (scaled 1.08), its neighbours scaled 0.82, rotated 26° about the vertical axis and 210 pt aside, faded to
+/// 55 %; the others hidden. A horizontal swipe moves through the games (the covers follow the finger, then settle on one with a spring); a tap on a side cover focuses it, on the focused one opens
+/// the game; a touch and hold on the focused one opens its menu. APPROXIMATED: the prototype's CSS transition is a 0.45 s cubic-bezier(.2,.8,.2,1); here a 0.45 s spring (damping 0.86).
+internal sealed class CoverFlowView : UIView
+{
+    public const float Side = 230, Step = 210, FocusScale = 1.08f, NearScale = 0.82f, Angle = 26;
+    private readonly List<FlowCell> cells = new List<FlowCell>();
+    private readonly List<FlowItem> items = new List<FlowItem>();
+    private double position, panStart;
+    private bool panning;
+    public int Focus { get; private set; }
+    public event Action<int> FocusChanged;
+    public Action<int> Open;
+    public Action<int, UIView> Hold;
+    public bool Panning => panning;
+
+    public CoverFlowView()
+    {
+        ClipsToBounds = false;
+        var pan = new UIPanGestureRecognizer(OnPan);
+        pan.ShouldBegin = g => { var v = ((UIPanGestureRecognizer) g).VelocityInView(this); return Math.Abs((double) v.X) > Math.Abs((double) v.Y); };   // vertical drags scroll the page
+        AddGestureRecognizer(pan);
+        AddGestureRecognizer(new UITapGestureRecognizer(OnTap));
+        var hold = new UILongPressGestureRecognizer(g =>
+        {
+            if (g.State != UIGestureRecognizerState.Began || Focus < 0 || Focus >= cells.Count) return;
+            if (IndexAt(g.LocationInView(this)) == Focus) Hold?.Invoke(Focus, cells[Focus]);
+        }) { MinimumPressDuration = 0.5 };
+        AddGestureRecognizer(hold);
+    }
+
+    /// The games, the focused one kept by its name when it is still there (the screen redraws often: a cell is reused, not rebuilt).
+    public void SetItems(IReadOnlyList<FlowItem> list, int focus)
+    {
+        items.Clear();
+        items.AddRange(list);
+        while (cells.Count > items.Count) { cells[^1].RemoveFromSuperview(); cells.RemoveAt(cells.Count - 1); }
+        while (cells.Count < items.Count)
+        {
+            var c = new FlowCell();
+            int index = cells.Count;
+            c.Activated = () => TapIndex(index);
+            AddSubview(c);
+            cells.Add(c);
+        }
+        for (int i = 0; i < items.Count; i++) cells[i].Set(items[i]);
+        focus = Math.Max(0, Math.Min(items.Count - 1, focus));
+        if (!panning && focus != Focus) { Focus = focus; position = focus; }
+        if (!panning) position = Focus;
+        Arrange();
+        UpdateAccessibility();
+    }
+
+    public void FocusOn(int index, bool animated)
+    {
+        if (index < 0 || index >= items.Count) return;
+        bool changed = index != Focus;
+        Focus = index;
+        if (animated)
+            UIView.AnimateNotify(0.45, 0, 0.86f, 0.3f, UIViewAnimationOptions.AllowUserInteraction | UIViewAnimationOptions.BeginFromCurrentState, () => { position = index; Arrange(); }, null);
+        else { position = index; Arrange(); }
+        UpdateAccessibility();
+        if (changed) FocusChanged?.Invoke(index);
+    }
+
+    private void TapIndex(int index)
+    {
+        if (index == Focus) Open?.Invoke(index); else FocusOn(index, true);
+    }
+
+    private void OnTap(UITapGestureRecognizer g)
+    {
+        int i = IndexAt(g.LocationInView(this));
+        if (i >= 0) TapIndex(i);
+    }
+
+    /// The cover under a point: the focused one first, then its neighbours (their place on the screen, the perspective left aside).
+    private int IndexAt(CGPoint p)
+    {
+        var order = Enumerable.Range(0, items.Count).OrderBy(i => Math.Abs(i - position));
+        foreach (var i in order)
+        {
+            double o = i - position, a = Math.Abs(o);
+            if (a > 1.5) break;
+            double s = a >= 1 ? NearScale : FocusScale + (NearScale - FocusScale) * a;
+            double cx = (double) Bounds.Width / 2 + o * Step, cy = (double) Bounds.Height / 2, half = Side * s / 2;
+            if (Math.Abs((double) p.X - cx) <= half && Math.Abs((double) p.Y - cy) <= half) return i;
+        }
+        return -1;
+    }
+
+    private void OnPan(UIPanGestureRecognizer g)
+    {
+        if (items.Count == 0) return;
+        switch (g.State)
+        {
+            case UIGestureRecognizerState.Began: panning = true; panStart = position; break;
+            case UIGestureRecognizerState.Changed:
+            {
+                double p = panStart - (double) g.TranslationInView(this).X / Step, max = items.Count - 1;
+                if (p < 0) p = -Rubber(-p); else if (p > max) p = max + Rubber(p - max);   // past the ends it resists
+                position = p;
+                Arrange();
+                break;
+            }
+            default:
+            {
+                panning = false;
+                double projected = position - (double) g.VelocityInView(this).X / Step * 0.18;
+                int target = (int) Math.Round(Math.Max(0, Math.Min(items.Count - 1, projected)));
+                // never more than one cover per swipe from where it started, like the prototype's swipe
+                target = (int) Math.Max(Math.Round(panStart) - 1, Math.Min(Math.Round(panStart) + 1, target));
+                bool changed = target != Focus;
+                Focus = target;
+                UIView.AnimateNotify(0.45, 0, 0.86f, 0.3f, UIViewAnimationOptions.AllowUserInteraction | UIViewAnimationOptions.BeginFromCurrentState, () => { position = target; Arrange(); }, null);
+                UpdateAccessibility();
+                if (changed) FocusChanged?.Invoke(target);
+                break;
+            }
+        }
+    }
+
+    private static double Rubber(double over) => 0.35 * over / (1 + over);
+
+    public override void LayoutSubviews()
+    {
+        base.LayoutSubviews();
+        Arrange();
+    }
+
+    private void Arrange()
+    {
+        var centre = new CGPoint(Bounds.GetMidX(), Bounds.GetMidY());
+        for (int i = 0; i < cells.Count; i++)
+        {
+            var c = cells[i];
+            double o = i - position, a = Math.Abs(o);
+            double s = a >= 1 ? NearScale : FocusScale + (NearScale - FocusScale) * a;
+            var t = CATransform3D.Identity;
+            t.M34 = -1f / 900f;
+            t = t.Translate((nfloat) (o * Step), 0, 0).Scale((nfloat) s, (nfloat) s, 1).Rotate((nfloat) (-Math.Max(-1, Math.Min(1, o)) * Angle * Math.PI / 180), 0, 1, 0);
+            c.Bounds = new CGRect(0, 0, Side, Side);
+            c.Center = centre;
+            c.Layer.Transform = t;
+            c.Alpha = (nfloat) (a <= 1 ? 1 - 0.45 * a : Math.Max(0, 0.55 - (a - 1) * 1.1));
+            c.Layer.ZPosition = (nfloat) (10 - a);
+        }
+    }
+
+    private void UpdateAccessibility()
+    {
+        for (int i = 0; i < cells.Count; i++) cells[i].AccessibilityElementsHidden = Math.Abs(i - Focus) > 1;
+    }
+}
