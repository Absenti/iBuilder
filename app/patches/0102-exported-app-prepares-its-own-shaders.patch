 }
+
+/// Patch 0102 (the owner, exported apps): an exported app (player mode) prepares its game's shaders by itself, in the background, as soon as it opens; its game never waits on a full
+/// preparation; and the state that describes ANOTHER app's Metal cache never travels in an export.
+public static class PlayerWarm
+{
+    /// The files of games/<id>/ that describe what THIS app's Metal cache holds (the warm-up's rows, its "all done" marker, the host's prewarm-tail state): an exported app starts with an
+    /// empty cache, so they are not exported (they made the exported South Park skip all 710 libraries as "already warm": "0 compiled in 0 s"), and a copy an older export left is ignored.
+    public static readonly IReadOnlyList<string> CacheState = new[] { "warmed.tsv", "prepared.tsv", "pso_tail.tsv" };
+
+    public static bool IsCacheState(string relative) => relative != null && CacheState.Contains(System.IO.Path.GetFileName(relative), StringComparer.Ordinal);
+
+    /// The build the warm-up's markers name: the app build, and in an exported app its own bundle id too (its Metal cache is its own: a marker the main app wrote never counts there).
+    public static string CacheBuild(string appBuild, bool player, string bundleId) => player ? appBuild + " in " + (bundleId ?? "?") : appBuild;
+
+    /// "Preparing the shaders before the first play: 120 of 900 (you can play now; it will stutter until done)", paused: "Shader preparation paused at 120 of 900 (…)".
+    public static string Line(int done, int total, bool paused)
+    {
+        string N(int n) => n.ToString("N0", CultureInfo.InvariantCulture);
+        var count = total > 0 ? N(Math.Min(done, total)) + " of " + N(total) : N(done);
+        return paused ? "Shader preparation paused at " + count + " (Resume to go on; you can play now)"
+                      : "Preparing the shaders before the first play: " + count + " (you can play now; it will stutter until done)";
+    }
+
+    public const string PauseTitle = "Pause the preparation", ResumeTitle = "Resume the preparation";
+    public const string PausedLine = "Shader preparation paused (Resume to go on; you can play now)";
+}
+
+/// Patch 0102: the share of the prewarm lists an exported game builds before its first frame. Its app starts with an empty Metal cache and its lists are the pack's seed list AND the host's
+/// own pso_user.tsv (what the game used, which travels in the export): the chain counts the seed list alone (profile.rs set_pso_prepare_percent), so a short seed list with a long
+/// pso_user.tsv was built whole before the first frame. The exported app counts both and asks for the share that makes about 500 lines (pso_prepare_percent= in its config).
+public static class PlayerPrepare
+{
+    public const long HeadLines = 500;
+
+    /// The data lines of a prewarm list as the host counts them: a line that is not empty and does not start with '#'.
+    public static long Lines(string text)
+    {
+        long n = 0;
+        foreach (var line in (text ?? "").Split('\n'))
+        {
+            var l = line.TrimEnd('\r');
+            if (l.Length > 0 && l[0] != '#') n++;
+        }
+        return n;
+    }
+
+    /// Null when both lists together are not longer than HeadLines (all of it, the host's default), else ceil(500 * 100 / lines) within 1..99 (profile.rs pso_head_percent).
+    public static int? Percent(long seedLines, long userLines)
+    {
+        long all = Math.Max(0, seedLines) + Math.Max(0, userLines);
+        if (all <= HeadLines) return null;
+        long p = (HeadLines * 100 + all - 1) / all;
+        return (int) Math.Clamp(p, 1, 99);
+    }
+}
+
+/// Patch 0102: "Preparing the game" over the game (GameBootOverlay) went away at the first picture it SAW: it read the guest log from where the log stood when the overlay appeared, so a
+/// game that showed its first picture before that (an exported app's quick boot: present #1 at 0.19 s) left it up for 30 minutes. It reads from where the log stood when the run began,
+/// and any presented frame ends it.
+public static class BootOverlayRule
+{
+    private static readonly Regex Present = new Regex(@"present #\d+[ :]");
+
+    public static bool FirstPicture(string text) => Present.IsMatch(text ?? "");
+}
