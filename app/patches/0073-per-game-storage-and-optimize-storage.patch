diff --color -ruN a/GameAppSlot.cs b/GameAppSlot.cs
--- a/GameAppSlot.cs	1970-01-01 01:00:00
+++ b/GameAppSlot.cs	2026-11-20 17:35:09
@@ -0,0 +1,606 @@
+// gameapp/GameAppSlot.cs -- one folder per game for its build (parking), the extraction marker, the games brought back from what is on disk, and "Optimize storage", with no UIKit (patch 0073; the host harness
+// compiles this file as it is).
+//
+// Why (the owner, field facts of Ocarina of Time, a 25.6 GB .nup): storage is the limit. The build of ONE game lived in Documents (extract/ with the 24.4 GB RomFS.img, the framework, profile.tsv, the stamp): building
+// another game wiped it, and an app update (which withdraws the framework) needed the game file again because extract/ExeFS was deleted after each build. Now:
+//   * THE SLOT is the set of paths in Documents that belong to the game built last (GameSlot.Items: extract/, DmGameProbe.framework/, profile.tsv, gameapp.framework, pipeline.boot, gameapp.extracted). The chain and the
+//     export read them at those fixed paths, so they stay there for the game in use; another game's slot is PARKED in Documents/games/<TITLE ID>/slot/ (Directory.Move / File.Move: the same APFS volume, one rename
+//     per item, nothing is copied) and moved back when that game needs the slot again (a build, Play, an export). Every move is journaled (Documents/gameapp.slot.tsv) and an interrupted one is finished at the next launch.
+//   * THE EXTRACTION MARKER, Documents/gameapp.extracted (it moves with the slot): written when an extraction is complete (game file name, title id, the update / DLC signature). With extract/ExeFS kept (keep_exefs=1),
+//     a game whose file has no content can be rebuilt from its extraction (ExtractionUse.Usable).
+//   * RECOVERY: a slot (in Documents or parked) whose game has no file in Documents gets its zero-byte placeholder back (patch 0071's BuiltKeep), with a name from the stamp, the marker, the built record, the import
+//     record, or, when nothing knows it, a name made from the game's own control data (SlotRecovery.Synthesize).
+//   * OPTIMIZE STORAGE (StorageOptimizer): once a game is extracted, its base file, update and DLC are replaced by zero-byte stubs (0068's ledger-first stub), when the Settings toggle is on.
+//
+//   GameSlot          the names and paths.
+//   SlotView / SlotStore    what one slot holds (read from its folder: a few stats and three small files), the parked slots.
+//   ExtractionMark / ExtractionUse   the marker, and whether an extraction can stand in for a game's files.
+//   SlotJournal       Documents/gameapp.slot.tsv: the title in the slot and the move going on.
+//   SlotPlanner / SlotMover   what makes the slot hold a game (park the occupant, or put an occupant nobody owns aside; bring the game's own slot back) and the moves themselves (journaled, rolled back in the
+//                     session when a move fails, finished at the next launch when the app was killed in the middle).
+//   SlotRecovery      the name of a slot's game and whether its placeholder must be made again.
+//   StorageOptimizer  the toggle, which files go after an extraction, and the stubs.
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+
+public static class GameSlot
+{
+    public const string Extract = "extract", Framework = "DmGameProbe.framework", Stamp = "gameapp.framework", Profile = "profile.tsv", PipelineBoot = "pipeline.boot";
+
+    /// The folders and files of a game's build in Documents (the chain's config names them: extract_out, framework_out, profile; the pipeline writes the stamp and pipeline.boot; this patch the marker). Nothing else in
+    /// Documents is a game's build: shaders/<id>, games/<id> (settings, saves, aoc/, launcher.json, the rewrite cache) and profile-derived/<id> are per game already.
+    public static readonly string[] Folders = { Extract, Framework };
+    public static readonly string[] Files = { Stamp, Profile, PipelineBoot, ExtractionMark.FileName };
+    public static IEnumerable<string> Items => Folders.Concat(Files);
+
+    public const string GamesRoot = "games", SlotFolder = "slot";
+
+    /// Documents/.slot-trash/<name>/: what a move had to put aside (a slot no game owns, or a stale copy in the way); deleted on a worker, never on the main thread.
+    public const string TrashRoot = ".slot-trash";
+
+    public static bool IsTitleId(string s) => s != null && s.Length == 16 && s.All(Uri.IsHexDigit);
+    public static string Norm(string tid) => IsTitleId(tid) ? tid.ToUpperInvariant() : null;
+
+    public static string ParkedRelative(string tid) => GamesRoot + "/" + tid + "/" + SlotFolder;
+    public static string ParkedPath(string documents, string tid) => Path.Combine(documents, GamesRoot, tid, SlotFolder);
+
+    internal static bool Exists(string path) => File.Exists(path) || Directory.Exists(path);
+}
+
+/// `Game`: the game file the extraction was made from; `TitleId`: the base title id the extraction holds (ExeFS/main.npdm); `Content`: GameAppUi.ContentSignature of the update and DLC it took; `At`: UTC.
+public sealed record ExtractionMark(string Game, string TitleId, string Content, string At)
+{
+    public const string FileName = "gameapp.extracted";
+
+    public static ExtractionMark Parse(string text)
+    {
+        if (text == null) return null;
+        string game = null, tid = null, content = "", at = "";
+        foreach (var raw in text.Split('\n'))
+        {
+            var line = raw.TrimEnd('\r');
+            var eq = line.IndexOf('=');
+            if (eq <= 0 || line.StartsWith("#", StringComparison.Ordinal)) continue;
+            var key = line.Substring(0, eq).Trim();
+            var value = line.Substring(eq + 1).Trim();
+            if (key == "game") game = value;
+            else if (key == "title_id") tid = value;
+            else if (key == "content") content = value;
+            else if (key == "at") at = value;
+        }
+        return string.IsNullOrEmpty(game) ? null : new ExtractionMark(game, GameSlot.Norm(tid), content, at);
+    }
+
+    private static string Clean(string s) => (s ?? "").Replace('\n', ' ').Replace('\r', ' ');
+
+    public string Format() =>
+        "# the extraction in this folder is complete (patch 0073): a rebuild can start from it when the game file has no content\n"
+        + "game=" + Clean(Game) + "\ntitle_id=" + Clean(TitleId) + "\ncontent=" + Clean(Content) + "\nat=" + Clean(At) + "\n";
+
+    /// Written through <file>.part and one rename. Throws when it cannot be written.
+    public static void Write(string folder, ExtractionMark mark)
+    {
+        var path = Path.Combine(folder, FileName);
+        var part = path + ".part";
+        try { File.WriteAllText(part, mark.Format()); File.Move(part, path, true); }
+        catch { try { File.Delete(part); } catch (Exception) { } throw; }
+    }
+}
+
+/// What one slot holds: `Root` is Documents (the slot in use) or games/<id>/slot (a parked one). `FolderTid`: the <id> of a parked slot, null for Documents. `Items`: which of GameSlot.Items are there.
+public sealed record SlotView(string Root, string FolderTid, string ProfileTid, string StampText, FrameworkStamp Stamp, ExtractionMark Mark, IReadOnlyList<string> Items,
+                              bool FrameworkOnDisk, bool FlatOnDisk, bool ExeFsOnDisk, long RomfsBytes)
+{
+    /// The title the slot belongs to: the marker's (the extraction itself), else profile.tsv's (the chain derived it from the extraction), else the stamp's game's, else the parked folder's name. Null: nobody's.
+    public string Tid => Mark?.TitleId ?? ProfileTid ?? GameAppUi.BaseTitleIdOf(Stamp?.Game is { Length: > 0 } g ? g : null) ?? FolderTid;
+
+    /// The game file named by the stamp (a finished build), else by the marker (an extraction).
+    public string Game => !string.IsNullOrEmpty(Stamp?.Game) ? Stamp.Game : Mark?.Game;
+
+    public bool IsEmpty => Items.Count == 0;
+
+    /// A finished build is here (the stamp, the framework and flat/): what Play and Export need.
+    public bool HasBuild => Stamp != null && FrameworkOnDisk && FlatOnDisk;
+
+    /// A whole extraction is here: what a rebuild without the game file needs (the chain reads ExeFS and RomFS.img).
+    public bool HasExtraction => ExeFsOnDisk && RomfsBytes > 0;
+
+    /// Worth keeping a game in the library for: a finished build, or the game's files.
+    public bool HasContent => HasBuild || RomfsBytes > 0;
+
+    /// This slot is `game`'s: it names that file, or it holds that title (the same game under another file name: its build is replaced by the next one anyway).
+    public bool BelongsTo(string game, string tid)
+    {
+        if (!string.IsNullOrEmpty(game) && (string.Equals(Stamp?.Game, game, StringComparison.Ordinal) || string.Equals(Mark?.Game, game, StringComparison.Ordinal))) return true;
+        var mine = GameSlot.Norm(tid);
+        return mine != null && string.Equals(Tid, mine, StringComparison.Ordinal);
+    }
+}
+
+public static class SlotStore
+{
+    private static string ReadSmall(string path, int max = 1 << 20)
+    {
+        try { var f = new FileInfo(path); return f.Exists && f.Length <= max ? File.ReadAllText(path) : null; } catch (Exception) { return null; }
+    }
+
+    /// profile.tsv's title_id (the same reading as GameAppMain.BuiltTitleId), or null.
+    public static string ProfileTitleId(string profilePath)
+    {
+        try
+        {
+            if (!File.Exists(profilePath)) return null;
+            foreach (var line in File.ReadLines(profilePath))
+                if (line.StartsWith("title_id\t", StringComparison.Ordinal)) return GameSlot.Norm(line.Substring(9).Trim());
+        }
+        catch (Exception) { }
+        return null;
+    }
+
+    /// One slot, read now: a stat per item, the stamp and the marker (small files) and profile.tsv's title line. No walk: safe on the main thread.
+    public static SlotView Read(string root, string folderTid = null)
+    {
+        var items = GameSlot.Items.Where(i => GameSlot.Exists(Path.Combine(root, i))).ToList();
+        var stampText = ReadSmall(Path.Combine(root, GameSlot.Stamp), 64 * 1024);
+        var mark = ExtractionMark.Parse(ReadSmall(Path.Combine(root, ExtractionMark.FileName), 64 * 1024));
+        long romfs = 0;
+        try { var f = new FileInfo(Path.Combine(root, GameSlot.Extract, "RomFS.img")); if (f.Exists) romfs = f.Length; } catch (Exception) { }
+        return new SlotView(root, GameSlot.Norm(folderTid), ProfileTitleId(Path.Combine(root, GameSlot.Profile)), stampText, GameAppUi.ParseFrameworkStamp(stampText), mark, items,
+                            File.Exists(Path.Combine(root, GameSlot.Framework, "DmGameProbe")), Directory.Exists(Path.Combine(root, GameSlot.Extract, "flat")),
+                            File.Exists(Path.Combine(root, GameSlot.Extract, "ExeFS", "main")), romfs);
+    }
+
+    /// The parked slots: Documents/games/<16 hex digits>/slot/ folders (one listing of games/, a stat each; the slot of a game is read only when it exists). Never throws.
+    public static List<SlotView> ListParked(string documents)
+    {
+        var list = new List<SlotView>();
+        try
+        {
+            var games = Path.Combine(documents, GameSlot.GamesRoot);
+            if (!Directory.Exists(games)) return list;
+            foreach (var dir in Directory.EnumerateDirectories(games))
+            {
+                var tid = GameSlot.Norm(Path.GetFileName(dir));
+                if (tid == null) continue;
+                var slot = Path.Combine(dir, GameSlot.SlotFolder);
+                if (!Directory.Exists(slot)) continue;
+                var view = Read(slot, tid);
+                if (!view.IsEmpty) list.Add(view);
+            }
+        }
+        catch (Exception) { }
+        return list;
+    }
+
+    /// The program id of ExeFS/main.npdm (its ACI0 block, +0x10), as a base title id (low 12 bits cleared), or null. The same reading as ibuilder-profile's title_id.
+    public static string NpdmTitleId(string npdmPath)
+    {
+        try
+        {
+            var f = new FileInfo(npdmPath);
+            if (!f.Exists || f.Length > (4 << 20)) return null;
+            var d = File.ReadAllBytes(npdmPath);
+            for (int i = 0; i + 0x18 <= d.Length; i++)
+                if (d[i] == (byte) 'A' && d[i + 1] == (byte) 'C' && d[i + 2] == (byte) 'I' && d[i + 3] == (byte) '0')
+                    return (BitConverter.ToUInt64(d, i + 0x10) & ~0xFFFUL).ToString("X16", CultureInfo.InvariantCulture);
+        }
+        catch (Exception) { }
+        return null;
+    }
+}
+
+public static class ExtractionUse
+{
+    /// The extraction in `slot` can stand in for `game`'s files (whose update / DLC signature is `content` now): the whole extraction is there (ExeFS/main and a RomFS.img with bytes), the slot's title is the game's
+    /// (when both are known), and the marker names this game with the same update and DLC. A slot built before this patch has no marker: its stamp must name this game with the same content=. Anything else: no
+    /// (the file is asked for, as before).
+    public static bool Usable(SlotView slot, string game, string tid, string content)
+    {
+        if (slot == null || string.IsNullOrEmpty(game) || !slot.HasExtraction) return false;
+        var mine = GameSlot.Norm(tid);
+        if (mine != null && slot.Tid != null && !string.Equals(slot.Tid, mine, StringComparison.Ordinal)) return false;
+        if (slot.Mark != null)
+            return string.Equals(slot.Mark.Game, game, StringComparison.Ordinal) && string.Equals(slot.Mark.Content ?? "", content ?? "", StringComparison.Ordinal);
+        return slot.Stamp != null && string.Equals(slot.Stamp.Game, game, StringComparison.Ordinal) && slot.Stamp.Content != null
+               && string.Equals(slot.Stamp.Content, content ?? "", StringComparison.Ordinal);
+    }
+}
+
+// ---- the journal ----------------------------------------------------------------------------------------------------------------------------------------------
+
+public enum SlotStep { Park, Trash, Unpark }
+
+/// One move of a whole slot: Park(tid) Documents -> games/<tid>/slot; Unpark(tid) games/<tid>/slot -> Documents; Trash(name) Documents -> .slot-trash/<name> (a slot nobody owns).
+public sealed record SlotOp(SlotStep Step, string Arg);
+
+/// `Active`: the title id whose build is in Documents ("" = none or not known; for the log and the person, the decisions read the files). `Op`: the move going on, null when none.
+public sealed record SlotJournalState(string Active, SlotOp Op, string At);
+
+public static class SlotJournal
+{
+    public const string FileName = "gameapp.slot.tsv";
+
+    private static readonly object gate = new object();
+
+    public static string PathIn(string documents) => Path.Combine(documents, FileName);
+
+    public static SlotJournalState Parse(string text)
+    {
+        string active = "", at = "";
+        SlotOp op = null;
+        foreach (var raw in (text ?? "").Split('\n'))
+        {
+            var line = raw.TrimEnd('\r');
+            if (line.Length == 0 || line.StartsWith("#", StringComparison.Ordinal)) continue;
+            var p = line.Split('\t');
+            if (p[0] == "active" && p.Length >= 2) active = GameSlot.Norm(p[1]) ?? "";
+            else if (p[0] == "op" && p.Length >= 3)
+            {
+                SlotStep? step = p[1] switch { "park" => SlotStep.Park, "unpark" => SlotStep.Unpark, "trash" => SlotStep.Trash, _ => null };
+                // the argument is a title id (park / unpark) or a plain folder name (trash): nothing else is ever acted on
+                var arg = step == SlotStep.Trash ? (IsTrashName(p[2]) ? p[2] : null) : GameSlot.Norm(p[2]);
+                if (step != null && arg != null) { op = new SlotOp(step.Value, arg); at = p.Length >= 4 ? p[3] : ""; }
+            }
+        }
+        return new SlotJournalState(active, op, at);
+    }
+
+    public static bool IsTrashName(string s) => !string.IsNullOrEmpty(s) && s.Length <= 64 && s.All(c => char.IsLetterOrDigit(c) || c == '-' || c == '_');
+
+    public static string Format(SlotJournalState s)
+    {
+        var sb = new StringBuilder("# the build slot of Documents (patch 0073): the game whose build is in Documents/extract and beside it, and a move of a slot that was going on (it is finished at the next launch)\n");
+        sb.Append("active\t").Append(s?.Active ?? "").Append('\n');
+        if (s?.Op != null)
+            sb.Append("op\t").Append(s.Op.Step switch { SlotStep.Park => "park", SlotStep.Unpark => "unpark", _ => "trash" }).Append('\t').Append(s.Op.Arg).Append('\t').Append(s.At ?? "").Append('\n');
+        return sb.ToString();
+    }
+
+    /// Never throws: an unreadable journal is "nothing going on".
+    public static SlotJournalState Read(string documents)
+    {
+        lock (gate)
+        {
+            try { var path = PathIn(documents); return Parse(File.Exists(path) ? File.ReadAllText(path) : ""); }
+            catch (Exception) { return new SlotJournalState("", null, ""); }
+        }
+    }
+
+    /// Through <file>.part and one rename. Throws when it cannot be written (a move is then not started).
+    public static void Write(string documents, SlotJournalState s)
+    {
+        lock (gate)
+        {
+            var path = PathIn(documents);
+            var part = path + ".part";
+            try { File.WriteAllText(part, Format(s)); File.Move(part, path, true); }
+            catch { try { File.Delete(part); } catch (Exception) { } throw; }
+        }
+    }
+
+    /// At launch, before the library is drawn: a move the app was killed in the middle of is FINISHED (every rename is done again where it is not done yet: the moves are idempotent). Returns the folders put
+    /// aside (to delete on a worker). Renames only: no walk. Never throws.
+    public static List<string> Recover(string documents, Action<string> log, Action<string, string, bool> move = null)
+    {
+        var trash = new List<string>();
+        var state = Read(documents);
+        if (state.Op == null) return trash;
+        log?.Invoke($"storage: the last launch ended in the middle of a slot move ({SlotMover.Describe(state.Op)}, {state.At}): it is finished now");
+        try { trash.AddRange(SlotMover.Apply(documents, state.Op, log, move, rollBack: false)); }
+        catch (Exception e) { log?.Invoke($"storage: the slot move could not be finished ({e.Message}): it is tried again at the next launch"); return trash; }
+        try { Write(documents, state with { Op = null, Active = state.Op.Step == SlotStep.Unpark ? state.Op.Arg : "" }); }
+        catch (Exception e) { log?.Invoke($"storage: the slot journal could not be cleared ({e.Message})"); }
+        return trash;
+    }
+}
+
+// ---- the plan and the moves --------------------------------------------------------------------------------------------------------------------------------
+
+public sealed record SlotDecision(IReadOnlyList<SlotOp> Ops, string Note);
+
+public static class SlotPlanner
+{
+    /// What makes Documents hold `game`'s slot (`tid`: its base title id from the file name, null when it has none). `active`: the slot in Documents; `parked`: the parked ones.
+    ///   * Documents already holds this game's slot (it names the file or holds the title): nothing (a build of it replaces it in place, as always).
+    ///   * Documents holds another title's: it is PARKED under that title. It holds nobody's (no marker, no profile, no stamp: a read cut short before the chain knew the title): it is put aside (trash) only when this
+    ///     game's own slot must come in, else left where it is (the build overwrites it, as before this patch).
+    ///   * This game has a parked slot: it comes back.
+    public static SlotDecision For(string game, string tid, SlotView active, IReadOnlyList<SlotView> parked, string trashName)
+    {
+        var ops = new List<SlotOp>();
+        var mine = (parked ?? Array.Empty<SlotView>()).FirstOrDefault(p => p.FolderTid != null && p.BelongsTo(game, tid));
+        if (active != null && !active.IsEmpty)
+        {
+            if (active.BelongsTo(game, tid)) return new SlotDecision(ops, "the slot is this game's already");
+            if (active.Tid != null) ops.Add(new SlotOp(SlotStep.Park, active.Tid));
+            else if (mine != null) ops.Add(new SlotOp(SlotStep.Trash, trashName));
+        }
+        if (mine != null) ops.Add(new SlotOp(SlotStep.Unpark, mine.FolderTid));
+        return new SlotDecision(ops, ops.Count == 0 ? "nothing to move" : string.Join(", ", ops.Select(SlotMover.Describe)));
+    }
+}
+
+public static class SlotMover
+{
+    public static string Describe(SlotOp op) => op.Step switch
+    {
+        SlotStep.Park => $"park {op.Arg} in {GameSlot.ParkedRelative(op.Arg)}",
+        SlotStep.Unpark => $"bring {op.Arg} back from {GameSlot.ParkedRelative(op.Arg)}",
+        _ => $"put a slot that names no game aside ({GameSlot.TrashRoot}/{op.Arg})",
+    };
+
+    private static void DefaultMove(string from, string to, bool folder)
+    {
+        if (folder) Directory.Move(from, to);        // rename(2): the same volume, nothing copied; it throws rather than copy across volumes
+        else File.Move(from, to, false);             // never over a file
+    }
+
+    private static string NewTrash(string documents)
+    {
+        var name = DateTime.UtcNow.ToString("yyyyMMdd-HHmmss-fff", CultureInfo.InvariantCulture) + "-" + Guid.NewGuid().ToString("N").Substring(0, 6);
+        var dir = Path.Combine(documents, GameSlot.TrashRoot, name);
+        Directory.CreateDirectory(dir);
+        return dir;
+    }
+
+    /// One op's renames. Items already where they belong are skipped (a recovery runs it again). Something in the way at the destination (a stale copy) is put aside first, never overwritten. `rollBack`: on a failure,
+    /// the renames this call made are undone (in the session); false at a recovery (the next launch tries again). Returns the folders put aside.
+    internal static List<string> Apply(string documents, SlotOp op, Action<string> log, Action<string, string, bool> move, bool rollBack)
+    {
+        move ??= DefaultMove;
+        var trash = new List<string>();
+        var done = new List<(string From, string To, bool Folder)>();
+        string trashDir = null;
+        string Aside(string path, bool folder)
+        {
+            trashDir ??= NewTrash(documents);
+            if (!trash.Contains(trashDir)) trash.Add(trashDir);
+            var to = Path.Combine(trashDir, Path.GetFileName(path));
+            move(path, to, folder);
+            done.Add((path, to, folder));
+            return to;
+        }
+        string fromRoot, toRoot;
+        switch (op.Step)
+        {
+            case SlotStep.Park: fromRoot = documents; toRoot = GameSlot.ParkedPath(documents, op.Arg); break;
+            case SlotStep.Unpark: fromRoot = GameSlot.ParkedPath(documents, op.Arg); toRoot = documents; break;
+            default:
+                fromRoot = documents;
+                toRoot = Path.Combine(documents, GameSlot.TrashRoot, op.Arg);
+                trash.Add(toRoot);
+                break;
+        }
+        var moved = new List<string>();
+        try
+        {
+            if (!Directory.Exists(fromRoot)) return trash;   // a park / unpark that already finished (its folder is gone)
+            Directory.CreateDirectory(toRoot);
+            foreach (var item in GameSlot.Items)
+            {
+                var from = Path.Combine(fromRoot, item);
+                bool folder = Directory.Exists(from);
+                if (!folder && !File.Exists(from)) continue;
+                var to = Path.Combine(toRoot, item);
+                if (GameSlot.Exists(to)) Aside(to, Directory.Exists(to));   // a stale copy in the way: aside, never overwritten, never mixed
+                move(from, to, folder);
+                done.Add((from, to, folder));
+                moved.Add(item);
+            }
+        }
+        catch
+        {
+            if (rollBack)
+            {
+                for (int i = done.Count - 1; i >= 0; i--)
+                    try { move(done[i].To, done[i].From, done[i].Folder); } catch (Exception) { }
+            }
+            throw;
+        }
+        if (op.Step == SlotStep.Unpark)
+            try { if (!Directory.EnumerateFileSystemEntries(fromRoot).Any()) Directory.Delete(fromRoot); } catch (Exception) { }   // the empty games/<id>/slot (games/<id> keeps the game's settings and saves)
+        if (moved.Count > 0) log?.Invoke($"storage: {Describe(op)}: {string.Join(", ", moved)} (renamed, nothing copied)");
+        return trash;
+    }
+
+    /// Runs `ops` in order, each one journaled first (the journal says what to finish if the app is killed in the middle). A failing op is rolled back and the rest is not run: `ok` false, the slot is as it was before
+    /// that op. Returns the folders put aside (to delete on a worker). `finalActive`: the title id the journal records as in the slot afterwards.
+    public static List<string> Run(string documents, IReadOnlyList<SlotOp> ops, string finalActive, Action<string> log, out bool ok, Action<string, string, bool> move = null)
+    {
+        var trash = new List<string>();
+        ok = true;
+        var active = SlotJournal.Read(documents).Active;
+        foreach (var op in ops ?? Array.Empty<SlotOp>())
+        {
+            try { SlotJournal.Write(documents, new SlotJournalState(active, op, ImportLedger.Now())); }
+            catch (Exception e) { log?.Invoke($"storage: the slot journal could not be written ({e.Message}): nothing was moved"); ok = false; return trash; }
+            try { trash.AddRange(Apply(documents, op, log, move, rollBack: true)); }
+            catch (Exception e)
+            {
+                log?.Invoke($"storage: could not {Describe(op)} ({e.Message}): the slot is as it was");
+                try { SlotJournal.Write(documents, new SlotJournalState(active, null, "")); } catch (Exception) { }
+                ok = false;
+                return trash;
+            }
+            active = op.Step == SlotStep.Unpark ? op.Arg : "";
+        }
+        try { SlotJournal.Write(documents, new SlotJournalState(GameSlot.Norm(finalActive) ?? active ?? "", null, "")); }
+        catch (Exception e) { log?.Invoke($"storage: the slot journal could not be updated ({e.Message})"); }
+        return trash;
+    }
+}
+
+// ---- recovery: a game comes back from what is on disk -------------------------------------------------------------------------------------------------------
+
+public enum RecoverWhy { Nothing, Present, Recreate }
+
+public sealed record RecoverDecision(RecoverWhy Why, string Name, string Tid, string Where);
+
+public static class SlotRecovery
+{
+    /// The game file name of a slot: the stamp's game=, else the marker's, else the built record of its title, else the import record of its title (a base game file), else null (then: Synthesize).
+    public static string NameFor(SlotView slot, IReadOnlyList<BuiltRecord> built, IReadOnlyList<ImportRecord> imports)
+    {
+        if (slot == null) return null;
+        if (BuiltLedger.IsGameFile(slot.Stamp?.Game)) return slot.Stamp.Game;
+        if (BuiltLedger.IsGameFile(slot.Mark?.Game)) return slot.Mark.Game;
+        var tid = slot.Tid;
+        if (tid == null) return null;
+        bool Base(string n) => BuiltLedger.IsGameFile(n) && GameAppUi.ContentKindOf(n) == GameAppUi.ContentKind.Base && string.Equals(GameAppUi.BaseTitleIdOf(n), tid, StringComparison.Ordinal);
+        var b = (built ?? Array.Empty<BuiltRecord>()).LastOrDefault(r => BuiltLedger.IsGameFile(r.Name) && (string.Equals(GameSlot.Norm(r.TitleId), tid, StringComparison.Ordinal) || Base(r.Name)));
+        if (b != null) return b.Name;
+        return (imports ?? Array.Empty<ImportRecord>()).LastOrDefault(r => Base(r.Name))?.Name;
+    }
+
+    /// `files`: the game files in Documents now (any content). Nothing to do for a slot with no build and no game files in it, or with no title; Present when its file, or another base file of its title, is there.
+    public static RecoverDecision Decide(SlotView slot, string name, IReadOnlyList<string> files)
+    {
+        var where = slot?.FolderTid == null ? "Documents" : GameSlot.ParkedRelative(slot.FolderTid);
+        if (slot == null || !slot.HasContent || slot.Tid == null || !BuiltLedger.IsGameFile(name)) return new RecoverDecision(RecoverWhy.Nothing, name, slot?.Tid, where);
+        foreach (var f in files ?? Array.Empty<string>())
+        {
+            if (string.Equals(f, name, StringComparison.OrdinalIgnoreCase)) return new RecoverDecision(RecoverWhy.Present, name, slot.Tid, where);
+            if (BuiltLedger.IsGameFile(f) && GameAppUi.ContentKindOf(f) is GameAppUi.ContentKind.Base && string.Equals(GameAppUi.BaseTitleIdOf(f), slot.Tid, StringComparison.Ordinal))
+                return new RecoverDecision(RecoverWhy.Present, f, slot.Tid, where);
+        }
+        return new RecoverDecision(RecoverWhy.Recreate, name, slot.Tid, where);
+    }
+
+    /// The game's name in its control data (control.nacp: 16 language entries of 0x300 bytes, the name in the first 0x200, UTF-8; the first non-empty one), or null.
+    public static string NacpTitle(byte[] nacp)
+    {
+        if (nacp == null || nacp.Length < 0x300) return null;
+        for (int i = 0; i < 16 && (i + 1) * 0x300 <= nacp.Length; i++)
+        {
+            int start = i * 0x300, end = start;
+            while (end < start + 0x200 && nacp[end] != 0) end++;
+            if (end == start) continue;
+            string s;
+            try { s = new UTF8Encoding(false, true).GetString(nacp, start, end - start).Trim(); } catch (Exception) { continue; }
+            if (s.Length > 0) return s;
+        }
+        return null;
+    }
+
+    /// A Switch 2 game, from what its slot holds: the NUP reader's other programs (extract/romfs_programs/, ibuilder-nup extract.rs PROGRAMS: no NSP/XCI extraction makes it), or the rewritten sdk module says
+    /// "spec: Ounce" (the Switch 2's SDK: the test ibuilder-profile facts.rs uses for a Switch 2 game's 9 GB pool). `read`: a file's bytes (null when absent or larger than the limit). Worker threads only.
+    public static bool LooksLikeSwitch2(string slotRoot, Func<string, byte[]> read = null)
+    {
+        read ??= p => { try { var f = new FileInfo(p); return f.Exists && f.Length <= (256L << 20) ? File.ReadAllBytes(p) : null; } catch (Exception) { return null; } };
+        var extract = Path.Combine(slotRoot, GameSlot.Extract);
+        if (Directory.Exists(Path.Combine(extract, "romfs_programs"))) return true;
+        var needle = Encoding.ASCII.GetBytes("spec: Ounce");
+        foreach (var p in new[] { Path.Combine(extract, "flat", "sdk.patched.bin"), Path.Combine(extract, "rewrite", "sdk", "sdk.patched.bin") })
+        {
+            var d = read(p);
+            if (d != null && d.AsSpan().IndexOf(needle) >= 0) return true;
+        }
+        return false;
+    }
+
+    /// A file name when nothing knows the game's: "<title> [<TITLE ID>].nup" for a Switch 2 game, ".nsp" otherwise (a Switch game's extraction does not say whether it came from an NSP or an XCI, and the name only
+    /// has to be a game file the library lists: the content is not there either way). The title loses what a file name or the library's parsing cannot hold (/ \ : [ ] and control characters).
+    public static string Synthesize(string title, string tid, bool switch2)
+    {
+        var chars = (title ?? "").Select(c => char.IsControl(c) || "/\\:[]*?\"<>|".IndexOf(c) >= 0 ? ' ' : c).ToArray();
+        var t = string.Join(" ", new string(chars).Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => w.Trim('.').Length > 0)).Trim().TrimStart('.').Trim();   // no ".." word, no hidden name
+        if (t.Length > 100) t = t.Substring(0, 100).TrimEnd();
+        if (t.Length == 0) t = "Game";
+        return $"{t} [{GameSlot.Norm(tid) ?? "0000000000000000"}]{(switch2 ? ".nup" : ".nsp")}";
+    }
+
+    /// The placeholder of a slot's game: the built record (patch 0071: kept when it exists, the size the import record knew else 0), then 0071's placeholder (the import ledger first, then the empty file; never over a
+    /// file). Returns true when the file was made. Worker threads only.
+    public static bool Recreate(string documents, RecoverDecision d, Action<string> log, Action<string, string> move = null)
+    {
+        if (d == null || d.Why != RecoverWhy.Recreate) return false;
+        long size = ImportLedger.Find(ImportLedger.Load(documents), d.Name)?.Size ?? 0;
+        BuiltLedger.Seed(documents, d.Name, d.Tid ?? "", size);
+        var record = BuiltLedger.Find(BuiltLedger.Load(documents), d.Name) ?? new BuiltRecord(d.Name, d.Tid ?? "", size, ImportLedger.Now());
+        var made = BuiltKeep.Execute(documents, new[] { new KeepDecision(record, KeepWhy.Placeholder) }, log, move);
+        if (made.Count > 0) log?.Invoke($"storage: {d.Name} is back in the library: its build is on this iPhone ({d.Where}) and its file was not");
+        return made.Count > 0;
+    }
+}
+
+// ---- "Optimize storage" ---------------------------------------------------------------------------------------------------------------------------------------
+
+public enum OptimizeWhy { Replace, NotAGameFile, OtherGame, NoContent, Missing, TitleUnknown }
+
+public sealed record OptimizeDecision(string File, OptimizeWhy Why, long Size);
+
+public static class StorageOptimizer
+{
+    public const string SettingKey = "optimize_storage";
+    public const string Title = "Optimize storage";
+    public const string Note = "Removes a game's file (.nsp, .xci, .nsz, .nup) once it is extracted. The game stays in the library and plays from its extraction; a later rebuild uses the extraction. Off: the files are kept.";
+
+    private static bool Truthy(string v) => (v ?? "").Trim().ToLowerInvariant() is "1" or "on" or "yes" or "true";
+
+    /// The toggle: optimize_storage when the file has it; else patch 0068's remove_source_after_build when the owner had STORED it on (carried over); else OFF (the default).
+    public static bool ToggleOn(string settingsText)
+    {
+        var v = GameAppUi.AppSetting(settingsText, SettingKey, null);
+        if (v != null) return Truthy(v);
+        var old = GameAppUi.AppSetting(settingsText, SourceRemoval.SettingKey, null);
+        return old != null && Truthy(old);
+    }
+
+    /// The files an extraction read (`files`: the base game, the update and the DLC it took), each decided on its own. `extractedTid`: the base title id the extraction holds (ExeFS/main.npdm), null when unknown
+    /// (then nothing goes). A file goes only when it is a game file (never prod.keys or anything else), of the extracted title (by its file name's id; a file with no id only when it is the base game file itself, the
+    /// one that was extracted), and it has content now.
+    public static List<OptimizeDecision> Plan(string game, IEnumerable<string> files, string extractedTid, Func<string, long> sizeOf)
+    {
+        var tid = GameSlot.Norm(extractedTid);
+        var list = new List<OptimizeDecision>();
+        foreach (var f in (files ?? Array.Empty<string>()).Where(f => !string.IsNullOrEmpty(f)).Distinct(StringComparer.OrdinalIgnoreCase))
+        {
+            if (!BuiltLedger.IsGameFile(f)) { list.Add(new OptimizeDecision(f, OptimizeWhy.NotAGameFile, 0)); continue; }
+            if (tid == null) { list.Add(new OptimizeDecision(f, OptimizeWhy.TitleUnknown, 0)); continue; }
+            var ftid = GameAppUi.BaseTitleIdOf(f);
+            if (ftid == null ? !string.Equals(f, game, StringComparison.Ordinal) : !string.Equals(ftid, tid, StringComparison.Ordinal)) { list.Add(new OptimizeDecision(f, OptimizeWhy.OtherGame, 0)); continue; }
+            long size;
+            try { size = sizeOf(f); } catch (Exception) { size = -1; }
+            list.Add(new OptimizeDecision(f, size < 0 ? OptimizeWhy.Missing : size == 0 ? OptimizeWhy.NoContent : OptimizeWhy.Replace, Math.Max(0, size)));
+        }
+        return list;
+    }
+
+    /// The import record that makes the empty file a stub (SourceStub.IsStub: size 0 and Removed): the app's own record when it has one (its source stays: "Add it again from <source>"), marked removed now; else a new
+    /// one: how "hand" (the file was put into iBuilder's folder), source "iBuilder's folder".
+    public static ImportRecord StubRecord(string name, long size, ImportRecord existing, string now) =>
+        existing != null ? existing with { Size = size, RemovedAt = now } : new ImportRecord(name, size, ImportHow.ByHand, "iBuilder's folder", "", now, now);
+
+    /// Replaces each Replace file by an empty stub: the import ledger FIRST (the record says "removed"), then SourceStub.Replace (one rename over the file); a stub that cannot be made puts the ledger back and leaves
+    /// the file as it was. One log line per file. Returns the bytes freed. Worker threads only.
+    public static long Execute(string documents, IEnumerable<OptimizeDecision> plan, Action<string> log, Action<string, string> move = null)
+    {
+        long freed = 0;
+        foreach (var d in plan ?? Array.Empty<OptimizeDecision>())
+        {
+            if (d.Why == OptimizeWhy.OtherGame) { log?.Invoke($"storage: {d.File} kept (it is not the extracted game's)"); continue; }
+            if (d.Why != OptimizeWhy.Replace) continue;
+            var path = Path.Combine(documents, d.File);
+            try
+            {
+                ImportRecord before = null;
+                var now = ImportLedger.Now();
+                ImportLedger.Update(documents, list => { before = ImportLedger.Find(list, d.File); return ImportLedger.Upsert(list, StubRecord(d.File, d.Size, before, now)); });
+                try { SourceStub.Replace(path, move); }
+                catch
+                {
+                    ImportLedger.Update(documents, list => before != null ? ImportLedger.Upsert(list, before) : ImportLedger.Remove(list, new[] { d.File }));   // as it was
+                    throw;
+                }
+                freed += d.Size;
+                log?.Invoke($"storage: {d.File} ({GameAppUi.SizeText(d.Size)}) replaced by an empty placeholder: the game is extracted (Optimize storage); it plays from its build and a rebuild uses the extraction");
+            }
+            catch (Exception e) { log?.Invoke($"storage: {d.File} was not removed ({e.Message})"); }
+        }
+        return freed;
+    }
+}
