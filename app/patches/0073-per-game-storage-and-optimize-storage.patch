+// gameapp/GameAppSlotUi.cs -- one folder per game for its build, rebuilds from the extraction, the games brought back from what is on disk, and "Optimize storage": the view controller's half (patch 0073). The plans,
+// the journal, the moves, the marker, the names and the stubs are in GameAppSlot.cs (no UIKit, run by the host harness).
+//
+//   * EnsureSlotFor(game): Documents holds this game's build, or is free for it, before anything reads or writes the slot: a build (BeginRun), Play (PrimaryTapped, before gameapp.boot-only is written: the next
+//     launch boots Documents/DmGameProbe.framework), an export (ConfirmExport). The other game's slot is parked in Documents/games/<TITLE ID>/slot/, this game's comes back from there. Renames only (the same APFS
+//     volume: no copy, no walk), on the main thread; never while a build or a boot runs, an export is going or being sized, or a delete runs (the answer is no and the log says why).
+//   * RecoverSlotAtLaunch: a move the last launch was killed in the middle of is finished (Documents/gameapp.slot.tsv), before the library is drawn; what a move put aside (.slot-trash) is deleted on a worker.
+//   * A parked game whose stamp this version of the app made is READY (UiFacts.Parked): Play, Export IPA, its settings, saves and mods; Play brings its slot back first.
+//   * A rebuild without the game file: Set up / Rebuild / "the framework on disk was not built by this version" / the queue, when the file (or its update / DLC) has no content but the game's extraction is on disk
+//     (in Documents or parked, with its marker and the same update / DLC): the extraction is not run again and the chain is not given nup= (the chain builds from extract/ExeFS and RomFS.img).
+//   * After an extraction (the C# step for .nsp .xci .nsz; for a .nup the chain's return when it read the package): the marker Documents/gameapp.extracted, then, with Settings > Optimize storage on, the base file, the
+//     update and the DLC it read become empty stubs.
+//   * At launch and back from the background (KeepBuiltGames' worker, patch 0071): a slot, in Documents or parked, whose game has no file in Documents gets its placeholder back.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+
+using Foundation;
+using UIKit;
+
+public sealed partial class GameAppViewController
+{
+    /// FolderSizes keys (GameAppPerf.cs): every parked slot (Documents/games/*/slot, measured rarely: a move or a delete invalidates it), and the open game sheet's own parked slot.
+    internal const string ParkedSizeKey = "parked", GameSlotSizeKey = "game-slot";
+
+    private List<SlotView> parkedCache;
+    private DateTime parkedRead = DateTime.MinValue;
+
+    /// The parked slots, read again at most every 5 s or when a move changed them (a listing of games/ and a few stats: the screens ask at every refresh).
+    private List<SlotView> ParkedSlots()
+    {
+        if (GameExport.IsPlayer) return new List<SlotView>();
+        if (parkedCache == null || (DateTime.UtcNow - parkedRead).TotalSeconds > 5)
+        {
+            parkedCache = SlotStore.ListParked(GameAppMain.Documents);
+            parkedRead = DateTime.UtcNow;
+        }
+        return parkedCache;
+    }
+
+    private void SlotsChanged()
+    {
+        parkedCache = null;
+        sizes.Invalidate(FolderSizes.Extract, FolderSizes.Framework, ParkedSizeKey);
+    }
+
+    /// The parked games that are ready: their stamp was made by this version of the app and their framework and flat/ are there. Game file -> the stamp's content= (for "Update available").
+    private IReadOnlyDictionary<string, string> ParkedReadyGames()
+    {
+        var map = new Dictionary<string, string>(StringComparer.Ordinal);
+        foreach (var p in ParkedSlots())
+            if (!string.IsNullOrEmpty(p.Stamp?.Game) && GameAppUi.ClassifyFramework(p.FrameworkOnDisk && p.FlatOnDisk, p.StampText, GameAppBuild.Id) == FrameworkState.Fresh)
+                map[p.Stamp.Game] = p.Stamp.Content;
+        return map;
+    }
+
+    /// This game's parked slot, or null.
+    private SlotView ParkedSlotOf(string game) => game == null ? null : ParkedSlots().FirstOrDefault(p => p.BelongsTo(game, GameAppUi.BaseTitleIdOf(game)));
+
+    /// The bytes of every parked slot (Documents/games/<id>/slot). A walk: worker threads only (FolderSizes).
+    private static long ParkedBytes(string gamesRoot)
+    {
+        long total = 0;
+        try
+        {
+            if (!Directory.Exists(gamesRoot)) return 0;
+            foreach (var dir in Directory.EnumerateDirectories(gamesRoot))
+            {
+                var slot = Path.Combine(dir, GameSlot.SlotFolder);
+                if (GameSlot.IsTitleId(Path.GetFileName(dir)) && Directory.Exists(slot)) total += FolderWalk.Bytes(slot);
+            }
+        }
+        catch (Exception) { }
+        return total;
+    }
+
+    // ---- the slot for a game -------------------------------------------------------------------------------------------------------------------------------------
+
+    /// Documents holds `game`'s build, or is free for it. `why`: for the log ("a build", "Play", "the export"). False: it could not be done now (the log says why; the caller does nothing). Main thread; renames only.
+    private bool EnsureSlotFor(string game, string why)
+    {
+        if (GameExport.IsPlayer || string.IsNullOrEmpty(game)) return true;
+        if (running || exporting || exportSizing || deletes.Busy)
+        {
+            Write($"storage: {why} for {GameAppUi.DisplayName(game)}: not now ({(running ? "a build or a game is running" : deletes.Busy ? "a delete is going" : "an export is going")})");
+            return false;
+        }
+        var docs = GameAppMain.Documents;
+        var tid = GameAppUi.BaseTitleIdOf(game);
+        SlotDecision plan;
+        try
+        {
+            var trashName = DateTime.UtcNow.ToString("yyyyMMdd-HHmmss", System.Globalization.CultureInfo.InvariantCulture) + "-" + Guid.NewGuid().ToString("N").Substring(0, 6);
+            plan = SlotPlanner.For(game, tid, SlotStore.Read(docs), SlotStore.ListParked(docs), trashName);
+        }
+        catch (Exception error) { Write($"storage: the slot could not be read ({error.Message}): {why} not started"); return false; }
+        if (plan.Ops.Count == 0) return true;
+        Write($"storage: {why} for {GameAppUi.DisplayName(game)}: {plan.Note}");
+        var lines = new List<string>();
+        bool ok;
+        List<string> trash;
+        try { trash = SlotMover.Run(docs, plan.Ops, tid, lines.Add, out ok); }
+        catch (Exception error) { lines.Add($"storage: the slot move failed ({error.Message})"); trash = new List<string>(); ok = false; }
+        foreach (var line in lines) Write(line);
+        DeleteSlotTrash(trash);
+        SlotsChanged();
+        RefreshScreen();
+        if (!ok) Write($"storage: {why} for {GameAppUi.DisplayName(game)} is not started: the slot could not be prepared");
+        return ok;
+    }
+
+    /// What a move put aside: deleted on a worker (one at a time with nothing else: these folders are outside every path the app reads). Not on the delete queue: a launch that boots must not wait for it.
+    private void DeleteSlotTrash(IEnumerable<string> folders)
+    {
+        var list = (folders ?? Array.Empty<string>()).Where(Directory.Exists).ToList();
+        if (list.Count == 0) return;
+        var docs = GameAppMain.Documents;
+        Task.Run(() =>
+        {
+            var notes = new List<string>();
+            foreach (var f in list)
+                try { BackgroundDelete.DeleteTree(f); notes.Add($"storage: {Path.GetFileName(f)} put aside by a slot move: deleted"); }
+                catch (Exception error) { notes.Add($"storage: {f} could not be deleted ({error.Message}): it is tried again at the next launch"); }
+            try { var root = Path.Combine(docs, GameSlot.TrashRoot); if (Directory.Exists(root) && !Directory.EnumerateFileSystemEntries(root).Any()) Directory.Delete(root); } catch (Exception) { }
+            BeginInvokeOnMainThread(() => { foreach (var n in notes) Write(n); sizes.Invalidate(); });
+        });
+    }
+
+    /// At launch, before the library is drawn: a slot move the last process was killed in the middle of is finished; what an earlier move put aside is deleted on a worker. Renames only on this thread.
+    private void RecoverSlotAtLaunch()
+    {
+        if (GameExport.IsPlayer) return;
+        var docs = GameAppMain.Documents;
+        var lines = new List<string>();
+        var trash = SlotJournal.Recover(docs, lines.Add);
+        foreach (var line in lines) Write(line);
+        try
+        {
+            var root = Path.Combine(docs, GameSlot.TrashRoot);
+            if (Directory.Exists(root)) trash.AddRange(Directory.EnumerateDirectories(root));
+        }
+        catch (Exception) { }
+        DeleteSlotTrash(trash.Distinct().ToList());
+        if (lines.Count > 0) parkedCache = null;
+    }
+
+    // ---- a rebuild from the extraction -------------------------------------------------------------------------------------------------------------------------------
+
+    /// Where `game`'s extraction is, when it can stand in for its files (ExtractionUse.Usable: the whole extraction, this game's, with the update and DLC in Documents now): "in Documents" or "parked in
+    /// games/<id>/slot"; null when it is not on this iPhone. A few stats and small reads.
+    private string ExtractionOnDisk(string game)
+    {
+        if (GameExport.IsPlayer || string.IsNullOrEmpty(game)) return null;
+        try
+        {
+            var docs = GameAppMain.Documents;
+            var content = GameAppUi.ContentSignature(game, Dumps().Select(Path.GetFileName).ToList());
+            var tid = GameAppUi.BaseTitleIdOf(game);
+            if (ExtractionUse.Usable(SlotStore.Read(docs), game, tid, content)) return "in Documents";
+            foreach (var p in SlotStore.ListParked(docs))
+                if (ExtractionUse.Usable(p, game, tid, content)) return "parked in " + GameSlot.ParkedRelative(p.FolderTid);
+        }
+        catch (Exception) { }
+        return null;
+    }
+
+    /// The extraction in Documents (the slot in use) can stand in for `game`'s files.
+    private bool ActiveExtractionFor(string game)
+    {
+        try { return ExtractionUse.Usable(SlotStore.Read(GameAppMain.Documents), game, GameAppUi.BaseTitleIdOf(game), GameAppUi.ContentSignature(game, Dumps().Select(Path.GetFileName).ToList())); }
+        catch (Exception) { return false; }
+    }
+
+    // ---- after an extraction ---------------------------------------------------------------------------------------------------------------------------------------
+
+    /// The extraction of `game` is complete in Documents/extract (`used`: the game files it read; `content`: their update / DLC signature, as the build's config has it): the marker, then, with the toggle on, the
+    /// stubs. `say` posts a log line. Worker threads only; never throws.
+    private void AfterExtraction(string game, IReadOnlyList<string> used, string content, bool optimize, Action<string> say)
+    {
+        try
+        {
+            var docs = GameAppMain.Documents;
+            var extract = Path.Combine(docs, GameSlot.Extract);
+            var slot = SlotStore.Read(docs);
+            var tid = SlotStore.NpdmTitleId(Path.Combine(extract, "ExeFS", "main.npdm")) ?? slot.ProfileTid;
+            var fileTid = GameAppUi.BaseTitleIdOf(game);
+            if (!slot.HasExtraction || tid == null || (fileTid != null && !string.Equals(fileTid, tid, StringComparison.Ordinal)))
+            {
+                say($"storage: the extraction of {game} is not marked ({(!slot.HasExtraction ? "extract/ExeFS/main or extract/RomFS.img is missing" : tid == null ? "its title id cannot be read" : $"it holds {tid}, the file names {fileTid}")}): a rebuild will need the file");
+                return;
+            }
+            ExtractionMark.Write(docs, new ExtractionMark(game, tid, content ?? "", ImportLedger.Now()));
+            say($"storage: the extraction of {game} ({tid}) is complete: a rebuild can start from it (Documents/{ExtractionMark.FileName})");
+            if (!optimize) return;
+            var plan = StorageOptimizer.Plan(game, used, tid, f => { var i = new FileInfo(Path.Combine(docs, f)); return i.Exists ? i.Length : -1; });
+            var lines = new List<string>();
+            long freed = StorageOptimizer.Execute(docs, plan, lines.Add);
+            foreach (var line in lines) say(line);
+            if (freed > 0) BeginInvokeOnMainThread(() => { sizes.Invalidate(); RefreshScreen(); });
+        }
+        catch (Exception error) { say($"storage: after the extraction of {game}: {error.GetType().Name}: {error.Message}"); }
+    }
+
+    // ---- recovery: games from what is on disk -----------------------------------------------------------------------------------------------------------------------
+
+    /// The slot in Documents and every parked one: a game whose build or extraction is here and whose file is not in Documents gets its placeholder back (SlotRecovery). Worker threads only (KeepBuiltGames).
+    /// Returns how many were made.
+    private int RecoverGamesFromSlots(string documents, List<string> lines)
+    {
+        int made = 0;
+        var slots = new List<SlotView> { SlotStore.Read(documents) };
+        slots.AddRange(SlotStore.ListParked(documents));
+        var built = BuiltLedger.Load(documents);
+        var imports = ImportLedger.Load(documents);
+        foreach (var slot in slots.Where(s => s.HasContent && s.Tid != null))
+        {
+            var name = SlotRecovery.NameFor(slot, built, imports);
+            if (name == null)
+            {
+                string title = null;
+                try { var nacp = Path.Combine(slot.Root, GameSlot.Extract, "control.nacp"); if (File.Exists(nacp) && new FileInfo(nacp).Length <= (1 << 20)) title = SlotRecovery.NacpTitle(File.ReadAllBytes(nacp)); } catch (Exception) { }
+                bool switch2 = SlotRecovery.LooksLikeSwitch2(slot.Root);
+                name = SlotRecovery.Synthesize(title, slot.Tid, switch2);
+                lines.Add($"storage: the build of {slot.Tid} ({(slot.FolderTid == null ? "Documents" : GameSlot.ParkedRelative(slot.FolderTid))}) names no game file: it is listed as \"{name}\" ({(switch2 ? "a Switch 2 game: its sdk is the Switch 2's" : "a Switch game")}{(title == null ? ", no name in its control data" : "")})");
+            }
+            var decision = SlotRecovery.Decide(slot, name, Dumps().Select(Path.GetFileName).ToList());
+            if (decision.Why != RecoverWhy.Recreate) continue;
+            try { if (SlotRecovery.Recreate(documents, decision, lines.Add)) made++; }
+            catch (Exception error) { lines.Add($"storage: {name} could not be put back in the library ({error.Message})"); }
+        }
+        return made;
+    }
+}
