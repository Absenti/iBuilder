diff -ruN a/GameAppUi.cs b/GameAppUi.cs
--- a/GameAppUi.cs
+++ b/GameAppUi.cs
@@ -981,6 +981,12 @@
             }
         }
         catch (Exception) { rows.Clear(); }
+        // A game's catalogue without a frame-rate row (Mario Kart 8 Deluxe's has none) gets one: the engine's DM_FPS_TARGET (30 or 60, 0 = the game's own), read at the start of the game.
+        // 30 keeps a frame budget of 33 ms when the phone is hot (the GPU slows down at "Serious": 19-21 ms a frame in device logs, 2026-11-19).
+        if (rows.Count > 0 && !rows.Any(r => r.Env == "DM_FPS_TARGET"))
+            rows.Insert(0, new LauncherRow("DM_FPS_TARGET", "choice", "Game", "Frame rate",
+                                           "Caps the frame rate: 30 stays steadier when the phone gets hot, 60 asks for more. Applies the next time the game starts.", "0", true, null, null,
+                                           new (string, string)[] { ("0", "Game's own"), ("30", "30 fps"), ("60", "60 fps") }, null, null, 0, 0, 0, null));
         return rows;
     }
 
