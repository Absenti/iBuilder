+    /// Patch 0097: the written .ipa opened again: its app Info.plist is there, parses, has CFBundleIdentifier, CFBundleExecutable and CFBundleVersion, and its local header lies below 4 GiB
+    /// (what a signer's unzip needs, ZIP64 or not). Throws with what is wrong: the export fails, the .part is removed.
+    private static void VerifyIpa(string ipa, string plistEntry, Action<string> log)
+    {
+        using var stream = new FileStream(ipa, FileMode.Open, FileAccess.Read, FileShare.Read, 1 << 16);
+        long offset = ExportZip.LocalHeaderOffset(stream, plistEntry);
+        stream.Position = 0;
+        byte[] bytes;
+        using (var zip = new ZipArchive(stream, ZipArchiveMode.Read, leaveOpen: true))
+        {
+            var entry = zip.GetEntry(plistEntry) ?? throw new InvalidOperationException($"the written .ipa has no {plistEntry}: the export failed");
+            using var input = entry.Open();
+            using var ms = new MemoryStream();
+            input.CopyTo(ms);
+            bytes = ms.ToArray();
+        }
+        var format = NSPropertyListFormat.Xml;
+        var dict = NSPropertyListSerialization.PropertyListWithData(NSData.FromArray(bytes), NSPropertyListReadOptions.Immutable, ref format, out NSError error) as NSDictionary
+                   ?? throw new InvalidOperationException("the written .ipa's Info.plist does not parse: " + error?.LocalizedDescription);
+        var missing = ExportZip.Missing(k => (dict[k] as NSString)?.ToString());
