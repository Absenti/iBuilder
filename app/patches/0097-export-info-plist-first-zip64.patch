+/// Patch 0097 (the owner: FlareStore, a zsign-based signer, on a FULL export: "Can't get BundleID, BundleVersion, or BundleExecute in Info.plist!"): the app's Info.plist was the LAST
+/// entry of the .ipa, after the multi-GB RomFS.img, so its local header lay beyond 4 GiB (a ZIP64 offset) and the signer's unzip gave no Info.plist. The bundle's own files come first now,
+/// the game's small files after them, the big ones last (the largest last of all), so every piece of bundle metadata sits below 4 GiB; an .ipa past 4 GB is said before the export, and
+/// the written .ipa is opened again and its Info.plist checked.
+public static class ExportZip
+{
+    public const long Limit = 0xFFFFFFFFL;   // the 32-bit ZIP fields: past this a size or an offset is ZIP64
+    public const long Big = 64L << 20;       // a "big" file of the game's data
+
+    /// The order of the entries: 0 the app's Info.plist, 1 the framework's Info.plist, 2 the rest of the bundle (executable, icons, PkgInfo, Frameworks/*) in their order, 3 the game's
+    /// data under `<app>/<dataFolder>/` smaller than Big in their order, 4 its big files by size, the largest (RomFS.img) last.
+    public static List<T> Order<T>(IEnumerable<T> items, Func<T, string> name, Func<T, long> size, string app, string dataFolder)
+    {
+        var list = (items ?? Enumerable.Empty<T>()).Select((x, i) => (x, i)).ToList();
+        int Rank(T x)
+        {
+            var n = name(x);
+            if (n == app + "Info.plist") return 0;
+            if (n == app + "Frameworks/DmGameProbe.framework/Info.plist") return 1;
+            if (!n.StartsWith(app + dataFolder + "/", StringComparison.Ordinal)) return 2;
+            return size(x) < Big ? 3 : 4;
+        }
+        return list.OrderBy(p => Rank(p.x)).ThenBy(p => Rank(p.x) == 4 ? size(p.x) : 0).ThenBy(p => p.i).Select(p => p.x).ToList();
+    }
+
+    /// The entries whose data starts at or past 4 GiB (or are bigger than it) in this order, with ~`header` bytes of local header each: they need ZIP64.
+    public static List<string> AboveLimit<T>(IEnumerable<T> ordered, Func<T, string> name, Func<T, long> size, long header = 128)
+    {
+        var above = new List<string>();
+        long at = 0;
+        foreach (var x in ordered ?? Enumerable.Empty<T>())
+        {
+            if (at > Limit || size(x) > Limit) above.Add(name(x));
+            at += header + Math.Max(0, size(x));
+        }
+        return above;
+    }
+
+    public static bool OverLimit(long bytes) => bytes > Limit;
+
+    public const string Warning = "This IPA is larger than 4 GB: some signing tools (FlareStore and other on-device signers) cannot open it. Use the slim export (the game's files are copied beside it) if the install fails.";
+
+    /// "export: 14.6 GB, ZIP64 (entries above 4 GB: Payload/…/RomFS.img)", or the plain size line.
+    public static string SizeLine(long total, IReadOnlyList<string> above) =>
+        "export: " + GameAppUi.SizeText(total) + (OverLimit(total) || (above?.Count ?? 0) > 0 ? ", ZIP64 (entries above 4 GB: " + ((above?.Count ?? 0) == 0 ? "none" : string.Join(", ", above)) + ")" : ", no ZIP64");
+
+    /// What zsign's GetSignFolderInfo needs in the app's Info.plist; the export refuses a plist without them (it was written from an empty dictionary when the bundle's could not be read).
+    public static readonly IReadOnlyList<string> Required = new[] { "CFBundleIdentifier", "CFBundleExecutable", "CFBundleVersion" };
+
+    public static List<string> Missing(Func<string, string> value) => Required.Where(k => string.IsNullOrEmpty(value(k))).ToList();
+
+    /// The local header offset of `entryName` in a zip, from its central directory (ZIP64 records and extra fields read); -1 when it is not there or the file is not a zip this reads.
+    public static long LocalHeaderOffset(Stream s, string entryName)
+    {
+        try
+        {
+            long len = s.Length;
+            int tail = (int) Math.Min(len, 65557);
+            var buf = new byte[tail];
+            s.Position = len - tail;
+            if (s.ReadAtLeast(buf, tail, false) != tail) return -1;
+            int eocd = -1;
+            for (int i = tail - 22; i >= 0; i--) if (BitConverter.ToUInt32(buf, i) == 0x06054b50) { eocd = i; break; }
+            if (eocd < 0) return -1;
+            long cdOffset = BitConverter.ToUInt32(buf, eocd + 16), cdSize = BitConverter.ToUInt32(buf, eocd + 12);
+            long entries = BitConverter.ToUInt16(buf, eocd + 10);
+            if (cdOffset == 0xFFFFFFFF || cdSize == 0xFFFFFFFF || entries == 0xFFFF)
+            {
+                int loc = eocd - 20;
+                if (loc < 0 || BitConverter.ToUInt32(buf, loc) != 0x07064b50) return -1;
+                long z64 = (long) BitConverter.ToUInt64(buf, loc + 8);
+                var rec = new byte[56];
+                s.Position = z64;
+                if (s.ReadAtLeast(rec, 56, false) != 56 || BitConverter.ToUInt32(rec, 0) != 0x06064b50) return -1;
+                entries = (long) BitConverter.ToUInt64(rec, 32);
+                cdSize = (long) BitConverter.ToUInt64(rec, 40);
+                cdOffset = (long) BitConverter.ToUInt64(rec, 48);
+            }
+            if (cdSize <= 0 || cdSize > 512L << 20) return -1;
+            var cd = new byte[cdSize];
+            s.Position = cdOffset;
+            if (s.ReadAtLeast(cd, (int) cdSize, false) != cdSize) return -1;
+            var want = System.Text.Encoding.UTF8.GetBytes(entryName);
+            int p = 0;
+            for (long k = 0; k < entries && p + 46 <= cd.Length; k++)
+            {
+                if (BitConverter.ToUInt32(cd, p) != 0x02014b50) return -1;
+                int nameLen = BitConverter.ToUInt16(cd, p + 28), extraLen = BitConverter.ToUInt16(cd, p + 30), commentLen = BitConverter.ToUInt16(cd, p + 32);
+                if (nameLen == want.Length && cd.AsSpan(p + 46, nameLen).SequenceEqual(want))
+                {
+                    long usize = BitConverter.ToUInt32(cd, p + 24), csize = BitConverter.ToUInt32(cd, p + 20), off = BitConverter.ToUInt32(cd, p + 42);
+                    if (off != 0xFFFFFFFF) return off;
+                    int e = p + 46 + nameLen, end = e + extraLen;
+                    while (e + 4 <= end)
+                    {
+                        int id = BitConverter.ToUInt16(cd, e), size = BitConverter.ToUInt16(cd, e + 2);
+                        if (id == 1)
+                        {
+                            int q = e + 4;
+                            if (usize == 0xFFFFFFFF) q += 8;
+                            if (csize == 0xFFFFFFFF) q += 8;
+                            return q + 8 <= e + 4 + size ? (long) BitConverter.ToUInt64(cd, q) : -1;
+                        }
+                        e += 4 + size;
+                    }
+                    return -1;
+                }
+                p += 46 + nameLen + extraLen + commentLen;
+            }
+            return -1;
+        }
+        catch (Exception) { return -1; }
+    }
+}
