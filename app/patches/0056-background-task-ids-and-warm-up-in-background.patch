diff -ruN a/GameAppExport.cs b/GameAppExport.cs
--- a/GameAppExport.cs
+++ b/GameAppExport.cs
@@ -318,6 +318,16 @@
         var dict = NSMutableDictionary.FromFile(original) ?? new NSMutableDictionary();
         var baseId = OriginalBundleId(dict);
         dict["CFBundleIdentifier"] = new NSString(GameAppUi.ExportBundleId(baseId, titleId));
+        // The background task (the shader warm-up keeps going when the app is left) is "<runtime bundle id>.build.<n>" and Info.plist must permit THAT id: the player's own, and the one an installer
+        // gives it (a team suffix: dev.nxpocket.gameapp.<TEAM> -> the suffix is kept after the player's id). The wildcard of the base app does not match (device test, 2026-11-19).
+        {
+            var exportId = GameAppUi.ExportBundleId(baseId, titleId);
+            var runtimeId = NSBundle.MainBundle.BundleIdentifier ?? baseId;
+            var suffix = runtimeId.StartsWith(baseId, StringComparison.Ordinal) ? runtimeId.Substring(baseId.Length) : "";
+            var permitted = new List<string> { exportId + ".build.*" };
+            if (suffix.Length > 0) permitted.Add(exportId + suffix + ".build.*");
+            dict["BGTaskSchedulerPermittedIdentifiers"] = NSArray.FromStrings(permitted.ToArray());
+        }
         // the installer's own keys (ALTBundleIdentifier, ALTAppGroups, ALTPairingFile ...) are its to write again at the next install
         foreach (var key in dict.Keys.Select(k => k.ToString()).Where(k => k.StartsWith("ALT", StringComparison.Ordinal)).ToList())
             dict.Remove(new NSString(key));
