+}
+
+/// Patch 0082 (review M1): the end of a download on the main thread: a Cancel that came after the worker's last look (the last block written, the cover pass reading) still counts, and the
+/// flag is cleared there, so it never leaks into the next download of the name. True: cancelled.
+public static class DownloadEnd
+{
+    public static bool Cancelled(bool workerSawCancel, CancelFlags flags, string key)
+    {
+        bool cancelled = workerSawCancel || (flags != null && flags.IsRequested(key));
+        flags?.Clear(key);
+        return cancelled;
     }
 }
 
