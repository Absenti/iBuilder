+/// Patch 0082 (the owner): a game's settings (its sheet or iPad inspector: frame rate, upscaler, memory saver, mods, saves, logs, export) exist ONLY for a BUILT game. A game on this iPhone that
+/// is not built has a small action sheet instead ("Choose a cover…", "Delete the game file"); a game only in the cloud has Download / Cancel and Hide from the library.
+public static class GameSettingsRule
+{
+    public static bool HasSettings(LibState state) => state == LibState.Built;
+
+    public const string NotBuiltNote = "Not built yet: its settings come once it is built";
+
+    /// Review L6: a tap on Settings while a build runs said nothing.
+    public const string BusyTitle = "A build is running", BusyNote = "The game's settings open once the build ends. Watch the build shows how far it is.";
+}
+
+/// Patch 0082 (review M3): the redraw key of the Library's cards, the carousel's buttons and the Build tab's rows: what makes them be BUILT again (names, states, labels, what is on),
+/// never a percentage: a redraw every second during a download updates the bars and the words in place, so a tap, a 0.5 s hold or VoiceOver's focus is not lost.
+public static class RedrawKey
+{
+    public static string Of(IEnumerable<string> parts) => string.Join("\u001f", parts ?? Enumerable.Empty<string>());
+
+    public static string Card(string name, LibState state, bool update, bool busy, bool canRun, bool hasIcon, bool warm) =>
+        Of(new[] { name, state.ToString(), update ? "u" : "", busy ? "b" : "", canRun ? "r" : "", hasIcon ? "i" : "", warm ? "w" : "" });
+
+    public static string Row(BuildRowView r) => Of(new[] { r.Name, r.Act.ToString(), r.Button, r.Primary ? "p" : "", r.HasMore ? "m" : "", r.Cloud ? "c" : "", r.Fraction == null ? "" : "f" });
+}
+
+/// Patch 0082 (review L7): "Remove download (stays in the cloud)" is offered and done only for a file the app itself brought from that source (its import record names the source), or one
+/// whose size is the cloud file's: a hand-placed file that merely has the name of a cloud file (now likelier with 0077/0079's subfolders) is never called a download.
+public static class DownloadPairing
+{
+    public static bool SameFile(long localSize, CloudFile cloud, ImportRecord record)
+    {
+        if (cloud == null) return false;
+        bool imported = record != null && !record.Removed && record.SourceId == cloud.SourceId
+                        && (record.How == ImportHow.Download || record.How == ImportHow.Clone || record.How == ImportHow.Copy);
+        return imported || (cloud.Size > 0 && localSize > 0 && cloud.Size == localSize);
+    }
+}
+
+/// Patch 0082: the Build tab of the prototype: READY TO BUILD (the games of this iPhone that need a build) and IN THE CLOUD, each a compact row, a count beside each section's title; the
+/// header's counts come from the same list, so they can never disagree with the rows (the "0 on this iPhone" seen on the owner's phone beside a listed game).
+public sealed record BuildGame(string Name, LibState State, string Size, string CloudWhere, bool Update, double? Fraction);
+public sealed record BuildRowView(string Name, string Note, bool NoteAccent, LibAct Act, string Button, bool Primary, bool HasMore, bool Cloud, double? Fraction);
+public sealed record BuildSection(string Title, int Count, IReadOnlyList<BuildRowView> Rows);
+
+public static class BuildList
+{
+    public const string IdleTitle = "Nothing is building", IdleNote = "A build ends on Ready. Play starts the game.", RunningNote = "Continues if you leave the app.";
+
+    private static string Pct(double? f) => Math.Round(Math.Max(0, Math.Min(1, f ?? 0)) * 100).ToString("0", CultureInfo.InvariantCulture);
+
+    public static BuildRowView Row(BuildGame g)
+    {
+        string Sized(string s) => string.IsNullOrEmpty(g.Size) ? s : g.Size + " · " + s;
+        switch (g.State)
+        {
+            case LibState.CloudOnly: return new BuildRowView(g.Name, Sized(g.CloudWhere ?? "In the cloud"), false, LibAct.Download, "Download", true, false, true, null);
+            case LibState.Downloading: return new BuildRowView(g.Name, $"Downloading · {Pct(g.Fraction)} %", true, LibAct.CancelDownload, "Cancel", false, false, true, g.Fraction ?? 0);
+            case LibState.Built when g.Update: return new BuildRowView(g.Name, Sized("Update available"), false, LibAct.Update, "Update", true, true, false, null);
+            default: return new BuildRowView(g.Name, Sized("Not built"), false, LibAct.Build, "Build", true, true, false, null);
+        }
+    }
+
+    /// READY TO BUILD: on this iPhone and not built (or built before an update or DLC was added); IN THE CLOUD: only in a cloud source. A game being built or paused is the "Now building"
+    /// card's, a built one the Library's. An empty section is not shown.
+    public static List<BuildSection> Sections(IEnumerable<BuildGame> games)
+    {
+        var list = (games ?? Enumerable.Empty<BuildGame>()).ToList();
+        var ready = list.Where(g => g.State == LibState.NotBuilt || (g.State == LibState.Built && g.Update)).Select(Row).ToList();
+        var cloud = list.Where(g => g.State == LibState.CloudOnly || g.State == LibState.Downloading).Select(Row).ToList();
+        var sections = new List<BuildSection>();
+        if (ready.Count > 0) sections.Add(new BuildSection("Ready to build", ready.Count, ready));
+        if (cloud.Count > 0) sections.Add(new BuildSection("In the cloud", cloud.Count, cloud));
+        return sections;
+    }
+
+    /// The header's line, from the same games: "3 on this iPhone · 2 in the cloud · 1 queued".
+    public static string Header(IEnumerable<BuildGame> games, int queued, string device)
+    {
+        var list = (games ?? Enumerable.Empty<BuildGame>()).ToList();
+        int cloud = list.Count(g => g.State == LibState.CloudOnly || g.State == LibState.Downloading), local = list.Count - cloud;
+        return $"{local} on this {device}" + (cloud > 0 ? $" · {cloud} in the cloud" : "") + (queued > 0 ? $" · {queued} queued" : "");
+    }
+}
+
