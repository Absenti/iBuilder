+/// One entry of a NAS folder as the SFTP listing gives it (the attributes come with the listing: no file is opened).
+/// `IsLink`: a symbolic link (the server reports the link itself, not what it points to), never followed into.
+public sealed record NasEntry(string Name, string FullName, bool IsDirectory, bool IsLink, long Size);
+
+/// What a listing found. `Files`: the CloudFile rows, the first of two files of one name kept (the sync folder's own
+/// files first, then the subfolders by name). `Subfolders`: how many subfolders were listed (read: a subfolder whose
+/// listing failed is not counted, it is in `Unreadable`); `Looked`: how many were tried (the cap: at most
+/// MaxSubfolders); `SubfoldersFound`: how many the folder has that would be looked into (more than `Looked` when the cap
+/// was hit). `Clashes`: the full paths of the files skipped because a file of the same name was already listed, with
+/// the one kept ("skipped -> kept"). `Unreadable`: subfolders whose listing failed ("path: why"), skipped.
+public sealed record NasScanResult(List<CloudFile> Files, int Subfolders, int Looked, int SubfoldersFound, List<string> Clashes, List<string> Unreadable)
+{
+    public bool Capped => SubfoldersFound > Looked;
+}
+
+/// The NAS listing's choices, with no SSH in them (the real lister is Nas.List; the host harness hands a fake one).
+///
+/// Why one level and no more: the owner keeps his games one per folder under the sync folder ("games/<game>/
+/// <file>.nsz"); one level of subfolders finds those with one list call per folder, which stays light over SFTP on a
+/// phone. A tree deeper than that is reached by choosing a deeper folder as the sync folder (the folder chooser goes
+/// down any number of levels, ChooseNasFolder / BrowseNas). A subfolder's files keep their own name as the game's name
+/// (that is what the library, the download's destination in Documents and the update / DLC grouping work with:
+/// Cloud.CloudOnlyGames, Cloud.DownloadSet and GameAppUi.UpdateFor / DlcFor match by file name and title id, across
+/// the whole NAS source), and their real full path as Remote, which is what Nas.Download and Nas.WithReadStream read.
+/// Documents holds one file of a name, so two files of one name on the NAS cannot both be listed: the first stays,
+/// the other is skipped and named in the log.
+public static class NasScan
+{
+    /// At most this many subfolders are listed per refresh (by name, the rest are left out and the log says so):
+    /// a folder of thousands of subfolders costs thousands of round trips over SFTP. The cap is on the SUBFOLDERS looked
+    /// into (one list call each), not on files: every game file of a subfolder that is looked into is listed (its one
+    /// call returns them all), and so is every file of the sync folder itself.
+    public const int MaxSubfolders = 200;
+
+    /// Where "Send to the NAS" puts exported apps (GameAppLibrary SendToNas(..., "Exports")): listed for .ipa files
+    /// only, as before, and not counted among the game subfolders. Its name is matched ignoring case, like the NAS's own
+    /// folders (a share seen through a case-insensitive file system may show it as "exports"); a folder of exactly that
+    /// name is preferred when two of them differ only by case.
+    public const string ExportsFolder = "Exports";
+
+    /// `name` is the Exports folder's name, ignoring case.
+    public static bool IsExports(string name) => string.Equals(name, ExportsFolder, StringComparison.OrdinalIgnoreCase);
+
+    /// At most this many clash lines go to the log (then one "… and N more").
+    public const int MaxClashLines = 10;
+
+    // Folders a NAS makes by itself in every share (Synology's thumbnail and recycle-bin folders, QNAP's recycle bin
+    // and snapshots): never games, and @eaDir is in every folder, so each one would cost a list call for nothing.
+    private static readonly HashSet<string> SystemFolders = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
+        { "@eaDir", "#recycle", "#snapshot", "@Recycle", "@Recently-Snapshot", "@__thumb", ".@__thumb" };
+
+    /// A subfolder worth one list call: a real folder (not a link: a link back to the folder or above would list the
+    /// same files again, or loop), not hidden (".something"), not a NAS system folder, not Exports, not the folder itself.
+    public static bool LooksInto(NasEntry e, string dir)
+    {
+        if (e == null || !e.IsDirectory || e.IsLink || string.IsNullOrEmpty(e.Name)) return false;
+        if (e.Name == "." || e.Name == ".." || e.Name.StartsWith(".", StringComparison.Ordinal)) return false;
+        if (SystemFolders.Contains(e.Name) || IsExports(e.Name)) return false;
+        return !string.Equals((e.FullName ?? "").TrimEnd('/'), (dir ?? "").TrimEnd('/'), StringComparison.Ordinal);
+    }
+
+    /// A file of the sync folder itself that the library lists: a game or an .ipa, not an upload in progress (.part).
+    /// Unchanged from before 0077.
+    public static bool TopFile(NasEntry e) => e != null && !e.IsDirectory && Cloud.Wanted(e.Name) && !e.Name.EndsWith(".part");
+
+    /// A file of a subfolder that the library lists: a game file (.nsp .xci .nsz .nup), not hidden (a Mac writes
+    /// "._Game.nsp" next to a game on some shares), not a link, not a .part.
+    public static bool SubfolderFile(NasEntry e) =>
+        e != null && !e.IsDirectory && !e.IsLink && !string.IsNullOrEmpty(e.Name) && !e.Name.StartsWith(".", StringComparison.Ordinal)
+        && Cloud.IsGameFile(e.Name) && !e.Name.EndsWith(".part");
+
+    /// `list(path)`: the entries of a folder (one SFTP list call). The sync folder's own listing failing is the
+    /// caller's error (it throws, as before 0077); a subfolder or Exports that cannot be listed is skipped and named in
+    /// Unreadable. `dir`: the sync folder as the listing names it ("." for the login folder).
+    public static NasScanResult Scan(string sourceId, string dir, Func<string, IEnumerable<NasEntry>> list, int maxSubfolders = MaxSubfolders)
+    {
+        var top = (list(dir) ?? Enumerable.Empty<NasEntry>()).Where(e => e != null).ToList();
+        var files = new List<CloudFile>();
+        var kept = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);   // name -> the full path listed
+        var clashes = new List<string>();
+        var unreadable = new List<string>();
+
+        void Add(NasEntry e)
+        {
+            if (kept.TryGetValue(e.Name, out var first)) { clashes.Add(e.FullName + " -> " + first); return; }
+            kept[e.Name] = e.FullName;
+            files.Add(new CloudFile(sourceId, e.Name, e.Size, e.FullName));
+        }
+
+        List<NasEntry> Sub(string path)
+        {
+            try { return (list(path) ?? Enumerable.Empty<NasEntry>()).Where(e => e != null).ToList(); }
+            catch (Exception ex) { unreadable.Add(path + ": " + ex.Message); return null; }
+        }
+
+        foreach (var e in top.Where(TopFile)) Add(e);
+
+        bool Folderish(NasEntry e) => e.IsDirectory || e.IsLink;
+        var exports = top.FirstOrDefault(e => string.Equals(e.Name, ExportsFolder, StringComparison.Ordinal) && Folderish(e))
+                      ?? top.Where(e => IsExports(e.Name) && Folderish(e)).OrderBy(e => e.Name, StringComparer.Ordinal).FirstOrDefault();
+        if (exports != null)
+            foreach (var e in (Sub(exports.FullName) ?? new List<NasEntry>()).Where(e => !e.IsDirectory && Cloud.IsIpa(e.Name)).OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase))
+                Add(e);
+
+        var seenFolders = new HashSet<string>(StringComparer.Ordinal);
+        var subfolders = top.Where(e => LooksInto(e, dir) && seenFolders.Add(e.FullName.TrimEnd('/')))
+                            .OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase).ThenBy(e => e.Name, StringComparer.Ordinal).ToList();
+        int cap = Math.Max(0, maxSubfolders);
+        int looked = 0, listed = 0;
+        foreach (var folder in subfolders.Take(cap))
+        {
+            looked++;
+            var entries = Sub(folder.FullName);
+            if (entries == null) continue;   // named in Unreadable, not counted as listed
+            listed++;
+            foreach (var e in entries.Where(SubfolderFile).OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase).ThenBy(e => e.Name, StringComparer.Ordinal))
+                Add(e);   // one level only: a subfolder's own folders are never listed
+        }
+        return new NasScanResult(files, listed, looked, subfolders.Count, clashes, unreadable);
+    }
+
+    /// The log lines of a listing: "NAS: 12 game files in /path and its 7 subfolders" (and the .ipa count when there are
+    /// some), the cap when it was hit, the clashes (at most MaxClashLines), the subfolders that could not be listed.
+    public static List<string> Lines(NasScanResult r, string dir)
+    {
+        var lines = new List<string>();
+        int games = r.Files.Count(f => Cloud.IsGameFile(f.Name));
+        int ipas = r.Files.Count(f => Cloud.IsIpa(f.Name));
+        lines.Add($"NAS: {games} game file{(games == 1 ? "" : "s")}{(ipas > 0 ? $" and {ipas} .ipa file{(ipas == 1 ? "" : "s")}" : "")} in {dir} and its {r.Subfolders} subfolder{(r.Subfolders == 1 ? "" : "s")}");
+        if (r.Capped)
+            lines.Add($"NAS: {dir} has {r.SubfoldersFound} subfolders: only the first {r.Looked} (by name) were looked into (the limit is on subfolders, not on files: each one looked into has all its games listed); choose a narrower sync folder to see the others");
+        foreach (var c in r.Clashes.Take(MaxClashLines))
+        {
+            var cut = c.IndexOf(" -> ", StringComparison.Ordinal);
+            lines.Add(cut < 0 ? $"NAS: skipped {c} (a file of that name is already listed)"
+                              : $"NAS: skipped {c.Substring(0, cut)}: a file of that name is already listed ({c.Substring(cut + 4)}), the first one is kept");
+        }
+        if (r.Clashes.Count > MaxClashLines) lines.Add($"NAS: … and {r.Clashes.Count - MaxClashLines} more file(s) skipped for the same reason");
+        foreach (var u in r.Unreadable) lines.Add($"NAS: could not list {u} (skipped)");
+        return lines;
+    }
+}
