+    // ---- patch 0100 (X): a game the build found no shader in (GameAppField.cs Unsupported) ----------------------------------------------------------------
+
+    /// From what the chain already wrote: Documents/shaders/<id>.none with no shaders/<id>/b-<chain>.img (the split found no shader), and profile-derived/<id>/game.tsv (no engine table:
+    /// the provisional profile). Three file looks.
+    private static (bool Unsupported, bool Provisional) UnsupportedOf(string game)
+    {
+        var tid = GameAppUi.BaseTitleIdOf(game);
+        if (tid == null || GameExport.IsPlayer) return (false, false);
+        try
+        {
+            var docs = GameAppMain.Documents;
+            var shaders = Path.Combine(docs, "shaders");
+            bool none = File.Exists(Path.Combine(shaders, tid + ".none")) || File.Exists(Path.Combine(shaders, tid.ToLowerInvariant() + ".none"));
+            if (!none) return (false, false);
+            var chain = "b-" + GameAppBuild.ShaderChain;
+            bool library = File.Exists(Path.Combine(shaders, tid, chain + ".img")) || Directory.Exists(Path.Combine(shaders, tid, chain));
+            bool provisional = File.Exists(Path.Combine(docs, "profile-derived", tid, "game.tsv"));
+            return (Unsupported.Is(none, library), provisional);
+        }
+        catch (Exception) { return (false, false); }
+    }
+
+    private static string UnsupportedAcceptedKey(string game) => "unsupported_play_ok_" + (GameAppUi.BaseTitleIdOf(game) ?? game);
+
+    /// The first Play of a game that draws nothing asks: "Play anyway (sound and controls)" (remembered for this game), "Share the log", Cancel. True when it asked.
+    private bool AskIfUnsupported(string game, Action again)
+    {
+        var u = UnsupportedOf(game);
+        if (!Unsupported.AskBeforePlay(u.Unsupported, NSUserDefaults.StandardUserDefaults.BoolForKey(UnsupportedAcceptedKey(game)))) return false;
+        var a = UIAlertController.Create(Unsupported.PlayTitle, Unsupported.Full(u.Provisional), UIAlertControllerStyle.Alert);
+        a.AddAction(UIAlertAction.Create(Unsupported.PlayAnyway, UIAlertActionStyle.Default, _ =>
+        {
+            NSUserDefaults.StandardUserDefaults.SetBool(true, UnsupportedAcceptedKey(game));
+            Write($"play: {GameAppUi.DisplayName(game)}: played although it draws nothing (no shader found): you said so once, it does not ask again");
+            again();
+        }));
+        a.AddAction(UIAlertAction.Create("Share the log", UIAlertActionStyle.Default, _ => ShareGameLogs(game, View)));
+        a.AddAction(UIAlertAction.Create("Cancel", UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(a);
+        return true;
+    }
+
