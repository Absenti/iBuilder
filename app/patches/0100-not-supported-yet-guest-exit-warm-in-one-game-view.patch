+/// Patch 0100 (X, the owner): a game the build found NO shader in (the shader split wrote Documents/shaders/<id>.none and no library image) draws nothing: said before the person plays it,
+/// on its card, its sheet, the cover flow, the iPad's hero and the build's end; Play stays possible behind one confirmation (sound and controls can still be tried). Read from what the
+/// chain already writes: shaders/<id>.none (with no shaders/<id>/b-<chain>.img) and, for "especially", profile-derived/<id>/game.tsv (the provisional profile of a game with no engine table).
+public static class Unsupported
+{
+    public const string Text = "Not supported yet: iBuilder found no shader it can read in this game, so it will draw nothing (its engine packs them in a format not handled yet). Logs help add it.";
+    public const string Short = "Not supported yet: no shader found";
+    public const string ProvisionalNote = " Its engine is not one iBuilder knows yet (a provisional profile).";
+    public const string PlayTitle = "This game will draw nothing";
+    public const string PlayAnyway = "Play anyway (sound and controls)";
+
+    public static bool Is(bool noneMarker, bool hasLibrary) => noneMarker && !hasLibrary;
+
+    public static string Full(bool provisional) => Text + (provisional ? ProvisionalNote : "");
+
+    /// The first Play of such a game asks; once the person said "Play anyway" for this game it does not ask again.
+    public static bool AskBeforePlay(bool unsupported, bool accepted) => unsupported && !accepted;
+
+    /// The log line at the end of a build: "build: <game>: NOT SUPPORTED YET: …".
+    public static string LogLine(string game, bool provisional) => "[RED] build: " + game + ": " + Full(provisional);
+}
+
+/// Patch 0100 (Y): the game ended ITSELF (the guest called svcExitProcess): said at the next launch, apart from the person's Quit, a fault, a kill and the time limit
+/// (GameAppUi.ClassifyPreviousRun's GuestExit, crates/ibuilder-pipeline state.rs PreviousRun::GuestExit).
+public static class GuestExitText
+{
+    /// "South Park closed itself after 12 s (the game called exit). It may need a service iBuilder does not emulate yet; the log says which call came last."
+    public static string Line(string game, double? seconds) =>
+        (string.IsNullOrEmpty(game) ? "The game" : game) + " closed itself" + (seconds is double s && s >= 0 ? " after " + Math.Round(s).ToString("0", CultureInfo.InvariantCulture) + " s" : "")
+        + " (the game called exit). It may need a service iBuilder does not emulate yet; the log says which call came last.";
+
+    /// Whether it ended soon after it started (the owner's case: within ~30 s): the alert is shown then; later it is said in the log.
+    public static bool Early(double? seconds) => seconds is double s && s >= 0 && s <= 30;
+
+    /// The guest log's last line before its `svcExitProcess` line (what the game did last), or null.
+    public static string LastCallBefore(IReadOnlyList<string> guestLines)
+    {
+        if (guestLines == null) return null;
+        for (int i = guestLines.Count - 1; i > 0; i--)
+            if (guestLines[i].Contains("svcExitProcess") && !guestLines[i].Contains("received "))
+            {
+                for (int j = i - 1; j >= 0; j--) if (!string.IsNullOrWhiteSpace(guestLines[j])) return guestLines[j].Trim();
+                return null;
+            }
+        return null;
+    }
+}
+
+/// Patch 0100 (Z): the shader preparation under the cover flow's game (and the iPad's hero), as on the grid card: the live line and bar for the game being prepared (or the paused queue's
+/// first), a quiet line for a built game waiting in the queue, paused or skipped (0098's words), nothing for a game with no preparation.
+public static class WarmFlow
+{
+    public enum Show { None, Live, Static }
+
+    public static Show Of(bool built, bool shownLive, bool queued, bool skipped) => !built ? Show.None : shownLive ? Show.Live : queued || skipped ? Show.Static : Show.None;
+}
