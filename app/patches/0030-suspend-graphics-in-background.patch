+++ b/GameAppExternal.cs
@@ -252,6 +252,49 @@
         }
         catch (EntryPointNotFoundException) { return null; }
     }
+
+    // ---- the app leaving the foreground (app/patches/0030-suspend-graphics-in-background.patch, docs/ENGINE-UPDATE.md) --------------------------
+    // The engine's own front end maps the four UIKit scene events onto the host's lifecycle entries (dm/ios/Sources/front_ios.m, front_ios_focus_event); GameApp links no front end
+    // (load/glue_front_standin.m stubs it), so until now nothing told the host the app had left: the game went on submitting GPU work in the background (the 84 lines of
+    // kIOGPUCommandBufferCallbackErrorBackgroundExecutionNotPermitted at the end of Grizzy's log) and its clock and audio went on. The entries are the host's own and are looked up as
+    // the gamepad's are (ibuilder_host_symbol, a dlsym on the loaded host): before the boot loads it, or on a host without one, every call here does nothing.
+    [DllImport("__Internal")] private static extern IntPtr ibuilder_host_symbol(string name);
+
+    private static bool away;   // the host has been told "background" and not yet "foreground" (main thread only)
+
+    /// UIApplication.WillResignActive (<c>entering</c> true: out of focus) and DidBecomeActive (false: in focus): oe's focus state, which a game reads to pause itself.
+    public static unsafe void Active(bool entering)
+    {
+        var focus = ibuilder_host_symbol("dm_focus_set");
+        if (focus != IntPtr.Zero) ((delegate* unmanaged<int, void>) focus)(entering ? 2 : 1);   // 1 InFocus, 2 OutOfFocus, 3 Background (hle_oe.c)
+    }
+
+    /// UIApplication.DidEnterBackground (<c>entering</c> true) and WillEnterForeground (false), in the order front_ios_focus_event takes: going away, the guest's focus, audio and
+    /// clock first and the graphics gate last (dm_gfx_suspend waits for the GPU work in flight and holds every later submit and present); coming back, the gate first. Main thread.
+    public static unsafe void Background(bool entering)
+    {
+        if (entering == away) return;
+        var gfx = ibuilder_host_symbol("dm_gfx_suspend");
+        if (gfx == IntPtr.Zero) return;   // the host is not loaded yet, or is one without the entry: nothing to suspend
+        var audio = ibuilder_host_symbol("dm_audio_suspend");
+        var clock = ibuilder_host_symbol("guest_clock_freeze_for");
+        var focus = ibuilder_host_symbol("dm_focus_set");
+        away = entering;
+        if (entering)
+        {
+            if (focus != IntPtr.Zero) ((delegate* unmanaged<int, void>) focus)(3);
+            if (audio != IntPtr.Zero) ((delegate* unmanaged<int, void>) audio)(1);
+            if (clock != IntPtr.Zero) ((delegate* unmanaged<int, int, void>) clock)(1, 1);   // reason 1: background (hle_os.c)
+            ((delegate* unmanaged<int, void>) gfx)(1);
+        }
+        else
+        {
+            ((delegate* unmanaged<int, void>) gfx)(0);
+            if (clock != IntPtr.Zero) ((delegate* unmanaged<int, int, void>) clock)(1, 0);
+            if (audio != IntPtr.Zero) ((delegate* unmanaged<int, void>) audio)(0);
+            if (focus != IntPtr.Zero) ((delegate* unmanaged<int, void>) focus)(2);   // DidBecomeActive follows and makes it 1
+        }
+    }
 }
 
