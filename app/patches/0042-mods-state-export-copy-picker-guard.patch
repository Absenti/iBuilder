+    /// True for a file the document picker copied into this app's container (Import mode: the container's tmp/, or Documents/Inbox/), which is ours to delete. NOT for any other file of the
+    /// container: a .p12 the player put in Documents/ and picked from there is the player's own file (the old test was "anywhere under HOME" and deleted it).
+    private static bool IsPickerCopy(string path)
+    {
+        var tmp = Path.GetTempPath();
+        if (tmp.Length > 1 && path.StartsWith(tmp, StringComparison.Ordinal)) return true;
+        var home = (Environment.GetEnvironmentVariable("HOME") ?? "").TrimEnd('/');
+        return home.Length > 0 && (path.StartsWith(home + "/tmp/", StringComparison.Ordinal) || path.StartsWith(home + "/Documents/Inbox/", StringComparison.Ordinal));
+    }
