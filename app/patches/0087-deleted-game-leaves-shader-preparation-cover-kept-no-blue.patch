+
+/// Patch 0087 (the owner, after deleting South Park: its cloud card still said "Preparing the shaders · South Park · 5,009 of 5,0…" with a full bar, for ever): GameWarm.Stop bumped the run's
+/// number but left the run ACTIVE; only the end of the CURRENT run cleared it, and a stopped run is never current again. So every stop (a delete, Play, an export, the owner's Pause) left a frozen
+/// "active" run with its last counts on the screen, the Library's menus and the Build tab, and the queue never started again (WarmKick waits for no active run) until iBuilder was quit. Stop
+/// ends the run at once now; the next run's thread waits for the old one to be gone (GameWarm.Start).
+public sealed class WarmRun
+{
+    private readonly object gate = new object();
+    private int generation;
+    private volatile bool active;
+    private string title;
+
+    /// A run starts: its number (the run's thread compares it, Current).
+    public int Start(string tid) { lock (gate) { generation++; active = true; title = tid?.ToUpperInvariant(); return generation; } }
+
+    /// Every run ends now, whether its thread is back or not. Returns whether one was going.
+    public bool Stop() { lock (gate) { bool was = active; generation++; active = false; return was; } }
+
+    /// The run's thread is back: it ends unless a newer run started meanwhile.
+    public void Ended(int mine) { lock (gate) { if (generation == mine) active = false; } }
+
+    public bool Current(int mine) => Volatile.Read(ref generation) == mine;
+    public bool Active => active;
+    public string Title { get { lock (gate) return active ? title : null; } }
+}
+
+/// Patch 0087: where the shader preparation's line (and its bar, and its Pause in a menu) shows: on a BUILT game only, whose preparation is going, or paused by the owner while it is the queue's
+/// first. Never on a cloud card, a game being downloaded, or a game whose build or file was deleted.
+public static class WarmShown
+{
+    /// The title whose line shows: the one being prepared, or (the owner paused the queue) the queue's first.
+    public static string Title(bool active, string activeTid, bool queuePaused, IReadOnlyList<string> queue) =>
+        active ? activeTid?.ToUpperInvariant() : queuePaused && queue != null && queue.Count > 0 ? queue[0] : null;
+
+    public static bool On(string tid, bool built, string shownTitle) =>
+        tid != null && built && shownTitle != null && string.Equals(tid, shownTitle, StringComparison.OrdinalIgnoreCase);
+}
+
+/// Patch 0087: a game deleted (its file, or only its build) leaves the shader preparation at once: its run stops when it is the one going (its background task and lock-screen progress end
+/// with it), its title leaves the queue, and its markers go (games/<id>/warmed.tsv, prepared.tsv: a later build of it is prepared again). What the game learned and played stays.
+public static class WarmForget
+{
+    public static readonly IReadOnlyList<string> Markers = new[] { "warmed.tsv", "prepared.tsv" };
+
+    public static List<string> MarkerFiles(string tid) =>
+        tid == null ? new List<string>() : Markers.Select(m => "games/" + tid.ToUpperInvariant() + "/" + m).ToList();
+
+    /// Whether the run going must stop: it prepares this title.
+    public static bool StopsRun(string tid, string activeTid) => tid != null && activeTid != null && string.Equals(tid, activeTid, StringComparison.OrdinalIgnoreCase);
+
+    /// The title leaves the queue's titles. Returns whether it was in it.
+    public static bool FromQueue(List<string> titles, string tid) => titles != null && tid != null && titles.RemoveAll(t => string.Equals(t, tid, StringComparison.OrdinalIgnoreCase)) > 0;
+}
+
+/// Patch 0087: a game deleted while the cloud still lists it keeps its cover (games/<id>/icon.jpg, and the person's own cover): its cloud card shows it, not the initials (South Park's did).
+public static class CoverKeep
+{
+    public static bool OnDelete(string game, IEnumerable<string> cloudNames)
+    {
+        var id = GameAppUi.BaseTitleIdOf(game);
+        return id != null && (cloudNames ?? Enumerable.Empty<string>()).Any(n => Cloud.IsGameFile(n) && GameAppUi.ContentKindOf(n) == GameAppUi.ContentKind.Base
+                                                                                 && string.Equals(GameAppUi.BaseTitleIdOf(n), id, StringComparison.OrdinalIgnoreCase));
+    }
 }
