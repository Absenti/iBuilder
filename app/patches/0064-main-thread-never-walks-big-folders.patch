+// gameapp/GameAppPerf.cs -- what keeps the main thread out of the file system and out of work proportional to the size of the data (patch 0064).
+//
+// Measured on the owner's iPhone (2026-11-20, two crash reports): the app died with 0x8BADF00D, "scene-update watchdog transgression ... exhausted real (wall clock) time allowance of 10.00
+// seconds", with the MAIN thread in -[UIApplication _sendWillEnterForegroundCallbacks] -> our WillEnterForeground observer -> lstat: a walk of Documents/shadercache (15,000+ files after a partial build
+// of a 22,000-shader game). The walk was the storage bar's (every refresh measured five folders), and the app's first screen grew from 586 ms (nothing cached) to 3,337 ms (9,000 shaders) to 5,090 ms (15,000).
+//
+// No UIKit, no Foundation here (the host harness compiles this file as it is): the controller (GameAppMain.cs and the others) hands in what only UIKit can do (`post` = BeginInvokeOnMainThread).
+//
+//   FolderWalk      the size of a folder: one readdir and one stat per file, no path string and no FileInfo per file. Only ever called from a worker thread.
+//   FolderSizes     the cache the screens read instead of walking: last known value per folder, measured off the main thread, ONE measurement at a time, a minimum interval between two of the same
+//                   folder, invalidated by the events that really change a size (a build ends, a delete, a clear, an export). A screen asks, never waits: Get returns the last value (or -1 = not known yet).
+//   Coalescer       "run this on the next turn of the run loop, once, however many times it is asked, and not twice within `spacing`": RefreshScreen, the log page's redraw.
+//   BackgroundDelete  recursive deletes (the shader cache, a game's build and shaders, the shader build's .work folder: 27,144 files, 6.2 GB measured on the phone) on ONE worker thread, in order; FolderSizes measures nothing meanwhile.
+//   Bg              "work on a worker thread, the answer on the main thread": the saves and the mods (a zip, a staging delete, a walk of a mod's tree).
+//   LaunchProfile   the `launch-profile: <part> <ms>` lines of the app log.
+//   UiLogModel      the lines the log page shows: bounded (about 400 rows), a counter line replaces the one before it in place, the engine's "unity compute source" lines stay in the files only.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Enumeration;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+internal static class FolderWalk
+{
+    /// The bytes of every file under `path` (0 when there is none, 0 when it cannot be read at all). A subfolder that cannot be read is skipped, not fatal. Several seconds for 60,000 files on a phone:
+    /// a worker thread only.
+    internal static long Bytes(string path)
+    {
+        try
+        {
+            if (string.IsNullOrEmpty(path) || !Directory.Exists(path)) return 0;
+            var options = new EnumerationOptions { RecurseSubdirectories = true, IgnoreInaccessible = true, AttributesToSkip = 0, ReturnSpecialDirectories = false };
+            long total = 0;
+            var files = new FileSystemEnumerable<long>(path, (ref FileSystemEntry entry) => entry.Length, options) { ShouldIncludePredicate = (ref FileSystemEntry entry) => !entry.IsDirectory };
+            foreach (var length in files) total += length;
+            return total;
+        }
+        catch (Exception) { return 0; }
+    }
+
+    /// The bytes under `path` of the entries whose NAME `topLevel` accepts (the folders and files directly in `path`; what is inside an accepted folder counts whole). For Documents/shaders: the packs
+    /// (shaders/<id>) apart from the shader build's resume folders (shaders/<id>.work: 27,144 files, 6.2 GB on the owner's phone), which are measured on their own, rarely. Worker threads only.
+    internal static long Bytes(string path, Func<string, bool> topLevel)
+    {
+        try
+        {
+            if (string.IsNullOrEmpty(path) || !Directory.Exists(path)) return 0;
+            long total = 0;
+            foreach (var info in new DirectoryInfo(path).EnumerateFileSystemInfos())
+            {
+                if (!topLevel(info.Name)) continue;
+                if (info is DirectoryInfo folder) total += Bytes(folder.FullName);
+                else if (info is FileInfo file) total += file.Length;
+            }
+            return total;
+        }
+        catch (Exception) { return 0; }
+    }
+}
+
+internal sealed class FolderSizes
+{
+    internal const string Extract = "extract", Framework = "framework", Shaders = "shaders", ShaderWork = "shaders-work", ShaderCache = "shadercache", Exports = "exports", GameShaders = "game-shaders";
+
+    private sealed class Slot
+    {
+        public string Path;
+        public long Bytes = -1;               // -1: never measured
+        public DateTime At = DateTime.MinValue;
+        public bool Stale;                    // an event changed it since: measure again
+        public bool Heavy;                    // thousands of files: not more often than BuildGap while a build runs
+        public bool Slow;                     // tens of thousands, changed only by a build or a delete: not more often than SlowGap when nothing invalidated it
+        public Func<string, long> Walk;       // its own measurement (null: the one the cache was made with)
+    }
+
+    private readonly Dictionary<string, Slot> slots = new Dictionary<string, Slot>();
+    private readonly List<string> order = new List<string>();
+    private readonly object gate = new object();
+    private readonly Func<string, long> walk;
+    private readonly Action<Action> post;
+    private readonly Func<bool> building;
+    private readonly Func<DateTime> now;
+    private readonly Action changed;
+    private readonly Func<bool> hold;
+    private readonly Action<string, long, long> measured;
+    private bool flying, notifyQueued;
+    private int inWalk, mostInWalk, walks;
+
+    /// The least time between two measurements of one folder when nothing invalidated it.
+    internal TimeSpan Gap = TimeSpan.FromSeconds(30);
+    /// The least time between two measurements of a heavy folder (the shader cache, the shaders, the extraction) while a build runs, an invalidation included: the build is writing there.
+    internal TimeSpan BuildGap = TimeSpan.FromSeconds(60);
+    /// The least time between two measurements of a slow folder (the shader build's .work folders) when nothing invalidated it: a build or a delete does, the clock does not.
+    internal TimeSpan SlowGap = TimeSpan.FromMinutes(5);
+
+    /// walk: the measurement (FolderWalk.Bytes); post: runs an action on the main thread without waiting (BeginInvokeOnMainThread); building: a build is running; now: the clock; changed: a value
+    /// arrived (on the thread `post` runs on; several arrivals in a row make one call); hold: nothing is measured while it answers true (a delete is going: the folder is being emptied under the walk);
+    /// measured: a walk ended (key, milliseconds, bytes), on the worker thread (the launch-profile lines).
+    internal FolderSizes(Func<string, long> walk, Action<Action> post, Func<bool> building, Func<DateTime> now, Action changed, Func<bool> hold = null, Action<string, long, long> measured = null)
+    {
+        this.walk = walk; this.post = post; this.building = building; this.now = now ?? (() => DateTime.UtcNow); this.changed = changed; this.hold = hold; this.measured = measured;
+    }
+
+    /// Names a folder to keep the size of (the path of a known key can change: the new one starts unknown). `walk`: its own measurement; `slow`: see SlowGap.
+    internal void Track(string key, string path, bool heavy, Func<string, long> walk = null, bool slow = false)
+    {
+        lock (gate)
+        {
+            if (!slots.TryGetValue(key, out var slot)) { slot = new Slot(); slots[key] = slot; order.Add(key); }
+            if (slot.Path != path) { slot.Path = path; slot.Bytes = -1; slot.At = DateTime.MinValue; slot.Stale = false; }
+            slot.Heavy = heavy; slot.Slow = slow; slot.Walk = walk;
+        }
+    }
+
+    /// These folders' sizes are not known any more (a folder was emptied): "…" until the next measurement, which is asked for now.
+    internal void Reset(params string[] keys)
+    {
+        lock (gate)
+            foreach (var key in order)
+                if (keys == null || keys.Length == 0 || Array.IndexOf(keys, key) >= 0) { slots[key].Bytes = -1; slots[key].At = DateTime.MinValue; slots[key].Stale = false; }
+        Request();
+    }
+
+    /// The last value measured, or -1 (not known yet). Never walks, never waits.
+    internal long Get(string key)
+    {
+        lock (gate) return slots.TryGetValue(key, out var slot) ? slot.Bytes : -1;
+    }
+
+    /// An event changed these folders' sizes (all of them when none is named): they are measured again, now, except a heavy folder while a build runs (BuildGap). The last value stays shown meanwhile.
+    internal void Invalidate(params string[] keys)
+    {
+        lock (gate)
+            foreach (var key in order)
+                if (keys == null || keys.Length == 0 || Array.IndexOf(keys, key) >= 0) slots[key].Stale = true;
+        Request();
+    }
+
+    /// Starts measuring what is due, off the calling thread, unless a measurement is already going (it then picks up what became due). Cheap: the main thread may call it at every refresh.
+    internal void Request()
+    {
+        lock (gate)
+        {
+            if (flying || NextDue() == null) return;
+            flying = true;
+        }
+        Task.Run(Pass);
+    }
+
+    /// Measurements made, and the most that ever ran at once (always 1).
+    internal int Walks { get { lock (gate) return walks; } }
+    internal int MostAtOnce { get { lock (gate) return mostInWalk; } }
+
+    private string NextDue()   // under the gate
+    {
+        if (hold != null && hold()) return null;
+        var t = now();
+        bool busy = building();
+        foreach (var key in order)
+        {
+            var s = slots[key];
+            if (string.IsNullOrEmpty(s.Path)) continue;
+            if (s.Bytes < 0 && s.At == DateTime.MinValue) return key;   // never measured
+            var since = t - s.At;
+            bool throttled = busy && s.Heavy;
+            var gap = s.Slow ? SlowGap : throttled ? BuildGap : Gap;
+            if (s.Stale ? (!throttled || since >= BuildGap) : since >= gap) return key;
+        }
+        return null;
+    }
+
+    private void Pass()
+    {
+        while (true)
+        {
+            string key; string path; Func<string, long> measure;
+            lock (gate)
+            {
+                key = NextDue();
+                if (key == null) { flying = false; return; }
+                path = slots[key].Path;
+                measure = slots[key].Walk ?? walk;
+                slots[key].Stale = false;   // an invalidation that comes while this walks sets it again
+                slots[key].At = now();
+                inWalk++; if (inWalk > mostInWalk) mostInWalk = inWalk;
+            }
+            long bytes = -1;
+            var clock = System.Diagnostics.Stopwatch.StartNew();
+            try { bytes = measure(path); } catch (Exception) { }
+            try { measured?.Invoke(key, clock.ElapsedMilliseconds, bytes); } catch (Exception) { }
+            lock (gate)
+            {
+                inWalk--; walks++;
+                var s = slots[key];
+                if (s.Path == path && bytes >= 0) { s.Bytes = bytes; s.At = now(); }
+            }
+            Notify();
+        }
+    }
+
+    private void Notify()
+    {
+        lock (gate) { if (notifyQueued || changed == null) return; notifyQueued = true; }
+        post(() => { lock (gate) notifyQueued = false; changed(); });
+    }
+}
+
+/// Runs `run` once on the thread `post` posts to, on a later turn (never inside the call that asks), however many times it is asked before then, and not twice within `spacing`.
+/// Request is called from that thread only.
+internal sealed class Coalescer
+{
+    private readonly Action<Action> post;
+    private readonly Action run;
+    private readonly TimeSpan spacing;
+    private readonly Func<DateTime> now;
+    private bool scheduled;
+    private DateTime lastRun = DateTime.MinValue;
+    private Timer later;
+
+    internal int Asked, Runs;
+
+    internal Coalescer(Action<Action> post, Action run, TimeSpan spacing, Func<DateTime> now = null)
+    {
+        this.post = post; this.run = run; this.spacing = spacing; this.now = now ?? (() => DateTime.UtcNow);
+    }
+
+    internal void Request()
+    {
+        Asked++;
+        if (scheduled) return;
+        scheduled = true;
+        var wait = lastRun + spacing - now();
+        if (wait <= TimeSpan.Zero) post(Fire);
+        else { later?.Dispose(); later = new Timer(_ => post(Fire), null, wait, Timeout.InfiniteTimeSpan); }
+    }
+
+    private void Fire()
+    {
+        scheduled = false;
+        lastRun = now();
+        Runs++;
+        run();
+    }
+}
+
+/// The lines of the log page (GameAppUi.Timeline turns them into rows). The files keep every line; this is what the screen holds:
+///   * at most MaxLines (and a few old errors): the page does not grow with a build of 22,000 shaders;
+///   * a counter line ("compiling: 758/21990 shaders", "NAS: 40 % of x.ipa") replaces the counter line before it, in place, instead of adding one (Timeline did that at every redraw, over all the lines);
+///   * a step line ("stage 3/5: ... (758/21990 shaders)", one every ~25 shaders) replaces the step's previous one: only the first of a step opens its header;
+///   * the engine's "unity compute source: [...]" lines (hundreds a build) are not rows: they stay in the files.
+internal sealed class UiLogModel
+{
+    internal const int MaxLines = 400;
+    private const int Slack = 100;           // trimmed in steps of this many, not at every line
+    private const int KeepErrors = 50;       // errors older than the window stay (the red rows, "Jump to the first error")
+
+    internal readonly List<(string Time, string Text, GameAppUi.LogKind Kind)> Lines = new List<(string, string, GameAppUi.LogKind)>();
+
+    private int rowAt = -1, stepAt = -1;      // the last line that is a row, the last step line
+    private string rowLabel;                  // its counter label, or null
+    private int step = -1, rowStep = -1;      // the step the lines are in now, and when the last row was added
+    internal int Kept, Merged, FileOnly;      // counts, for the harness
+
+    /// A line that only the files keep.
+    internal static bool IsFileOnly(string line) => line != null && line.StartsWith("unity compute source:", StringComparison.Ordinal);
+
+    /// Adds a line the log page shows; false when the page does not show it (a file-only line).
+    internal bool Add(string time, string line, GameAppUi.LogKind kind)
+    {
+        if (IsFileOnly(line)) { FileOnly++; return false; }
+        if (kind == GameAppUi.LogKind.Stage)
+        {
+            var s = GameAppUi.ParseStage(line.Trim());
+            if (s.Valid && s.Of == 5)
+            {
+                if (s.Step == step && stepAt >= 0) { Lines[stepAt] = (time, line, kind); Merged++; return true; }
+                step = s.Step;
+                stepAt = Push(time, line, kind);
+                return true;
+            }
+            if (line.Trim().StartsWith("=== ", StringComparison.Ordinal)) { step = 0; stepAt = -1; }   // a new run: its first step opens a header again
+        }
+        var label = line.Trim().StartsWith("=== ", StringComparison.Ordinal) ? null : GameAppUi.ProgressLabel(GameAppUi.Tidy(line));
+        if (label != null && rowAt >= 0 && rowLabel == label && rowStep == step && Lines[rowAt].Kind == kind)
+        {
+            Lines[rowAt] = (time, line, kind);
+            Merged++;
+            return true;
+        }
+        rowAt = Push(time, line, kind);
+        rowLabel = label;
+        rowStep = step;
+        return true;
+    }
+
+    private int Push(string time, string line, GameAppUi.LogKind kind)
+    {
+        Lines.Add((time, line, kind));
+        Kept++;
+        if (Lines.Count > MaxLines + Slack) Trim();
+        return Lines.Count - 1;   // after a trim the last line is still the last
+    }
+
+    private void Trim()
+    {
+        int drop = Lines.Count - MaxLines;
+        var survivors = new List<(string Time, string Text, GameAppUi.LogKind Kind)>();
+        for (int i = 0; i < drop && survivors.Count < KeepErrors; i++)
+            if (Lines[i].Kind == GameAppUi.LogKind.Error) survivors.Add(Lines[i]);
+        survivors.AddRange(Lines.Skip(drop));
+        Lines.Clear();
+        Lines.AddRange(survivors);
+        rowAt = stepAt = -1;   // the next counter line is a row of its own once, then merges again
+        rowLabel = null;
+    }
+
+    internal void Clear()
+    {
+        Lines.Clear();
+        rowAt = stepAt = -1; rowLabel = null; step = rowStep = -1;
+    }
+}
+
+/// Recursive deletes on ONE worker thread, in the order they were asked. A delete of 40,000 files takes longer than the 10 s the system gives a button handler or a scene update (the third crash report of
+/// 2026-11-20 had a handler walking files for that long); none runs on the main thread. `Busy` is true from the Enqueue until the job's `done` has run on the main thread, so the screens can say "clearing…", refuse
+/// a second question and start no build meanwhile, and FolderSizes (hold) measures nothing while a folder is being emptied.
+internal sealed class BackgroundDelete
+{
+    private readonly Action<Action> post;
+    private readonly Queue<(Action Work, Action<Exception> Done)> queue = new Queue<(Action, Action<Exception>)>();
+    private readonly object gate = new object();
+    private bool flying;
+    private int pending, running, most;
+
+    internal BackgroundDelete(Action<Action> post) { this.post = post; }
+
+    internal bool Busy { get { lock (gate) return pending > 0; } }
+    /// The most jobs that ever ran at once (always 1: the harness).
+    internal int MostAtOnce { get { lock (gate) return most; } }
+
+    /// Runs `work` on the worker after the jobs asked before it; `done(error)` on the main thread afterwards (error null: it went well).
+    internal void Enqueue(Action work, Action<Exception> done)
+    {
+        lock (gate)
+        {
+            queue.Enqueue((work, done));
+            pending++;
+            if (flying) return;
+            flying = true;
+        }
+        Task.Run(Pump);
+    }
+
+    private void Pump()
+    {
+        while (true)
+        {
+            (Action Work, Action<Exception> Done) job;
+            lock (gate)
+            {
+                if (queue.Count == 0) { flying = false; return; }
+                job = queue.Dequeue();
+                running++; if (running > most) most = running;
+            }
+            Exception error = null;
+            try { job.Work(); } catch (Exception e) { error = e; }
+            lock (gate) running--;
+            post(() => { lock (gate) pending--; job.Done?.Invoke(error); });
+        }
+    }
+
+    /// The deletion of a folder and everything in it; nothing when there is no such folder.
+    internal static void DeleteTree(string path)
+    {
+        if (Directory.Exists(path)) Directory.Delete(path, true);
+    }
+}
+
+/// Work on a worker thread, its answer on the main thread (`post`): exactly one `done(result, error)`.
+internal static class Bg
+{
+    internal static void Run<T>(Func<T> work, Action<T, Exception> done, Action<Action> post)
+    {
+        Task.Run(() =>
+        {
+            T result = default; Exception error = null;
+            try { result = work(); } catch (Exception e) { error = e; }
+            post(() => done(result, error));
+        });
+    }
+}
+
+/// The `launch-profile: <part> <ms>` lines: in the first 90 s of the process every part over 50 ms (the launch: where the time goes), afterwards only a part over 250 ms and at most one line per part every 10 s
+/// (a slow refresh must not fill the log). Main thread only.
+internal sealed class LaunchProfile
+{
+    internal static readonly TimeSpan LaunchPhase = TimeSpan.FromSeconds(90);
+    private readonly Dictionary<string, TimeSpan> last = new Dictionary<string, TimeSpan>();
+
+    /// The line to write for `part` that took `ms` when the process is `sinceLaunch` old, or null.
+    internal string Line(string part, long ms, TimeSpan sinceLaunch)
+    {
+        bool launch = sinceLaunch < LaunchPhase;
+        if (ms <= (launch ? 50 : 250)) return null;
+        if (!launch && last.TryGetValue(part, out var at) && sinceLaunch - at < TimeSpan.FromSeconds(10)) return null;
+        last[part] = sinceLaunch;
+        return $"launch-profile: {part} {ms}";
+    }
+}
