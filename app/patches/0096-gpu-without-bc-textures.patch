+// ---- patch 0096: a GPU without BC textures, said once at the first build ------------------------------------------------------------------------------------------
+public sealed partial class GameAppViewController
+{
+    /// At the first build on a GPU without BC textures: one notice that performance may be low (the build goes on behind it). Shown once: Documents/gameapp.settings.tsv keeps cpu_textures_notice 1.
+    private void CpuTexturesNoticeOnce()
+    {
+        int bc = GameAppMain.GpuBcTexturesValue();
+        if (!GameAppUi.CpuTexturesNoticeDue(bc, ReadAppSettings())) return;
+        try { File.WriteAllText(AppSettingsPath, GameAppUi.WithAppSetting(ReadAppSettings(), GameAppUi.CpuTexturesNoticeKey, "1")); }
+        catch (Exception error) { Write($"could not save the settings: {error.Message}"); }
+        Write("device: " + GameAppUi.CpuTexturesLine + " (every game; slower, more memory)");
+        var a = UIAlertController.Create(GameAppUi.CpuTexturesNoticeTitle, GameAppUi.CpuTexturesNoticeText, UIAlertControllerStyle.Alert);
+        a.AddAction(UIAlertAction.Create("OK", UIAlertActionStyle.Default, null));
+        PresentWhenFree(a);
+    }
+}
