+/// Patch 0083: what the end of a run that a stop request ended means. The Rust chain now returns 131 (paused) / 130 (cancelled) from a BOOT-ONLY run (Play) too, when a stop interrupts the
+/// shader library's rebuild before the boot (no boot; a pause keeps the boot-only request so a later Play continues, a cancel consumes it): that is an interrupted PLAY, never a paused or
+/// cancelled BUILD (no paused-build record, no cancel cleanup: the game stays Ready and Play is offered again).
+public enum StopEnd { None, PlayInterrupted, BuildPaused, BuildCancelled }
+
+public static class PlayStop
+{
+    public static StopEnd Of(bool bootOnly, StopOutcome outcome) =>
+        outcome == StopOutcome.Paused ? (bootOnly ? StopEnd.PlayInterrupted : StopEnd.BuildPaused)
+        : outcome == StopOutcome.Cancelled ? (bootOnly ? StopEnd.PlayInterrupted : StopEnd.BuildCancelled)
+        : StopEnd.None;
+
+    public const string Stopped = "Play was stopped before the game started";
+
+    public static string Line(bool paused) => paused ? Stopped + "; Play continues it" : Stopped;
+}
