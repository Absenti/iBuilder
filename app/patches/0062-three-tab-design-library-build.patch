+        NSLayoutConstraint.ActivateConstraints(constraints.ToArray());
+        tile.AccessibilityLabel = GameAppUi.DisplayName(e.Name) + (chipText != null ? ", " + chipText : "");
+        tile.TouchUpInside += (_, __) => ShowGameSheet(e);
