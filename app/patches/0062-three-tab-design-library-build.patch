+// gameapp/GameAppShelf.cs: the three-tab design (app/patches/0062). Tabs: Library, Build, Settings.
+//
+//   Library  the games of this iPhone as a grid or a list (a toggle, kept): each with its cover (CoverView: the icon, else the name's colour and initials, so a game never has an empty cover),
+//            and the buttons that fit what this install can do: Play and Export IPA with a development certificate (get-task-allow), Export IPA alone with a distribution one (GameAppUi.GameAction
+//            says which), Set up for a game not built yet, Update when an update or DLC was added since the build. A tap opens the game's sheet (the settings sheet); a long press opens its menu.
+//   Build    what the queue is doing now, the games on this phone (Build, Rebuild, Update, Update and DLC) and the games only in the cloud (Download, Download and build).
+//
+// An exported player keeps its own one screen (BuildPlayerPage, GameAppLibrary.cs) and the old library page, but draws that screen with the helpers of this file: the gradient Play (GradientBackView),
+// the flat rows (SettingsRow, SettingsCard). The tabs, the shelf, the Build tab and the sheet do not run for it.
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using CoreAnimation;
+using CoreGraphics;
+using Foundation;
+using ImageIO;
+using UIKit;
+
+/// A cover drawn from the name alone: the name's colour and a white glyph (ring, triangle or rounded square). It is the icon of an exported app whose game has none.
+internal static class CoverArt
+{
+    public static byte[] Png(string name, int size)
+    {
+        try
+        {
+            using var space = CGColorSpace.CreateDeviceRGB();
+            using var context = new CGBitmapContext(null, size, size, 8, size * 4, space, CGImageAlphaInfo.NoneSkipLast);
+            context.SetFillColor(Theme.ColorFor(name).CGColor);
+            context.FillRect(new CGRect(0, 0, size, size));
+            context.SetStrokeColor(UIColor.White.CGColor);
+            context.SetLineWidth(size * 0.09f);
+            context.SetLineJoin(CGLineJoin.Round);
+            nfloat c = size / 2f, r = size * 0.27f;
+            int kind;
+            unchecked { int h = 17; foreach (var ch in name ?? "") h = h * 31 + ch; kind = (h & 0x7FFFFFFF) % 3; }
+            if (kind == 0) context.StrokeEllipseInRect(new CGRect(c - r, c - r, 2 * r, 2 * r));
+            else if (kind == 1)
+            {
+                context.MoveTo(c, c - r * 1.05f);
+                context.AddLineToPoint(c + r * 1.05f, c + r * 0.85f);
+                context.AddLineToPoint(c - r * 1.05f, c + r * 0.85f);
+                context.ClosePath();
+                context.StrokePath();
+            }
+            else
+            {
+                context.AddPath(UIBezierPath.FromRoundedRect(new CGRect(c - r, c - r, 2 * r, 2 * r), r * 0.35f).CGPath);
+                context.StrokePath();
+            }
+            using var image = context.ToImage();
+            var data = new NSMutableData();
+            using var dest = CGImageDestination.Create(data, "public.png", 1);
+            if (dest == null) return null;
+            dest.AddImage(image, (NSDictionary) null);
+            return dest.Close() ? data.ToArray() : null;
+        }
+        catch (Exception) { return null; }
+    }
+}
+
+/// The background of a primary button: a gradient of the game's own colour (the average of its cover, else the colour of its name). A button configuration takes it as its background view.
+internal sealed class GradientBackView : UIView
+{
+    [Export("layerClass")]
+    public static ObjCRuntime.Class LayerClass() => new ObjCRuntime.Class(typeof(CAGradientLayer));
+
+    /// The colour of what is written on it: dark on a light tint, white on a dark one.
+    public UIColor Foreground { get; }
+
+    public GradientBackView(UIColor tint)
+    {
+        UserInteractionEnabled = false;
+        tint.GetRGBA(out nfloat r, out nfloat g, out nfloat b, out nfloat a);
+        var top = UIColor.FromRGBA((nfloat) Math.Min(1.0, (double) r * 1.1 + 0.06), (nfloat) Math.Min(1.0, (double) g * 1.1 + 0.06), (nfloat) Math.Min(1.0, (double) b * 1.1 + 0.06), 1f);
+        var bottom = UIColor.FromRGBA(r * 0.58f, g * 0.58f, b * 0.58f, 1f);
+        var gradient = (CAGradientLayer) Layer;
+        gradient.StartPoint = new CGPoint(0, 0);
+        gradient.EndPoint = new CGPoint(1, 1);
+        gradient.Colors = new[] { top.CGColor, bottom.CGColor };
+        double lum = 0.2126 * (double) r + 0.7152 * (double) g + 0.0722 * (double) b;
+        Foreground = lum > 0.62 ? Theme.Ground : UIColor.White;
+    }
+}
