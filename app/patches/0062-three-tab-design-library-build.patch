+
+        // The buttons: what a tile offers, and always Export IPA once the game is built
+        var acts = ShelfActions(e, facts, out _, out _);
+        if (ready && !acts.Any(a => a.Title == "Export IPA"))
+            acts.Add(new ShelfAct("Export IPA", "square.and.arrow.up", false, () => ConfirmExport(game)));
+        var tint = TintOf(e.Icon, name);
+        var buttons = acts.Select(a =>
+        {
+            var inner = a.Do;
+            var act = a with { Do = () => Then(inner) };
+            var b = ShelfActButton(act, false, !facts.Running || a.Title == "Watch the build", tint);
+            b.HeightAnchor.ConstraintEqualTo(48).Active = true;
+            return (UIView) b;
+        }).ToList();
+        UIView actionBlock;
+        if (buttons.Count <= 2)
+        {
+            var row = Theme.Row(10, buttons.ToArray());
+            row.Distribution = UIStackViewDistribution.FillEqually;
+            actionBlock = row;
+        }
+        else
+        {
+            var first = Theme.Row(10, buttons.Take(2).ToArray());
+            first.Distribution = UIStackViewDistribution.FillEqually;
+            actionBlock = Theme.Column(10, first, buttons[2]);
+        }
+
+        // GAME
+        var gameRows = new List<UIView>();
+        gameRows.Add(SettingsRow("Game settings", () => nav.PushViewController(SettingsPage(), true), true, false, -1, "sheet-game-settings").Button);
+        if (tid != null) gameRows.Add(SettingsRow("Saves", () => Then(() => ShowSaves(game)), true, false).Button);
+        if (tid != null && !GameExport.IsPlayer) gameRows.Add(SettingsRow("Mods and cheats", () => Then(() => ShowMods(game, ready)), true, false).Button);
+        bool isBase = GameAppUi.ContentKindOf(game) == GameAppUi.ContentKind.Base && !GameAppUi.IsNup(game);
+        if (isBase)
+        {
+            var update = GameAppUi.UpdateFor(game, names);
+            var dlcs = GameAppUi.DlcFor(game, names);
+            var content = SettingsRow("Update and DLC", () => Then(Import), true, false);
+            content.Value.Text = update == null && dlcs.Count == 0 ? "None" : (update != null ? "Update" : "") + (update != null && dlcs.Count > 0 ? " · " : "") + (dlcs.Count > 0 ? $"{dlcs.Count} DLC" : "");
+            gameRows.Add(content.Button);
+        }
+
+        // SHADERS
+        UIView shadersBlock = null;
+        if (WarmOffered(game))
+        {
+            var prepare = SettingsRow("Prepare the shaders…", () => Then(() => PrepareShadersFor(game)), true, false);
+            prepare.Value.Text = GameWarm.Active ? "Running" : "";
+            shadersBlock = Theme.Column(8, SectionLabel("SHADERS"), SettingsCard(prepare.Button),
+                Theme.Label("Compiles the game's shader libraries now, in the background, so the first session does not stop to compile them. Best on a charger.", Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 0));
+        }
+
+        // STORAGE
+        var storage = new List<UIView>();
+        void Line(string k, string v) { var r = SettingsRow(k, null, false, false); r.Value.Text = v; storage.Add(r.Button); }
+        long gameBytes = 0; try { gameBytes = new FileInfo(Path.Combine(docs, game)).Length; } catch (Exception) { }
+        Line("Game", GameAppUi.SizeText(gameBytes));
+        if (ready) Line("Build", GameAppUi.SizeText(FolderBytes(Path.Combine(docs, "extract")) + FolderBytes(Path.Combine(docs, "DmGameProbe.framework"))));
+        if (tid != null) Line("Shaders", GameAppUi.SizeText(FolderBytes(Path.Combine(docs, "shaders", tid))));
+        Line("Free on this " + GameAppUi.DeviceName, GameAppUi.SizeText(FreeBytes()));
+
+        // MORE
+        var more = new List<UIView>();
+        var logs = SettingsRow("Logs", () => Then(() => ShareGameLogs(game, View)), true, false);
+        more.Add(logs.Button);
+        more.Add(SettingsRow("Show in Files", () => ShowInFiles(Path.Combine(docs, game)), true, false).Button);
+        more.Add(SettingsRow("Add to the build queue", () => Then(() => AddToBuildQueue(game)), true, false).Button);
+        bool canRebuild = !GameExport.IsPlayer && GameAppUi.ShowRebuild(facts) && ready;
+        if (canRebuild) more.Add(SettingsRow("Rebuild from scratch…", () => Then(() => ConfirmRebuild(game)), false, false).Button);
+        var delete = SettingsRow("Delete this game…", () => Then(() => ConfirmDelete(game)), false, false);
+        delete.Title.TextColor = Theme.Error;
+        more.Add(delete.Button);
+
+        var column = new List<UIView> { top, head, actionBlock, SectionLabel("GAME"), SettingsCard(gameRows.ToArray()) };
+        if (shadersBlock != null) column.Add(shadersBlock);
+        column.Add(SectionLabel("STORAGE")); column.Add(SettingsCard(storage.ToArray()));
+        column.Add(SectionLabel("MORE")); column.Add(SettingsCard(more.ToArray()));
+        var stack = Theme.Column(8, column.ToArray());
+        stack.SetCustomSpacing(18, head);
+        stack.SetCustomSpacing(22, actionBlock);
+        foreach (var v in column.Skip(4)) if (!(v is UILabel)) stack.SetCustomSpacing(20, v);
+        var scroll = new UIScrollView { AlwaysBounceVertical = true, ShowsVerticalScrollIndicator = false };
+        stack.TranslatesAutoresizingMaskIntoConstraints = false;
+        scroll.TranslatesAutoresizingMaskIntoConstraints = false;
+        scroll.AddSubview(stack);
+        Theme.PinColumn(scroll, stack, 12, 32, 20);
+        vc.View.AddSubview(scroll);
+        NSLayoutConstraint.ActivateConstraints(new[]
+        {
+            scroll.TopAnchor.ConstraintEqualTo(vc.View.SafeAreaLayoutGuide.TopAnchor), scroll.BottomAnchor.ConstraintEqualTo(vc.View.BottomAnchor),
+            scroll.LeadingAnchor.ConstraintEqualTo(vc.View.LeadingAnchor), scroll.TrailingAnchor.ConstraintEqualTo(vc.View.TrailingAnchor),
+        });
+        if (openSettings) nav.SetViewControllers(new UIViewController[] { vc, SettingsPage() }, false);
+        Theme.StyleSheet(nav);
+        var sheet = nav.SheetPresentationController;
+        if (sheet != null && !Theme.IsPad) { sheet.Detents = new[] { UISheetPresentationControllerDetent.CreateLargeDetent() }; sheet.PrefersGrabberVisible = true; }
+        PresentViewController(nav, true, null);
+    }
+
+}
