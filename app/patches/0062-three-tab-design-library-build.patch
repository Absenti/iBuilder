+    /// The buttons a game has right now, and its state chip. A running build or boot disables them (the phone is theirs).
+    private List<ShelfAct> ShelfActions(LibraryEntry e, UiFacts facts, out string chip, out UIColor tone)
+    {
+        var name = e.Name;
+        bool busy = facts.Running;
+        chip = null; tone = Theme.Muted;
+        var acts = new List<ShelfAct>();
+        var frac = CoverFraction(name, facts);
+        if (running && frac != null)
+        {
+            chip = $"Building {Math.Round(frac.Value * 100):0}%"; tone = Theme.Accent;
+            acts.Add(new ShelfAct("Watch the build", "list.bullet.rectangle", false, ShowBuildScreen));
+            return acts;
+        }
+        var next = GameAppUi.GameAction(name, facts);
+        var names = Dumps().Select(Path.GetFileName).ToList();
+        bool ready = GameAppUi.GameStatusOf(name, facts) == GameAppUi.GameStatus.Ready;
+        bool update = ready && GameAppUi.ContentChangedSinceBuild(name, names, facts);
+        void PlayIt() { selected = name; PrimaryTapped(); }
+        void ExportIt() { selected = name; ConfirmExport(name); }
+        if (!ready)
+        {
+            chip = "Needs setup"; tone = Theme.Warn;
+            acts.Add(new ShelfAct(next.Kind == ActionKind.Import ? "Import keys" : "Set up", next.Kind == ActionKind.Import ? "key.fill" : "hammer.fill", true, PlayIt));
+            return acts;
+        }
+        if (update) { chip = "Update available"; tone = Theme.Accent; acts.Add(new ShelfAct("Update", "arrow.triangle.2.circlepath", true, () => DoUpdate(name))); }
+        if (next.Kind == ActionKind.Boot)
+            acts.Add(new ShelfAct("Play", "play.fill", !update, PlayIt));
+        if (!(update && next.Kind == ActionKind.Boot))
+            acts.Add(new ShelfAct("Export IPA", "square.and.arrow.up", next.Kind != ActionKind.Boot && !update, ExportIt));
+        return acts;
+    }
+
+    /// The update or DLC added since the build goes in: the whole build runs again.
+    private void DoUpdate(string name)
+    {
+        selected = name;
+        if (AskIfHot(() => DoUpdate(name))) return;
+        SetUpAndPlay(name);
+        RefreshScreen();
+    }
+
+    private void ConfirmRebuild(string name)
+    {
+        var a = UIAlertController.Create("Rebuild " + GameAppUi.DisplayName(name) + "?", "The whole build runs again: about a minute for most games.", UIAlertControllerStyle.Alert);
+        a.AddAction(UIAlertAction.Create("Cancel", UIAlertActionStyle.Cancel, null));
+        a.AddAction(UIAlertAction.Create("Rebuild", UIAlertActionStyle.Default, _ => DoUpdate(name)));
+        PresentWhenFree(a);
+    }
