+    private UIMenu ShelfMenu(LibraryEntry e, List<ShelfAct> acts, UiFacts facts)
+    {
+        var items = new List<UIMenuElement>();
+        foreach (var a in acts.Where(a => a.Menu == null))
+            items.Add(UIAction.Create(a.Title == "Export IPA" ? "Export as IPA…" : a.Title, UIImage.GetSystemImage(a.Symbol), null, _ => a.Do()));
+        bool ready = GameAppUi.GameStatusOf(e.Name, facts) == GameAppUi.GameStatus.Ready;
+        if (ready && !acts.Any(a => a.Title == "Export IPA") && !facts.Running)
+            items.Add(UIAction.Create("Export as IPA…", UIImage.GetSystemImage("square.and.arrow.up"), null, _ => { selected = e.Name; ConfirmExport(e.Name); }));
+        items.Add(UIAction.Create("Game settings", UIImage.GetSystemImage("gearshape"), null, _ => ShowGameSheet(e, true)));
+        var path = Path.Combine(GameAppMain.Documents, e.Name);
+        items.Add(UIAction.Create("Add to the build queue", UIImage.GetSystemImage("list.number"), null, _ => AddToBuildQueue(e.Name)));
+        foreach (var target in UploadTargets())
+            if (e.Cloud == null || e.Cloud.SourceId != target.Id)
+                items.Add(UIAction.Create("Upload to " + target.Name, UIImage.GetSystemImage("icloud.and.arrow.up"), null, _ => UploadTo(target, path, false)));
+        if (e.Cloud != null)
+            items.Add(UIAction.Create("Remove download (stays in the cloud)", UIImage.GetSystemImage("icloud.slash"), null, _ => RemoveGameDownload(e.Name)));
+        return UIMenu.Create(items.ToArray());
+    }
