+    /// The game is on this phone after a download: it joins the queue, which starts if it is not going.
+    private void QueueNow(string game)
+    {
+        if (!File.Exists(Path.Combine(GameAppMain.Documents, game))) return;
+        BuildQueue.Add(buildQueue, game);
+        SaveBuildQueue();
+        if (!queueWanted) ToggleQueue();
+        RefreshScreen();   // a build that is refused at once (no keys) has already ended the queue: the Build tab shows it
+    }
