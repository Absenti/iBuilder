+    private void RefreshShelf(UiFacts facts, IReadOnlyList<string> games)
+    {
+        if (shelfTiles == null) return;
+        // What is missing before anything can run: one tappable row each, as before.
+        foreach (var row in banner.ArrangedSubviews.ToArray()) { banner.RemoveArrangedSubview(row); row.RemoveFromSuperview(); }
+        foreach (var need in GameAppUi.Prerequisites(facts))
+        {
+            var importer = need.Importer;
+            var view = new BannerView(ChecklistLabel(need.Row), need.Row.Level == CheckLevel.Missing ? UIColor.SystemRed : UIColor.SystemOrange);
+            view.AccessibilityLabel = $"{need.Row.Label}: {need.Row.Detail}";
+            view.AccessibilityIdentifier = importer == GameAppUi.Importer.Keys ? "banner-keys" : "banner-certificate";
+            view.TouchUpInside += (_, __) => { if (importer == GameAppUi.Importer.Keys) Import(); else ImportCertificate(); };
+            banner.AddArrangedSubview(view);
+        }
+        AddKilledBanner();   // GameAppResume.cs: "iOS ended the last build (memory). Resume"
+        banner.Hidden = banner.ArrangedSubviews.Length == 0;
+
+        var localNames = Dumps().Select(Path.GetFileName).ToList();
+        var list = games.Select(g => new LibraryEntry(g, Cloud.CloudCopyOf(g, cloudFiles), CoverOf(g, facts))).ToList();
+        list.AddRange(Cloud.CloudOnlyGames(localNames, cloudFiles).Select(f => new LibraryEntry(f.Name, f, CoverOf(f.Name, facts))));
+        entries = list;   // the cloud-only ones too: the download flows look a game up there
+        if (selected == null || !entries.Any(e => e.Name == selected)) selected = entries.FirstOrDefault()?.Name;
+        if (currentTint == null) { currentTint = Theme.DefaultTint; ambient.SetTint(currentTint, false); }
+
+        var shown = list.Where(e => !IsCloudOnly(e.Name)).ToList();
+        shelfSubtitle.Text = $"{shown.Count} game{(shown.Count == 1 ? "" : "s")} · {GameAppUi.SizeText(FreeBytes())} free";
+        bool grid = shelfView == "grid";
+        void Lit(UIButton b, bool on) { b.BackgroundColor = on ? UIColor.FromWhiteAlpha(1f, 0.16f) : UIColor.Clear; b.TintColor = on ? Theme.Text : Theme.Muted; }
+        Lit(shelfGridButton, grid);
+        Lit(shelfListButton, !grid);
+
+        shelfKeep.Clear();
+        foreach (var v in shelfTiles.ArrangedSubviews.ToArray()) { shelfTiles.RemoveArrangedSubview(v); v.RemoveFromSuperview(); }
+        if (grid)
+        {
+            var cells = shown.Select(e => ShelfTile(e, facts)).ToList();
+            if (!GameExport.IsPlayer) cells.Add(ShelfAddTile(false));
+            for (int i = 0; i < cells.Count; i += 2)
+            {
+                var pair = new UIStackView(new UIView[] { cells[i], i + 1 < cells.Count ? cells[i + 1] : new UIView() })
+                    { Axis = UILayoutConstraintAxis.Horizontal, Distribution = UIStackViewDistribution.FillEqually, Spacing = 14, Alignment = UIStackViewAlignment.Top };
+                shelfTiles.AddArrangedSubview(pair);
+            }
+        }
+        else
+        {
+            var rows = new UIStackView { Axis = UILayoutConstraintAxis.Vertical, Spacing = 0 };
+            foreach (var e in shown) rows.AddArrangedSubview(ShelfRow(e, facts));
+            rows.AddArrangedSubview(ShelfAddTile(true));
+            shelfTiles.AddArrangedSubview(rows);
+        }
+
+        int appCount = FillApps(appsList);
+        appsTitle.Hidden = shelfAppsCard.Hidden = appCount == 0;
+    }
