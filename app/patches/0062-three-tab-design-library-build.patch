+public sealed partial class GameAppViewController
+{
+    private sealed record ShelfAct(string Title, string Symbol, bool Primary, Action Do, UIMenu Menu = null);
+
+    // ---- Library -----------------------------------------------------------------------------------------------
+
+    private UIStackView shelfTiles;
+    private UILabel shelfSubtitle;
+    private UIButton shelfGridButton, shelfListButton;
+    private UIView shelfAppsCard;
+    private string shelfView = "grid";
+    private readonly List<NSObject> shelfKeep = new List<NSObject>();   // the long-press delegates, alive as long as their tiles
+
+    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<UIImage, UIColor> tintCache = new System.Runtime.CompilerServices.ConditionalWeakTable<UIImage, UIColor>();
+
+    /// The colour a game gives its primary button: its cover's average, else the colour of its name.
+    private static UIColor TintOf(UIImage icon, string name)
+    {
+        if (icon == null) return Theme.ColorFor(name);
+        if (!tintCache.TryGetValue(icon, out var tint)) { tint = Theme.AverageColor(icon); tintCache.Add(icon, tint); }
+        return tint;
+    }
+
+    private static UIButton ShelfButton(string title, string symbol, bool primary, bool compact, bool enabled, UIColor tint = null)
+    {
+        bool tinted = primary && tint != null;
+        var b = new UIButton(UIButtonType.System);
+        var c = tinted ? UIButtonConfiguration.PlainButtonConfiguration : primary ? UIButtonConfiguration.FilledButtonConfiguration : UIButtonConfiguration.GrayButtonConfiguration;
+        if (!compact) c.AttributedTitle = new NSAttributedString(title, new UIStringAttributes { Font = Theme.Font(13, UIFontWeight.Semibold) });
+        if (symbol != null)
+        {
+            c.Image = UIImage.GetSystemImage(symbol);
+            c.ImagePadding = compact ? 0 : 5;
+            c.PreferredSymbolConfigurationForImage = UIImageSymbolConfiguration.Create(UIFont.SystemFontOfSize(compact ? 15 : 12, UIFontWeight.Bold));
+        }
+        c.CornerStyle = UIButtonConfigurationCornerStyle.Medium;
+        if (tinted)
+        {
+            var back = new GradientBackView(tint);
+            var background = c.Background;
+            background.CustomView = back;
+            background.CornerRadius = 12;
+            c.Background = background;
+            c.BaseForegroundColor = back.Foreground;
+        }
+        else
+        {
+            c.BaseBackgroundColor = primary ? Theme.Accent : UIColor.FromWhiteAlpha(1f, 0.12f);
+            c.BaseForegroundColor = primary ? Theme.Ground : Theme.Text;
+        }
