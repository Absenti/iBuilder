+    private void RefreshBuildTab(UiFacts facts)
+    {
+        if (buildSub == null) return;
+        int filter = (int) buildFilter.SelectedSegment;   // 0 all, 1 on this phone, 2 cloud
+        var localNames = Dumps().Select(Path.GetFileName).ToList();
+        var phone = (facts.Games ?? new List<string>()).ToList();
+        var cloud = GameExport.IsPlayer ? new List<CloudFile>() : Cloud.CloudOnlyGames(localNames, cloudFiles);
+        buildSub.Text = $"{phone.Count} on this {GameAppUi.DeviceName}" + (cloud.Count > 0 ? $" · {cloud.Count} in the cloud" : "") + (buildQueue.Items.Count > 0 ? $" · {buildQueue.Items.Count} queued" : "");
+
+        // Now: the build that is running
+        buildNowCard.Hidden = !running;
+        if (running)
+        {
+            var s = GameAppUi.ParseStage(lastStage);
+            var step = GameAppUi.BuildSteps(lastStage, stepStarts, DateTime.Now).FirstOrDefault(r => r.State == GameAppUi.StepState.Now);
+            buildNowLine.Text = $"{GameAppUi.DisplayName(selected ?? "")} · {Math.Round(s.Fraction * 100):0}% · {step?.Name ?? "Starting"} · {GameAppUi.FormatElapsed(DateTime.Now - startedAt)}";
+            buildNowBar.Progress = (float) Math.Max(0.02, s.Fraction);
+        }
+        buildQueueSection.Hidden = buildQueue.Items.Count == 0 && !queueWanted;
+
+        // On this phone
+        foreach (var v in phoneList.ArrangedSubviews.ToArray()) { phoneList.RemoveArrangedSubview(v); v.RemoveFromSuperview(); }
+        for (int i = 0; i < phone.Count; i++)
+        {
+            var name = phone[i];
+            bool ready = GameAppUi.GameStatusOf(name, facts) == GameAppUi.GameStatus.Ready;
+            bool update = ready && GameAppUi.ContentChangedSinceBuild(name, localNames, facts);
+            bool isBase = GameAppUi.ContentKindOf(name) == GameAppUi.ContentKind.Base && !GameAppUi.IsNup(name);
+            var acts = new List<ShelfAct>();
+            var frac = CoverFraction(name, facts);
+            string chip; UIColor tone;
+            if (running && frac != null) { chip = $"Building {Math.Round(frac.Value * 100):0}%"; tone = Theme.Accent; }
+            else
+            {
+                var more = new List<UIMenuElement>();
+                if (!ready) { chip = "Not built yet"; tone = Theme.Warn; acts.Add(new ShelfAct("Build", "hammer.fill", true, () => { selected = name; PrimaryTapped(); })); more.Add(UIAction.Create("Add to the build queue", UIImage.GetSystemImage("list.number"), null, _ => AddToBuildQueue(name))); }
+                else if (update) { chip = "Update available"; tone = Theme.Accent; acts.Add(new ShelfAct("Update", "arrow.triangle.2.circlepath", true, () => DoUpdate(name))); }
+                else { chip = "Built"; tone = Theme.Ok; acts.Add(new ShelfAct("Rebuild", "arrow.clockwise", false, () => ConfirmRebuild(name))); }
+                if (isBase) more.Add(UIMenu.Create("Update & DLC", UIImage.GetSystemImage("plus"), UIMenuIdentifier.None, UIMenuOptions.DisplayInline, ContentMenu(name, facts).Children));
+                if (more.Count > 0) acts.Add(new ShelfAct("More", "ellipsis", false, null, UIMenu.Create(more.ToArray())));
+            }
+            var cloudCopy = Cloud.CloudCopyOf(name, cloudFiles);
+            phoneList.AddArrangedSubview(BuildRow(CoverOf(name, facts), GameAppUi.DisplayName(name), GameAppUi.SizeText(SafeLength(Path.Combine(GameAppMain.Documents, name))) + (cloudCopy != null ? " · also in the cloud" : ""),
+                                                  false, frac, chip, tone, acts, !facts.Running, i == 0));
+        }
+        if (phone.Count == 0) phoneList.AddArrangedSubview(Theme.Label("No game on this " + GameAppUi.DeviceName + " yet. Tap + to import a .nsp, .xci, .nsz or .nup, or pick one in the cloud.", Theme.Font(14, UIFontWeight.Regular), Theme.Muted, 0));
+        phoneSection.Hidden = filter == 2;
+        phoneCard.Hidden = false;   // it holds the "no game yet" line when there is none
+
+        // In the cloud
+        foreach (var v in cloudList.ArrangedSubviews.ToArray()) { cloudList.RemoveArrangedSubview(v); v.RemoveFromSuperview(); }
+        for (int i = 0; i < cloud.Count; i++)
+        {
+            var f = cloud[i];
+            var entry = entries.FirstOrDefault(x => x.Name == f.Name) ?? new LibraryEntry(f.Name, f, CoverOf(f.Name, facts));
+            bool busy = downloads.TryGetValue(f.Name, out var d);
+            var acts = new List<ShelfAct>();
+            string chip = null; UIColor tone = Theme.Accent;
+            if (busy) chip = $"Downloading {Math.Round(d * 100):0}%";
+            else
+            {
+                acts.Add(new ShelfAct("Download and build", "hammer.fill", true, () => DownloadAndBuild(entry)));
+                acts.Add(new ShelfAct("Download", "arrow.down.to.line", false, () => { selected = entry.Name; DownloadSelected(); }));
+            }
+            cloudList.AddArrangedSubview(BuildRow(entry.Icon, GameAppUi.DisplayName(f.Name), Cloud.Where(f, cloudSources),   // already says the source and the size
+                                                  false, busy ? (double?) Math.Max(0.02, d) : null, chip, tone, acts, !facts.Running || busy, i == 0));
+        }
+        cloudNote.Text = cloudSources.Count == 0 ? "No cloud source yet. Settings › Cloud adds a NAS or a folder (iCloud Drive, Google Drive…)."
+                       : cloud.Count == 0 ? "Everything in your cloud sources is already on this " + GameAppUi.DeviceName + "." : "";
+        cloudNote.Hidden = cloudNote.Text.Length == 0;
+        cloudCard.Hidden = cloud.Count == 0;
+        cloudSection.Hidden = filter == 1 || (cloud.Count == 0 && cloudSources.Count > 0 && filter == 0);
+    }
+
+    private void DownloadAndBuild(LibraryEntry e)
+    {
+        if (e.Cloud == null || downloads.ContainsKey(e.Name)) return;
+        selected = e.Name;
+        var local = Dumps().Select(Path.GetFileName).ToList();
+        var set = Cloud.DownloadSet(e.Name, e.Cloud.SourceId, cloudFiles, local);
+        if (set.Count == 0) set = new List<CloudFile> { e.Cloud };
+        Download(set, GameAppMain.Documents, key => QueueNow(e.Name));
+    }
