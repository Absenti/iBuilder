+        var info = Theme.Column(8, cover, Theme.Column(2, name, meta));
+        info.UserInteractionEnabled = false;
+        // The buttons sit one under the other: a tile is about 165 pt wide and "Export IPA" must fit in its button
+        var tint = TintOf(e.Icon, GameAppUi.DisplayName(e.Name));
+        var buttons = Theme.Column(8, acts.Select(a => (UIView) ShelfActButton(a, false, !facts.Running || a.Title == "Watch the build", tint)).ToArray());
+        foreach (var v in new UIView[] { info, buttons }) { v.TranslatesAutoresizingMaskIntoConstraints = false; tile.AddSubview(v); }
+        var constraints = new List<NSLayoutConstraint>
+        {
+            info.TopAnchor.ConstraintEqualTo(tile.TopAnchor), info.LeadingAnchor.ConstraintEqualTo(tile.LeadingAnchor), info.TrailingAnchor.ConstraintEqualTo(tile.TrailingAnchor),
+            buttons.TopAnchor.ConstraintEqualTo(info.BottomAnchor, 10), buttons.LeadingAnchor.ConstraintEqualTo(tile.LeadingAnchor), buttons.TrailingAnchor.ConstraintEqualTo(tile.TrailingAnchor),
+            buttons.BottomAnchor.ConstraintEqualTo(tile.BottomAnchor),
+        };
+        if (chipText != null)
+        {
+            var chip = ShelfChip(chipText, tone);
+            tile.AddSubview(chip);
+            constraints.Add(chip.TopAnchor.ConstraintEqualTo(cover.TopAnchor, 10));
+            constraints.Add(chip.LeadingAnchor.ConstraintEqualTo(cover.LeadingAnchor, 10));
