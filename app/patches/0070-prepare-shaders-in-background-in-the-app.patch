@@ -107,10 +107,9 @@
         string step = stage.Valid ? $"{stage.Step}/{stage.Of}: {stage.Text}" : (lastStage ?? "Starting");
         if (backgroundWarm)
         {
-            // the warm-up's own status ("Preparing the shaders… 1200 of 29650")
+            // the warm-up's own fraction and status ("Preparing the shaders… 1,200 of 4,000": the count has thousands separators now, so it is not parsed back from the text)
             var status = GameWarm.Status ?? "";
-            var m = System.Text.RegularExpressions.Regex.Match(status, @"(\d+) of (\d+)");
-            if (m.Success && long.TryParse(m.Groups[2].Value, out var total) && total > 0) fraction = long.Parse(m.Groups[1].Value) / (double) total;
+            fraction = GameWarm.Fraction;
             step = status.Length > 0 ? status : "Starting";
         }
         lock (backgroundLock)
@@ -125,6 +124,17 @@
                 backgroundSubtitle = step;
                 task.UpdateTitle(task.Title, step);
             }
+        }
+    }
+
+    /// The shader warm-up ended or was stopped: its task ends, and ONLY a warm-up's (patch 0070: the warm-up's ticker used to call BackgroundEnd, which would end a build's task that started
+    /// meanwhile; and StopWarm ends it before BeginRun asks for the build's). Nothing when the task in flight is a build's, or none is.
+    private void BackgroundEndWarm(bool success)
+    {
+        lock (backgroundLock)   // held across the look and the end (Monitor is re-entrant: BackgroundEnd takes it again)
+        {
+            if (!backgroundWarm || backgroundId == null) return;
+            BackgroundEnd(success);
         }
     }
 
