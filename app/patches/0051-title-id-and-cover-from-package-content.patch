+
+    // A dump whose file name carries no title id (`Some Game (v4.0.0 + all DLC) (EU).xci`): the id is read from the package itself (its application's control
+    // NCA, FetchMissingIcons) and kept in Documents/.titleids.tsv, so the saves, the mods, the warm-up, the shader pack and the cover find the game by the same id as for any other dump.
+    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, ulong> titleFromContent = new System.Collections.Concurrent.ConcurrentDictionary<string, ulong>();
+
+    internal static void SetTitleFromContent(string fileName, ulong baseTitleId) => titleFromContent[fileName] = baseTitleId;
+
+    internal static bool HasTitleFromContent(string fileName) => titleFromContent.ContainsKey(fileName);
+
+    internal static void LoadTitlesFromContent(string documents)
+    {
+        try
+        {
+            var path = System.IO.Path.Combine(documents, ".titleids.tsv");
+            if (!System.IO.File.Exists(path)) return;
+            foreach (var line in System.IO.File.ReadAllLines(path))
+            {
+                var p = line.Split('\t');
+                if (p.Length == 2 && ulong.TryParse(p[1], NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var id)) titleFromContent[p[0]] = id;
+            }
+        }
+        catch (Exception) { }
+    }
+
+    internal static void SaveTitlesFromContent(string documents)
+    {
+        try
+        {
+            var lines = titleFromContent.OrderBy(kv => kv.Key, StringComparer.Ordinal).Select(kv => kv.Key + "\t" + kv.Value.ToString("X16", CultureInfo.InvariantCulture));
+            var path = System.IO.Path.Combine(documents, ".titleids.tsv");
+            System.IO.File.WriteAllText(path + ".part", string.Join("\n", lines) + "\n");
+            if (System.IO.File.Exists(path)) System.IO.File.Delete(path);
+            System.IO.File.Move(path + ".part", path);
+        }
+        catch (Exception) { }
+    }
+
+    /// `games/_unresolved/<hash>.none` relative to Documents: this dump (no title id in its name) was read and gave none; tried again only with newer keys.
+    internal static string UnresolvedMarker(string fileName)
+    {
+        var hash = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(fileName ?? ""));
+        return "games/_unresolved/" + Convert.ToHexString(hash, 0, 8) + ".none";
     }
 
     public enum ContentKind { Base, Update, AddOn, Unknown }
