+        int ag2 = Array.IndexOf(parts, "AppGroup");
+        if (ag2 >= 0) return "another app's shared storage (app group " + (ag2 + 1 < parts.Length ? parts[ag2 + 1].Substring(0, Math.Min(8, parts[ag2 + 1].Length)) + "…" : "?") + ")";
+        if (Array.IndexOf(parts, "Application") >= 0 && Array.IndexOf(parts, "Containers") >= 0) return "another app's folder (On My iPhone)";
+        return "location not recognised: /" + string.Join("/", parts.Take(3));
+    }
