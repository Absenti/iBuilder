+// gameapp/GameAppImportFolder.cs -- "Add from a folder without copying": what is looked for in the folder, which files are "In the library" already, and what the person chose, with no UIKit (patch 0067; the host
+// harness compiles this file as it is).
+//
+// Why a folder: the FILE picker in Open mode does not deliver its selection on iOS 27.0.1 or 27.2.1 (the delegate gets "cancelled" when the person taps Open: measured on the owner's iPhone), while the FOLDER picker in
+// Open mode does (the Cloud page's "Add a folder"). So the person picks the folder that holds the games, the app looks inside it, shows what it found, and clones the chosen files (GameImport.Place, patch 0066).
+//
+//   FolderEntry / FolderListing   one entry of a folder as the file system lists it (name, folder or not, link or not, size from the directory entry: no file is opened or read), and the real lister.
+//   FolderScan                    the top level of the folder plus ONE level of subfolders, at most 2,000 entries read, never deeper: the files InPlaceImport accepts (.nsp .xci .nsz .nup, prod.keys), an iCloud
+//                                 placeholder (.name.icloud) under its real name, hidden files and links never, each name once (the top level wins), "In the library" when Documents has that name.
+//   FolderChoice                  the sheet's model: one row per file, multi-select, Select all / Select none, rows already in the library disabled, "Add N".
+//   FolderImportText              the words of the rows and the log.
+//   PickedLocation                where a picked folder is, in words for the picker log lines (iCloud Drive, a File Provider's storage, a network share, this app's own folder...).
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Enumeration;
+using System.Linq;
+
+/// One entry of a folder. `Size`: the directory entry's size (-1 for a folder or when it is not known).
+public sealed record FolderEntry(string Name, bool IsDirectory, bool IsLink, long Size);
+
+/// A game file (or prod.keys) found in the folder. `Name`: the name it will have in Documents (the real name of an iCloud placeholder). `Relative`: where it is under the picked folder ("Name" or "Sub/Name"; for a
+/// placeholder the real name's path: the coordinated read that reads it downloads it first). `Size`: -1 when it is only a placeholder (not downloaded: the size is not known without the cloud).
+public sealed record FolderFile(string Name, string Relative, string Folder, long Size, bool Placeholder, bool InLibrary);
+
+/// What the scan found. `Entries`: how many directory entries were read; `Folders`: how many subfolders were listed; `Truncated`: the cap was reached (the rest of the folder was not looked at);
+/// `Duplicates`: files whose name was already found (the first one stands: the top level before a subfolder).
+public sealed record FolderScanResult(IReadOnlyList<FolderFile> Files, int Entries, int Folders, bool Truncated, int Duplicates);
+
+public static class FolderListing
+{
+    /// The real lister: the entries of `root`/`relative` ("" = the folder itself) from one readdir, the size from the directory entry (a stat, never a read of the file), links flagged. Lazy: the scan stops reading
+    /// at its cap. An entry that cannot be read is skipped (IgnoreInaccessible); a folder that is not there throws when it is enumerated (the scan reports the top one, and skips a subfolder that went away). Worker threads only.
+    public static Func<string, IEnumerable<FolderEntry>> OnDisk(string root) => relative =>
+    {
+        var path = string.IsNullOrEmpty(relative) ? root : Path.Combine(root, relative);
+        var options = new EnumerationOptions { RecurseSubdirectories = false, IgnoreInaccessible = true, AttributesToSkip = 0, ReturnSpecialDirectories = false };
+        return new FileSystemEnumerable<FolderEntry>(path,
+            (ref FileSystemEntry e) => new FolderEntry(e.FileName.ToString(), e.IsDirectory, (e.Attributes & FileAttributes.ReparsePoint) != 0, e.IsDirectory ? -1 : e.Length), options);
+    };
+}
+
+public static class FolderScan
+{
+    /// About 2,000 entries: a folder of thousands is looked at in part, never walked to its end (the scan is on a worker, but a provider's folder can be slow to list).
+    public const int MaxEntries = 2000;
+
+    /// "X.nsp" for ".X.nsp.icloud" (an iCloud file not downloaded here), else null.
+    internal static string PlaceholderName(string name)
+    {
+        var real = Cloud.RealName(name);   // GameAppCloud.cs: ".X.nsp.icloud" -> "X.nsp", anything else as it is
+        return !string.IsNullOrEmpty(name) && real != name ? real : null;
+    }
+
+    /// A file this import takes, whatever else the folder holds: not hidden (".DS_Store", "._Game.nsp" next to a game on an exFAT card), not a link, and a name InPlaceImport.Accepts.
+    /// Returns the name it will have in Documents, or null.
+    internal static string Taken(FolderEntry e, out bool placeholder)
+    {
+        placeholder = false;
+        if (e.IsDirectory || e.IsLink || string.IsNullOrEmpty(e.Name)) return null;
+        var holder = PlaceholderName(e.Name);
+        if (holder != null) { placeholder = true; return InPlaceImport.Accepts(holder) ? holder : null; }
+        if (e.Name.StartsWith(".", StringComparison.Ordinal)) return null;
+        return InPlaceImport.Accepts(e.Name) ? e.Name : null;
+    }
+
+    /// `list(relative)`: the entries of the folder ("" = the picked folder, "Sub" = one of its subfolders). `libraryNames`: the file names Documents has (the games it lists, and prod.keys when it is there).
+    public static FolderScanResult Scan(Func<string, IEnumerable<FolderEntry>> list, IEnumerable<string> libraryNames, int maxEntries = MaxEntries)
+    {
+        var library = new HashSet<string>(libraryNames ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);
+        var files = new List<FolderFile>();
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        var subfolders = new List<string>();
+        int entries = 0, folders = 0, duplicates = 0;
+        bool truncated = false;
+
+        // returns false when the cap is reached
+        bool Read(string relative, bool top)
+        {
+            IEnumerable<FolderEntry> listed;
+            try { listed = list(relative) ?? Array.Empty<FolderEntry>(); }
+            catch (Exception) when (!top) { return true; }   // a subfolder that cannot be opened is skipped; the picked folder itself is the caller's error
+            using var cursor = listed.GetEnumerator();
+            while (true)
+            {
+                FolderEntry e;
+                try { if (!cursor.MoveNext()) break; e = cursor.Current; }
+                catch (Exception) when (!top) { return true; }   // ... or that goes away while it is read
+
+                if (entries >= maxEntries) { truncated = true; return false; }
+                entries++;
+                if (top && e.IsDirectory && !e.IsLink && !string.IsNullOrEmpty(e.Name) && !e.Name.StartsWith(".", StringComparison.Ordinal) && InPlaceImport.SafeName(e.Name)) { subfolders.Add(e.Name); continue; }
+                var name = Taken(e, out var placeholder);
+                if (name == null) continue;
+                if (!seen.Add(name)) { duplicates++; continue; }
+                files.Add(new FolderFile(name, relative.Length == 0 ? name : relative + "/" + name, relative, placeholder ? -1 : e.Size, placeholder, library.Contains(name)));
+            }
+            return true;
+        }
+
+        if (Read("", true))
+            foreach (var sub in subfolders.OrderBy(s => s, StringComparer.OrdinalIgnoreCase).ToList())
+            {
+                folders++;
+                if (!Read(sub, false)) break;   // one level only: a subfolder's folders are never listed
+            }
+        return new FolderScanResult(files.OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase).ThenBy(f => f.Relative, StringComparer.Ordinal).ToList(), entries, folders, truncated, duplicates);
+    }
+}
+
+/// The sheet's model: what is selected. Rows already in the library cannot be chosen. Two rows of one name (the scan keeps one) could not both be chosen either: Documents has one file of a name.
+public sealed class FolderChoice
+{
+    private readonly IReadOnlyList<FolderFile> files;
+    private readonly bool[] chosen;
+
+    public FolderChoice(IReadOnlyList<FolderFile> files)
+    {
+        this.files = files ?? Array.Empty<FolderFile>();
+        chosen = new bool[this.files.Count];
+    }
+
+    public IReadOnlyList<FolderFile> Files => files;
+    public bool CanChoose(int row) => row >= 0 && row < files.Count && !files[row].InLibrary;
+    public bool IsChosen(int row) => row >= 0 && row < files.Count && chosen[row];
+    public int Choosable => Enumerable.Range(0, files.Count).Count(CanChoose);
+    public int InLibrary => files.Count(f => f.InLibrary);
+    public int Count => chosen.Count(c => c);
+    public bool AllChosen => Choosable > 0 && Count == Choosable;
+
+    /// Taps a row: a row in the library does nothing; choosing a name that another chosen row already has un-chooses that one.
+    public void Toggle(int row)
+    {
+        if (!CanChoose(row)) return;
+        if (chosen[row]) { chosen[row] = false; return; }
+        for (int i = 0; i < files.Count; i++)
+            if (chosen[i] && string.Equals(files[i].Name, files[row].Name, StringComparison.OrdinalIgnoreCase)) chosen[i] = false;
+        chosen[row] = true;
+    }
+
+    /// "Select all": every row that can be chosen (one per name). When all are chosen already, the same button says "Select none" and clears them.
+    public void SelectAllOrNone()
+    {
+        if (AllChosen) { Array.Clear(chosen, 0, chosen.Length); return; }
+        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        for (int i = 0; i < files.Count; i++)
+        {
+            chosen[i] = CanChoose(i) && names.Add(files[i].Name);
+        }
+    }
+
+    public IReadOnlyList<FolderFile> Chosen => files.Where((f, i) => chosen[i]).ToList();
+
+    /// The bytes of the chosen files that are known (a placeholder's size is not).
+    public long KnownBytes => files.Where((f, i) => chosen[i] && f.Size >= 0).Sum(f => f.Size);
+    public bool SomeSizeUnknown => files.Where((f, i) => chosen[i]).Any(f => f.Size < 0);
+
+    public string AddTitle => "Add " + Count;
+    public string SelectTitle => AllChosen ? "Select none" : "Select all";
+}
+
+/// The words of the sheet and the log.
+public static class FolderImportText
+{
+    public const string Title = "Add from a folder";
+    public const string InLibrary = "In the library";
+    public const string Cancel = "Cancel";
+
+    /// The log line when the scan is done.
+    public static string Found(string folder, int count) => $"import: folder {folder}: {count} game file(s) found";
+
+    /// The second line of a row: the size and where it is, or why it cannot be chosen.
+    public static string Detail(FolderFile f) =>
+        f.InLibrary ? InLibrary
+        : f.Placeholder ? "In iCloud, not downloaded yet" + (f.Folder.Length > 0 ? " · " + f.Folder : "")
+        : GameAppUi.SizeText(f.Size) + (f.Folder.Length > 0 ? " · " + f.Folder : "");
+
+    /// Under the list: what is chosen.
+    public static string Summary(FolderChoice choice)
+    {
+        if (choice.Count == 0) return choice.Choosable == 0 ? "Everything in this folder is in the library already." : "Nothing chosen.";
+        return $"{choice.Count} chosen" + (choice.KnownBytes > 0 ? " · " + (choice.SomeSizeUnknown ? "at least " : "") + GameAppUi.SizeText(choice.KnownBytes) : "")
+               + ". Cloned, not copied, when they are on this " + GameAppUi.DeviceName + "'s storage.";
+    }
+
+    public static string Truncated(int max) => $"Only the first {max:N0} entries were looked at (the folder, and one level of folders in it).";
+
+    public static string Empty(string folder) => $"{folder} holds no .nsp, .xci, .nsz or .nup game file and no prod.keys, at its top level or one folder down.";
+}
