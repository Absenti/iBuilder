diff -ruN a/GameAppPickers.cs b/GameAppPickers.cs
--- a/GameAppPickers.cs
+++ b/GameAppPickers.cs
@@ -0,0 +1,133 @@
+// gameapp/GameAppPickers.cs -- the ONE place a FOLDER picker is made (patch 0067): the Cloud page's "Add a folder", its "Add a folder (older picker)", the game files of an exported app, "Find them in a folder" (a game's update
+// and DLC) and "Add from a folder without copying". Why one place: on the owner's iPhone (iOS 27.2.1) the Cloud page's "Add a folder" stopped answering (no `cloud:` line at all in the log: the picker's callback never
+// reached the app), after it had worked on 27.0.1, and nobody can tell yet whether it is iOS, the iCloud provider or the initialiser. So every folder picker now
+//   * is built the MODERN way by default: new UIDocumentPickerViewController(new[] { UTTypes.Folder }, asCopy: false), AllowsMultipleSelection = false ("modern API"); the previous way, the obsolete initialiser with
+//     public.folder and UIDocumentPickerMode.Open, is the "older API" (the Cloud page has a button for it, and the offer below);
+//   * has ONE delegate that answers all three callbacks (documentPicker:didPickDocumentsAtURLs:, the single-URL documentPicker:didPickDocumentAtURL:, documentPickerWasCancelled:), each purpose told once;
+//   * writes the same log lines, so the next field log shows what happens: `picker: <purpose> folder picker is open (<api>; <start location>)`, `picker: <purpose> picked <name> (<where: provider / domain>; <api>)`,
+//     `picker: <purpose> provider domain <identifier>` (NSFileProviderManager, when it answers), `picker: <purpose> cancelled (<api>)`, and when the controller went away with no callback at all
+//     `picker: <purpose> closed with no answer (<api>)`, which also offers to try the older picker.
+// FolderPickerOlderByDefault is the one switch to flip when the field log says the older initialiser is the one that answers.
+using System;
+using System.Linq;
+using System.Threading;
+
+using FileProvider;
+using Foundation;
+using UIKit;
+using UniformTypeIdentifiers;
+
+public sealed partial class GameAppViewController
+{
+    /// false: every folder picker is built the modern way unless the caller asks for the older one.
+    internal static readonly bool FolderPickerOlderByDefault = false;
+
+    private NSObject folderPickerKeep;   // the delegate of the picker that is up (UIKit does not keep it)
+
+    /// Opens a folder picker for `purpose` (a few words: "cloud folder", "import folder"...). `picked(url)` on the main thread with the folder (its security scope is not started: the caller starts it); `cancelled()` when
+    /// the person cancelled or no folder came back. `older`: the previous initialiser (the Cloud page's second button; also the answer of the offer below).
+    private void PresentFolderPicker(string purpose, Action<NSUrl> picked, Action cancelled = null, bool? older = null)
+    {
+        bool useOlder = older ?? FolderPickerOlderByDefault;
+        UIDocumentPickerViewController picker;
+        if (useOlder)
+        {
+            // The initialiser that was here before patch 0067 (Open mode, public.folder): kept as the fallback, the warning silenced for these two lines.
+#pragma warning disable CA1422
+            picker = new UIDocumentPickerViewController(new[] { "public.folder" }, UIDocumentPickerMode.Open);
+#pragma warning restore CA1422
+        }
+        else picker = new UIDocumentPickerViewController(new[] { UTTypes.Folder }, false);   // asCopy: false = open the folder where it is (the non-obsolete initialiser, as the cover picker's)
+        picker.AllowsMultipleSelection = false;
+        var api = useOlder ? "older API" : "modern API";
+        var answer = new FolderPickerAnswer(purpose, api, line => Write(line), picked, cancelled);
+        folderPickerKeep = answer;
+        picker.Delegate = answer;
+        var start = picker.DirectoryUrl?.Path;
+        Write($"picker: {purpose} folder picker is open ({api}; " + (string.IsNullOrEmpty(start) ? "no start location set" : "opened in " + PickedLocation.Describe(start, Environment.GetEnvironmentVariable("HOME"))) + ")");
+        PresentWhenFree(picker);
+        WatchFolderPicker(picker, answer, purpose, api, useOlder, () => PresentFolderPicker(purpose, picked, cancelled, older: true));
+    }
+
+    /// One delegate for every folder picker: the plural and the single-URL callbacks are one answer (the first), a cancel is an answer too.
+    private sealed class FolderPickerAnswer : NSObject, IUIDocumentPickerDelegate
+    {
+        private readonly string purpose, api;
+        private readonly Action<string> log;
+        private readonly Action<NSUrl> picked;
+        private readonly Action cancelled;
+        private int answered;
+        public FolderPickerAnswer(string purpose, string api, Action<string> log, Action<NSUrl> picked, Action cancelled)
+        {
+            this.purpose = purpose; this.api = api; this.log = log; this.picked = picked; this.cancelled = cancelled;
+        }
+
+        public bool Answered => Volatile.Read(ref answered) != 0;
+
+        [Export("documentPicker:didPickDocumentsAtURLs:")]
+        public void DidPickDocumentAtUrls(UIDocumentPickerViewController controller, NSUrl[] urls) => Pick(urls?.FirstOrDefault());
+
+        [Export("documentPicker:didPickDocumentAtURL:")]
+        public void DidPickDocument(UIDocumentPickerViewController controller, NSUrl url) => Pick(url);
+
+        [Export("documentPickerWasCancelled:")]
+        public void WasCancelled(UIDocumentPickerViewController controller)
+        {
+            if (Interlocked.Exchange(ref answered, 1) != 0) return;
+            log($"picker: {purpose} cancelled ({api})");
+            cancelled?.Invoke();
+        }
+
+        private void Pick(NSUrl url)
+        {
+            if (Interlocked.Exchange(ref answered, 1) != 0) return;
+            if (url == null || string.IsNullOrEmpty(url.Path))
+            {
+                log($"picker: {purpose} answered with no folder ({api})");
+                cancelled?.Invoke();
+                return;
+            }
+            log($"picker: {purpose} picked {url.LastPathComponent} ({PickedLocation.Describe(url.Path, Environment.GetEnvironmentVariable("HOME"))}; {api})");
+            try
+            {
+                // the provider's own name for where it is (its domain), when the system tells: only for the log (the API is iOS / macOS only: the Mac Catalyst warning is silenced)
+#pragma warning disable CA1416
+                NSFileProviderManager.GetIdentifierForUserVisibleFile(url, (item, domain, error) =>
+                    NSOperationQueue.MainQueue.AddOperation(() => log($"picker: {purpose} provider domain " + (domain != null ? domain.ToString() : "none") + (error != null ? $" ({error.Domain} {error.Code})" : ""))));
+#pragma warning restore CA1416
+            }
+            catch (Exception) { }
+            picked(url);
+        }
+    }
+
+    /// The controller is gone and not one callback came: the line, and the offer of the older picker (only after the modern one). Two property reads twice a second, at most 10 minutes.
+    private void WatchFolderPicker(UIDocumentPickerViewController picker, FolderPickerAnswer answer, string purpose, string api, bool older, Action tryOlder)
+    {
+        int ticks = 0, gone = 0;
+        bool shown = false;
+        void Tick()
+        {
+            if (answer.Answered || ++ticks > 1200) return;
+            bool on = picker.IsViewLoaded && picker.View?.Window != null;
+            if (on) { shown = true; gone = 0; }
+            else if (shown && ++gone >= 6)
+            {
+                Write($"picker: {purpose} closed with no answer ({api})");
+                if (!older) OfferOlderPicker(purpose, tryOlder);
+                return;
+            }
+            NSTimer.CreateScheduledTimer(0.5, _ => Tick());
+        }
+        NSTimer.CreateScheduledTimer(0.5, _ => Tick());
+    }
+
+    private void OfferOlderPicker(string purpose, Action tryOlder)
+    {
+        var a = UIAlertController.Create("The folder picker did not answer",
+            "iOS closed the picker without telling the app which folder was chosen. The older picker may work on this " + GameAppUi.DeviceName + ": try it?", UIAlertControllerStyle.Alert);
+        a.AddAction(UIAlertAction.Create("Try the older picker", UIAlertActionStyle.Default, _ => { Write($"picker: {purpose} trying the older picker"); tryOlder(); }));
+        a.AddAction(UIAlertAction.Create("Not now", UIAlertActionStyle.Cancel, null));
+        PresentWhenFree(a);
+    }
+}
