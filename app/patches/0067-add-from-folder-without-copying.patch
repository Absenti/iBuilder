--- a/GameAppImportFolderUi.cs
+++ b/GameAppImportFolderUi.cs
@@ -0,0 +1,155 @@
+// gameapp/GameAppImportFolderUi.cs -- the sheet of "Add from a folder without copying" (patch 0067): one row per game file the scan found, its size under the name, a circle to tick, "Select all" / "Select none", rows already in the
+// library disabled with "In the library", and "Add N". What is found and what is chosen (FolderScan, FolderChoice, FolderImportText) is in GameAppImportFolder.cs (no UIKit, run by the host harness).
+//
+// A table, not a stack of views: a folder can hold hundreds of games and only the rows on screen are built. The scan was done on a worker before this sheet exists, so opening it costs nothing. The sheet cannot be swiped
+// away (ModalInPresentation): "Cancel" or "Add N" end it, and either way the owner is told exactly once (the picked folder's security scope is stopped there).
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+using Foundation;
+using UIKit;
+
+public sealed class GameFolderImportViewController : UIViewController
+{
+    private readonly string folderName;
+    private readonly FolderScanResult scan;
+    private readonly FolderChoice choice;
+    private readonly Action<IReadOnlyList<FolderFile>> add;
+    private readonly Action cancelled;
+    private readonly UITableView table = new UITableView(CoreGraphics.CGRect.Empty, UITableViewStyle.Plain);
+    private UIButton addButton, selectButton;
+    private UILabel summary;
+    private bool finished;
+
+    /// `add(chosen)`: "Add N" (the sheet closes first); `cancelled()`: Cancel, or the sheet went away some other way.
+    public GameFolderImportViewController(string folderName, FolderScanResult scan, Action<IReadOnlyList<FolderFile>> add, Action cancelled)
+    {
+        this.folderName = folderName; this.scan = scan; this.add = add; this.cancelled = cancelled;
+        choice = new FolderChoice(scan.Files);
+        ModalInPresentation = true;
+    }
+
+    public override void ViewDidLoad()
+    {
+        base.ViewDidLoad();
+        View.BackgroundColor = Theme.Ground;
+        View.TintColor = Theme.Accent;
+        View.AccessibilityIdentifier = "import-folder-sheet";
+
+        var title = Theme.Label(FolderImportText.Title, Theme.Rounded(22, UIFontWeight.Bold), Theme.Text);
+        title.AccessibilityTraits = UIAccessibilityTrait.Header;
+        var sub = Theme.Label($"{folderName} · {scan.Files.Count} game file{(scan.Files.Count == 1 ? "" : "s")}", Theme.Font(13, UIFontWeight.Regular), Theme.Muted, 2);
+        var cancel = UIButton.FromType(UIButtonType.System);
+        cancel.SetTitle(FolderImportText.Cancel, UIControlState.Normal);
+        cancel.AccessibilityIdentifier = "import-folder-cancel";
+        cancel.TouchUpInside += (_, __) => Close(add: false);
+        selectButton = UIButton.FromType(UIButtonType.System);
+        selectButton.AccessibilityIdentifier = "import-folder-select-all";
+        selectButton.TouchUpInside += (_, __) => { choice.SelectAllOrNone(); Changed(); };
+        var top = Theme.Row(8, Theme.Column(2, title, sub), new UIView(), cancel);
+        top.Alignment = UIStackViewAlignment.Top;
+        var selectRow = Theme.Row(8, new UIView(), selectButton);
+
+        table.TranslatesAutoresizingMaskIntoConstraints = false;
+        table.BackgroundColor = UIColor.Clear;
+        table.SeparatorColor = UIColor.FromWhiteAlpha(1f, 0.08f);
+        table.AccessibilityIdentifier = "import-folder-list";
+        table.Source = new Rows(this);
+
+        summary = Theme.Label("", Theme.Font(12, UIFontWeight.Regular), Theme.Muted, 0);
+        addButton = Theme.Pill("Add 0", "plus", true, 50);
+        addButton.AccessibilityIdentifier = "import-folder-add";
+        addButton.TouchUpInside += (_, __) => Close(add: true);
+        var foot = new List<UIView> { summary };
+        if (scan.Truncated) foot.Add(Theme.Label(FolderImportText.Truncated(FolderScan.MaxEntries), Theme.Font(12, UIFontWeight.Medium), Theme.Warn, 0));
+        foot.Add(addButton);
+        var bottom = Theme.Column(8, foot.ToArray());
+
+        top.TranslatesAutoresizingMaskIntoConstraints = false;
+        selectRow.TranslatesAutoresizingMaskIntoConstraints = false;
+        bottom.TranslatesAutoresizingMaskIntoConstraints = false;
+        View.AddSubview(top);
+        View.AddSubview(selectRow);
+        View.AddSubview(table);
+        View.AddSubview(bottom);
+        var guide = View.SafeAreaLayoutGuide;
+        NSLayoutConstraint.ActivateConstraints(new[]
+        {
+            top.TopAnchor.ConstraintEqualTo(View.TopAnchor, 20), top.LeadingAnchor.ConstraintEqualTo(guide.LeadingAnchor, 20), top.TrailingAnchor.ConstraintEqualTo(guide.TrailingAnchor, -20),
+            selectRow.TopAnchor.ConstraintEqualTo(top.BottomAnchor, 8), selectRow.LeadingAnchor.ConstraintEqualTo(guide.LeadingAnchor, 20), selectRow.TrailingAnchor.ConstraintEqualTo(guide.TrailingAnchor, -20),
+            table.TopAnchor.ConstraintEqualTo(selectRow.BottomAnchor, 4), table.LeadingAnchor.ConstraintEqualTo(guide.LeadingAnchor), table.TrailingAnchor.ConstraintEqualTo(guide.TrailingAnchor),
+            table.BottomAnchor.ConstraintEqualTo(bottom.TopAnchor, -8),
+            bottom.LeadingAnchor.ConstraintEqualTo(guide.LeadingAnchor, 20), bottom.TrailingAnchor.ConstraintEqualTo(guide.TrailingAnchor, -20), bottom.BottomAnchor.ConstraintEqualTo(guide.BottomAnchor, -12),
+        });
+        Changed();
+    }
+
+    /// Whatever ended the sheet other than its two buttons (it cannot be swiped away, but a view that disappears is not trusted): the owner is told once.
+    public override void ViewDidDisappear(bool animated)
+    {
+        base.ViewDidDisappear(animated);
+        if (!finished && IsBeingDismissed) { finished = true; cancelled(); }
+    }
+
+    private void Close(bool add)
+    {
+        if (finished) return;
+        finished = true;
+        var chosen = choice.Chosen;
+        DismissViewController(true, null);
+        if (add && chosen.Count > 0) this.add(chosen); else cancelled();
+    }
+
+    /// The model changed: the rows, the two buttons and the line under the list are drawn again from it.
+    private void Changed()
+    {
+        table.ReloadData();
+        selectButton.SetTitle(choice.SelectTitle, UIControlState.Normal);
+        selectButton.Enabled = choice.Choosable > 0;
+        var c = addButton.Configuration;
+        c.AttributedTitle = new NSAttributedString(choice.AddTitle, new UIStringAttributes { Font = Theme.Font(16, UIFontWeight.Semibold) });
+        addButton.Configuration = c;
+        addButton.Enabled = choice.Count > 0;
+        summary.Text = FolderImportText.Summary(choice);
+    }
+
+    private sealed class Rows : UITableViewSource
+    {
+        private readonly GameFolderImportViewController owner;
+        public Rows(GameFolderImportViewController owner) => this.owner = owner;
+
+        public override nint RowsInSection(UITableView tableView, nint section) => owner.choice.Files.Count;
+
+        public override UITableViewCell GetCell(UITableView tableView, NSIndexPath indexPath)
+        {
+            int row = (int) indexPath.Row;
+            var file = owner.choice.Files[row];
+            bool on = owner.choice.IsChosen(row), can = owner.choice.CanChoose(row);
+            var cell = tableView.DequeueReusableCell("row") ?? new UITableViewCell(UITableViewCellStyle.Default, "row");
+            var content = UIListContentConfiguration.SubtitleCellConfiguration;
+            content.Text = file.Name;
+            content.SecondaryText = FolderImportText.Detail(file);
+            content.TextProperties.Color = can ? Theme.Text : Theme.Dim;
+            content.TextProperties.NumberOfLines = 2;
+            content.SecondaryTextProperties.Color = can ? Theme.Muted : Theme.Dim;
+            content.Image = UIImage.GetSystemImage(on ? "checkmark.circle.fill" : can ? "circle" : "minus.circle");
+            content.ImageProperties.TintColor = on ? Theme.Accent : Theme.Dim;
+            cell.ContentConfiguration = content;
+            cell.BackgroundColor = UIColor.Clear;
+            cell.SelectionStyle = can ? UITableViewCellSelectionStyle.Default : UITableViewCellSelectionStyle.None;
+            cell.IsAccessibilityElement = true;
+            cell.AccessibilityLabel = file.Name + ", " + FolderImportText.Detail(file) + (on ? ", chosen" : "");
+            cell.AccessibilityTraits = can ? UIAccessibilityTrait.Button : UIAccessibilityTrait.Button | UIAccessibilityTrait.NotEnabled;
+            cell.AccessibilityIdentifier = "import-folder-row-" + row;
+            return cell;
+        }
+
+        public override void RowSelected(UITableView tableView, NSIndexPath indexPath)
+        {
+            tableView.DeselectRow(indexPath, true);
+            owner.choice.Toggle((int) indexPath.Row);
+            owner.Changed();
+        }
+    }
+}
