+/// Where a folder the picker returned is, from its path, for the picker log (`picker: <purpose> picked <name> (<this>)`): the next field log then shows which providers answer. Nothing here reads the disk.
+public static class PickedLocation
+{
+    /// `home`: this app's container (HOME), to tell "this app's own folder" (may be null). Never the whole path of an unknown place: its first three components.
+    public static string Describe(string path, string home = null)
+    {
+        if (string.IsNullOrEmpty(path)) return "no path";
+        var p = path.Replace('\\', '/');
+        if (home != null && home.Length > 1)
+        {
+            var h = Normal(home);
+            if (Normal(p) == h || Normal(p).StartsWith(h + "/", StringComparison.Ordinal)) return "this app's own container";
+        }
+        var parts = p.Split('/', StringSplitOptions.RemoveEmptyEntries);
+        int cs = Array.IndexOf(parts, "CloudStorage");
+        if (cs >= 0 && cs + 1 < parts.Length)
+        {
+            var provider = parts[cs + 1];
+            var dash = provider.IndexOf('-');   // "GoogleDrive-<account>": the account is not logged
+            return "CloudStorage: " + (dash > 0 ? provider.Substring(0, dash) + "-…" : provider) + " (" + Cloud.ProviderName(p) + ")";
+        }
+        int md = Array.IndexOf(parts, "Mobile Documents");
+        if (md >= 0 && md + 1 < parts.Length)
+            return parts[md + 1] == "com~apple~CloudDocs" ? "iCloud Drive: com~apple~CloudDocs" : "iCloud container: " + parts[md + 1];
+        if (p.Contains("com~apple~CloudDocs")) return "iCloud Drive: com~apple~CloudDocs";
+        int fp = Array.IndexOf(parts, "File Provider Storage");
+        if (fp >= 0)
+        {
+            int ag = Array.IndexOf(parts, "AppGroup");
+            var group = ag >= 0 && ag + 1 < parts.Length ? parts[ag + 1] : "?";
+            return "File Provider Storage, app group " + (group.Length > 8 ? group.Substring(0, 8) + "…" : group) + " (" + Cloud.ProviderName(p) + ")";
+        }
+        int live = Array.IndexOf(parts, "LiveFiles");
+        if (live >= 0)
+            return live + 1 < parts.Length && parts[live + 1].IndexOf("smb", StringComparison.OrdinalIgnoreCase) >= 0 ? "a network share (LiveFiles, SMB)" : "a network or external volume (LiveFiles)";
