+/// gameapp_run_chain's results that say WHY a run failed, so the screen tells the truth instead of "Ready" or "Built: ready to play." (patch 0078). The shim passes the library's code through unchanged
+/// (crates/ibuilder-ffi/include/ibuilder.h, docs/chain/PIPELINE-RUST.md). Any code but 0 is already a failed run (StopMachine.ChainReturned); these only give it its words.
+public static class ChainResult
+{
+    /// IBUILDER_RC_NO_SHADER_LIBRARY: the game has no shader library and would draw nothing. A build's stage 3 had to make it and could not: the chain still assembled the game but did not
+    /// boot it and wrote no framework stamp, so the game reads as not built (never "Ready"). A Play's stage 3 could not make a missing one: the boot was refused.
+    public const int NoShaderLibrary = 4;
+
+    /// What the person reads (the log's error line, the build screen, the notification).
+    public const string NoShaderLibraryText = "The shader library could not be built: the game would draw nothing. Rebuild, or send the log.";
+
+    /// The run line under the game (instead of "Stopped at <step>": the chain went on to the assembly, so the step it ended on is not the one that failed).
+    public const string NoShaderLibraryLine = "Shader library not built";
+
+    /// The build queue's note for that game.
+    public const string NoShaderLibraryNote = "the shader library could not be built: see the log";
+
+    /// IBUILDER_RC_NO_FRAMEWORK: no framework to play. Stage 4 failed, the assembly or the signature (a missing or unreadable certificate, ...): nothing was stamped or booted. It was 0, and
+    /// the screen said "Built: ready to play.". When stage 3 failed too the chain returns this one (the log says both).
+    public const int NoFramework = 5;
+
+    public const string NoFrameworkText = "The game could not be assembled or signed: see the log.";
+    public const string NoFrameworkLine = "Not assembled or signed";
+    public const string NoFrameworkNote = "the game could not be assembled or signed: see the log";
+
+    /// The reason a failed run of code `rc` has words for, or null (the generic "stopped" texts stay).
+    public static string FailureText(int rc) => rc == NoShaderLibrary ? NoShaderLibraryText : rc == NoFramework ? NoFrameworkText : null;
+
+    /// The run line's start for a failed run of code `rc`, or null ("Stopped at <step>").
+    public static string RunLine(int rc) => rc == NoShaderLibrary ? NoShaderLibraryLine : rc == NoFramework ? NoFrameworkLine : null;
+
+    /// The build queue's note for a failed run of code `rc`, or null ("the build stopped: see the log").
+    public static string QueueNote(int rc) => rc == NoShaderLibrary ? NoShaderLibraryNote : rc == NoFramework ? NoFrameworkNote : null;
+
+    /// The line the log gets for a failed run of code `rc` (an error line: "[RED]" makes it the build screen's last error, where "See what stopped it" scrolls), or null.
+    public static string LogLine(int rc) => FailureText(rc) is string t ? "[RED] " + t : null;
+}
