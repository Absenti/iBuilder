+// ---- patch 0095: a build with no .p12 is signed for export only; "Sign again to play" once the .p12 is imported ------------------------------------------------
+public sealed partial class GameAppViewController
+{
+    /// gameapp_sign_framework_again (app/gameapp_shim_rust.c): the framework in `frameworkDir` signed again with this app's identity (embedded.mobileprovision + the Keychain .p12), as stage 4b signs.
+    [System.Runtime.InteropServices.DllImport("__Internal")] private static extern int gameapp_sign_framework_again(string frameworkDir, string exe);
+
+    internal const string SignAgainTitle = "Sign again to play";
+    private string signingAgain;   // the game whose framework is being signed again (a worker thread), or null
+
+    /// The built games whose framework is signed for export only: the one in Documents (its stamp `stamp`) and the parked ones whose build this version of the app made.
+    private IReadOnlyCollection<string> ExportOnlyGames(string stamp)
+    {
+        var set = new HashSet<string>(StringComparer.Ordinal);
+        var active = GameAppUi.ParseFrameworkStamp(stamp);
+        if (active != null && active.ExportOnly && !string.IsNullOrEmpty(active.Game)) set.Add(active.Game);
+        foreach (var p in ParkedSlots())
+            if (p.Stamp != null && p.Stamp.ExportOnly && !string.IsNullOrEmpty(p.Stamp.Game)) set.Add(p.Stamp.Game);
+        return set;
+    }
+
+    /// The build that just ended is signed for export only (Documents/gameapp.framework says so).
+    private bool LastBuildExportOnly()
+    {
+        try
+        {
+            var path = Path.Combine(GameAppMain.Documents, "gameapp.framework");
+            return File.Exists(path) && GameAppUi.ParseFrameworkStamp(File.ReadAllText(path))?.ExportOnly == true;
+        }
+        catch (Exception) { return false; }
+    }
+
+    /// "Sign again to play": the game's framework (in Documents, or parked in games/<id>/slot) is signed with the imported .p12 on a worker, then its stamp loses `signature=adhoc-export`
+    /// and the game plays. Nothing is rebuilt. Refused while a build, a boot or another signature runs.
+    private void SignAgainToPlay(string game)
+    {
+        var facts = GatherFacts();
+        if (running || signingAgain != null) { Write("sign again: wait until the build or the signature that is running ends"); return; }
+        if (!GameAppUi.OffersSignAgain(game, facts)) { Write($"sign again: {GameAppUi.DisplayName(game)} is not a build signed for export only with a .p12 to sign it (nothing done)"); return; }
+        string root = facts.Framework == FrameworkState.Fresh && facts.FrameworkGame == game ? GameAppMain.Documents : ParkedSlotOf(game)?.Root;
+        if (root == null) { Write($"sign again: the build of {GameAppUi.DisplayName(game)} was not found"); return; }
+        var frameworkDir = Path.Combine(root, GameSlot.Framework);
+        var stampPath = Path.Combine(root, GameSlot.Stamp);
+        signingAgain = game;
+        Write($"sign again: {GameAppUi.DisplayName(game)}: its framework is signed with your .p12 (no rebuild) — {frameworkDir}");
+        RefreshScreen();
+        Bg.Run(() =>
+        {
+            int rc;
+            try { rc = gameapp_sign_framework_again(frameworkDir, "DmGameProbe"); }
+            catch (Exception) { rc = -1; }   // EntryPointNotFoundException: a shim without it
+            if (rc == 0)
+            {
+                var part = stampPath + ".part";
+                File.WriteAllText(part, GameAppUi.StampSignedAgain(File.ReadAllText(stampPath)));
+                File.Move(part, stampPath, true);
+            }
+            return rc;
+        }, (rc, error) =>
+        {
+            signingAgain = null;
+            if (error != null) Write($"sign again: [RED] the stamp could not be written: {error.Message} — the build stays for export only");
+            else if (rc == 0) Write($"sign again: {GameAppUi.DisplayName(game)} is signed with your certificate: Play");
+            else Write($"sign again: [RED] not signed: {GameAppUi.SignAgainFailure(rc)} — the build stays for export only");
+            SlotsChanged();
+            RefreshScreen();
+            if (error == null && rc != 0)
+            {
+                var a = UIAlertController.Create(SignAgainTitle, "Not signed: " + GameAppUi.SignAgainFailure(rc) + ". The game can still be exported.", UIAlertControllerStyle.Alert);
+                a.AddAction(UIAlertAction.Create("OK", UIAlertActionStyle.Default, null));
+                PresentWhenFree(a);
+            }
+        }, work => BeginInvokeOnMainThread(work));
+    }
+}
