<Project Sdk="Microsoft.NET.Sdk">
  <!-- the patched engine's dmsh_xlate (Program.cs UNCHANGED) as a plain console tool, built from the sources the app compiles (@XLATE_SRC@): only to compare the app's in-process translator with a run of the same sources as a child process -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>dmsh_xlate</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="@XLATE_SRC@/ryu/**/*.cs" />
    <Compile Include="@XLATE_SRC@/Program.cs" />
    <Compile Include="@XLATE_SRC@/XlateCommonShim.cs" />
    <EmbeddedResource Include="@XLATE_SRC@/Program.cs" LogicalName="src0" />
    <EmbeddedResource Include="@XLATE_SRC@/dmsh_xlate.csproj" LogicalName="src1" />
    <EmbeddedResource Include="@XLATE_SRC@/ryu/Ryujinx.Graphics.Shader/CodeGen/Glsl/HelperFunctions/MultiplyHighS32.glsl" LogicalName="Ryujinx.Graphics.Shader.CodeGen.Glsl.HelperFunctions.MultiplyHighS32.glsl" />
    <EmbeddedResource Include="@XLATE_SRC@/ryu/Ryujinx.Graphics.Shader/CodeGen/Glsl/HelperFunctions/MultiplyHighU32.glsl" LogicalName="Ryujinx.Graphics.Shader.CodeGen.Glsl.HelperFunctions.MultiplyHighU32.glsl" />
    <EmbeddedResource Include="@XLATE_SRC@/ryu/Ryujinx.Graphics.Shader/CodeGen/Glsl/HelperFunctions/SwizzleAdd.glsl" LogicalName="Ryujinx.Graphics.Shader.CodeGen.Glsl.HelperFunctions.SwizzleAdd.glsl" />
  </ItemGroup>
</Project>
